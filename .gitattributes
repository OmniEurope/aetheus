# Auto detect text files and normalize to LF on commit
* text=auto

# Force LF for files that run on Linux
*.sh text eol=lf
*.bash text eol=lf
entrypoint* text eol=lf
Dockerfile* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Force CRLF for Windows-only scripts
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Worktree-sync merge strategies (managed by /syncw)
.claude/suggestions.md   merge=union
.claude/wishlist.md      merge=union
.claude/plan.md          merge=union
.claude/auditsession.md  merge=union
.claude/challenge-session.md merge=ours
CHANGELOG.md             merge=union
.claude/handoff.md       merge=ours
.claude/.next-progress   merge=ours
.claude/findings-plan.md merge=ours

# Binary files
*.tar.gz binary
*.gz binary
*.zip binary
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
