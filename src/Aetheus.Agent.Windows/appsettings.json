{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Aetheus": {
    "ServerUrl": "https://localhost:5301",
    "PollingIntervalSeconds": 10,
    "HeartbeatIntervalSeconds": 30,
    "MaxConcurrentTasks": 2,
    "WorkDirectory": "",
    "LogRetentionDays": 30,
    "DockerStorageMaintenance": {
      "PolicyVersion": 2,
      "Enabled": true,
      "DryRun": false,
      "DeploymentOnly": false,
      "AllowBuildsOnDeploymentTarget": false,
      "MaintenanceIntervalMinutes": 60,
      "MaxCacheAgeHours": 168,
      "PressureCacheAgeHours": 24,
      "ReservedSpaceGiB": 20,
      "MaxCacheGiB": 80,
      "MinFreeSpaceGiB": 20,
      "PressureUsedPercent": 80,
      "NuGetCacheRetentionDays": 30
    },
    "RegistrationToken": ""
  }
}
