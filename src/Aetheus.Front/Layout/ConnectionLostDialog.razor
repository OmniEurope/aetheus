@using Aetheus.Front.Resources
@inject IStringLocalizer<AppStrings> L

<OmniConnectionOverlay State="@(Visible ? OmniConnectionState.Reconnecting : OmniConnectionState.Connected)"
                       TimeUntilRetry="@TimeSpan.FromSeconds(ReconnectCountdown)" Reason="@LastFailureReason"
                       Busy="@ManualReconnecting" Title="@L["ConnectionLost"]"
                       Description="@L["ConnectionLostDescription"]"
                       OnReconnect="@OnManualReconnect" />
