<RadzenPanelMenu Click="@(_ => OnNavigate.InvokeAsync())">
    <RadzenPanelMenuItem Text="@L["Dashboard"]" Icon="dashboard" Path="" />
    @if (Permissions.CanReadAny(ResourceType.Server))
    {
    <RadzenPanelMenuItem Text="@L["Servers"]" Icon="dns" Path="servers" Expanded="true" Selected="@IsOnSection("servers")" class="nav-group">
        @if (IsOnSection("servers"))
        {
            var serverId = GetSpecificServerId();
            @if (serverId is not null)
            {
                @* Item #1 - migrated from legacy `?section=` query strings to real routes. *@
                <RadzenPanelMenuItem Text="@L["Overview"]" Icon="dashboard" Path="@($"servers/{serverId}/overview")" />
                <RadzenPanelMenuItem Text="@L["Services"]" Icon="engineering" Path="@($"servers/{serverId}/services")" />
                @* Docker / Apache / Certbot / Mail / TeamSpeak / Portsentry / Rkhunter are listed in the Services tab as manageable modules. *@
                <RadzenPanelMenuItem Text="@L["Projects"]" Icon="folder" Path="@($"servers/{serverId}/projects")" />
                <RadzenPanelMenuItem Text="@L["Pipelines"]" Icon="account_tree" Path="@($"servers/{serverId}/pipelines")" />
                <RadzenPanelMenuItem Text="@L["Libraries"]" Icon="library_books" Path="@($"servers/{serverId}/libraries")" />
                <RadzenPanelMenuItem Text="@L["Vaults"]" Icon="lock" Path="@($"servers/{serverId}/vaults")" />
                <RadzenPanelMenuItem Text="@L["Releases"]" Icon="new_releases" Path="@($"servers/{serverId}/releases")" />
                <RadzenPanelMenuItem Text="@L["Tasks"]" Icon="task_alt" Path="@($"servers/{serverId}/tasks")" />
                <RadzenPanelMenuItem Text="@L["Logs"]" Icon="receipt_long" Path="@($"servers/{serverId}/logs")" />
            }
            else
            {
                <RadzenPanelMenuItem Text="@L["Tasks"]" Icon="task_alt" Path="tasks" />
                <RadzenPanelMenuItem Text="@L["Logs"]" Icon="receipt_long" Path="logs" />
                <RadzenPanelMenuItem Text="@L["Alerts"]" Icon="notification_important" Path="alerts">
                    <Template>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <span>@L["Alerts"]</span>
                            @if (AlertNotify.UnreadCount > 0)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="@AlertNotify.UnreadCount.ToString()" class="alert-badge-dot" />
                            }
                        </RadzenStack>
                    </Template>
                </RadzenPanelMenuItem>
            }
        }
    </RadzenPanelMenuItem>
    }

    @if (CanReadProjectArea())
    {
    <RadzenPanelMenuItem Text="@L["Projects"]" Icon="folder" Path="projects" Expanded="true" Selected="@IsOnSection("projects")" class="nav-group">
        @if (IsOnSection("projects"))
        {
            var projectId = GetSpecificProjectId();
            @if (projectId is not null)
            {
                @foreach (var item in ProjectNavigationCatalog.VisibleItems(Permissions, projectId.Value))
                {
                    <RadzenPanelMenuItem Text="@L[item.LabelKey]" Icon="@item.Icon" Path="@item.Path(projectId.Value)" />
                }
            }
            else
            {
                @if (Permissions.CanReadAny(ResourceType.Pipeline)
                    || Permissions.CanReadAny(ResourceType.PipelineTemplate))
                {
                    <RadzenPanelMenuItem Text="@L["Pipelines"]" Icon="account_tree" Path="pipelines" />
                }
                <RadzenPanelMenuItem Text="@L["AnalysisPortfolio"]" Icon="shield" Path="analysis" />
                @if (Permissions.CanReadAny(ResourceType.Release))
                {
                    <RadzenPanelMenuItem Text="@L["Releases"]" Icon="new_releases" Path="releases" />
                }
                @if (Permissions.CanReadAny(ResourceType.VariableLibrary))
                {
                    <RadzenPanelMenuItem Text="@L["VariableLibraries"]" Icon="data_object" Path="variable-libraries" />
                }
                @if (Permissions.CanReadAny(ResourceType.Vault))
                {
                    <RadzenPanelMenuItem Text="@L["Vaults"]" Icon="lock" Path="vaults" />
                }
                @if (Permissions.CanReadAny(ResourceType.Environment))
                {
                    <RadzenPanelMenuItem Text="@L["Environments"]" Icon="layers" Path="environments" />
                }
            }
        }
    </RadzenPanelMenuItem>
    }
    <RadzenPanelMenuItem Text="@L["Settings"]" Icon="settings" Path="settings" />
    <RadzenPanelMenuItem Text="@L["HelpCenter"]" Icon="help" Path="help" />
    @if (Auth.IsAdmin)
    {
        <RadzenPanelMenuItem Text="@L["Administration"]" Icon="admin_panel_settings" Path="admin" Expanded="@IsOnSection("admin")" Selected="@IsOnSection("admin")">
            @if (IsOnSection("admin"))
            {
                <RadzenPanelMenuItem Text="@L["Users"]" Icon="group" Path="admin/users" />
                <RadzenPanelMenuItem Text="@L["Organizations"]" Icon="apartment" Path="admin/organizations" />
                <RadzenPanelMenuItem Text="@L["Roles"]" Icon="admin_panel_settings" Path="admin/roles" />
                <RadzenPanelMenuItem Text="@L["AuditLogs"]" Icon="policy" Path="admin/audit" />
                <RadzenPanelMenuItem Text="@L["NotificationRules"]" Icon="notifications_active" Path="admin/notifications" />
                <RadzenPanelMenuItem Text="@L["AiRunnerProfiles"]" Icon="smart_toy" Path="admin/ai-profiles" />
                <RadzenPanelMenuItem Text="@L["PackageFeeds"]" Icon="inventory" Path="admin/package-feeds" />
                <RadzenPanelMenuItem Text="@L["PackageRegistry"]" Icon="deployed_code" Path="admin/package-registry" />
                <RadzenPanelMenuItem Text="@L["SystemLogs"]" Icon="description" Path="admin/system-logs" />
                <RadzenPanelMenuItem Text="@L["Plugins"]" Icon="extension" Path="admin/plugins" />
                <RadzenPanelMenuItem Text="@L["Dashboards"]" Icon="space_dashboard" Path="admin/dashboards" />
                <RadzenPanelMenuItem Text="@L["PlatformSettings"]" Icon="tune" Path="admin/settings" />
                <RadzenPanelMenuItem Text="@L["ApiReference"]" Icon="api" Path="admin/api-reference" />
            }
        </RadzenPanelMenuItem>
    }
</RadzenPanelMenu>
