@* ADR-021 phase 4: grouped errors for a monitored app (fingerprint / type / message / count / seen). *@
<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" class="rz-mb-2">
    <RadzenButton Icon="refresh" Text="@L["Refresh"]" Click="@LoadAsync" IsBusy="@_loading" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
</RadzenStack>

<RadzenDataGrid Responsive="false" Data="@_errors" TItem="AppErrorEventDto" Density="Density.Compact" AllowSorting="true"
                IsLoading="@_loading" EmptyText="@L["NoErrorsYet"]" AllowFiltering="true" FilterMode="FilterMode.Advanced" AllowColumnResize="true" AllowVirtualization="@AetheusGrid.Virtualization" VirtualizationOverscanCount="3" AllowPaging="@(!AetheusGrid.Virtualization)">
    <Columns>
        <RadzenDataGridColumn TItem="AppErrorEventDto" Property="ExceptionType" Title="@L["ErrorType"]" Width="220px" />
        <RadzenDataGridColumn TItem="AppErrorEventDto" Property="Message" Title="@L["Message"]">
            <Template Context="e">
                <span title="@e.Message">@e.Message</span>
                @if (!string.IsNullOrEmpty(e.TopFrame))
                {
                    <div class="rz-color-secondary app-error-top-frame">@e.TopFrame</div>
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AppErrorEventDto" Property="OccurrenceCount" Title="@L["Occurrences"]" Width="120px">
            <Template Context="e"><RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="@e.OccurrenceCount.ToString()" /></Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AppErrorEventDto" Property="FirstSeenAt" Title="@L["FirstSeen"]" Width="150px" FormatString="{0:g}" />
        <RadzenDataGridColumn TItem="AppErrorEventDto" Property="LastSeenAt" Title="@L["LastSeen"]" Width="150px" FormatString="{0:g}" />
    </Columns>
</RadzenDataGrid>
@if (_total > PageSize)
{
    <RadzenPager Count="@_total" PageSize="@PageSize" PageChanged="@OnPageChanged" />
}
