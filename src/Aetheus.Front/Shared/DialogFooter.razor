@* S-TECH-Z3MP: shared footer for section dialogs - the right-aligned action row + the standard
   Light "Cancel" button (the part that genuinely repeats). Each dialog's primary action(s) - which
   legitimately vary (Submit vs Click, icon, busy, disabled) - go in ChildContent. *@
<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
            JustifyContent="@(SecondaryContent is null ? JustifyContent.End : JustifyContent.SpaceBetween)"
            Gap="0.5rem" class="rz-mt-3">
    @if (SecondaryContent is not null)
    {
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            @SecondaryContent
        </RadzenStack>
    }
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenButton Text="@(CancelText ?? L["Cancel"])" Icon="close" Variant="@CancelVariant" Click="@OnCancel" ButtonStyle="ButtonStyle.Light" />
        @ChildContent
    </RadzenStack>
</RadzenStack>
