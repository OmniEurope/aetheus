@namespace Aetheus.Front.Shared

<RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.75rem" class="empty-state rz-p-6">
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <RadzenIcon Icon="@Icon" class="empty-state-icon" />
    }
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">@Title</RadzenText>
    }
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-m-0" TextAlign="TextAlign.Center">@Description</RadzenText>
    }
    @if (ActionContent is not null)
    {
        <div class="empty-state-actions">@ActionContent</div>
    }
</RadzenStack>
