@if (IsGlobal)
{
    <div class="pipeline-list-toolbar">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">@L["Releases"]</RadzenText>
            <HelpLink PageKey="releases" />
            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@string.Format(L["Total"], _totalCount)" />
            <div class="pipeline-list-spacer"></div>
            <RadzenButton Icon="refresh" Size="ButtonSize.Small"
                Click="@RefreshAsync" title="@L["Refresh"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap"
            class="rz-mt-2">
            <RadzenIcon Icon="filter_list" class="rz-color-secondary" />
            <RadzenDropDown TValue="int?" Data="@_projects" TextProperty="Name" ValueProperty="Id"
                Placeholder="@L["AllProjects"]" AllowClear="true" @bind-Value="_projectFilter"
                Change="@(_ => OnProjectFilterChanged())" />
            @if (_projectFilter.HasValue)
            {
                <RadzenButton Text="@L["SyncReleases"]" Icon="sync" Size="ButtonSize.Small"
                    Click="@SyncReleases" IsBusy="@_syncing" Disabled="@(!_canWrite)"
                    title="@(!_canWrite ? L["InsufficientPermissions"] : "")" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                <RadzenButton Text="@L["ClearFilters"]" Icon="clear" Size="ButtonSize.Small"
                    Click="@ClearFilters" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
            }
        </RadzenStack>
    </div>
}
else
{
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-4">
        <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@L["Releases"]</RadzenText>
        @if (IsProjectScope)
        {
            <RadzenButton Icon="sync" Size="ButtonSize.Small"
                Click="@SyncReleases" IsBusy="@_syncing" Disabled="@(!_canWrite)" title="@L["SyncReleases"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        }
    </RadzenStack>
}

<AetheusDataGrid @ref="_grid" TItem="ReleaseDto" Data="@_releases"
    Count="@_totalCount" IsLoading="@_loading" LoadData="@OnLoadData"
    RowClick="@(r => Nav.NavigateTo($"/releases/{r.Id}"))"
    EmptyText="@L["NoReleasesFound"]" FullHeight="@IsGlobal" class="pipeline-list-grid">
    <EmptyTemplate>
        <EmptyState Icon="new_releases" Title="@L["NoReleasesFound"]" Description="@L["EmptyReleasesHint"]" />
    </EmptyTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="ReleaseDto" Property="Version" Title="@L["Version"]" MinWidth="10rem">
            <Template Context="r">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="new_releases" class="rz-color-secondary" />
                    <a href="/releases/@r.Id" class="pipeline-name-link">@r.Version</a>
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
        @if (!IsProjectScope)
        {
            <RadzenDataGridColumn TItem="ReleaseDto" Property="ProjectName" Title="@L["Project"]" MinWidth="10rem" />
        }
        <RadzenDataGridColumn TItem="ReleaseDto" Property="BranchName" Title="@L["Branch"]" Width="150px" />
        <RadzenDataGridColumn TItem="ReleaseDto" Property="Status" Title="@L["Status"]" Width="130px">
            <Template Context="r">
                <RadzenBadge BadgeStyle="@ReleaseHelper.GetReleaseBadge(r.Status)" Text="@L[r.Status.ToString()]" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ReleaseDto" Property="PublishedAt" Title="@L["ReleaseDate"]" Width="160px" SortOrder="SortOrder.Descending">
            <Template Context="r">
                @if (r.PublishedAt.HasValue)
                {
                    @r.PublishedAt.Value.ToString("g")
                }
                else
                {
                    <span class="rz-color-secondary">-</span>
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ReleaseDto" Title="@L["Changelog"]" Sortable="false" Filterable="false">
            <Template Context="r">
                @if (string.IsNullOrWhiteSpace(r.Changelog))
                {
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-m-0">-</RadzenText>
                }
                else
                {
                    <div class="release-changelog-cell">
                        @(IsChangelogExpanded(r.Id) ? r.Changelog : ChangelogPreview(r.Changelog))
                    </div>
                    @if (IsChangelogTruncatable(r.Changelog))
                    {
                        <span @onclick:stopPropagation="true">
                            <RadzenButton ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.ExtraSmall"
                                Text="@(IsChangelogExpanded(r.Id) ? L["ShowLess"] : L["ShowMore"])"
                                Click="@(() => ToggleChangelog(r.Id))" />
                        </span>
                    }
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ReleaseDto" Title="@L["Artifact"]" Width="140px" Sortable="false">
            <Template Context="r">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" Wrap="FlexWrap.Wrap">
                    @foreach (var art in r.Artifacts)
                    {
                        <a href="/artifacts/@art.Id" class="pipeline-name-link" @onclick:stopPropagation="true">
                            <RadzenIcon Icon="inventory_2" /> @art.Name
                        </a>
                    }
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
        @if (!IsServerScope)
        {
            <RadzenDataGridColumn TItem="ReleaseDto" Title="" Width="200px" Sortable="false" TextAlign="TextAlign.Right">
                <Template Context="r">
                    <span @onclick:stopPropagation="true">
                    @if (r.Status == ReleaseStatus.Detected)
                    {
                        <RadzenButton Icon="rocket_launch" Size="ButtonSize.Small" Click="@(() => TriggerBuild(r))" title="@L["TriggerBuild"]" Disabled="@(!_canWrite)" ButtonStyle="ButtonStyle.Success" Variant="Variant.Filled" />
                    }
                    @if (r.Status == ReleaseStatus.Published)
                    {
                        <RadzenButton Icon="arrow_upward" Size="ButtonSize.Small" Click="@(() => PromoteRelease(r))" title="@L["Promote"]" Disabled="@(!_canWrite)" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                        <RadzenButton Icon="undo" Size="ButtonSize.Small" Click="@(() => RollbackRelease(r))" title="@L["Rollback"]" Disabled="@(!_canWrite)" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                    }
                    @if (r.PipelineRunId.HasValue)
                    {
                        <RadzenButton Icon="visibility" Size="ButtonSize.Small" Click="@(() => Nav.NavigateTo($"/pipelines/runs/{r.PipelineRunId}"))" title="@L["ViewRun"]" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
                    }
                    </span>
                </Template>
            </RadzenDataGridColumn>
        }
    </Columns>
</AetheusDataGrid>
