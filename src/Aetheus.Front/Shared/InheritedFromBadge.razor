@using Microsoft.Extensions.Localization
@using Aetheus.Front.Resources
@inject IStringLocalizer<AppStrings> L

@if (!string.IsNullOrEmpty(OwnerName))
{
    <RadzenBadge BadgeStyle="BadgeStyle.Light" class="inherited-badge"
        title="@string.Format(L["InheritedFrom"], OwnerLabel, OwnerName)"
        Text="@($"{OwnerLabel}: {OwnerName}")" />
}
