<RadzenStack Gap="1rem">
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">
        @string.Format(L["RollbackReleaseSummary"].Value, SourceVersion, TargetVersion, DeploymentAge)
    </RadzenAlert>

    <RadzenDropDown TValue="int?" Data="@Pipelines" TextProperty="Name" ValueProperty="Id"
        @bind-Value="_pipelineId" Placeholder="@L["RollbackPipeline"]" class="rz-w-100" />

    @if (_canRestoreDatabase)
    {
        <LabeledToggle Value="_restoreDatabase"
            ValueChanged="@(value => OnRestoreDatabaseChanged(value))"
            Text="@L["RestoreDatabaseFromVerifiedBackup"]" />
        @if (_restoreDatabase)
        {
            <RadzenDropDown TValue="int?" Data="@_verifiedBackups" TextProperty="Label" ValueProperty="Id"
                @bind-Value="_backupRunId" Placeholder="@L["SelectVerifiedBackup"]" class="rz-w-100" />
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@L["DatabaseRestoreWarning"]</RadzenAlert>
        }
    }

    <DialogFooter OnCancel="@(() => Dialog.Close())">
        <RadzenButton Text="@L["Rollback"]" Icon="undo" Click="@Confirm"
            Disabled="@(!_pipelineId.HasValue || (_restoreDatabase && !_backupRunId.HasValue))"
            ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
    </DialogFooter>
</RadzenStack>
