@using Aetheus.Front.Helpers

<ol class="@TreeCssClass">
    @foreach (var run in Items)
    {
        var hasChildren = run.LinkedRuns.Count > 0;
        var expanded = IsExpanded(run.RunId);
        <li class="pipeline-run-tree-node">
            <div class="pipeline-run-tree-row">
                @if (hasChildren)
                {
                    <RadzenButton Icon="@(expanded ? "expand_more" : "chevron_right")"
                                  Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Light"
                                  Variant="Variant.Text"
                                  class="pipeline-run-tree-toggle"
                                  Click="@(() => Toggle(run.RunId))"
                                  aria-label="@(expanded ? L["CollapseLinkedPipelineRuns"] : L["ExpandLinkedPipelineRuns"])"
                                  aria-expanded="@expanded" />
                }
                else
                {
                    <span class="pipeline-run-tree-leaf" aria-hidden="true"></span>
                }
                <a href="@RunHref(run)" class="pipeline-run-tree-id" @onclick:stopPropagation="true">@run.RunId</a>
                <a href="@PipelineHref(run)" class="pipeline-name-link pipeline-run-tree-name" @onclick:stopPropagation="true">@run.PipelineName</a>
                @if (GroupByProject)
                {
                    <span class="pipeline-project-context pipeline-run-tree-project">
                        <RadzenIcon Icon="folder" aria-hidden="true" />
                        <span>@(run.ProjectName ?? L["Unassigned"])</span>
                    </span>
                }
                <span class="pipeline-run-tree-status">
                    <RadzenBadge BadgeStyle="@PipelineHelper.GetRunBadge(run.Status)" Text="@L.Localize(run.Status)" />
                    @if (run.GateGrade.HasValue)
                    {
                        @* Same rule as the runs grid: the gate letter rides with the status, and only
                           when a gate actually graded the run. *@
                        <RadzenBadge BadgeStyle="@PipelineHelper.GetGradeBadge(run.GateGrade.Value)"
                                     Text="@run.GateGrade.Value.ToString()"
                                     title="@L["GateGrade"]" class="pipeline-gate-grade-badge" />
                    }
                </span>
                @if (!Compact)
                {
                    <span class="pipeline-run-tree-step">@(run.CurrentStep ?? "-")</span>
                }
                <span class="pipeline-run-tree-started" title="@run.StartedAt.ToString("F")">@run.StartedAt.ToString("g")</span>
                @if (!Compact || ShowDurationInCompact)
                {
                    <span class="pipeline-run-tree-duration"><PipelineRunTableLiveDuration Run="@run" /></span>
                }
            </div>
            @if (hasChildren && expanded)
            {
                <PipelineRunHierarchy Items="@run.LinkedRuns" Compact="@Compact" ShowDurationInCompact="@ShowDurationInCompact" GroupByProject="@GroupByProject"
                                      ServerId="@ServerId" Depth="@(Depth + 1)" />
            }
        </li>
    }
</ol>
