@namespace Aetheus.Front.Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<Aetheus.Front.Resources.AppStrings> L

@*
    C / F-06: shared page header. One consistent title row across pages - optional back button,
    section icon, title (+ inline badges/help via ChildContent), a spacer, then right-aligned
    Actions. Pages stop hand-rolling RadzenStack header markup; the look stays uniform.
*@
<div class="page-header @Class">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
        @if (!string.IsNullOrWhiteSpace(BackHref))
        {
            <BrowserBackButton Size="ButtonSize.Small" Title="@L["GoBack"]" />
        }
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <RadzenIcon Icon="@Icon" class="rz-color-primary page-header-icon" />
        }
        <RadzenText TextStyle="@TitleStyle" class="rz-m-0">@Title</RadzenText>
        @* Phones only: badges and actions would push the page content several rows down, so they
           collapse behind this toggle. The button is hidden above the phone breakpoint and the
           collapsed rule is scoped to the same media query, so wider viewports are unaffected
           whatever the toggle state. *@
        @if (HasCollapsibleContent)
        {
            <RadzenButton Icon="@(_detailsExpanded ? "expand_less" : "expand_more")"
                          Click="@ToggleDetails" Size="ButtonSize.ExtraSmall"
                          ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                          class="page-header-toggle"
                          aria-expanded="@_detailsExpanded.ToString().ToLowerInvariant()"
                          aria-label="@(_detailsExpanded ? L["ShowLess"] : L["ShowMore"])"
                          title="@(_detailsExpanded ? L["ShowLess"] : L["ShowMore"])" />
        }
        @if (ChildContent is not null)
        {
            <span class="page-header-badges @CollapsibleStateClass">@ChildContent</span>
        }
        @if (Actions is not null)
        {
            <div class="page-header-spacer"></div>
            <div class="page-header-actions @CollapsibleStateClass">
                @Actions
            </div>
        }
    </RadzenStack>
    @if (!string.IsNullOrWhiteSpace(Subtitle))
    {
        <RadzenText TextStyle="TextStyle.Body2" class="page-header-subtitle rz-color-secondary">@Subtitle</RadzenText>
    }
    @if (Filters is not null)
    {
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"
            Wrap="FlexWrap.Wrap" class="rz-mt-2">
            @Filters
        </RadzenStack>
    }
</div>
