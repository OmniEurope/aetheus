@using Microsoft.AspNetCore.Components.Forms

@if (_loading)
{
    <AetheusLoader />
}
else
{
    <RadzenCard class="quality-gate-activation-card rz-mb-4">
        <div class="quality-gate-activation-copy">
            <div class="quality-gate-activation-icon" aria-hidden="true">
                <RadzenIcon Icon="verified_user" />
            </div>
            <RadzenStack Gap="0.35rem">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.4rem" Wrap="FlexWrap.Wrap">
                    <RadzenBadge Text="@L["QualityGateOptionalBadge"]" BadgeStyle="BadgeStyle.Success" />
                    <RadzenBadge Text="YAML" BadgeStyle="BadgeStyle.Info" />
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.H5">@L["QualityGateOptionalTitle"]</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                    @L["QualityGateOptionalDescription"]
                </RadzenText>
            </RadzenStack>
        </div>
        <div class="quality-gate-yaml-panel">
            <div class="quality-gate-yaml-header">
                <RadzenText TextStyle="TextStyle.Subtitle2">@L["QualityGateYamlExample"]</RadzenText>
                <RadzenButton Text="@L["QualityGateCopyYaml"]" Icon="content_copy"
                    Click="CopyYamlAsync" Size="ButtonSize.Small"
                    ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
            </div>
            <pre><code>@YamlExample</code></pre>
        </div>
    </RadzenCard>

    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
        JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem" Wrap="FlexWrap.Wrap" class="rz-mb-3">
        <RadzenStack Gap="0.25rem">
            <RadzenText TextStyle="TextStyle.H5">@L["QualityGates"]</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">@L["QualityGatesInheritanceHelp"]</RadzenText>
        </RadzenStack>
        @if (CanEdit)
        {
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenButton Text="@L["QualityGateRecommended"]" Icon="check_circle"
                    Click="@(() => ApplyPresetAsync(false))" IsBusy="@_applying"
                    ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
                <RadzenButton Text="@L["QualityGateStrict"]" Icon="security"
                    Click="@(() => ApplyPresetAsync(true))" IsBusy="@_applying"
                    ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
                <RadzenButton Text="@L["Import"]" Icon="upload_file" Click="OpenImportAsync"
                    Disabled="@_applying" ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
                <InputFile @ref="_importFile" OnChange="ImportAsync" class="input-file-hidden" accept=".json,application/json" />
                <RadzenButton Text="@L["Export"]" Icon="download" Click="ExportAsync"
                    ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
                <RadzenButton Text="@L["QualityGateAddRule"]" Icon="add" Click="BeginAdd"
                    ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
            </RadzenStack>
        }
    </RadzenStack>

    @if (_showForm)
    {
        <RadzenCard class="rz-mb-3 analysis-governance-form">
            <RadzenTemplateForm TItem="PolicyFormModel" Data="@_form" Submit="SaveAsync">
                <LocalizedDataAnnotationsValidator />
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="@L["QualityGateRuleType"]">
                            <RadzenDropDown TValue="QualityGateRuleKind" Data="@_ruleKinds"
                                TextProperty="Text" ValueProperty="Value" @bind-Value="_form.Kind"
                                aria-label="@L["QualityGateRuleType"]" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="@L["Name"]">
                            <RadzenTextBox Name="PolicyName" @bind-Value="_form.Name" MaxLength="200"
                                aria-label="@L["Name"]" />
                            <RadzenRequiredValidator Component="PolicyName" Text="@L["RequiredField"]" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="@L["QualityGatePolicyKey"]">
                            <RadzenTextBox Name="PolicyKey" @bind-Value="_form.PolicyKey"
                                MaxLength="200" Disabled="@_lockPolicyKey"
                                aria-label="@L["QualityGatePolicyKey"]" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="@L["Category"]">
                            <RadzenDropDown TValue="AnalysisCategory?" Data="@_categories"
                                TextProperty="Text" ValueProperty="Value"
                                @bind-Value="_form.Category" AllowClear="true"
                                aria-label="@L["Category"]" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="@L["AnalysisScanner"]">
                            <RadzenTextBox @bind-Value="_form.ScannerKey" MaxLength="100"
                                aria-label="@L["AnalysisScanner"]" />
                        </RadzenFormField>
                    </RadzenColumn>
                    @if (_form.Kind == QualityGateRuleKind.Finding)
                    {
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="@L["AnalysisRule"]">
                                <RadzenTextBox @bind-Value="_form.RuleId" MaxLength="300"
                                    aria-label="@L["AnalysisRule"]" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="@L["Severity"]">
                                <RadzenDropDown TValue="AnalysisSeverity?" Data="@_severities"
                                    TextProperty="Text" ValueProperty="Value"
                                    @bind-Value="_form.SeverityThreshold" AllowClear="true"
                                    aria-label="@L["Severity"]" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <LabeledToggle @bind-Value="_form.NewFindingsOnly"
                                Text="@L["QualityGateNewFindingsOnly"]" />
                        </RadzenColumn>
                    }
                    else
                    {
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="@L["AnalysisMetricKey"]">
                                <RadzenTextBox Name="MetricKey" @bind-Value="_form.MetricKey" MaxLength="300"
                                    aria-label="@L["AnalysisMetricKey"]" />
                                <RadzenRequiredValidator Component="MetricKey" Text="@L["RequiredField"]" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="@L["AnalysisOperator"]">
                                <RadzenDropDown TValue="AnalysisPolicyOperator?" Data="@_operators"
                                    TextProperty="Text" ValueProperty="Value" @bind-Value="_form.Operator"
                                    aria-label="@L["AnalysisOperator"]" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="@L["AnalysisThreshold"]">
                                <RadzenNumeric TValue="double?" Name="Threshold" @bind-Value="_form.Threshold"
                                    AriaLabel="@L["AnalysisThreshold"]" />
                                <RadzenRequiredValidator Component="Threshold" Text="@L["RequiredField"]" />
                            </RadzenFormField>
                        </RadzenColumn>
                    }
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenFormField Text="@L["Branch"]">
                            <RadzenTextBox @bind-Value="_form.BranchPattern" MaxLength="300"
                                aria-label="@L["Branch"]" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenFormField Text="@L["Environment"]">
                            <RadzenTextBox @bind-Value="_form.EnvironmentPattern" MaxLength="300"
                                aria-label="@L["Environment"]" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenFormField Text="@L["Behavior"]">
                            <RadzenDropDown TValue="AnalysisGateBehavior" Data="@_behaviors"
                                TextProperty="Text" ValueProperty="Value" @bind-Value="_form.Behavior"
                                aria-label="@L["Behavior"]" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenFormField Text="@L["Priority"]">
                            <RadzenNumeric TValue="int" @bind-Value="_form.Priority"
                                AriaLabel="@L["Priority"]" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="2">
                        <LabeledToggle @bind-Value="_form.Enabled" Text="@L["Enabled"]" />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-3" Wrap="FlexWrap.Wrap">
                    <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Save"]" Icon="save"
                        IsBusy="@_saving" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                    <RadzenButton Text="@L["QualityGatePreview"]" Icon="preview" Click="PreviewAsync"
                        IsBusy="@_previewing" ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
                    <RadzenButton Text="@L["Cancel"]" Icon="close" Click="CancelEdit"
                        ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }

    @if (_preview is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" class="rz-mb-3">
            <RadzenText TextStyle="TextStyle.Subtitle2">@L["QualityGateEffectivePreview"]</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2">@L["QualityGateSnapshotHash"]: <code>@_preview.SnapshotHash</code></RadzenText>
            <RadzenText TextStyle="TextStyle.Body2">
                @L["QualityGateEffectiveRuleCount", _preview.Policies.Count(item => item.IsEffective)]
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Body2">
                @L["QualityGateExpectedProducers"]:
                @(_preview.ExpectedProducers.Count == 0 ? L["None"].Value : string.Join(", ", _preview.ExpectedProducers))
            </RadzenText>
            @if (_preview.Conflicts.Count > 0)
            {
                <RadzenText TextStyle="TextStyle.Body2">
                    @L["QualityGateConflicts"]: @string.Join(", ", _preview.Conflicts)
                </RadzenText>
            }
            @if (_preview.LatestRunGate is not null)
            {
                <RadzenText TextStyle="TextStyle.Body2">
                    @L["QualityGateLatestRunVerdict", _preview.LatestRunGate.PipelineRunId]:
                    <strong>@_preview.LatestRunGate.Status</strong>
                    · @L["AnalysisGrade"]:
                    <strong>@(_preview.LatestRunGate.Grade?.OverallGrade?.ToString() ?? L["Incomplete"])</strong>
                </RadzenText>
            }
        </RadzenAlert>
    }

    <RadzenCard class="quality-gate-rules-card">
        <div class="quality-gate-stat-strip">
            <div><strong>@_policies.Count</strong><span>@L["QualityGateRuleCount"]</span></div>
            <div><strong>@_policies.Count(item => item.IsInherited)</strong><span>@L["QualityGateInheritedCount"]</span></div>
            <div><strong>@_policies.Count(item => !item.IsInherited)</strong><span>@L["QualityGateLocalCount"]</span></div>
        </div>
        <RadzenDataGrid Responsive="false" Data="@_policies" TItem="AnalysisPolicyDto" AllowSorting="true"
            AllowFiltering="true" FilterMode="FilterMode.Advanced" Density="Density.Compact"
            EmptyText="@L["NoRecords"]" class="analysis-table quality-gate-table" AllowColumnResize="true" AllowVirtualization="@AetheusGrid.Virtualization" VirtualizationOverscanCount="3" AllowPaging="@(!AetheusGrid.Virtualization)">
            <Columns>
                <RadzenDataGridColumn TItem="AnalysisPolicyDto" Property="Name" Title="@L["Name"]" />
                <RadzenDataGridColumn TItem="AnalysisPolicyDto" Property="PolicyKey" Title="@L["QualityGatePolicyKey"]" />
                <RadzenDataGridColumn TItem="AnalysisPolicyDto" Title="@L["QualityGateOrigin"]">
                    <Template Context="item">
                        <RadzenBadge Text="@ScopeLabel(item.Scope)"
                            BadgeStyle="@(item.IsInherited ? BadgeStyle.Light : BadgeStyle.Info)" />
                        @if (item.IsOverride)
                        {
                            <RadzenBadge Text="@L["QualityGateOverride"]" BadgeStyle="BadgeStyle.Warning" />
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AnalysisPolicyDto" Title="@L["QualityGateCriterion"]">
                    <Template Context="item">@Criterion(item)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AnalysisPolicyDto" Title="@L["Behavior"]">
                    <Template Context="item">@BehaviorLabel(item.Behavior)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AnalysisPolicyDto" Property="Version" Title="@L["Version"]" Width="6rem" />
                <RadzenDataGridColumn TItem="AnalysisPolicyDto" Title="@L["Status"]" Width="8rem">
                    <Template Context="item">
                        <RadzenBadge Text="@(item.IsEffective ? L["Enabled"].Value : L["Disabled"].Value)"
                            BadgeStyle="@(item.IsEffective ? BadgeStyle.Success : BadgeStyle.Danger)" />
                    </Template>
                </RadzenDataGridColumn>
                @if (CanEdit)
                {
                    <RadzenDataGridColumn TItem="AnalysisPolicyDto" Filterable="false" Sortable="false"
                        TextAlign="TextAlign.Right" Width="13rem">
                        <Template Context="item">
                            @if (CanEditDirectly(item))
                            {
                                <RadzenButton Icon="edit" Title="@L["Edit"]" aria-label="@L["Edit"]"
                                    Size="ButtonSize.Small" Click="@(() => BeginEdit(item))"
                                    ButtonStyle="ButtonStyle.Info" Variant="Variant.Filled" />
                                <RadzenButton Icon="history" Title="@L["QualityGateHistory"]"
                                    aria-label="@L["QualityGateHistory"]" Size="ButtonSize.Small"
                                    Click="@(() => ShowHistoryAsync(item))"
                                    ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                            }
                            else
                            {
                                <RadzenButton Icon="difference" Title="@L["QualityGateOverride"]"
                                    aria-label="@L["QualityGateOverride"]" Size="ButtonSize.Small"
                                    Click="@(() => BeginOverride(item))"
                                    ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                            }
                            <RadzenButton Icon="content_copy" Title="@L["Duplicate"]"
                                aria-label="@L["Duplicate"]" Size="ButtonSize.Small"
                                Click="@(() => BeginDuplicate(item))"
                                ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                        </Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>

    @if (_historyPolicy is not null)
    {
        <RadzenCard class="rz-mt-3">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenText TextStyle="TextStyle.H5">
                    @L["QualityGateHistoryFor", _historyPolicy.Name]
                </RadzenText>
                <RadzenButton Icon="close" Size="ButtonSize.Small" Click="@(() => _historyPolicy = null)"
                    aria-label="@L["Close"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
            </RadzenStack>
            <RadzenDataGrid Responsive="false" Data="@_revisions" TItem="AnalysisPolicyRevisionDto"
                AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced"
                Density="Density.Compact" EmptyText="@L["NoRecords"]" AllowColumnResize="true" AllowVirtualization="@AetheusGrid.Virtualization" VirtualizationOverscanCount="3" AllowPaging="@(!AetheusGrid.Virtualization)">
                <Columns>
                    <RadzenDataGridColumn TItem="AnalysisPolicyRevisionDto" Property="Version"
                        Title="@L["Version"]" Width="7rem" />
                    <RadzenDataGridColumn TItem="AnalysisPolicyRevisionDto" Property="CreatedAt"
                        Title="@L["CreatedAt"]" FormatString="{0:g}" />
                    <RadzenDataGridColumn TItem="AnalysisPolicyRevisionDto" Property="SnapshotHash"
                        Title="@L["QualityGateSnapshotHash"]" />
                    @if (CanEdit)
                    {
                        <RadzenDataGridColumn TItem="AnalysisPolicyRevisionDto" Filterable="false"
                            Sortable="false" TextAlign="TextAlign.Right" Width="9rem">
                            <Template Context="revision">
                                <RadzenButton Text="@L["Restore"]" Icon="undo"
                                    Click="@(() => RollbackAsync(revision))"
                                    Disabled="@(revision.Version == _historyPolicy.Version || _applying)"
                                    ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled"
                                    Size="ButtonSize.Small" />
                            </Template>
                        </RadzenDataGridColumn>
                    }
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    }
}
