@if (IsGlobal)
{
    <div class="pipeline-list-toolbar">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">@L["VariableLibraries"]</RadzenText>
            <HelpLink PageKey="variable-libraries" />
            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@string.Format(L["Total"], _totalCount)" />
            <div class="pipeline-list-spacer"></div>
            <RadzenButton Icon="refresh" Size="ButtonSize.Small" Click="@ReloadGrid" title="@L["Refresh"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
            <RadzenButton Text="@L["NewVariableLibrary"]" Icon="add" Click="@NewLibrary"
                Disabled="@(!_canWrite)" title="@(!_canWrite ? L["InsufficientPermissions"] : "")" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap" class="rz-mt-2">
            <RadzenIcon Icon="filter_list" class="rz-color-secondary" />
            <RadzenTextBox Placeholder="@L["SearchVariableLibraries"]" @bind-Value="_search" Change="@ReloadGrid" class="pipeline-list-search" />
            @if (!string.IsNullOrEmpty(_search))
            {
                <RadzenButton Text="@L["ClearFilters"]" Icon="clear" Size="ButtonSize.Small" Click="@ClearFilters" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
            }
        </RadzenStack>
    </div>
}
else
{
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
        <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@L["Libraries"]</RadzenText>
        @if (IsProjectScope)
        {
            <RadzenButton Icon="add" Text="@L["NewVariableLibrary"]" Size="ButtonSize.Small" Click="@NewLibrary" Disabled="@(!_canWrite)" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        }
    </RadzenStack>
}

<AetheusDataGrid @ref="_grid" TItem="VariableLibraryDto" Data="@_libraries"
    Count="@_totalCount" PageSize="25" IsLoading="@_loading" LoadData="@OnLoadData"
    RowClick="@(lib => Nav.NavigateTo($"/variable-libraries/{lib.Id}"))"
    EmptyText="@L["NoVariableLibrariesFound"]" FullHeight="@IsGlobal">
    <EmptyTemplate>
        <EmptyState Icon="data_object" Title="@L["NoVariableLibrariesFound"]" Description="@L["EmptyLibrariesHint"]">
            <ActionContent>
                @if (_canWrite && (IsGlobal || IsProjectScope))
                {
                    <RadzenButton Text="@L["NewVariableLibrary"]" Icon="add" Click="@NewLibrary"
                        ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                }
            </ActionContent>
        </EmptyState>
    </EmptyTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="VariableLibraryDto" Property="Name" Title="@L["Name"]" MinWidth="10rem">
            <Template Context="lib">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="data_object" class="rz-color-secondary" />
                    <RadzenStack Gap="0">
                        <a href="/variable-libraries/@lib.Id" class="pipeline-name-link">@lib.Name</a>
                        @if (!IsProjectScope && !string.IsNullOrEmpty(lib.ProjectName))
                        {
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-m-0">@lib.ProjectName</RadzenText>
                        }
                    </RadzenStack>
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="VariableLibraryDto" Property="Description" Title="@L["Description"]" MinWidth="10rem" />
        <RadzenDataGridColumn TItem="VariableLibraryDto" Property="EntryCount" Title="@L["Entries"]" Width="100px" TextAlign="TextAlign.Center" />
        <RadzenDataGridColumn TItem="VariableLibraryDto" Property="UpdatedAt" Title="@L["Updated"]" FormatString="{0:g}" Width="160px" />
    </Columns>
</AetheusDataGrid>
