@if (IsGlobal)
{
    <div class="pipeline-list-toolbar">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">@L["Vaults"]</RadzenText>
            <HelpLink PageKey="vaults" />
            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@string.Format(L["Total"], _totalCount)" />
            <div class="pipeline-list-spacer"></div>
            <RadzenButton Icon="refresh" Size="ButtonSize.Small" Click="@ReloadGrid" title="@L["Refresh"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
            <RadzenButton Text="@L["NewVault"]" Icon="add" Click="@NewVault"
                Disabled="@(!_canWrite)" title="@(!_canWrite ? L["InsufficientPermissions"] : "")" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap" class="rz-mt-2">
            <RadzenIcon Icon="filter_list" class="rz-color-secondary" />
            <RadzenTextBox Placeholder="@L["SearchVaults"]" @bind-Value="_search" Change="@ReloadGrid" class="pipeline-list-search" />
            @if (!string.IsNullOrEmpty(_search))
            {
                <RadzenButton Text="@L["ClearFilters"]" Icon="clear" Size="ButtonSize.Small" Click="@ClearFilters" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
            }
        </RadzenStack>
    </div>
}
else
{
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
        <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@L["Vaults"]</RadzenText>
        @if (IsProjectScope)
        {
            <RadzenButton Icon="add" Text="@L["NewVault"]" Size="ButtonSize.Small" Click="@NewVault" Disabled="@(!_canWrite)" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        }
    </RadzenStack>
}

<AetheusDataGrid @ref="_grid" TItem="VaultDto" Data="@_vaults"
    Count="@_totalCount" PageSize="25" IsLoading="@_loading" LoadData="@OnLoadData"
    RowClick="@(v => Nav.NavigateTo($"/vaults/{v.Id}"))"
    EmptyText="@L["NoVaultsFound"]" FullHeight="@IsGlobal">
    <EmptyTemplate>
        <EmptyState Icon="lock" Title="@L["NoVaultsFound"]" Description="@L["EmptyVaultsHint"]">
            <ActionContent>
                @if (_canWrite && (IsGlobal || IsProjectScope))
                {
                    <RadzenButton Text="@L["NewVault"]" Icon="add" Click="@NewVault"
                        ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                }
            </ActionContent>
        </EmptyState>
    </EmptyTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="VaultDto" Property="Name" Title="@L["Name"]" MinWidth="10rem">
            <Template Context="vault">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="lock" class="rz-color-secondary" />
                    <RadzenStack Gap="0">
                        <a href="/vaults/@vault.Id" class="pipeline-name-link">@vault.Name</a>
                        @if (!IsProjectScope && !string.IsNullOrEmpty(vault.ProjectName))
                        {
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-m-0">@vault.ProjectName</RadzenText>
                        }
                    </RadzenStack>
                    @if (!Permissions.CanWrite(ResourceType.Vault, vault.Id))
                    {
                        <RadzenIcon Icon="visibility" class="rz-color-secondary icon-xs-app" title="@L["Read"]" />
                    }
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="VaultDto" Property="Description" Title="@L["Description"]" MinWidth="10rem" />
        <RadzenDataGridColumn TItem="VaultDto" Property="SecretCount" Title="@L["Secrets"]" Width="100px" TextAlign="TextAlign.Center" />
        <RadzenDataGridColumn TItem="VaultDto" Property="UpdatedAt" Title="@L["Updated"]" FormatString="{0:g}" Width="160px" />
    </Columns>
</AetheusDataGrid>
