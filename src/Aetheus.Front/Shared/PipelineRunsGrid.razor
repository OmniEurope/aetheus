@using Aetheus.Front.Helpers

@if (IsLoading)
{
    <div role="progressbar" aria-label="@L["Loading"]" aria-valuemin="0" aria-valuemax="100"
         class="rz-progressbar rz-progressbar-indeterminate rz-progressbar-primary">
        <div class="rz-progressbar-value"></div>
    </div>
}
else if (Items.Count == 0)
{
    <EmptyState Icon="hourglass_empty" Title="@L[EmptyTitleKey]" Description="@L[EmptyDescriptionKey]" />
}
else
{
    <RadzenDataGrid Responsive="false" @ref="_grid" Data="@DisplayItems" TItem="PipelineRunTableItem" Density="Density.Compact"
        AllowPaging="@(AllowPaging && !Virtualize && !FillHeight)" PageSize="@PageSize" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced"
        AllowColumnResize="true"
        AllowVirtualization="@UsesVirtualization" VirtualizationOverscanCount="3"
        ExpandMode="DataGridExpandMode.Single" RowRender="@OnRowRender"
        RowExpand="@OnRowExpand" RowCollapse="@OnRowCollapse"
        ExpandChildItemAriaLabel="@L["ExpandLinkedPipelineRuns"]"
        RowClick="@OnRowClick" class="@GridCssClass">
        <Template Context="run">
            <div class="pipeline-linked-runs">
                <div class="pipeline-linked-runs-header">
                    <RadzenIcon Icon="account_tree" aria-hidden="true" />
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">@L["LinkedPipelineRuns"]</RadzenText>
                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@run.LinkedRuns.Count.ToString()" />
                </div>
                <PipelineRunHierarchy Items="@run.LinkedRuns" Compact="@Compact" ShowDurationInCompact="@ShowDurationInCompact"
                                      GroupByProject="@GroupByProject" ServerId="@ServerId" />
            </div>
        </Template>
        <Columns>
            <RadzenDataGridColumn TItem="PipelineRunTableItem" Property="RunId" Title="@L["ID"]" Width="5rem">
                <Template Context="run">
                    <a href="@RunHref(run)" @onclick:stopPropagation="true">@run.RunId</a>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineRunTableItem" Title="@L["Actions"]" Width="5.5rem"
                Sortable="false" Filterable="false" CssClass="pipeline-run-actions-column"
                HeaderCssClass="pipeline-run-actions-column">
                <Template Context="run">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.15rem" AlignItems="AlignItems.Center">
                        @if (CanCancel(run))
                        {
                            <RadzenButton Icon="cancel" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled"
                                          Size="ButtonSize.Small" title="@L["CancelRun"]" aria-label="@L["CancelRun"]"
                                          Disabled="@(_cancelling == run.RunId)"
                                          Click="@(() => CancelRunAsync(run))" @onclick:stopPropagation="true" />
                        }
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineRunTableItem" Property="PipelineName" Title="@L["Pipeline"]" MinWidth="10rem"
                Visible="@ShowPipelineColumn"
                CssClass="pipeline-run-name-column" HeaderCssClass="pipeline-run-name-column">
                <Template Context="run">
                    <a href="@PipelineHref(run)" class="pipeline-name-link" @onclick:stopPropagation="true">@run.PipelineName</a>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineRunTableItem" Property="ProjectName" Title="@L["Project"]" Width="10rem"
                Visible="@GroupByProject" CssClass="pipeline-project-column" HeaderCssClass="pipeline-project-column">
                <Template Context="run">
                    <span class="pipeline-project-context"><RadzenIcon Icon="folder" /> @(run.ProjectName ?? L["Unassigned"])</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineRunTableItem" Property="Status" Title="@L["Status"]" Width="8.5rem"
                CssClass="pipeline-secondary-column" HeaderCssClass="pipeline-secondary-column">
                <Template Context="run">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.3rem" AlignItems="AlignItems.Center">
                        <RadzenBadge BadgeStyle="@PipelineHelper.GetRunBadge(run.Status)" Text="@L.Localize(run.Status)" />
                        @if (run.GateGrade.HasValue)
                        {
                            @* The gate letter only appears when a gate actually graded the run; an
                               ungraded run shows nothing rather than a misleading placeholder. *@
                            <RadzenBadge BadgeStyle="@PipelineHelper.GetGradeBadge(run.GateGrade.Value)"
                                         Text="@run.GateGrade.Value.ToString()"
                                         title="@L["GateGrade"]" class="pipeline-gate-grade-badge" />
                        }
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineRunTableItem" Property="StartedAt" Title="@L["Started"]" FormatString="{0:g}" Width="9rem"
                CssClass="pipeline-secondary-column" HeaderCssClass="pipeline-secondary-column" />
            <RadzenDataGridColumn TItem="PipelineRunTableItem" Property="CompletedAt" Title="@L["Completed"]" FormatString="{0:g}" Width="9rem"
                CssClass="pipeline-secondary-column" HeaderCssClass="pipeline-secondary-column" />
            <RadzenDataGridColumn TItem="PipelineRunTableItem" Title="@L["Duration"]" Width="8rem" Sortable="false"
                Visible="@(!Compact || ShowDurationInCompact)" CssClass="pipeline-secondary-column" HeaderCssClass="pipeline-secondary-column">
                <Template Context="run">
                    <span class="pipeline-run-duration"><PipelineRunTableLiveDuration Run="@run" /></span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineRunTableItem" Property="BranchName" Title="@L["Branch"]" Width="10rem"
                CssClass="pipeline-secondary-column" HeaderCssClass="pipeline-secondary-column">
                <Template Context="run">
                    @if (string.IsNullOrWhiteSpace(run.BranchName))
                    {
                        <span class="rz-color-secondary">-</span>
                    }
                    else if (BranchHref(run) is { Length: > 0 } branchHref)
                    {
                        <a href="@branchHref" @onclick:stopPropagation="true" class="pipeline-run-ref-link">
                            @run.BranchName
                        </a>
                    }
                    else
                    {
                        <span class="pipeline-run-ref-link">@run.BranchName</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineRunTableItem" Property="CommitHash" Title="@L["Commit"]" Width="8rem"
                CssClass="pipeline-secondary-column" HeaderCssClass="pipeline-secondary-column">
                <Template Context="run">
                    @if (ShortCommit(run) is { Length: > 0 } shortCommit)
                    {
                        @if (CommitHref(run) is { Length: > 0 } commitHref)
                        {
                            <a href="@commitHref" @onclick:stopPropagation="true" class="pipeline-run-ref-link"
                               title="@run.CommitHash">@shortCommit</a>
                        }
                        else
                        {
                            <span class="pipeline-run-ref-link" title="@run.CommitHash">@shortCommit</span>
                        }
                    }
                    else
                    {
                        <span class="rz-color-secondary">-</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineRunTableItem" Property="ServerName" Title="@L["Server"]" Width="9rem"
                CssClass="pipeline-secondary-column" HeaderCssClass="pipeline-secondary-column">
                <Template Context="run">
                    @if (string.IsNullOrWhiteSpace(run.ServerName))
                    {
                        <span class="rz-color-secondary">-</span>
                    }
                    else
                    {
                        <span class="pipeline-run-ref-link" title="@run.ServerOs">@run.ServerName</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineRunTableItem" Title="@L["CurrentStep"]" MinWidth="11rem" Sortable="false" Visible="@(!Compact)">
                <Template Context="run">
                    @if (!string.IsNullOrWhiteSpace(run.CurrentStep))
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                            <div class="run-tl-dot run-timeline-dot-running"><span class="run-timeline-pulse"></span></div>
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">@run.CurrentStep</RadzenText>
                        </RadzenStack>
                    }
                    else
                    {
                        <span class="rz-color-secondary">-</span>
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
