<RadzenDataGrid Responsive="false" Data="@DisplayItems" TItem="PipelineDependencyDto" Density="Density.Compact"
    AllowPaging="@(!Virtualize && !FillHeight)" PageSize="@PageSize" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced"
    AllowVirtualization="@Virtualize" VirtualizationOverscanCount="3"
    ExpandMode="DataGridExpandMode.Single" RowRender="@OnRowRender" RowClick="@OnRowClick"
    ExpandChildItemAriaLabel="@L["ExpandChildItem"]"
    class="@GridCssClass" AllowColumnResize="true">
    <Template Context="pipeline">
        @{ var relations = Relations(pipeline); }
        <div class="pipeline-dependency-details">
            <div class="pipeline-relation-header">
                <span class="pipeline-relation-header-icon" aria-hidden="true">
                    <RadzenIcon Icon="@(ShowsChildren ? "account_tree" : "call_merge")" />
                </span>
                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">
                    @(ShowsChildren ? L["ChildPipelines"] : L["ParentPipelines"])
                </RadzenText>
                <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@relations.Count.ToString()" />
            </div>
            <ol class="@RelationListCss">
                @for (var index = 0; index < relations.Count; index++)
                {
                    var relation = relations[index];
                    <li class="pipeline-relation-item">
                        @if (relation.Id.HasValue)
                        {
                            <a href="@PipelineHref(relation.Id.Value)" class="pipeline-relation-card">
                                <span class="pipeline-relation-marker" aria-hidden="true">
                                    @if (ShowsChildren)
                                    {
                                        @((index + 1).ToString())
                                    }
                                    else
                                    {
                                        <RadzenIcon Icon="call_merge" />
                                    }
                                </span>
                                <span class="pipeline-relation-name">@relation.Name</span>
                                <RadzenIcon Icon="arrow_forward" class="pipeline-relation-open" aria-hidden="true" />
                            </a>
                        }
                        else
                        {
                            <span class="pipeline-relation-card pipeline-relation-card-static">
                                <span class="pipeline-relation-marker" aria-hidden="true">
                                    @if (ShowsChildren)
                                    {
                                        @((index + 1).ToString())
                                    }
                                    else
                                    {
                                        <RadzenIcon Icon="call_merge" />
                                    }
                                </span>
                                <span class="pipeline-relation-name">@relation.Name</span>
                            </span>
                        }
                    </li>
                }
            </ol>
        </div>
    </Template>
    <Columns>
        <RadzenDataGridColumn TItem="PipelineDependencyDto" Property="Name" Title="@L["Pipeline"]" MinWidth="11rem">
            <Template Context="pipeline">
                <a href="@PipelineHref(pipeline.Id)" class="pipeline-name-link" @onclick:stopPropagation="true">@pipeline.Name</a>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="PipelineDependencyDto" Property="ProjectName" Title="@L["Project"]" Width="10rem"
            Visible="@GroupByProject" CssClass="pipeline-project-column" HeaderCssClass="pipeline-project-column">
            <Template Context="pipeline">
                <span class="pipeline-project-context"><RadzenIcon Icon="folder" /> @(pipeline.ProjectName ?? L["Unassigned"])</span>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="PipelineDependencyDto" Title="@L["RecentRunsColumn"]" Width="6rem"
            Sortable="false" Filterable="false">
            <Template Context="pipeline">
                <PipelineRunHistory Runs="@pipeline.RecentRuns" ProjectId="@pipeline.ProjectId" ServerId="@ServerId" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="PipelineDependencyDto" Property="TriggerType" Title="@L["Trigger"]" Width="8rem"
            CssClass="pipeline-secondary-column" HeaderCssClass="pipeline-secondary-column">
            <Template Context="pipeline">@L.Localize(pipeline.TriggerType)</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="PipelineDependencyDto" Title="@L["Template"]" Width="11rem"
            Sortable="false" Filterable="false" Visible="@FleetAvailable">
            <Template Context="pipeline">
                @if (FleetItem(pipeline.Id) is { } fleetItem)
                {
                    @if (fleetItem.TemplateId is { } templateId)
                    {
                        <a href="@($"/templates/{templateId}")" class="pipeline-template-link"
                            title="@fleetItem.TemplateName" @onclick:stopPropagation="true">@fleetItem.TemplateName</a>
                    }
                    else if (!string.IsNullOrWhiteSpace(fleetItem.TemplateName))
                    {
                        <span title="@fleetItem.TemplateName">@fleetItem.TemplateName</span>
                    }
                    else
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@L["AutonomousPipeline"]" />
                    }
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="PipelineDependencyDto" Title="@L["Status"]" Width="9rem"
            Sortable="false" Filterable="false" Visible="@FleetAvailable">
            <Template Context="pipeline">
                @if (FleetItem(pipeline.Id) is { } fleetItem)
                {
                    @if (fleetItem.Freshness == PipelineFleetFreshness.OffCatalog)
                    {
                        <span title="@L["AutonomousPipeline"]">—</span>
                    }
                    else
                    {
                        <span class="pipeline-template-status" title="@TemplateStatusTitle(fleetItem)">
                            <RadzenBadge Text="@FreshnessText(fleetItem.Freshness)" BadgeStyle="@FreshnessStyle(fleetItem.Freshness)" />
                            @if (fleetItem.PinnedVersion is { } pinnedVersion)
                            {
                                <span>@($"v{pinnedVersion}")</span>
                            }
                        </span>
                    }
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="PipelineDependencyDto" Title="@L["Actions"]" Width="21rem" Sortable="false" Filterable="false" TextAlign="TextAlign.Right"
            CssClass="pipeline-actions-column" HeaderCssClass="pipeline-actions-column">
            <Template Context="pipeline">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.35rem" JustifyContent="JustifyContent.End" class="pipeline-row-actions" @onclick:stopPropagation="true">
                    @if (FleetItem(pipeline.Id) is { Freshness: PipelineFleetFreshness.Outdated, LatestVersion: { } latestVersion })
                    {
                        <RadzenButton Text="@L["Update"]" Icon="system_update_alt"
                            Click="@(() => UpdatePipelineTemplate(pipeline.Id, latestVersion))"
                            Disabled="@(!CanWrite)" title="@L["Update"]"
                            ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
                    }
                    <RadzenButton Icon="@(IsFavorite(pipeline.Id) ? "star" : "star_border")"
                        Click="@(() => SetFavorite(pipeline.Id, !IsFavorite(pipeline.Id)))"
                        Disabled="@PendingFavoritePipelineIds.Contains(pipeline.Id)"
                        aria-label="@(IsFavorite(pipeline.Id) ? L["RemovePipelineFromFavorites"] : L["AddPipelineToFavorites"])"
                        title="@(IsFavorite(pipeline.Id) ? L["RemovePipelineFromFavorites"] : L["AddPipelineToFavorites"])"
                        ButtonStyle="@(IsFavorite(pipeline.Id) ? ButtonStyle.Warning : ButtonStyle.Light)"
                        Variant="Variant.Text" class="pipeline-favorite-button" />
                    <RadzenButton Text="@L["Edit"]" Icon="edit" Click="@(() => EditPipeline(pipeline.Id))"
                        Disabled="@(!CanWrite)" title="@L["Edit"]" ButtonStyle="ButtonStyle.Info" Variant="Variant.Filled" />
                    <RadzenSplitButton Text="@L["Run"]" Icon="play_arrow" Click="@(item => RunPipeline(pipeline.Id, item))"
                        aria-label="@L["RunPipelineAction"]" title="@L["RunPipelineAction"]" Disabled="@(!CanWrite)" ButtonStyle="ButtonStyle.Success" Variant="Variant.Filled">
                        <RadzenSplitButtonItem Text="@L["RunWithOptions"]" Value="options" Icon="tune" />
                    </RadzenSplitButton>
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
