@using Aetheus.Front.Helpers

@if (Commits.Count == 0)
{
    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">@L["GitGraphEmptyTitle"]</RadzenText>
}
else
{
    <div class="git-svg-graph">
        <svg class="git-svg-lanes" width="@N(SvgWidth)" height="@N(SvgHeight)"
             viewBox="@($"0 0 {N(SvgWidth)} {N(SvgHeight)}")" xmlns="http://www.w3.org/2000/svg" role="img">
            <title>@L["GitGraph"]</title>
            @foreach (var e in _edges)
            {
                <path d="@e.Path" fill="none" stroke="@e.Color" stroke-width="2" stroke-linecap="round" />
            }
            @foreach (var n in _nodes)
            {
                <circle cx="@N(n.X)" cy="@N(n.Y)" r="@NodeRadius" fill="@LaneColor(n.Col)"
                        stroke="var(--rz-base-background-color)" stroke-width="1.5" />
            }
        </svg>
        <div class="git-svg-rows">
            @foreach (var n in _nodes)
            {
                <div class="git-svg-row">
                    <span class="git-graph-sha" title="@n.Commit.Sha">@n.Commit.ShortSha</span>
                    @* S-FEAT-G6T9: branch/tag refs decorating the commit tip - tags styled distinctly. *@
                    @foreach (var r in n.Commit.RefNames)
                    {
                        var isTag = r.StartsWith("tag: ", StringComparison.Ordinal);
                        <RadzenBadge BadgeStyle="@(isTag ? BadgeStyle.Warning : BadgeStyle.Info)" IsPill="true"
                                     Text="@(isTag ? r["tag: ".Length..] : r)"
                                     class="git-graph-ref-badge" />
                    }
                    <span class="git-graph-subject" title="@CommitTitle(n.Commit.Message)">@CommitTitle(n.Commit.Message)</span>
                    <span class="git-graph-meta">@n.Commit.AuthorName · @RelativeTime.FormatAgo(L, n.Commit.AuthorDate)</span>
                </div>
            }
        </div>
    </div>
}
