@* PLAN-005 lot 6 / D42: the content (a label, or a whole field), then a help icon on its right whose
   tooltip carries the description; the description is never a caption under the field. *@
<div class="param-help-row">
    <div class="param-help-content">@ChildContent</div>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <OmniTooltip Text="@Description" Focusable="true">
            <span class="param-help" role="img" aria-label="@Description">
                <OmniIcon Name="OmniIconName.Question" aria-hidden="true" />
            </span>
        </OmniTooltip>
        <span id="@DescriptionId" class="param-help-description">@Description</span>
    }
</div>
