@page "/admin/organizations/new"
@page "/admin/organizations/{Id:int}/edit"

<PageTitle>@(_isNew ? L["NewOrganization"] : L["EditOrganization"]) - Aetheus</PageTitle>

<OmniPageHeader Title="@(_isNew ? L["NewOrganization"] : L["EditOrganization"])" ShowBack="true" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("apartment")" /></Icon>
</OmniPageHeader>

@if (_loading)
{
    <AetheusLoader />
}
else
{
    <div class="omni-u-mt-lg form-narrow"><OmniTemplateForm TModel="OrganizationFormModel" Model="@_model"
        OnValidSubmit="@OnSubmit">
        <OmniDataAnnotationsValidator Localizer="@L" />
        <OmniStack Gap="OmniSpacing.Large">
            <OmniFormField For="oe-pages-organizations-organizationedit-1"><LabelContent>@L["Name"]</LabelContent><ChildContent>
                <OmniTextBox @bind-Value="_model.Name" Id="oe-pages-organizations-organizationedit-1" />
            </ChildContent></OmniFormField>
            <OmniFormField For="oe-pages-organizations-organizationedit-2"><LabelContent>@L["Slug"]</LabelContent><ChildContent>
                <OmniTextBox @bind-Value="_model.Slug" Id="oe-pages-organizations-organizationedit-2" />
            </ChildContent></OmniFormField>
            <OmniFormField For="oe-pages-organizations-organizationedit-3"><LabelContent>@L["Description"]</LabelContent><ChildContent>
                <OmniTextArea @bind-Value="_model.Description" Rows="3" Id="oe-pages-organizations-organizationedit-3" />
            </ChildContent></OmniFormField>
            <ValidationSummary />
            <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small">
                <OmniButton Variant="OmniButtonVariant.Primary" Disabled="@_saving" ButtonType="OmniButtonType.Submit"><OmniIcon Name="OmniIconName.Save" /> <span>@L["Save"]</span></OmniButton>
                <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => Nav.NavigateTo("/admin/organizations"))"><OmniIcon Name="OmniIconName.Close" /> <span>@L["Cancel"]</span></OmniButton>
            </OmniStack>
        </OmniStack>
    </OmniTemplateForm></div>
}
