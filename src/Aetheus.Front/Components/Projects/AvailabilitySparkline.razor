@namespace Aetheus.Front.Components.Projects
@* S-UX-SPKL: compact 24 h availability sparkline - one bar per sample bucket, green=up / red=down.
   Recette R-440: the colours come from app.css classes on the OE status tokens (the former
   var(--omni-u-text-*) values named tokens that exist nowhere, so every bar fell back to black), and
   the tooltip says what the bar is. *@
@if (_bars.Count == 0)
{
    <span class="omni-u-text-muted">@L["NotAvailable"]</span>
}
else
{
    <svg class="availability-sparkline" width="96" height="18" viewBox="0 0 96 18" role="img" aria-label="@Summary">
        <title>@Summary</title>
        @foreach (var bar in _bars)
        {
            <rect x="@bar.X" y="0" width="@bar.W" height="18" rx="1"
                  class="@(bar.IsUp ? "availability-sparkline-bar availability-sparkline-bar--up" : "availability-sparkline-bar availability-sparkline-bar--down")" />
        }
    </svg>
}
