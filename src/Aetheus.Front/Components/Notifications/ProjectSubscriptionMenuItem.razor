@* R-110 / R-116: follow or stop following a project. Its subscribers are the recipients of the
   project's notifications. Recette R-180: an entry of the project header's "..." menu. Recette R-431:
   the state comes from the header, known before the menu opens, so the entry never appears late and
   pushes "Edit" down; hidden while unknown, so it never shows a wrong label. *@

@if (State.Subscribed is { } subscribed)
{
    <OmniMenuItem OnClick="State.ToggleAsync" Disabled="@State.Busy"
                          title="@(subscribed ? L["NotificationUnsubscribeHint"] : L["NotificationSubscribeHint"])">
        <Icon><OmniIcon Name="@(subscribed ? OmniIconName.BellSlash : OmniIconName.Bell)" /></Icon>
        <ChildContent>@(subscribed ? L["Unsubscribe"] : L["Subscribe"])</ChildContent>
    </OmniMenuItem>
}
