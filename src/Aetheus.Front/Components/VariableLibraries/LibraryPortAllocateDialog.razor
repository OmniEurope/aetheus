@namespace Aetheus.Front.Components.VariableLibraries
@* PLAN-005 lot 5 - hands a library free ports instead of leaving an operator to invent them and
   discover the collision at `docker up`. The keys carry the PORT_ prefix because that prefix is the
   only thing the pipeline preflight guard reads. *@
<OmniStack Gap="OmniSpacing.Large">
    <OmniText Element="OmniTextElement.Paragraph">@L["PortAllocateLibraryHint"]</OmniText>

    @if (_blocker is not null)
    {
        <OmniAlert Severity="OmniSeverity.Warning"><Icon><OmniIcon Name="OmniIconName.Warning" /></Icon><ChildContent>@_blocker</ChildContent></OmniAlert>
    }
    else
    {
        <OmniStack Gap="OmniSpacing.XSmall">
        <OmniLabel For="alloc-server">@L["Server"]</OmniLabel>
            <OmniDropDown Id="alloc-server" name="alloc-server" TValue="int?" Options="@(_servers.ToOptions(item => (int?)item.ServerId, item => item.ServerName))" @bind-Value="_serverId" Placeholder="@L["Server"]" Class="w-100" />
        </OmniStack>

        <OmniStack Gap="OmniSpacing.XSmall">
        <OmniLabel For="alloc-preset">@L["PortAllocatePreset"]</OmniLabel>
            <OmniDropDown Id="alloc-preset" name="alloc-preset" TValue="string" Options="@(Presets.ToOptions(item => (string)item, item => item))" @bind-Value="_preset"
                @bind-Value:after="ApplyPreset" Class="w-100" />
        </OmniStack>

        <OmniStack Gap="OmniSpacing.XSmall">
        <OmniLabel For="alloc-keys">@L["PortAllocateKeys"]</OmniLabel>
            <OmniTextArea Id="alloc-keys" @bind-Value="_keysInput" Rows="4" Class="w-100" />
        </OmniStack>

        @if (_created.Count > 0)
        {
            <OmniStack Gap="OmniSpacing.XSmall">
                @foreach (var entry in _created)
                {
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@entry.Key = @entry.Value</OmniText>
                }
            </OmniStack>
        }
    }

    @if (_error is not null)
    {
        <OmniAlert Severity="OmniSeverity.Danger"><Icon><OmniIcon name="OmniIconName.Error" /></Icon><ChildContent>@_error</ChildContent></OmniAlert>
    }

    <DialogFooter OnCancel="@(() => Dialog.Close(_created.Count > 0))">
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@AllocateAsync" Disabled="@(_blocker is not null || _serverId is null)" Class="@(_busy ? "btn-busy" : null)" Busy="@(_busy)"><OmniIcon name="OmniIconName.Archive" /> <span>@L["PortAllocate"]</span></OmniButton>
    </DialogFooter>
</OmniStack>
