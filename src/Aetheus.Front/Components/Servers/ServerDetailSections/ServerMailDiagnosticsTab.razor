<OmniStack Gap="OmniSpacing.Large">
    <OmniRow Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
        @if (_diagnostics is not null)
        {
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@string.Format(L["MailDnsCheckedAt"], _diagnostics.CheckedAt.ToString("g"))</OmniText>
        }
        <div class="blade-content-spacer"></div>
        @* R-181: no Refresh button, the checklist reloads on the server's heartbeats and completed tasks. *@
        @if (CanManage)
        {
            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@RunServerCheckAsync" Disabled="@(_checkTaskId is not null)"><OmniIcon Name="OmniIconName.ListChecks" /> <span>@L["MailRunServerCheck"]</span></OmniButton>
            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@SendTestAsync" Disabled="@(_deliveryTaskId is not null)"><OmniIcon Name="OmniIconName.PaperPlaneRight" /> <span>@L["MailSendTest"]</span></OmniButton>
            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@MeasureUsageAsync" Disabled="@(_quotaTaskId is not null)"><OmniIcon Name="OmniIconName.ChartBarHorizontal" /> <span>@L["MailMeasureUsage"]</span></OmniButton>
        }
    </OmniRow>

    @if (_loading && _diagnostics is null)
    {
        <AetheusLoader Size="OmniControlSize.Small" />
    }
    @if (_diagnostics is not null)
    {
        <OmniStack Gap="OmniSpacing.XSmall">
            @foreach (var item in _diagnostics.Items)
            {
                <OmniRow Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
                    <OmniBadge Fill="OmniFill.Solid" Tone="@MailUiText.VerdictStyle(item.Verdict)">@MailUiText.Verdict(L, item.Verdict)</OmniBadge>
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@MailUiText.DiagnosticLabel(L, item.Key)</OmniText>
                    @if (!string.IsNullOrEmpty(item.Detail))
                    {
                        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@MailUiText.Detail(L, item.Detail)</OmniText>
                    }
                </OmniRow>
            }
        </OmniStack>
    }

    @if (_checkTaskId is not null || _deliveryTaskId is not null || _quotaTaskId is not null)
    {
        <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
            <AetheusLoader Size="OmniControlSize.Small" />
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@L["MailWaitingForTask"]</OmniText>
        </OmniStack>
    }

    @if (_delivery is not null)
    {
        <OmniAlert Severity="@(_delivery.IsSent ? OmniSeverity.Success : OmniSeverity.Danger)">
            @(_delivery.IsSent
                ? string.Format(L["MailDeliverySent"], _delivery.QueueId)
                : string.Format(L["MailDeliveryFailed"], _delivery.Status, _delivery.Detail))
        </OmniAlert>
    }

    @if (_checks.Count > 0)
    {
        <OmniStack Gap="OmniSpacing.XSmall">
            <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["MailServerChecks"]</OmniText>
            @foreach (var check in _checks)
            {
                <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
                    <OmniBadge Fill="OmniFill.Solid" Tone="@(check.IsOk ? OmniTone.Success : OmniTone.Danger)">@(check.IsOk ? L["MailVerdictOk"] : L["MailVerdictMismatch"])</OmniBadge>
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@check.Component</OmniText>
                    @if (!string.IsNullOrEmpty(check.Detail))
                    {
                        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@check.Detail</OmniText>
                    }
                </OmniStack>
            }
        </OmniStack>
    }
</OmniStack>
