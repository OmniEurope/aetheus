<OmniCard Class="omni-u-mb-lg">
    <OmniStack Gap="OmniSpacing.Medium">
        <OmniRow Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
            <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Accent">@(Mail.IsManagedByAetheus ? L["MailManagedByAetheus"] : L["MailAdoptedStack"])</OmniBadge>
            @if (!string.IsNullOrEmpty(Mail.Hostname))
            {
                <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@L["Hostname"] : @Mail.Hostname</OmniText>
            }
            <OmniBadge Fill="OmniFill.Solid" Tone="@(Mail.IsOpenDkimRunning ? OmniTone.Success : OmniTone.Danger)">@($"{L["MailOpenDkim"]} {(Mail.IsOpenDkimRunning ? L["Running"] : L["Stopped"])}")</OmniBadge>
            <OmniBadge Fill="OmniFill.Solid" Tone="@SpamBadgeStyle">@SpamText</OmniBadge>
            @if (CanManage)
            {
                <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@RestartOpenDkimAsync" Disabled="@_busy"><OmniIcon Name="OmniIconName.Refresh" /> <span>@L["MailRestartOpenDkim"]</span></OmniButton>
            }
        </OmniRow>

        @if (CanManage && Mail.HelperVersion < CurrentHelperVersion)
        {
            <OmniAlert Severity="OmniSeverity.Warning">
                @string.Format(L["MailHelperOutdated"], Mail.HelperVersion)
            </OmniAlert>
        }

        <OmniRow Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
            <OmniIcon Name="OmniIconName.Lock" />
            <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["MailTlsCertificate"]</OmniText>
            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@TlsText</OmniText>
            @if (Mail.Tls.IsSelfSigned)
            {
                <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Warning">@L["MailTlsSelfSigned"]</OmniBadge>
            }
            <div class="blade-content-spacer"></div>
            @if (CanManage && HostnameKnown && !UsesLetsEncryptLineage)
            {
                @* User exception (2026-09-28): Obtain and Install are both blue in this zone. *@
                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@RequestCertificateAsync" Disabled="@_busy"><OmniIcon Name="OmniIconName.ShieldCheck" /> <span>@L["MailObtainCertificate"]</span></OmniButton>
                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@InstallCertificateAsync" Disabled="@_busy"><OmniIcon Name="OmniIconName.Monitor" /> <span>@L["MailInstallCertificate"]</span></OmniButton>
            }
        </OmniRow>

        @if (Mail.Diagnostics.Count > 0)
        {
            <OmniStack Gap="OmniSpacing.XSmall">
                <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["MailCollectorFindings"]</OmniText>
                @foreach (var finding in Mail.Diagnostics)
                {
                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@MailUiText.Finding(L, finding)</OmniText>
                }
            </OmniStack>
        }
    </OmniStack>
</OmniCard>
