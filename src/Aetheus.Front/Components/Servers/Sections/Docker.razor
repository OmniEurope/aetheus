@inherits ServerTaskAwareSectionBase
@page "/servers/{Id:int}/docker"
@layout Aetheus.Front.Layout.ServerDetailLayout
@implements IDisposable
@inject Microsoft.Extensions.Localization.IStringLocalizer<Aetheus.Front.Resources.AppStrings> L

<PageTitle>@(Loader?.Server?.Name ?? L["Server"]) - Docker - Aetheus</PageTitle>

@if (Loader is null || Loader.Server is null)
{
    <AetheusLoader />
}
else if (!Loader.HasDocker)
{
    <OmniAlert Severity="OmniSeverity.Info" Fill="OmniFill.Solid">@L["DockerNotInstalled"]</OmniAlert>
}
else
{
    <Aetheus.Front.Components.Servers.ServerDetailSections.ServerDockerSection
        @ref="_section"
        Server="@Loader.Server" ServerId="@Id"
        DockerInitialLoaded="@Loader.InitialLoadCompleted"
        ServerChanged="@OnServerChanged" />
}
