@page "/admin/dashboards"
@page "/dashboards"

<PageTitle>@L["Dashboards"] - Aetheus</PageTitle>

<OmniPageHeader Title="@L["Dashboards"]" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("space_dashboard")" /></Icon>
    <Badges>
        <HelpLink PageKey="dashboards" />
    </Badges>
    <Actions>
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@CreateDashboard"><OmniIcon Name="OmniIconName.Add" /> <span>@L["Create"]</span></OmniButton>
    </Actions>
</OmniPageHeader>

@if (_loading)
{
    <AetheusLoader Size="OmniControlSize.Large" />
}
else if (_dashboards.Count == 0)
{
    @* B-bis: no blue Info banner - use the shared empty state with a create action. *@
    <EmptyState Icon="dashboard" Title="@L["NoRecords"]">
        <ActionContent>
            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@CreateDashboard"><OmniIcon Name="OmniIconName.Add" /> <span>@L["Create"]</span></OmniButton>
        </ActionContent>
    </EmptyState>
}
else
{
    <OmniRow Gap="OmniSpacing.Large">
        @foreach (var dashboard in _dashboards)
        {
            <OmniColumn Span="12" SmallSpan="6">
                <OmniCard Class="omni-u-p-lg">
                    <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Gap="OmniSpacing.Large">
                        <OmniHeading Level="OmniHeadingLevel.H5">@dashboard.Name</OmniHeading>
                        @if (dashboard.IsDefault)
                        {
                            <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Success">@L["IsDefault"]</OmniBadge>
                        }
                    </OmniStack>
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-mt-sm">
                        @dashboard.Widgets.Count @L["Widgets"]
                    </OmniText>
                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-mt-xs">
                        @dashboard.CreatedAt.ToString("g")
                    </OmniText>
                    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Class="omni-u-mt-md">
                        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => EditDashboard(dashboard))"><OmniIcon Name="OmniIconName.Edit" /> <span>@L["Edit"]</span></OmniButton>
                        <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => DeleteDashboard(dashboard.Id))"><OmniIcon Name="OmniIconName.Delete" /> <span>@L["Delete"]</span></OmniButton>
                    </OmniStack>
                </OmniCard>
            </OmniColumn>
        }
    </OmniRow>
}
