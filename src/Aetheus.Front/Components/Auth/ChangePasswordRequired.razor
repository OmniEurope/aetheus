@page "/account/change-password"

<PageTitle>@L["ChangePasswordRequiredTitle"] - Aetheus</PageTitle>

<div class="login-container">
    <OmniCard>
        <OmniStack Gap="OmniSpacing.Large">
            <OmniHeading Level="OmniHeadingLevel.H4" Class="omni-u-mb-0">@L["ChangePasswordRequiredTitle"]</OmniHeading>
            <OmniAlert Severity="OmniSeverity.Info"><Icon><OmniIcon Name="OmniIconName.Info" /></Icon><ChildContent>
                @L["ChangePasswordRequiredMessage"]
            </ChildContent></OmniAlert>

            <OmniTemplateForm TModel="PasswordChangeModel" Model="@_model" OnValidSubmit="@OnSubmit">
                <OmniDataAnnotationsValidator Localizer="@L" />
                <OmniStack Gap="OmniSpacing.Large">
                    <OmniFormField Label="@L["CurrentPassword"]" For="CurrentPassword">
                        <ChildContent>
                            <OmniPassword @bind-Value="_model.CurrentPassword" Id="CurrentPassword" aria-label="@L["CurrentPassword"]" />
                            <ValidationMessage For="@(() => _model.CurrentPassword)" />
                        </ChildContent>
                    </OmniFormField>
                    <OmniFormField Label="@L["NewPassword"]" For="NewPassword">
                        <ChildContent>
                            <OmniPassword @bind-Value="_model.NewPassword" Id="NewPassword" aria-label="@L["NewPassword"]" />
                            <ValidationMessage For="@(() => _model.NewPassword)" />
                        </ChildContent>
                    </OmniFormField>
                    <OmniFormField Label="@L["ConfirmPassword"]" For="ConfirmPassword">
                        <ChildContent>
                            <OmniPassword @bind-Value="_model.ConfirmPassword" Id="ConfirmPassword" aria-label="@L["ConfirmPassword"]" />
                            <ValidationMessage For="@(() => _model.ConfirmPassword)" />
                        </ChildContent>
                    </OmniFormField>

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <OmniAlert Severity="OmniSeverity.Danger"><Icon><OmniIcon Name="OmniIconName.Error" /></Icon><ChildContent>@_error</ChildContent></OmniAlert>
                    }

                    <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit" Class="@("btn-full-width" + (_busy ? " btn-busy" : null))" Busy="@(_busy)" Label="@L["Save"]"><OmniIcon Name="OmniIconName.LockKey" /> <span>@L["Save"]</span></OmniButton>
                    @* FP3K: explicit way out for a user who can't / won't change their password now. *@
                    <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@LogoutAsync" Class="btn-full-width" Label="@L["Logout"]"><OmniIcon Name="OmniIconName.SignOut" /> <span>@L["Logout"]</span></OmniButton>
                </OmniStack>
            </OmniTemplateForm>
        </OmniStack>
    </OmniCard>
</div>
