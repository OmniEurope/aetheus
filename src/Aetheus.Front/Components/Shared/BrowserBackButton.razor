@namespace Aetheus.Front.Components.Shared
@* The labelled back action of a page body (a not-found screen, a help article); the page header's own
   back arrow is OmniPageHeader's. STD-BTN exception chosen by the user (recette R-395, 2026-09-28): the
   back arrow is blue on every page, where the importance rule would make it a discreet neutral navigation. *@
<OmniButton Variant="OmniButtonVariant.Primary" Size="@Size"
            OnClick="@(_ => GoBackAsync())" title="@Title" Label="@Title">
    <OmniIcon Name="OmniIconName.ArrowLeft" /> @Text
</OmniButton>
