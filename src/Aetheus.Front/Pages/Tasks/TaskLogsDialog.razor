@* Task log viewer rendered inside a Radzen modal dialog (opened from TaskListView.ViewLogs). *@
@namespace Aetheus.Front.Pages.Tasks

<div class="task-log-viewer">
    @if (Logs is null || Logs.Count == 0)
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">@L["NoLogsAvailable"]</RadzenText>
    }
    else
    {
        @foreach (var log in Logs)
        {
            <div class="log-entry log-level-@log.Level.ToString().ToLowerInvariant()">
                <span class="log-timestamp">[@log.Timestamp.ToString("HH:mm:ss")]</span>
                <span>[@L.Localize(log.Level)]</span> @log.Message
            </div>
        }
    }
</div>
<DialogFooter CancelText="@L["Close"]" OnCancel="@Close" />
