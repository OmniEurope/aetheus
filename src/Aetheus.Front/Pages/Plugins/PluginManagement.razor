@page "/admin/plugins"
@page "/plugins"

<PageTitle>@L["Plugins"] - Aetheus</PageTitle>

@if (_authorized)
{
    <Aetheus.Front.Shared.PageHeader Title="@L["Plugins"]" Icon="extension">
        <ChildContent>
            <HelpLink PageKey="plugins" />
        </ChildContent>
        <Actions>
            <RadzenButton Text="@L["Register"]" Icon="add" Size="ButtonSize.Small" Click="@OpenRegisterDialog" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        </Actions>
    </Aetheus.Front.Shared.PageHeader>

    <RadzenTextBox Placeholder="@L["Search"]" @bind-Value="_search" Change="@OnSearchChangedAsync"
        class="pipeline-list-search rz-mb-2" />

    <AetheusDataGrid @ref="_grid" Data="@_plugins" TItem="PluginRegistrationDto"
        Count="@_totalCount" IsLoading="@_loading" LoadData="@OnLoadDataAsync"
        PageSize="25" EmptyText="@L["NoRecords"]" class="aetheus-grid-fullheight">
        <Columns>
            <RadzenDataGridColumn TItem="PluginRegistrationDto" Property="Name" Title="@L["PluginName"]" />
            <RadzenDataGridColumn TItem="PluginRegistrationDto" Property="Version" Title="@L["Version"]" Width="100px" />
            <RadzenDataGridColumn TItem="PluginRegistrationDto" Property="Type" Title="@L["PluginType"]" Width="120px" />
            <RadzenDataGridColumn TItem="PluginRegistrationDto" Property="Author" Title="@L["Author"]" Width="150px" />
            <RadzenDataGridColumn TItem="PluginRegistrationDto" Property="Status" Title="@L["Status"]" Width="130px">
                <Template Context="plugin">
                    <RadzenBadge BadgeStyle="@GetStatusBadgeStyle(plugin.Status)" Text="@L.Localize(plugin.Status)" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PluginRegistrationDto" Property="CreatedAt" Title="@L["Created"]" FormatString="{0:g}" Width="160px" />
            <RadzenDataGridColumn TItem="PluginRegistrationDto" Title="@L["Actions"]" Width="160px" Sortable="false">
                <Template Context="plugin">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" Click="@(() => TogglePlugin(plugin))" title="@L["Edit"]" ButtonStyle="ButtonStyle.Info" Variant="Variant.Filled" />
                        <RadzenButton Icon="delete" Size="ButtonSize.Small" Click="@(() => UnregisterPlugin(plugin.Id))" title="@L["Unregister"]" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </AetheusDataGrid>
}
