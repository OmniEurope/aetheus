@using Aetheus.Shared.DTOs

<RadzenTemplateForm TItem="RegisterPluginRequest" Data="@_model" Submit="@SubmitAsync">
    <DataAnnotationsValidator />
    <RadzenStack Gap="1rem">
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeSM="6">
                <RadzenFormField Text="@L["PluginName"]" class="rz-w-100">
                    <RadzenTextBox @bind-Value="_model.Name" Name="Name" />
                    <ValidationMessage For="@(() => _model.Name)" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeSM="6">
                <RadzenFormField Text="@L["Version"]" class="rz-w-100">
                    <RadzenTextBox @bind-Value="_model.Version" Name="Version" />
                    <ValidationMessage For="@(() => _model.Version)" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeSM="6">
                <RadzenFormField Text="@L["Author"]" class="rz-w-100">
                    <RadzenTextBox @bind-Value="_model.Author" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeSM="6">
                <RadzenFormField Text="@L["PluginType"]" class="rz-w-100">
                    <RadzenDropDown @bind-Value="_model.Type" Data="@_pluginTypes"
                        TextProperty="Text" ValueProperty="Value" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
        <DialogFooter OnCancel="@Cancel">
            <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Register"]" Icon="save" IsBusy="@_busy" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        </DialogFooter>
    </RadzenStack>
</RadzenTemplateForm>
