@page "/variable-libraries/new"
@page "/variable-libraries/{Id:int}"

<PageTitle>@(_isNew ? L["NewVariableLibrary"] : _detail?.Name ?? L["VariableLibrary"]) - Aetheus</PageTitle>

<Aetheus.Front.Shared.PageHeader Title="@(_isNew ? L["NewVariableLibrary"] : _detail?.Name ?? "")" Icon="data_object" BackHref="/variable-libraries">
    <ChildContent>
        @if (!_isNew && _detail is not null)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@string.Format(L["EntriesCount"], _detail.EntryCount)" />
        }
    </ChildContent>
    <Actions>
        @if (!_isNew)
        {
            <RadzenButton Text="@L["Delete"]" Icon="delete" Click="@OnDelete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
        }
    </Actions>
</Aetheus.Front.Shared.PageHeader>

@if (_loading)
{
    <RadzenProgressBarCircular ShowValue="true" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
}
else if (_loadFailed || (!_isNew && _detail is null))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenText class="rz-m-0">@L["LoadError"]</RadzenText>
            <RadzenButton Text="@L["Retry"]" Icon="refresh" Click="@RetryLoadAsync"
                Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        </RadzenStack>
    </RadzenAlert>
}
else
{
    <RadzenTemplateForm TItem="LibraryModel" Data="@_model" Submit="@OnSubmit">
        <LocalizedDataAnnotationsValidator />
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Gap="1rem">
                    <RadzenFormField Text="@L["Name"]">
                        <RadzenTextBox @bind-Value="_model.Name" Name="Name" />
                        <ValidationMessage For="@(() => _model.Name)" />
                    </RadzenFormField>
                    <RadzenFormField Text="@L["Description"]">
                        <RadzenTextArea @bind-Value="_model.Description" Name="Description" Rows="3" />
                    </RadzenFormField>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <OwnerTypeSelector Projects="@_projects"
                    @bind-ProjectId="_model.ProjectId"
                    @bind-EnvironmentId="_model.EnvironmentId"
                    @bind-ProjectServerId="_model.ProjectServerId" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-4">
            <RadzenButton ButtonType="ButtonType.Submit" Text="@(_isNew ? L["Create"] : L["Save"])" Icon="@(_isNew ? "add" : "save")"
                ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" IsBusy="@_saving" />
        </RadzenStack>
    </RadzenTemplateForm>

    @if (!_isNew && _detail is not null)
    {
        <RadzenText TextStyle="TextStyle.H5" class="rz-mt-6 rz-mb-2">@L["Entries"]</RadzenText>

        <RadzenTemplateForm TItem="NewEntryModel" Data="@_newEntry" Submit="@AddEntry">
        <LocalizedDataAnnotationsValidator />
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mb-4" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_newEntry.Key" Placeholder="@L["Key"]" />
            <ValidationMessage For="@(() => _newEntry.Key)" />
            <RadzenTextBox @bind-Value="_newEntry.Value" Placeholder="@L["Value"]" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Add"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
            <div class="pipeline-list-spacer"></div>
            <RadzenButton Text="@L["Export"]" Icon="download" Click="@ExportEntries" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
            <RadzenButton Text="@L["Import"]" Icon="upload" Click="@ImportEntries" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
        </RadzenStack>
        </RadzenTemplateForm>

        @if (_entriesLoadFailed)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" class="rz-mb-2">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenText>@L["LoadFailed"]</RadzenText>
                    <RadzenButton Text="@L["Retry"]" Icon="refresh" Click="@RetryEntriesAsync"
                        Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                </RadzenStack>
            </RadzenAlert>
        }

        <RadzenDataGrid @ref="_entriesGrid" Data="@_entries" Count="@_entryCount" TItem="VariableEntryDto" Density="Density.Compact"
            IsLoading="@_entriesLoading" LoadData="@LoadEntriesAsync" AllowPaging="true" PageSize="25"
            AllowAltering="true" EditMode="DataGridEditMode.Single" RowUpdate="@OnEntryUpdate" AllowSorting="true"
            AllowFiltering="true" FilterMode="FilterMode.Advanced">
            <Columns>
                <RadzenDataGridColumn Property="Key" Title="@L["Key"]">
                    <Template Context="entry">
                        <span class="clickable-cell" role="button" tabindex="0" @onclick="@(() => EditEntry(entry))"
                            @onkeydown="@(e => OnEditableCellKeyDown(e, entry))">@entry.Key</span>
                    </Template>
                    <EditTemplate Context="entry">
                        <RadzenTextBox @bind-Value="_editEntryKey" class="rz-w-100"
                            @onkeydown="@(e => OnEntryKeyDown(e, entry))" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="Value" Title="@L["Value"]">
                    <Template Context="entry">
                        <span class="clickable-cell" role="button" tabindex="0" @onclick="@(() => EditEntry(entry))"
                            @onkeydown="@(e => OnEditableCellKeyDown(e, entry))">@entry.Value</span>
                    </Template>
                    <EditTemplate Context="entry">
                        <RadzenTextBox @bind-Value="_editEntryValue" class="rz-w-100"
                            @onkeydown="@(e => OnEntryKeyDown(e, entry))" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="@L["Versions"]" Width="90px" TextAlign="TextAlign.Center" Sortable="false">
                    <Template Context="entry">
                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@entry.VersionCount.ToString()" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="" Width="160px" Sortable="false" TextAlign="TextAlign.Right">
                    <Template Context="entry">
                        <RadzenButton Icon="history" Size="ButtonSize.Small" Click="@(() => ShowVersions(entry))" title="@L["History"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" Click="@(() => EditEntry(entry))" title="@L["Edit"]" ButtonStyle="ButtonStyle.Info" Variant="Variant.Filled" />
                        <RadzenButton Icon="delete" Size="ButtonSize.Small" Click="@(() => DeleteEntry(entry.Id))" title="@L["Delete"]" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                    </Template>
                    <EditTemplate Context="entry">
                        <RadzenButton Icon="check" Size="ButtonSize.Small" Click="@(() => _entriesGrid!.UpdateRow(entry))" title="@L["Save"]" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                        <RadzenButton Icon="close" Size="ButtonSize.Small" Click="@(() => _entriesGrid!.CancelEditRow(entry))" title="@L["Cancel"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                    </EditTemplate>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
}
