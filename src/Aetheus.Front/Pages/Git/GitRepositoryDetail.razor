@page "/git-repositories/{Id:int}"

<PageTitle>@(_repo?.Name ?? L["GitRepository"]) - Aetheus</PageTitle>

@if (_loading)
{
    <RadzenProgressBarCircular ShowValue="true" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
}
else if (_repo is null)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">@L["NotFound"]</RadzenAlert>
}
else
{
    <Aetheus.Front.Shared.PageHeader Title="@_repo.Name" Icon="commit" BackHref="@($"/git-repositories?projectId={_repo.ProjectId}")">
        <ChildContent>
            @if (_repo.IsEmpty)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@L["Empty"]" />
            }
        </ChildContent>
        <Actions>
            <RadzenButton Icon="refresh" Size="ButtonSize.Small" Click="@LoadData" title="@L["Refresh"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        </Actions>
    </Aetheus.Front.Shared.PageHeader>
    @if (!string.IsNullOrEmpty(_repo.Description))
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-mt-1">@_repo.Description</RadzenText>
    }
    @if (!string.IsNullOrEmpty(_repo.CloneUrl))
    {
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem" class="rz-mt-2">
            <RadzenTextBox Value="@_repo.CloneUrl" ReadOnly="true" class="clone-url-input" />
            <RadzenButton Icon="content_copy" Size="ButtonSize.Small" Click="@CopyCloneUrl" title="@L["Copy"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        </RadzenStack>
    }

    <UrlSyncedTabs Slugs="@TabSlugs" @bind-SelectedIndex="_selectedTab" class="rz-mt-4">
        <Tabs>
            <RadzenTabsItem Text="@L["Commits"]" Icon="history">
                @if (_commitsError)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mt-2">
                        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false"
                            class="rz-m-0 rz-flex-grow-1">@L["LoadFailed"]</RadzenAlert>
                        <RadzenButton Icon="refresh" Text="@L["Retry"]" Size="ButtonSize.Small" Click="@LoadCommits" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                    </RadzenStack>
                }
                else
                {
                    @* The grid stays mounted; IsLoading is the in-grid overlay. Previously
                       hiding the grid behind a {_commitsLoading} branch unmounted it, and
                       the AetheusDataGrid wrapper's first-render auto-Reload then fired
                       repeatedly on every re-mount - infinite fetch loop. AutoLoad=false
                       also prevents double-fetching the initial page (we already load it
                       in OnInitializedAsync via LoadCommits). *@
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-2">
                        <RadzenDropDown TValue="string" Data="@_branches.Select(b => b.Name)" @bind-Value="_selectedRef"
                            Change="@(_ => LoadCommits())" Placeholder="@_repo.DefaultBranch" AllowClear="false" />
                        <RadzenTextBox @bind-Value="_commitSearch" Placeholder="@L["SearchCommits"]" class="rz-flex-grow-1" />
                        <RadzenButton Icon="search" Size="ButtonSize.Small" Click="@LoadCommits" title="@L["Search"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@string.Format(L["Total"], _commitsTotalCount)" />
                    </RadzenStack>
                    <AetheusDataGrid TItem="GitLightCommitDto" Data="@_commits"
                        Count="@_commitsTotalCount" IsLoading="@_commitsLoading" LoadData="@OnLoadCommits"
                        AutoLoad="false" EmptyText="@L["NoCommitsFound"]"
                        RowClick="@(c => Nav.NavigateTo($"/git-repositories/{Id}/commits/{c.Sha}"))">
                        <Columns>
                            <RadzenDataGridColumn TItem="GitLightCommitDto" Property="ShortSha" Title="@L["Commit"]" Width="100px">
                                <Template Context="c">
                                    <a href="@($"/git-repositories/{Id}/commits/{c.Sha}")" class="rz-link" @onclick:stopPropagation="true"><code>@c.ShortSha</code></a>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="GitLightCommitDto" Property="Message" Title="@L["Message"]" Width="auto" />
                            <RadzenDataGridColumn TItem="GitLightCommitDto" Property="AuthorName" Title="@L["Author"]" Width="150px" />
                            <RadzenDataGridColumn TItem="GitLightCommitDto" Property="AuthorDate" Title="@L["Date"]" FormatString="{0:g}" Width="160px" />
                        </Columns>
                    </AetheusDataGrid>
                }
            </RadzenTabsItem>

            <RadzenTabsItem Text="@L["Branches"]" Icon="account_tree">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-2">
                    <RadzenButton Icon="add" Text="@L["NewBranch"]" Click="@ShowCreateBranchDialog" Disabled="@(!_canWrite)"
                        title="@(!_canWrite ? L["InsufficientPermissions"] : "")" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                </RadzenStack>
                @if (_branchPage.Error)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
                        @L["LoadFailed"] <RadzenButton Text="@L["Retry"]" Icon="refresh" Click="@LoadBranches" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                    </RadzenAlert>
                }
                <AetheusDataGrid TItem="GitLightBranchDto" Data="@_branches"
                    Count="@_branchPage.TotalCount" IsLoading="@_branchPage.Loading"
                    LoadData="@OnLoadBranches" AutoLoad="false" EmptyText="@L["NoBranchesFound"]">
                    <Columns>
                        <RadzenDataGridColumn TItem="GitLightBranchDto" Property="Name" Title="@L["Name"]" Width="auto">
                            <Template Context="b">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenText class="rz-m-0">@b.Name</RadzenText>
                                    @if (b.IsDefault)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@L["Default"]" />
                                    }
                                    @if (IsBranchProtected(b.Name))
                                    {
                                        <RadzenIcon Icon="lock" class="rz-color-warning" />
                                    }
                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="GitLightBranchDto" Property="LastCommitSha" Title="@L["LastCommit"]" Width="100px">
                            <Template Context="b">
                                <code>@b.LastCommitSha?[..Math.Min(7, b.LastCommitSha?.Length ?? 0)]</code>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="GitLightBranchDto" Property="LastCommitDate" Title="@L["Date"]" FormatString="{0:g}" Width="160px" />
                        <RadzenDataGridColumn TItem="GitLightBranchDto" Title="" Width="110px" Sortable="false" TextAlign="TextAlign.Right">
                            <Template Context="b">
                                @if (!b.IsDefault)
                                {
                                    <GitDefaultBranchButton RepositoryId="@Id" Branch="@b" CanWrite="@_canWrite" Changed="@LoadData" />
                                    <RadzenButton Text="@L["Delete"]" Icon="delete" Click="@(() => DeleteBranch(b))" Disabled="@(!_canWrite)" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </AetheusDataGrid>
            </RadzenTabsItem>

            <RadzenTabsItem Text="@L["Tags"]" Icon="label">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-2">
                    <RadzenButton Icon="add" Text="@L["NewTag"]" Click="@ShowCreateTagDialog" Disabled="@(!_canWrite)"
                        title="@(!_canWrite ? L["InsufficientPermissions"] : "")" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                </RadzenStack>
                @if (_tagPage.Error)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
                        @L["LoadFailed"] <RadzenButton Text="@L["Retry"]" Icon="refresh" Click="@LoadTags" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                    </RadzenAlert>
                }
                <AetheusDataGrid TItem="GitLightTagDto" Data="@_tags"
                    Count="@_tagPage.TotalCount" IsLoading="@_tagPage.Loading"
                    LoadData="@OnLoadTags" AutoLoad="false" EmptyText="@L["NoTagsFound"]">
                    <Columns>
                        <RadzenDataGridColumn TItem="GitLightTagDto" Property="Name" Title="@L["Name"]" Width="auto" />
                        <RadzenDataGridColumn TItem="GitLightTagDto" Property="Sha" Title="@L["Commit"]" Width="100px">
                            <Template Context="t">
                                <code>@t.Sha[..Math.Min(7, t.Sha.Length)]</code>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="GitLightTagDto" Property="Message" Title="@L["Message"]" Width="auto" />
                        <RadzenDataGridColumn TItem="GitLightTagDto" Property="TaggerDate" Title="@L["Date"]" FormatString="{0:g}" Width="160px" />
                        <RadzenDataGridColumn TItem="GitLightTagDto" Title="" Width="80px" Sortable="false" TextAlign="TextAlign.Right">
                            <Template Context="t">
                                <RadzenButton Text="@L["Delete"]" Icon="delete" Click="@(() => DeleteTag(t))" Disabled="@(!_canWrite)" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </AetheusDataGrid>
            </RadzenTabsItem>

            <RadzenTabsItem Text="@L["Files"]" Icon="folder_open">
                @if (_treeError)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
                        @L["LoadFailed"] <RadzenButton Text="@L["Retry"]" Icon="refresh" Click="@LoadTree" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                    </RadzenAlert>
                }
                else
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-2">
                        <RadzenDropDown TValue="string" Data="@_branches.Select(b => b.Name)" @bind-Value="_treeRef"
                            Change="@(_ => LoadTree())" Placeholder="@_repo.DefaultBranch" AllowClear="false" />
                        @if (!string.IsNullOrEmpty(_treePath))
                        {
                            <RadzenBreadCrumb>
                                <RadzenBreadCrumbItem Text="/" />
                                @foreach (var segment in _treePath.Split('/'))
                                {
                                    <RadzenBreadCrumbItem Text="@segment" />
                                }
                            </RadzenBreadCrumb>
                            <RadzenButton Icon="arrow_back" Size="ButtonSize.Small" Click="@NavigateUp" title="@L["Back"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                        }
                    </RadzenStack>

                    @if (_blobContent is not null)
                    {
                        <RadzenCard class="rz-p-4">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-2">
                                <RadzenIcon Icon="description" />
                                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0">@_blobContent.Path</RadzenText>
                                <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@FormatSize(_blobContent.Size)" />
                                <div class="pipeline-list-spacer"></div>
                                @if (!_blobContent.IsBinary)
                                {
                                    <RadzenButton Icon="person_search" Text="@(_blameLines is not null ? L["Code"] : L["Blame"])"
                                        Size="ButtonSize.Small" Click="@ToggleBlame" title="@L["Blame"]" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
                                }
                                <RadzenButton Icon="arrow_back" Size="ButtonSize.Small" Click="@CloseBlobAsync" title="@L["Back"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                            </RadzenStack>
                            @if (_blameLines is not null)
                            {
                                <pre class="blame-view">@_blameFormatted</pre>
                            }
                            else if (_blobContent.IsBinary)
                            {
                                <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">@L["BinaryFile"]</RadzenAlert>
                            }
                            else
                            {
                                <div id="@_monacoElementId" class="monaco-viewer-container"></div>
                            }
                        </RadzenCard>
                    }
                    else
                    {
                        <AetheusDataGrid TItem="GitLightTreeEntryDto" Data="@_treeEntries"
                            Count="@_treeTotalCount" IsLoading="@_treeLoading"
                            LoadData="@OnLoadTree" AutoLoad="false" EmptyText="@L["NoFilesFound"]">
                            <Columns>
                                <RadzenDataGridColumn TItem="GitLightTreeEntryDto" Property="Name" Title="@L["Name"]" Width="auto">
                                    <Template Context="e">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                            <RadzenIcon Icon="@(e.Type == GitTreeEntryType.Tree ? "folder" : "description")"
                                                class="@(e.Type == GitTreeEntryType.Tree ? "rz-color-warning" : "rz-color-secondary")" />
                                            <a href="javascript:void(0)" class="rz-link" @onclick="@(() => NavigateToEntry(e))" @onclick:preventDefault>@e.Name</a>
                                        </RadzenStack>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="GitLightTreeEntryDto" Property="Size" Title="@L["Size"]" Width="100px">
                                    <Template Context="e">
                                        @if (e.Size.HasValue)
                                        {
                                            @FormatSize(e.Size.Value)
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </AetheusDataGrid>
                    }
                }
            </RadzenTabsItem>

            <RadzenTabsItem Text="@L["PullRequests"]" Icon="merge_type">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-2">
                    <RadzenButton Icon="add" Text="@L["NewPullRequest"]" Click="@ShowCreatePrDialog" Disabled="@(!_canWrite)"
                        title="@(!_canWrite ? L["InsufficientPermissions"] : "")" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                </RadzenStack>
                @if (_prsError)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
                        @L["LoadFailed"] <RadzenButton Text="@L["Retry"]" Icon="refresh" Click="@LoadPrs" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                    </RadzenAlert>
                }
                <AetheusDataGrid TItem="InternalPullRequestDto" Data="@_pullRequests"
                    Count="@_prTotalCount" IsLoading="@_prsLoading" LoadData="@OnLoadPrs"
                    EmptyText="@L["NoPullRequestsFound"]">
                    <Columns>
                        <RadzenDataGridColumn TItem="InternalPullRequestDto" Property="Number" Title="#" Width="60px" />
                        <RadzenDataGridColumn TItem="InternalPullRequestDto" Property="Title" Title="@L["Title"]" Width="auto" />
                        <RadzenDataGridColumn TItem="InternalPullRequestDto" Property="SourceBranch" Title="@L["Source"]" Width="140px">
                            <Template Context="pr">
                                <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@pr.SourceBranch" />
                                <RadzenIcon Icon="arrow_forward" class="rz-color-secondary" />
                                <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@pr.TargetBranch" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="InternalPullRequestDto" Property="AuthorLogin" Title="@L["Author"]" Width="120px" />
                        <RadzenDataGridColumn TItem="InternalPullRequestDto" Property="Status" Title="@L["Status"]" Width="100px">
                            <Template Context="pr">
                                <RadzenBadge BadgeStyle="@GetPrStatusBadge(pr.Status)" Text="@L.Localize(pr.Status)" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="InternalPullRequestDto" Property="CreatedAt" Title="@L["Created"]" FormatString="{0:g}" Width="160px" />
                        <RadzenDataGridColumn TItem="InternalPullRequestDto" Title="" Width="150px" Sortable="false" TextAlign="TextAlign.Right">
                            <Template Context="pr">
                                @if (pr.Status == PullRequestStatus.Open)
                                {
                                    <RadzenButton Text="@L["Merge"]" Icon="merge_type" Click="@(() => MergePr(pr))" Disabled="@(!_canWrite)" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
                                    <RadzenButton Text="@L["Close"]" Icon="close" Click="@(() => ClosePr(pr))" Disabled="@(!_canWrite)" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </AetheusDataGrid>
            </RadzenTabsItem>

            <RadzenTabsItem Text="@L["Graph"]" Icon="timeline">
                @if (_graphError)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
                        @L["LoadFailed"] <RadzenButton Text="@L["Retry"]" Icon="refresh" Click="@LoadGraph" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                    </RadzenAlert>
                }
                else if (_graphLoading)
                {
                    <RadzenProgressBarCircular ShowValue="true" Mode="ProgressBarMode.Indeterminate" />
                }
                else
                {
                    @* O: SVG lane graph (reload lives on the page header - LoadData reloads the graph too). *@
                    <div class="commit-graph-svg-wrap">
                        <Aetheus.Front.Shared.GitCommitGraph Commits="@_graphCommits" />
                    </div>
                }
            </RadzenTabsItem>

            @if (!string.IsNullOrEmpty(_readmeHtml))
            {
                <RadzenTabsItem Text="@L["Readme"]" Icon="description">
                    <div class="readme-rendered">@((MarkupString)_readmeHtml)</div>
                </RadzenTabsItem>
            }

            <RadzenTabsItem Text="@L["BranchProtection"]" Icon="security">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-2">
                    <RadzenButton Icon="add" Text="@L["AddRule"]" Click="@ShowAddProtectionRuleDialog" Disabled="@(!_canWrite)"
                        title="@(!_canWrite ? L["InsufficientPermissions"] : "")" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                </RadzenStack>
                @if (_protectionPage.Error)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
                        @L["LoadFailed"] <RadzenButton Text="@L["Retry"]" Icon="refresh" Click="@LoadProtectionRules" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                    </RadzenAlert>
                }
                <AetheusDataGrid TItem="BranchProtectionRuleDto" Data="@_protectionRules"
                    Count="@_protectionPage.TotalCount" IsLoading="@_protectionPage.Loading"
                    LoadData="@OnLoadProtectionRules" AutoLoad="false" EmptyText="@L["NoRulesFound"]">
                    <Columns>
                        <RadzenDataGridColumn TItem="BranchProtectionRuleDto" Property="Pattern" Title="@L["Pattern"]" Width="auto" />
                        <RadzenDataGridColumn TItem="BranchProtectionRuleDto" Property="PreventDeletion" Title="@L["PreventDeletion"]" Width="140px">
                            <Template Context="r">
                                <RadzenSwitch Value="@r.PreventDeletion" Change="@((bool v) => UpdateProtectionRule(r, preventDeletion: v))" Disabled="@(!_canWrite)"
                                    aria-label="@($"{L["PreventDeletion"]}: {r.Pattern}")" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="BranchProtectionRuleDto" Property="PreventForcePush" Title="@L["PreventForcePush"]" Width="150px">
                            <Template Context="r">
                                <RadzenSwitch Value="@r.PreventForcePush" Change="@((bool v) => UpdateProtectionRule(r, preventForcePush: v))" Disabled="@(!_canWrite)"
                                    aria-label="@($"{L["PreventForcePush"]}: {r.Pattern}")" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="BranchProtectionRuleDto" Property="RequirePullRequest" Title="@L["RequirePR"]" Width="130px">
                            <Template Context="r">
                                <RadzenSwitch Value="@r.RequirePullRequest" Change="@((bool v) => UpdateProtectionRule(r, requirePr: v))" Disabled="@(!_canWrite)"
                                    aria-label="@($"{L["RequirePR"]}: {r.Pattern}")" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="BranchProtectionRuleDto" Title="" Width="80px" Sortable="false" TextAlign="TextAlign.Right">
                            <Template Context="r">
                                <RadzenButton Text="@L["Delete"]" Icon="delete" Click="@(() => DeleteProtectionRule(r))" Disabled="@(!_canWrite)" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </AetheusDataGrid>
            </RadzenTabsItem>
        </Tabs>
    </UrlSyncedTabs>
}
