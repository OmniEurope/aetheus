@page "/git/branches/{BranchId:int}"
@page "/git-repositories/branches/{BranchId:int}"

<PageTitle>@L["Branch"] - Aetheus</PageTitle>

@if (_loading)
{
    <AetheusLoader Size="AetheusLoaderSize.Large" />
}
else
{
    <Aetheus.Front.Shared.PageHeader Title="@L["Branch"]" Icon="account_tree"
        BackHref="@($"/git-repositories?projectId={_projectId}")" />
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">@L["NotFound"]</RadzenAlert>
}
