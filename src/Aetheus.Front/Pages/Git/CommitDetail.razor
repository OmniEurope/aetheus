@page "/git/commits/{CommitId:int}"
@page "/git-repositories/commits/{CommitId:int}"

<PageTitle>@L["Commit"] - Aetheus</PageTitle>

@if (_loading)
{
    <AetheusLoader Size="AetheusLoaderSize.Large" />
}
else
{
    <Aetheus.Front.Shared.PageHeader Title="@L["Commit"]" Icon="commit"
        BackHref="@($"/git-repositories?projectId={_projectId}")" />
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">@L["NotFound"]</RadzenAlert>
}
