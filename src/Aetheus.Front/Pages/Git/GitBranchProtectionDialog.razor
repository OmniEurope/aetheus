@using Aetheus.Shared.DTOs

<RadzenStack Gap="1rem">
    <RadzenFormField Text="@L["Pattern"]" Variant="Variant.Filled">
        <RadzenTextBox @bind-Value="_pattern" Placeholder="main, release/*" />
    </RadzenFormField>
    <LabeledToggle @bind-Value="_preventDeletion" Text="@L["PreventDeletion"]" />
    <LabeledToggle @bind-Value="_preventForcePush" Text="@L["PreventForcePush"]" />
    <LabeledToggle @bind-Value="_requirePr" Text="@L["RequirePR"]" />
    <DialogFooter OnCancel="@(() => Dialog.Close(false))">
        <RadzenButton Text="@L["Save"]" Icon="save" Click="@Save" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
    </DialogFooter>
</RadzenStack>
