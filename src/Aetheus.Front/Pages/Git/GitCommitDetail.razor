@page "/git-repositories/{RepoId:int}/commits/{Sha}"

<PageTitle>@(_detail?.Commit.ShortSha ?? L["Commit"]) - Aetheus</PageTitle>

@if (_loading)
{
    <AetheusLoader Size="AetheusLoaderSize.Large" />
}
else if (_detail is null)
{
    <Aetheus.Front.Shared.PageHeader Title="@L["Commit"]" Icon="commit" BackHref="@($"/git-repositories/{RepoId}")" />
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">@L["NotFound"]</RadzenAlert>
}
else
{
    <Aetheus.Front.Shared.PageHeader Title="@_detail.Commit.ShortSha" Icon="commit" BackHref="@($"/git-repositories/{RepoId}")">
        <ChildContent>
            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@_detail.Commit.AuthorName" />
        </ChildContent>
    </Aetheus.Front.Shared.PageHeader>

    <RadzenCard class="git-commit-summary rz-mt-3">
        <div class="git-commit-summary-content">
            <div class="git-commit-overview">
                <RadzenText TextStyle="TextStyle.Subtitle1" class="git-commit-message">@_detail.Commit.Message</RadzenText>
                <div class="git-commit-metadata">
                    <div class="essential-item">
                        <RadzenIcon Icon="tag" class="essential-icon" />
                        <div class="essential-text">
                            <span class="essential-label">@L["Commit"]</span>
                            <span class="essential-value overview-break-anywhere"><code>@_detail.Commit.Sha</code></span>
                        </div>
                    </div>
                    <div class="essential-item">
                        <RadzenIcon Icon="person" class="essential-icon" />
                        <div class="essential-text">
                            <span class="essential-label">@L["Author"]</span>
                            <span class="essential-value overview-break-anywhere">@_detail.Commit.AuthorName &lt;@_detail.Commit.AuthorEmail&gt;</span>
                        </div>
                    </div>
                    <div class="essential-item">
                        <RadzenIcon Icon="event" class="essential-icon" />
                        <div class="essential-text">
                            <span class="essential-label">@L["Date"]</span>
                            <span class="essential-value" title="@_detail.Commit.AuthorDate.ToString("F")">@_detail.Commit.AuthorDate.ToString("g")</span>
                        </div>
                    </div>
                    @if (_detail.Commit.ParentShas.Count > 0)
                    {
                        <div class="essential-item">
                            <RadzenIcon Icon="account_tree" class="essential-icon" />
                            <div class="essential-text">
                                <span class="essential-label">@L["Parents"]</span>
                                <span class="essential-value">
                                    @foreach (var parent in _detail.Commit.ParentShas)
                                    {
                                        <a href="@($"/git-repositories/{RepoId}/commits/{parent}")" class="rz-link rz-mr-2"><code>@Short(parent)</code></a>
                                    }
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="git-commit-stats" aria-label="@L["FilesChanged"]">
                <div class="git-commit-stat">
                    <strong>@_detail.Diff.Stats.FilesChanged</strong>
                    <span>@L["FilesChanged"]</span>
                </div>
                <div class="git-commit-stat">
                    <strong class="diff-file-stat-add">+@_detail.Diff.Stats.Additions</strong>
                    <span>@L["Additions"]</span>
                </div>
                <div class="git-commit-stat">
                    <strong class="diff-file-stat-del">-@_detail.Diff.Stats.Deletions</strong>
                    <span>@L["Deletions"]</span>
                </div>
            </div>
        </div>
    </RadzenCard>

    @if (_detail.Commit.ParentShas.Count > 1)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" class="rz-mt-3 rz-mb-2">
            @L["GitMergeDiffFirstParent"]
        </RadzenAlert>
    }

    @if (_detail.Diff.IsTruncated)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" class="rz-mt-3 rz-mb-2">
            @L["GitPatchTruncated"]
        </RadzenAlert>
    }

    @if (_detail.Diff.FileDiffs.Count == 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">@L["NoFileChanges"]</RadzenAlert>
    }
    else
    {
        <div class="git-diff-workspace rz-mt-3">
            <aside class="git-file-browser" aria-label="@L["FilesChanged"]">
                <div class="git-file-browser-header">
                    <div class="git-file-browser-title">
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">@L["FilesChanged"]</RadzenText>
                        <span>@_visibleFiles.Count / @_detail.Diff.FileDiffs.Count</span>
                    </div>
                    <RadzenTextBox @bind-Value="_fileSearch" Change="@OnFileSearchChanged" Immediate="true"
                                   Placeholder="@L["Search"]" aria-label="@L["Search"]"
                                   class="git-file-search" />
                    <div class="git-file-status-filters" aria-label="@L["FilterByStatus"]">
                        <RadzenButton Text="@($"{L["AllFiles"]} · {_detail.Diff.FileDiffs.Count}")" Icon="description"
                                      Size="ButtonSize.Small"
                                      Variant="@(_statusFilter is null ? Variant.Filled : Variant.Text)"
                                      ButtonStyle="@(_statusFilter is null ? ButtonStyle.Light : ButtonStyle.Light)"
                                      Click="@(() => SetStatusFilter(null))" class="@StatusFilterClass(null)"
                                      aria-label="@L["AllFiles"]" aria-pressed="@(_statusFilter is null ? "true" : "false")" />
                        @foreach (var status in _availableStatuses)
                        {
                            <RadzenButton Text="@($"{LocalizeStatus(status)} · {StatusCount(status)}")" Icon="@StatusIcon(status)"
                                          Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light"
                                          Click="@(() => SetStatusFilter(status))" class="@StatusFilterClass(status)"
                                          aria-label="@LocalizeStatus(status)" aria-pressed="@(StatusFilterIsActive(status) ? "true" : "false")" />
                        }
                    </div>
                </div>
                <RadzenListBox TValue="string" Data="@_visibleFiles" TextProperty="Path" ValueProperty="Path"
                               Value="@_selectedFile?.Path" Change="@OnFileSelected"
                               class="git-file-listbox" aria-label="@L["FilesChanged"]">
                    <Template Context="item">
                        @{ var file = (FileDiffDto)item; }
                        <div class="git-file-option">
                            <RadzenIcon Icon="@StatusIcon(file.Status)" class="@StatusIconClass(file.Status)" />
                            <code class="git-file-option-path" title="@file.Path">@file.Path</code>
                            <span class="git-file-option-delta">
                                <span class="diff-file-stat-add">+@file.Additions</span>
                                <span class="diff-file-stat-del">-@file.Deletions</span>
                            </span>
                        </div>
                    </Template>
                    <EmptyTemplate>
                        <div class="git-file-browser-empty">@L["NoFilesFound"]</div>
                    </EmptyTemplate>
                </RadzenListBox>
            </aside>

            <section class="git-focused-diff" aria-live="polite">
                @if (_selectedFile is null)
                {
                    <EmptyState Icon="search_off" Title="@L["NoFilesFound"]" />
                }
                else
                {
                    <div class="git-focused-diff-header">
                        <div class="git-focused-diff-title">
                            <code title="@_selectedFile.Path">@_selectedFile.Path</code>
                            <div>
                                <RadzenBadge BadgeStyle="@StatusBadge(_selectedFile.Status)" Text="@LocalizeStatus(_selectedFile.Status)" />
                                <span class="diff-file-stat-add">+@_selectedFile.Additions</span>
                                <span class="diff-file-stat-del">-@_selectedFile.Deletions</span>
                            </div>
                        </div>
                        <RadzenButton Text="@(_diffCollapsed ? L["ShowDiff"] : L["HideDiff"])"
                                      Icon="@(_diffCollapsed ? "expand_more" : "expand_less")"
                                      Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light"
                                      Click="@ToggleDiff" class="git-diff-toggle"
                                      aria-label="@(_diffCollapsed ? L["ShowDiff"] : L["HideDiff"])"
                                      aria-expanded="@(!_diffCollapsed ? "true" : "false")" />
                    </div>
                    @if (!_diffCollapsed)
                    {
                        @if (_selectedDiffLines.Count > 0)
                        {
                            <div class="diff-view git-focused-diff-body" tabindex="0">
                                @foreach (var line in _selectedDiffLines)
                                {
                                    <span class="@LineClass(line.Text)">
                                        <span class="diff-line-number">@line.OldLineNumber</span>
                                        <span class="diff-line-number">@line.NewLineNumber</span>
                                        <span class="diff-line-content">@line.Text</span>
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" class="rz-m-3">@L["BinaryFile"]</RadzenAlert>
                        }
                    }
                }
            </section>
        </div>
    }
}
