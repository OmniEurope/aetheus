@page "/vaults/new"
@page "/vaults/{Id:int}"

<PageTitle>@(_isNew ? L["NewVault"] : _detail?.Name ?? L["Vault"]) - Aetheus</PageTitle>

<Aetheus.Front.Shared.PageHeader Title="@(_isNew ? L["NewVault"] : _detail?.Name ?? "")" Icon="lock" BackHref="/vaults">
    <ChildContent>
        @if (!_isNew && _detail is not null)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@string.Format(L["SecretsCount"], _detail.SecretCount)" />
        }
    </ChildContent>
    <Actions>
        @if (!_isNew)
        {
            <RadzenButton Text="@L["Delete"]" Icon="delete" Click="@OnDelete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
        }
    </Actions>
</Aetheus.Front.Shared.PageHeader>

@if (!_isNew && _detail is null)
{
    <AetheusLoader Size="AetheusLoaderSize.Large" />
}
else
{
    <RadzenTemplateForm TItem="VaultModel" Data="@_model" Submit="@OnSubmit">
        <LocalizedDataAnnotationsValidator />
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Gap="1rem">
                    <RadzenFormField Text="@L["Name"]">
                        <RadzenTextBox @bind-Value="_model.Name"
                                       @oninput="@(e => _model.Name = e.Value?.ToString() ?? string.Empty)"
                                       Name="Name" />
                        <ValidationMessage For="@(() => _model.Name)" />
                    </RadzenFormField>
                    <RadzenFormField Text="@L["Description"]">
                        <RadzenTextArea @bind-Value="_model.Description" Name="Description" Rows="3" />
                    </RadzenFormField>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <OwnerTypeSelector Projects="@_projects"
                    @bind-ProjectId="_model.ProjectId"
                    @bind-EnvironmentId="_model.EnvironmentId"
                    @bind-ProjectServerId="_model.ProjectServerId" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-4">
            <RadzenButton ButtonType="ButtonType.Submit" Text="@(_isNew ? L["Create"] : L["Save"])" Icon="@(_isNew ? "add" : "save")"
                ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" IsBusy="@_saving" />
        </RadzenStack>
    </RadzenTemplateForm>

    @if (!_isNew && _detail is not null)
    {
        <RadzenText TextStyle="TextStyle.H5" class="rz-mt-6 rz-mb-2">@L["Secrets"]</RadzenText>

        <RadzenTemplateForm TItem="NewSecretModel" Data="@_newSecret" Submit="@AddSecret">
        <LocalizedDataAnnotationsValidator />
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mb-4" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_newSecret.Key"
                           @oninput="@(e => _newSecret.Key = e.Value?.ToString() ?? string.Empty)"
                           Placeholder="@L["Key"]" AutoComplete="false" />
            <ValidationMessage For="@(() => _newSecret.Key)" />
            <RadzenPassword @bind-Value="_newSecret.Value" Name="Value"
                            @oninput="@(e => _newSecret.Value = e.Value?.ToString() ?? string.Empty)"
                            Placeholder="@L["Value"]" AutoComplete="false" />
            <RadzenButton Icon="auto_fix_high" Size="ButtonSize.Small" ButtonType="ButtonType.Button"
                          Click="@GenerateNewSecretValue" title="@GenerateHint(_newSecret.Key)"
                          aria-label="@GenerateHint(_newSecret.Key)"
                          ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
            <ValidationMessage For="@(() => _newSecret.Value)" />
            <RadzenDatePicker @bind-Value="_newSecret.ExpiresAt" Placeholder="@L["ExpiresAt"]" DateFormat="yyyy-MM-dd" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Add"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
            <div class="pipeline-list-spacer"></div>
            <RadzenButton Text="@L["ExportKeys"]" Icon="download" Click="@ExportKeys" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
            <RadzenButton Text="@L["Import"]" Icon="upload" Click="@ImportSecrets" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
        </RadzenStack>
        </RadzenTemplateForm>

        <RadzenDataGrid Responsive="false" Data="@_detail.Secrets" TItem="VaultSecretDto" Density="Density.Compact" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced" AllowColumnResize="true" AllowVirtualization="@AetheusGrid.Virtualization" VirtualizationOverscanCount="3" AllowPaging="@(!AetheusGrid.Virtualization)">
            <Columns>
                <RadzenDataGridColumn Property="Key" Title="@L["Key"]">
                    <Template Context="secret">
                        <span class="clickable-cell" role="button" tabindex="0"
                              @onclick="@(() => UpdateSecret(secret))"
                              @onkeydown="@(e => OnSecretCellKeyDown(e, secret))">@secret.Key</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="@L["Value"]" Width="200px">
                    <Template Context="secret">
                        <span class="clickable-cell" role="button" tabindex="0"
                              @onclick="@(() => UpdateSecret(secret))"
                              @onkeydown="@(e => OnSecretCellKeyDown(e, secret))">••••••••</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="UpdatedAt" Title="@L["Updated"]" FormatString="{0:g}" Width="160px" />
                <RadzenDataGridColumn Title="@L["ExpiresAt"]" Width="160px">
                    <Template Context="secret">
                        @if (secret.ExpiresAt.HasValue)
                        {
                            var badge = GetExpiryBadge(secret.ExpiresAt.Value);
                            <RadzenBadge BadgeStyle="@badge" Text="@secret.ExpiresAt.Value.ToString("yyyy-MM-dd")" />
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="@L["Versions"]" Width="90px" TextAlign="TextAlign.Center" Sortable="false">
                    <Template Context="secret">
                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@secret.VersionCount.ToString()" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="" Width="240px" Sortable="false" TextAlign="TextAlign.Right">
                    <Template Context="secret">
                        <RadzenButton Icon="content_copy" Size="ButtonSize.Small" Click="@(() => CopyKeyReference(secret.Key))" title="@L["CopyKeyReference"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                        <RadzenButton Icon="history" Size="ButtonSize.Small" Click="@(() => ShowVersions(secret))" title="@L["History"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" Click="@(() => UpdateSecret(secret))" title="@L["Edit"]" ButtonStyle="ButtonStyle.Info" Variant="Variant.Filled" />
                        <RadzenButton Icon="autorenew" Size="ButtonSize.Small" Click="@(() => RotateSecret(secret))" title="@L["Rotate"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
                        <RadzenButton Icon="delete" Size="ButtonSize.Small" Click="@(() => DeleteSecret(secret.Id))"
                            title="@L["Delete"]" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
}
