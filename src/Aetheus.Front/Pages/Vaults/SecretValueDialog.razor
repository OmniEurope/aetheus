<RadzenStack Gap="1rem">
    <RadzenFormField Text="@L["NewValue"]">
        <RadzenPassword @bind-Value="_value" @oninput="@(e => _value = e.Value?.ToString() ?? "")"
            @onkeydown="@OnKeyDown" id="secret-value-input" />
    </RadzenFormField>
    <DialogFooter OnCancel="@(() => Dialog.Close())">
        <RadzenButton Text="@L["Save"]" Icon="save" Click="@Save" Disabled="@string.IsNullOrWhiteSpace(_value)" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
    </DialogFooter>
</RadzenStack>
