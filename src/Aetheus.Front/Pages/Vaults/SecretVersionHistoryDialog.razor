<RadzenDataGrid Data="@Versions" TItem="VaultSecretVersionDto" Density="Density.Compact" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced">
    <Columns>
        <RadzenDataGridColumn Property="Version" Title="#" Width="60px" />
        <RadzenDataGridColumn Property="Key" Title="@L["Key"]" />
        <RadzenDataGridColumn Property="ChangeType" Title="@L["Type"]" Width="100px">
            <Template Context="v">
                <RadzenBadge BadgeStyle="@GetBadge(v.ChangeType)" Text="@L.Localize(v.ChangeType)" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="ChangedAt" Title="@L["Date"]" FormatString="{0:g}" Width="160px" />
    </Columns>
</RadzenDataGrid>
<DialogFooter CancelText="@L["Close"]" OnCancel="@Close" />
