@using Aetheus.Shared.DTOs

<RadzenStack Gap="1rem" class="contact-agent-dialog">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenIcon Icon="cell_tower" />
        <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0">
            @string.Format(L["ContactAgentTarget"], ServerName)
        </RadzenText>
    </RadzenStack>

    @if (_state == ContactState.Running)
    {
        <RadzenStack Gap="0.5rem">
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">
                @string.Format(L["ContactAgentAttempt"], _attempt, MaxAttempts)
            </RadzenText>
            <RadzenProgressBar ShowValue="false"
                Mode="ProgressBarMode.Indeterminate" class="contact-agent-progress" />
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-m-0">
                @L["ContactAgentWaiting"]
            </RadzenText>
        </RadzenStack>
    }
    else if (_state == ContactState.Success)
    {
        <RadzenAlert AlertStyle="AlertStyle.Success" Shade="Shade.Lighter" AllowClose="false" class="rz-m-0">
            <RadzenStack Gap="0.25rem">
                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">@L["ContactAgentReachable"]</RadzenText>
                @if (_result?.SecondsSinceLastHeartbeat is { } secs)
                {
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">
                        @string.Format(L["ContactAgentLastSeen"], FormatSeconds(secs))
                    </RadzenText>
                }
                @if (!string.IsNullOrWhiteSpace(_result?.AgentVersion))
                {
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">
                        @string.Format(L["ContactAgentVersion"], _result!.AgentVersion)
                    </RadzenText>
                }
            </RadzenStack>
        </RadzenAlert>
    }
    else if (_state == ContactState.Failed)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="false" class="rz-m-0">
            <RadzenStack Gap="0.25rem">
                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">
                    @string.Format(L["ContactAgentFailed"], MaxAttempts)
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@_errorMessage</RadzenText>
            </RadzenStack>
        </RadzenAlert>

        @if (_diagnostic is not null)
        {
            <RadzenCard class="rz-m-0 rz-p-3 contact-agent-diagnostic">
                <RadzenStack Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">@L["WhyOffline"]</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@_diagnostic.Summary</RadzenText>
                    <div class="contact-agent-diagnostic-meta">
                        @if (_diagnostic.TokenExpiresAt.HasValue)
                        {
                            <span class="diagnostic-token-row">
                                <strong>@L["Token"]:</strong>
                                @(_diagnostic.TokenValid ? L["Valid"] : L["Invalid"])
                                @if (_diagnostic.TokenDaysRemaining.HasValue)
                                {
                                    <text> (@string.Format(L["TokenDaysRemaining"], _diagnostic.TokenDaysRemaining.Value))</text>
                                    <span class="diagnostic-token-bar @TokenBarClass(_diagnostic.TokenDaysRemaining.Value)"
                                          title="@string.Format(L["TokenDaysRemaining"], _diagnostic.TokenDaysRemaining.Value)">
                                        @* F-33: inline style sets a CSS custom property from runtime data
                                           (token-bar fill width); documented exception to no-inline-style. *@
                                        <span class="diagnostic-token-bar-fill"
                                              style="--fill-width: @TokenBarPercent(_diagnostic.TokenDaysRemaining.Value)%"></span>
                                    </span>
                                }
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(_diagnostic.AgentVersion))
                        {
                            <span><strong>@L["Agent"]:</strong> @_diagnostic.AgentVersion</span>
                        }
                        <span><strong>@L["Backend"]:</strong> @_diagnostic.BackendVersion</span>
                    </div>
                </RadzenStack>
            </RadzenCard>
        }
    }

    @* DF6L (decided - stays bespoke, NOT migrated to DialogFooter): this footer is state-driven -
       Running shows a single Cancel; Failed shows WhyOffline + Retry + Close (Close last); Success shows
       only Close. DialogFooter renders a fixed standard Cancel FIRST then ChildContent, with cancel
       semantics it owns - it can't express the per-state button sets, the cancel-vs-close distinction,
       nor the Close-last ordering without either reordering buttons (UX regression) or bloating the
       shared component with state/order options for this one dialog. The DialogFooter migration is
       complete for every dialog it fits; this one is intentionally left bespoke. *@
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
        @if (_state == ContactState.Running)
        {
            <RadzenButton Text="@L["Cancel"]" Icon="close" Click="@CancelAndCloseAsync" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        }
        else
        {
            @if (_state == ContactState.Failed)
            {
                <RadzenButton Text="@L["WhyOffline"]" Icon="help" Size="ButtonSize.Small"
                    IsBusy="@_diagnosticLoading" BusyText="@L["WhyOffline"]"
                    Click="@LoadDiagnosticAsync" Disabled="@(_diagnostic is not null && !_diagnosticLoading)" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                <RadzenButton Text="@L["Retry"]" Icon="refresh" Click="@StartAsync" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
            }
            <RadzenButton Text="@L["Close"]" Icon="close" Click="@(() => Dialog.Close(_state == ContactState.Success))" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        }
    </RadzenStack>
</RadzenStack>
