@if (_result is null)
{
    <RadzenProgressBarCircular ShowValue="true" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <RadzenText TextStyle="TextStyle.H5" class="rz-mb-4">@L["Logs"]</RadzenText>
    <RadzenDataGrid Data="@_result.Items" TItem="TaskLogDto" Density="Density.Compact" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced">
        <EmptyTemplate>
            <EmptyState Icon="article" Title="@L["NoLogs"]" />
        </EmptyTemplate>
        <Columns>
            <RadzenDataGridColumn TItem="TaskLogDto" Property="Timestamp" Title="@L["Time"]" FormatString="{0:G}" Width="180px" />
            <RadzenDataGridColumn TItem="TaskLogDto" Property="Level" Title="@L["Level"]" Width="100px">
                <Template Context="log">
                    <RadzenBadge BadgeStyle="@GetLevelBadge(log.Level)" Text="@L.Localize(log.Level)" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="TaskLogDto" Property="Message" Title="@L["Message"]" />
        </Columns>
    </RadzenDataGrid>

    @if (_result.TotalCount > _result.PageSize)
    {
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" class="rz-mt-4">
            <RadzenButton Icon="expand_more" Text="@L["LoadMore"]" Click="@LoadMoreAsync"
                IsBusy="@_loading" Disabled="@(_result.Items.Count >= _result.TotalCount)" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        </RadzenStack>
        @if (_loadMoreError)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" class="rz-mt-2">
                @L["LoadFailed"]
            </RadzenAlert>
        }
    }
}
