<RadzenText TextStyle="TextStyle.H5" class="rz-mb-4">@L["Configuration"]</RadzenText>
<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
        <RadzenButton Text="@L["ExportYaml"]" Icon="download" Click="@ExportConfigAsync" IsBusy="@_configExporting" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
        <RadzenButton Text="@L["ImportYaml"]" Icon="upload" Click="@(() => _configImportVisible = true)" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
        @if (!string.IsNullOrEmpty(_configYaml))
        {
            <RadzenButton Text="@L["Copy"]" Icon="content_copy" Click="@CopyConfigToClipboardAsync" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        }
    </RadzenStack>

    @if (!string.IsNullOrEmpty(_configYaml))
    {
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-2">@L["CurrentConfiguration"]</RadzenText>
            <pre class="config-yaml-block">@_configYaml</pre>
        </RadzenCard>
    }

    @if (_configImportVisible)
    {
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-2">@L["ImportYamlConfiguration"]</RadzenText>
            <RadzenTextArea @bind-Value="_configImportYaml" Rows="15" class="config-yaml-editor" />
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-3">
                <RadzenButton Text="@L["ValidateYaml"]" Icon="check_circle" Click="@ValidateConfigAsync" IsBusy="@_configValidating" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
                <RadzenButton Text="@L["Preview"]" Icon="preview" Click="@PreviewConfigAsync" IsBusy="@_configPreviewing" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
                <RadzenButton Text="@L["Deploy"]" Icon="rocket_launch" Click="@DeployConfigAsync" IsBusy="@_configDeploying"
                    Disabled="@string.IsNullOrWhiteSpace(_configImportYaml)" ButtonStyle="ButtonStyle.Success" Variant="Variant.Filled" />
                <RadzenButton Icon="close" Text="@L["Cancel"]" Click="@(() => { _configImportVisible = false; _configPreview = null; })" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
            </RadzenStack>

            @if (_configValidation is not null)
            {
                <RadzenAlert AlertStyle="@(_configValidation.IsValid ? AlertStyle.Success : AlertStyle.Danger)"
                    class="rz-mt-3" Shade="Shade.Lighter" AllowClose="false">
                    @if (_configValidation.IsValid)
                    {
                        <span>@L["ConfigurationValid"]</span>
                    }
                    else
                    {
                        <ul class="rz-m-0">
                            @foreach (var error in _configValidation.Errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    }
                </RadzenAlert>
            }

            @if (_configPreview is not null)
            {
                <RadzenCard class="rz-mt-3">
                    <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-2">
                        @string.Format(L["TasksPlanned"], _configPreview.TaskCount)
                    </RadzenText>
                    <RadzenDataGrid Data="@_configPreview.Changes" TItem="ServerConfigChange" Density="Density.Compact"
                        AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced"
                        AllowPaging="true" PageSize="25" PagerHorizontalAlign="HorizontalAlign.Center">
                        <Columns>
                            <RadzenDataGridColumn TItem="ServerConfigChange" Property="Category" Title="@L["Category"]" Width="160px" />
                            <RadzenDataGridColumn TItem="ServerConfigChange" Property="Action" Title="@L["Action"]" Width="120px">
                                <Template Context="change">
                                    <RadzenBadge Text="@change.Action"
                                        BadgeStyle="@GetChangeBadgeStyle(change.Action)" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="ServerConfigChange" Property="Description" Title="@L["Description"]" />
                        </Columns>
                    </RadzenDataGrid>
                </RadzenCard>
            }
        </RadzenCard>
    }
</RadzenStack>
