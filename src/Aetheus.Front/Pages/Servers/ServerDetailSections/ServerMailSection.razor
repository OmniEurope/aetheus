<RadzenText TextStyle="TextStyle.H5" class="rz-mb-4">@L["Mail"]</RadzenText>

@* --- Status bar --- *@
<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" class="rz-mb-4" Gap="0.5rem" Wrap="FlexWrap.Wrap">
    <RadzenBadge BadgeStyle="@(Mail.IsInstalled ? BadgeStyle.Success : BadgeStyle.Light)"
        Text="@(Mail.IsInstalled ? L["Installed"] : L["NotInstalled"])" />
    @if (Mail.IsInstalled)
    {
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
            <span class="rz-badge-dot mail-status-dot @(Mail.IsPostfixRunning ? "is-running" : "")"></span>
            <RadzenBadge BadgeStyle="@(Mail.IsPostfixRunning ? BadgeStyle.Success : BadgeStyle.Danger)">
                <RadzenIcon Icon="@(Mail.IsPostfixRunning ? "check" : "close")" /> @L["Postfix"]
            </RadzenBadge>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
            <span class="rz-badge-dot mail-status-dot @(Mail.IsDovecotRunning ? "is-running" : "")"></span>
            <RadzenBadge BadgeStyle="@(Mail.IsDovecotRunning ? BadgeStyle.Success : BadgeStyle.Danger)">
                <RadzenIcon Icon="@(Mail.IsDovecotRunning ? "check" : "close")" /> @L["Dovecot"]
            </RadzenBadge>
        </RadzenStack>
        @if (!string.IsNullOrEmpty(Mail.PostfixVersion))
        {
            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">Postfix v@(Mail.PostfixVersion)</RadzenText>
        }
        @if (!string.IsNullOrEmpty(Mail.DovecotVersion))
        {
            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">Dovecot v@(Mail.DovecotVersion)</RadzenText>
        }
        <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@string.Format(L["MailQueueCount"], Mail.QueueSize)" />
    }
    <div class="blade-content-spacer"></div>

    @if (!Mail.IsInstalled)
    {
        <RadzenButton Icon="rocket_launch" Text="@L["MailSetup"]"
            Disabled="@(!Server.MailSetupAvailable)"
            title="@(Server.MailSetupAvailable ? null : L["MailSetupCapabilityRequired"].Value)"
            Click="@OpenSetupDialogAsync" ButtonStyle="ButtonStyle.Success" Variant="Variant.Filled" />
    }
    else
    {
        <RadzenSplitButton Icon="play_arrow" Text="@L["Postfix"]" Size="ButtonSize.Small"
            Disabled="@_actionRunning" Click="@(() => ExecuteActionAsync(MailAction.RestartPostfix))">
            <ChildContent>
                <RadzenSplitButtonItem Text="@L["Start"]" Value="start" Icon="play_arrow" ButtonStyle="ButtonStyle.Success" Variant="Variant.Filled" />
                <RadzenSplitButtonItem Text="@L["Stop"]" Value="stop" Icon="stop" />
                <RadzenSplitButtonItem Text="@L["Restart"]" Value="restart" Icon="refresh" />
                <RadzenSplitButtonItem Text="@L["Reload"]" Value="reload" Icon="sync" />
            </ChildContent>
        </RadzenSplitButton>
        <RadzenSplitButton Icon="play_arrow" Text="@L["Dovecot"]" Size="ButtonSize.Small"
            Disabled="@_actionRunning" Click="@(() => ExecuteActionAsync(MailAction.RestartDovecot))">
            <ChildContent>
                <RadzenSplitButtonItem Text="@L["Start"]" Value="start" Icon="play_arrow" ButtonStyle="ButtonStyle.Success" Variant="Variant.Filled" />
                <RadzenSplitButtonItem Text="@L["Stop"]" Value="stop" Icon="stop" />
                <RadzenSplitButtonItem Text="@L["Restart"]" Value="restart" Icon="refresh" />
                <RadzenSplitButtonItem Text="@L["Reload"]" Value="reload" Icon="sync" />
            </ChildContent>
        </RadzenSplitButton>
        <RadzenButton Icon="checklist" Text="@L["TestConfig"]"
            Disabled="@_actionRunning"
            Click="@(() => ExecuteActionAsync(MailAction.TestConfig))" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
    }
</RadzenStack>

@* S-FEAT-MSTK: postfix/dovecot can be apt-installed via the Services tab, which leaves them running
   but with no virtual mailboxes / Dovecot auth / DKIM. Detect that half-configured state (installed but
   no domain configured) and steer the operator to the full Mail stack setup instead of a dead-looking UI. *@
@if (Mail.IsInstalled && _domains.Count == 0 && _accounts.Count == 0)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Lighter" Size="AlertSize.Small" class="rz-mb-4"
        AllowClose="false" Icon="warning">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@L["MailInstalledNotConfigured"]</RadzenText>
            <RadzenButton Icon="rocket_launch" Text="@L["MailSetup"]"
                Disabled="@(!Server.MailSetupAvailable)"
                title="@(Server.MailSetupAvailable ? null : L["MailSetupCapabilityRequired"].Value)"
                Click="@OpenSetupDialogAsync" ButtonStyle="ButtonStyle.Success" Variant="Variant.Filled" />
        </RadzenStack>
    </RadzenAlert>
}

@if (Mail.IsInstalled)
{
    <UrlSyncedTabs Slugs="@(new[] { "domains", "accounts", "aliases", "queue", "logs", "relations" })">
        <Tabs>
            @* --- Domains tab --- *@
            <RadzenTabsItem Text="@L["MailDomains"]" Icon="dns">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" class="rz-mb-2" Gap="0.5rem">
                    <RadzenBadge Text="@_domainCount.ToString()" BadgeStyle="BadgeStyle.Info" />
                    <div class="blade-content-spacer"></div>
                    <RadzenButton Icon="add_circle" Text="@L["AddDomain"]"
                        Click="@OpenAddDomainDialogAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                </RadzenStack>
                <AetheusDataGrid @ref="_domainsGrid" Data="@_domains" Count="@_domainCount"
                    TItem="MailDomainDto" IsLoading="@_domainsLoading" LoadData="@LoadDomainsAsync"
                    PageSize="25" Density="Density.Compact" AllowSorting="true" EmptyText="@L["NoMailDomains"]">
                    <Columns>
                        <RadzenDataGridColumn TItem="MailDomainDto" Property="Name" Title="@L["DomainName"]" Width="250px" />
                        <RadzenDataGridColumn TItem="MailDomainDto" Title="DKIM" Width="120px">
                            <Template Context="d">
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@d.DkimSelector</RadzenText>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="MailDomainDto" Title="DNS" Width="180px">
                            <Template Context="d">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                    <RadzenBadge BadgeStyle="@(d.HasSpf ? BadgeStyle.Success : BadgeStyle.Light)" Text="SPF" />
                                    <RadzenBadge BadgeStyle="@(d.HasDkim ? BadgeStyle.Success : BadgeStyle.Light)" Text="DKIM" />
                                    <RadzenBadge BadgeStyle="@(d.HasDmarc ? BadgeStyle.Success : BadgeStyle.Light)" Text="DMARC" />
                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="MailDomainDto" Title="@L["Status"]" Width="100px">
                            <Template Context="d">
                                <RadzenBadge BadgeStyle="@(d.IsActive ? BadgeStyle.Success : BadgeStyle.Light)"
                                    Text="@(d.IsActive ? L["Active"] : L["Inactive"])" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="MailDomainDto" Title="@L["Actions"]" Width="320px">
                            <Template Context="d">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                    <RadzenButton Icon="dns" Text="DNS"
                                        Click="@(() => ShowDnsRecordsAsync(d))" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
                                    <RadzenButton Icon="vpn_key" Text="DKIM"
                                        Click="@(() => ShowDkimRotation(d))" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
                                    <RadzenButton Icon="delete" Text="@L["Delete"]"
                                        Click="@(() => ShowConfirm(L["DeleteDomain"], string.Format(L["ConfirmDeleteMailDomain"], d.Name),
                                            () => DeleteDomainAsync(d.Id)))" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </AetheusDataGrid>
            </RadzenTabsItem>

            @* --- Accounts tab --- *@
            <RadzenTabsItem Text="@L["MailAccounts"]" Icon="people">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" class="rz-mb-2" Gap="0.5rem">
                    <RadzenBadge Text="@_accountCount.ToString()" BadgeStyle="BadgeStyle.Info" />
                    <div class="blade-content-spacer"></div>
                    <RadzenButton Icon="person_add" Text="@L["AddAccount"]"
                        Click="@OpenAddAccountDialogAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                </RadzenStack>
                <AetheusDataGrid @ref="_accountsGrid" Data="@_accounts" Count="@_accountCount"
                    TItem="MailAccountDto" IsLoading="@_accountsLoading" LoadData="@LoadAccountsAsync"
                    PageSize="25" Density="Density.Compact" AllowSorting="true" EmptyText="@L["NoRecords"]">
                    <Columns>
                        <RadzenDataGridColumn TItem="MailAccountDto" Property="Email" Title="@L["Email"]" Width="300px" />
                        <RadzenDataGridColumn TItem="MailAccountDto" Title="@L["Quota"]" Width="200px">
                            <Template Context="a">
                                <RadzenStack Gap="0.1rem">
                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">
                                        @a.UsedMb / @a.QuotaMb MB (@(a.QuotaMb > 0 ? Math.Round(a.UsedMb * 100.0 / a.QuotaMb, 1) : 0)%)
                                    </RadzenText>
                                    <RadzenProgressBar Value="@(a.QuotaMb > 0 ? Math.Round(a.UsedMb * 100.0 / a.QuotaMb, 1) : 0)"
                                        ShowValue="false" class="h-progress-thin"
                                        ProgressBarStyle="@(a.QuotaMb > 0 && a.UsedMb * 100.0 / a.QuotaMb > 90 ? ProgressBarStyle.Danger : (a.QuotaMb > 0 && a.UsedMb * 100.0 / a.QuotaMb > 75 ? ProgressBarStyle.Warning : ProgressBarStyle.Primary))" />
                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="MailAccountDto" Title="@L["Status"]" Width="100px">
                            <Template Context="a">
                                <RadzenBadge BadgeStyle="@(a.IsActive ? BadgeStyle.Success : BadgeStyle.Light)"
                                    Text="@(a.IsActive ? L["Active"] : L["Inactive"])" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="MailAccountDto" Title="@L["Created"]" Width="140px">
                            <Template Context="a">
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@a.CreatedAt.ToString("yyyy-MM-dd")</RadzenText>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="MailAccountDto" Title="@L["Actions"]" Width="200px">
                            <Template Context="a">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                    <RadzenButton Icon="delete" Text="@L["Delete"]"
                                        Click="@(() => ShowConfirm(L["DeleteAccount"], string.Format(L["ConfirmDeleteMailAccount"], a.Email),
                                            () => DeleteAccountAsync(a.Id)))" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </AetheusDataGrid>
            </RadzenTabsItem>

            @* --- Aliases tab --- *@
            <RadzenTabsItem Text="@L["Aliases"]" Icon="alternate_email">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" class="rz-mb-2" Gap="0.5rem">
                    <RadzenBadge Text="@_aliasCount.ToString()" BadgeStyle="BadgeStyle.Info" />
                    <div class="blade-content-spacer"></div>
                    <RadzenButton Icon="add_circle" Text="@L["AddAlias"]"
                        Click="@OpenAddAliasDialogAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                </RadzenStack>
                <AetheusDataGrid @ref="_aliasesGrid" Data="@_aliases" Count="@_aliasCount"
                    TItem="MailAliasDto" IsLoading="@_aliasesLoading" LoadData="@LoadAliasesAsync"
                    PageSize="25" Density="Density.Compact" AllowSorting="true" EmptyText="@L["NoMailAliases"]">
                        <Columns>
                            <RadzenDataGridColumn TItem="MailAliasDto" Property="SourceEmail" Title="@L["Source"]" Width="250px" />
                            <RadzenDataGridColumn TItem="MailAliasDto" Title="" Width="40px">
                                <Template Context="a">
                                    <RadzenIcon Icon="arrow_forward" class="icon-md-app" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="MailAliasDto" Property="DestinationEmail" Title="@L["Destination"]" Width="250px" />
                            <RadzenDataGridColumn TItem="MailAliasDto" Title="@L["Status"]" Width="100px">
                                <Template Context="a">
                                    <RadzenBadge BadgeStyle="@(a.IsActive ? BadgeStyle.Success : BadgeStyle.Danger)"
                                        Text="@(a.IsActive ? L["Active"] : L["Inactive"])" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="MailAliasDto" Title="" Width="80px" TextAlign="TextAlign.End">
                                <Template Context="a">
                                    <RadzenButton Icon="delete" Text="@L["Delete"]"
                                        Click="@(() => ShowConfirm(L["DeleteAlias"], L["ConfirmDeleteAlias"],
                                            () => DeleteAliasAsync(a.Id)))" Title="@L["Delete"]" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                </AetheusDataGrid>
            </RadzenTabsItem>

            @* --- Queue tab --- *@
            <RadzenTabsItem Text="@L["MailQueue"]" Icon="queue">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" class="rz-mb-2" Gap="0.5rem">
                    <RadzenBadge Text="@Mail.QueueSize.ToString()" BadgeStyle="@(Mail.QueueSize > 0 ? BadgeStyle.Warning : BadgeStyle.Success)" />
                    <div class="blade-content-spacer"></div>
                    <RadzenButton Icon="refresh" Text="@L["Refresh"]"
                        Click="@(() => ExecuteActionAsync(MailAction.ViewQueue))" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                    <RadzenButton Icon="visibility" Text="@L["ViewQueue"]"
                        Click="@(() => ExecuteActionAsync(MailAction.ViewQueue))" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
                    <RadzenButton Icon="send" Text="@L["FlushQueue"]"
                        Click="@(() => ShowConfirm(L["FlushQueue"], L["ConfirmFlushQueue"],
                            () => ExecuteActionAsync(MailAction.FlushQueue)))" ButtonStyle="ButtonStyle.Success" Variant="Variant.Filled" />
                </RadzenStack>
                <RadzenDataGrid Data="@_queueItems" TItem="MailQueueItemDto" Density="Density.Compact" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced">
                    <Columns>
                        <RadzenDataGridColumn TItem="MailQueueItemDto" Property="Id" Title="ID" Width="120px" />
                        <RadzenDataGridColumn TItem="MailQueueItemDto" Property="Sender" Title="@L["Sender"]" Width="200px" />
                        <RadzenDataGridColumn TItem="MailQueueItemDto" Property="Recipient" Title="@L["Recipient"]" Width="200px" />
                        <RadzenDataGridColumn TItem="MailQueueItemDto" Title="@L["Size"]" Width="100px">
                            <Template Context="q">
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@FormatBytes(q.SizeBytes)</RadzenText>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="MailQueueItemDto" Property="Status" Title="@L["Status"]" Width="120px" />
                    </Columns>
                </RadzenDataGrid>
            </RadzenTabsItem>

            @* --- Logs tab --- *@
            <RadzenTabsItem Text="@L["Logs"]" Icon="article">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" class="rz-mb-2" Gap="0.5rem">
                    <RadzenDropDown @bind-Value="_logType" Data="@_logTypes" TValue="string"
                        Placeholder="@L["SelectLogType"]" class="w-rem-10" />
                    <RadzenNumeric @bind-Value="_logLines" Min="10" Max="10000" TValue="int" class="w-rem-6" />
                    <RadzenButton Icon="download" Text="@L["FetchLogs"]"
                        Click="@FetchLogsAsync" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
                </RadzenStack>
            </RadzenTabsItem>

            @* --- Relations tab --- *@
            <RadzenTabsItem Text="@L["Relations"]" Icon="link">
                <ModuleLinksTab ServerId="ServerId" SourceType="ModuleLinkType.Mail" Resources="@MailResourceNames" />
            </RadzenTabsItem>
        </Tabs>
    </UrlSyncedTabs>
}
