<RadzenText TextStyle="TextStyle.H5" class="rz-mb-4">@L["Projects"]</RadzenText>
<AetheusDataGrid @ref="_grid" Data="@_projects" Count="@_totalCount" TItem="ProjectDto"
    IsLoading="@_loading" LoadData="@LoadProjectsAsync" PageSize="25" Density="Density.Compact"
    EmptyText="@L["NoRecords"]" AllowSorting="true" GridCssClass="aetheus-clickable-rows" RowClick="@OnRowClick">
        <Columns>
            <RadzenDataGridColumn TItem="ProjectDto" Property="Name" Title="@L["Name"]">
                <Template Context="p">
                    <a href="/projects/@p.Id/overview" @onclick:stopPropagation="true">@p.Name</a>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ProjectDto" Property="Status" Title="@L["Status"]" Width="120px">
                <Template Context="p">
                    <RadzenBadge BadgeStyle="@(p.Status == ProjectStatus.Active ? BadgeStyle.Success : BadgeStyle.Light)"
                        Text="@L[p.Status.ToString()]" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ProjectDto" Property="CreatedAt" Title="@L["Created"]" FormatString="{0:d}" Width="120px" />
        </Columns>
    </AetheusDataGrid>
