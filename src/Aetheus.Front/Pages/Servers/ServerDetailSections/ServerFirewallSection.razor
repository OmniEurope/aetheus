<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenIcon Icon="security" />
            <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@L["FirewallTitle"]</RadzenText>
            @if (_firewall is not null && _firewall.Installed)
            {
                <RadzenBadge BadgeStyle="@(!_firewall.StatusKnown ? BadgeStyle.Warning : _firewall.Active ? BadgeStyle.Success : BadgeStyle.Light)"
                    Text="@(!_firewall.StatusKnown ? L["FirewallStatusUnknown"] : _firewall.Active ? L["FirewallActive"] : L["FirewallInactive"])" />
            }
        </RadzenStack>
        @if (CanManage && _firewall is { Installed: true, StatusKnown: true })
        {
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                @if (_firewall.Active)
                {
                    <RadzenButton Text="@L["FirewallDisable"]" Icon="gpp_maybe" Size="ButtonSize.Small" Busy="@_busy" Click="@(() => ToggleAsync(false))" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
                }
                else
                {
                    <RadzenButton Text="@L["FirewallEnable"]" Icon="gpp_good" Size="ButtonSize.Small"
                        Busy="@_busy" Click="@(() => ToggleAsync(true))" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
                }
            </RadzenStack>
        }
    </RadzenStack>

    @if (_loading)
    {
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
    }
    else if (_firewall is null || !_firewall.Installed)
    {
        <EmptyState Icon="gpp_bad" Title="@L["FirewallNotInstalledTitle"]" Description="@L["FirewallNotInstalledDescription"]" />
    }
    else if (!_firewall.StatusKnown)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter">
            @(string.IsNullOrWhiteSpace(_firewall.CollectionDiagnostics)
                ? L["FirewallStatusUnknownHint"]
                : _firewall.CollectionDiagnostics)
        </RadzenAlert>
    }
    else
    {
        @if (!CanManage)
        {
            <RadzenText TextStyle="TextStyle.Caption">@L["FirewallManageDisabledHint"]</RadzenText>
        }

        @if (CanManage)
        {
            <RadzenCard>
                <RadzenTemplateForm TItem="NewRuleModel" Data="@_rule" Submit="@SubmitRuleAsync">
                    <LocalizedDataAnnotationsValidator />
                    <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.End" Gap="1rem">
                        <RadzenFormField Text="@L["FirewallPort"]" Variant="Variant.Outlined">
                            <RadzenNumeric TValue="int" @bind-Value="_rule.Port" Min="1" Max="65535" />
                        </RadzenFormField>
                        <RadzenFormField Text="@L["FirewallProtocol"]" Variant="Variant.Outlined">
                            <RadzenDropDown TValue="string" @bind-Value="_rule.Protocol" Data="@Protocols" />
                        </RadzenFormField>
                        <RadzenFormField Text="@L["FirewallSource"]" Variant="Variant.Outlined">
                            <RadzenTextBox @bind-Value="_rule.Source" MaxLength="64" />
                        </RadzenFormField>
                        <RadzenButton ButtonType="ButtonType.Submit" Text="@L["FirewallAllow"]" Icon="lock_open" Busy="@_busy"
                            Click="@(() => _ruleAction = FirewallRuleAction.Allow)" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
                        <RadzenButton ButtonType="ButtonType.Submit" Text="@L["FirewallDeny"]" Icon="block" Busy="@_busy"
                            Click="@(() => _ruleAction = FirewallRuleAction.Deny)" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                    </RadzenStack>
                </RadzenTemplateForm>
            </RadzenCard>
        }

        <RadzenDataGrid Data="@_firewall.Rules" TItem="FirewallRuleDto" AllowSorting="true" Density="Density.Compact" AllowFiltering="true" FilterMode="FilterMode.Advanced">
            <EmptyTemplate>
                <EmptyState Icon="rule" Title="@L["FirewallNoRulesTitle"]" Description="@L["FirewallNoRulesDescription"]" />
            </EmptyTemplate>
            <Columns>
                <RadzenDataGridColumn TItem="FirewallRuleDto" Property="Port" Title="@L["FirewallPort"]" Width="100px" />
                <RadzenDataGridColumn TItem="FirewallRuleDto" Property="Protocol" Title="@L["FirewallProtocol"]" Width="100px" />
                <RadzenDataGridColumn TItem="FirewallRuleDto" Property="Action" Title="@L["FirewallActionColumn"]" Width="110px">
                    <Template Context="r">
                        <RadzenBadge BadgeStyle="@(r.Action == "allow" ? BadgeStyle.Success : BadgeStyle.Danger)" Text="@LocalizeAction(r.Action)" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="FirewallRuleDto" Property="Source" Title="@L["FirewallSource"]" />
                <RadzenDataGridColumn TItem="FirewallRuleDto" Title="@L["Actions"]" MinWidth="9rem" Sortable="false">
                    <Template Context="r">
                        @if (CanManage && IsDeletable(r))
                        {
                            <RadzenButton Text="@L["Delete"]" Icon="delete" Busy="@_busy" Click="@(() => DeleteRuleAsync(r))" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenStack>
