@using Aetheus.Shared.Enums

<RadzenStack Gap="0.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
        <RadzenBadge Text="@_totalCount.ToString()" BadgeStyle="BadgeStyle.Info" />
        <div class="blade-content-spacer"></div>
        <RadzenButton Icon="auto_fix_high" Text="@L["AutoDetect"]" Size="ButtonSize.Small"
            Click="@AutoDetectAsync" IsBusy="@_detecting" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
        <RadzenButton Icon="add_link" Text="@L["AddLink"]" Size="ButtonSize.Small"
            Click="@OpenAddDialogAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
    </RadzenStack>

    <RadzenTextBox Placeholder="@L["Search"]" @bind-Value="_search" Change="@OnSearchChangedAsync"
        class="pipeline-list-search rz-mb-2" />

    <AetheusDataGrid @ref="_grid" Data="@_links" TItem="LinkedResourceDto"
        Count="@_totalCount" IsLoading="@_loading" LoadData="@OnLoadDataAsync"
        PageSize="25" Density="Density.Compact" AllowFiltering="false" EmptyText="@L["NoRecords"]">
            <Columns>
                <RadzenDataGridColumn TItem="LinkedResourceDto" Property="Type" Title="@L["Type"]" Width="120px">
                    <Template Context="l">
                        <RadzenBadge BadgeStyle="@GetTypeBadge(l.Type)" Text="@l.Type.ToString()" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="LinkedResourceDto" Property="Identifier" Title="@L["Resource"]" />
                <RadzenDataGridColumn TItem="LinkedResourceDto" Property="IsAutoDetected" Title="@L["Source"]" Width="120px">
                    <Template Context="l">
                        <RadzenBadge BadgeStyle="@(l.IsAutoDetected ? BadgeStyle.Light : BadgeStyle.Secondary)"
                            Text="@(l.IsAutoDetected ? L["Auto"] : L["Manual"])" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="LinkedResourceDto" Title="@L["Actions"]" Width="100px" Sortable="false">
                    <Template Context="l">
                        <RadzenButton Icon="link_off" Size="ButtonSize.ExtraSmall"
                            ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled"
                            Click="@(() => DeleteLinkAsync(l.LinkId))" Title="@L["Unlink"]" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
    </AetheusDataGrid>
</RadzenStack>
