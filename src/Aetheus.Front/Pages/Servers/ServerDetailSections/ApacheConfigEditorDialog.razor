<RadzenStack Gap="0.5rem">
    @if (Model.Loading)
    {
        <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" class="rz-mb-2" />
        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@L["LoadingConfig"]</RadzenText>
    }
    <textarea class="config-editor-textarea" @bind="_content" @bind:event="oninput" rows="20"
        disabled="@Model.Loading"></textarea>
    <Aetheus.Front.Shared.DialogFooter OnCancel="@Cancel">
        <RadzenButton Text="@L["Save"]" Icon="save" Click="@Save"
            IsBusy="@_saving" Disabled="@Model.Loading" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
    </Aetheus.Front.Shared.DialogFooter>
</RadzenStack>
