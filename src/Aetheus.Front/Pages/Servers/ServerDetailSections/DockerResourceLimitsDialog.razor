<RadzenTemplateForm TItem="DockerResourceLimitsDialogModel" Data="@_model" Submit="@Submit">
    <LocalizedDataAnnotationsValidator />
    <RadzenStack Gap="0.75rem">
        <RadzenText TextStyle="TextStyle.Caption">@ContainerId</RadzenText>
        <RadzenFormField Text="@L["CpuLimit"]"><RadzenNumeric @bind-Value="_model.CpuLimit" Min="0" Max="1024" Step="0.25" /></RadzenFormField>
        <RadzenFormField Text="@L["MemoryLimit"]"><RadzenNumeric @bind-Value="_model.MemoryLimitMb" Min="0" Max="1048576" Step="64" TValue="int" /></RadzenFormField>
    </RadzenStack>
    <DialogFooter><Aetheus.Front.Shared.DialogCloseButton Text="@L["Cancel"]" /><RadzenButton ButtonType="ButtonType.Submit" Icon="check" Text="@L["Apply"]" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" /></DialogFooter>
</RadzenTemplateForm>
