<RadzenText TextStyle="TextStyle.H5" class="rz-mb-4">@L["Apache"]</RadzenText>

@* --- Status bar --- *@
<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" class="rz-mb-4" Gap="0.5rem" Wrap="FlexWrap.Wrap">
    <RadzenBadge BadgeStyle="@GetStatusBadge(Apache.IsRunning)"
        Text="@(Apache.IsRunning ? L["Running"] : L["Stopped"])" />
    @if (!string.IsNullOrEmpty(Apache.Version))
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">v@(Apache.Version)</RadzenText>
    }
    @if (Apache.Pid.HasValue)
    {
        <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">PID @Apache.Pid</RadzenText>
    }
    <div class="blade-content-spacer"></div>

    <RadzenButton Icon="play_arrow" Text="@L["Start"]" Size="ButtonSize.Small"
        Disabled="@(Apache.IsRunning || _actionRunning)"
        Click="@(() => ExecuteActionAsync(ApacheAction.Start))" IsBusy="@_actionRunning" ButtonStyle="ButtonStyle.Success" Variant="Variant.Filled" />
    <RadzenButton Icon="stop" Text="@L["Stop"]" Size="ButtonSize.Small"
        Disabled="@(!Apache.IsRunning || _actionRunning)"
        Click="@(() => ShowConfirm(L["StopApache"], L["ConfirmStopApache"], () => ExecuteActionAsync(ApacheAction.Stop)))" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
    <RadzenButton Icon="refresh" Text="@L["Restart"]" Size="ButtonSize.Small"
        Disabled="@(!Apache.IsRunning || _actionRunning)"
        Click="@(() => ExecuteActionAsync(ApacheAction.Restart))" IsBusy="@_actionRunning" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
    <RadzenButton Icon="sync" Text="@L["Reload"]" Size="ButtonSize.Small"
        Disabled="@(!Apache.IsRunning || _actionRunning)"
        Click="@(() => ExecuteActionAsync(ApacheAction.Reload))" IsBusy="@_actionRunning" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
    <RadzenButton Icon="check_circle" Text="@L["TestConfig"]" Size="ButtonSize.Small"
        Disabled="@_actionRunning"
        Click="@(() => ExecuteActionAsync(ApacheAction.TestConfig))" IsBusy="@_actionRunning" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
</RadzenStack>

@if (Apache.CollectionDegraded)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat"
        AllowClose="false" class="rz-mb-4" Title="@L["ApacheCollectionDegraded"]">
        @L["ApacheCollectionDegradedHint"]
        @if (!string.IsNullOrWhiteSpace(Apache.CollectionDiagnostics))
        {
            <RadzenText TextStyle="TextStyle.Caption" class="rz-mt-2 rz-mb-0">
                @Apache.CollectionDiagnostics
            </RadzenText>
        }
    </RadzenAlert>
}

<UrlSyncedTabs Slugs="@(new[] { "sites", "modules", "logs", "relations" })">
    <Tabs>
        @* --- Sites tab (enabled + disabled, split) --- *@
        <RadzenTabsItem Text="@L["Sites"]">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" class="rz-mb-2" Gap="0.5rem">
                <RadzenBadge Text="@FilteredVirtualHosts.Count.ToString()" BadgeStyle="BadgeStyle.Info" />
                <RadzenTextBox @bind-Value="_vhostSearch" Placeholder="@L["FilterSites"]" />
            </RadzenStack>

            @* Item #5.1: one row per domain (ServerName), with port chips for each vhost the
               domain serves. A `:80` + `:443` pair that share the same .conf - the common case -
               collapses from 2 rows to 1. Per-port action buttons disable/edit the matching
               config file. *@
            <RadzenText TextStyle="TextStyle.H6" class="rz-mt-3 rz-mb-2">
                @L["SitesEnabled"] (@EnabledVirtualHostGroups.Count)
            </RadzenText>
            <RadzenDataGrid Data="@EnabledVirtualHostGroups" TItem="ApacheVirtualHostGroup" Density="Density.Compact"
                AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced"
                AllowPaging="true" PageSize="25" PagerHorizontalAlign="HorizontalAlign.Center">
                <Columns>
                    <RadzenDataGridColumn TItem="ApacheVirtualHostGroup" Property="ServerName" Title="@L["ServerName"]" Width="260px">
                        <Template Context="g">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                <strong>@g.ServerName</strong>
                                @if (g.Members.Count > 1)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@($"× {g.Members.Count}")" />
                                }
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ApacheVirtualHostGroup" Title="@L["Ports"]" Width="200px" Sortable="false" Filterable="false">
                        <Template Context="g">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" Wrap="FlexWrap.Wrap">
                                @foreach (var m in g.Members)
                                {
                                    <RadzenBadge BadgeStyle="@(m.Port == 443 ? BadgeStyle.Success : BadgeStyle.Info)"
                                        Text="@m.Port.ToString()"
                                        title="@($"{m.Port} → {System.IO.Path.GetFileName(m.ConfigFile)}")" />
                                }
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ApacheVirtualHostGroup" Title="@L["Actions"]" Width="320px" Sortable="false" Filterable="false">
                        <Template Context="g">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" Wrap="FlexWrap.Wrap">
                                <RadzenButton Icon="edit" Text="@L["EditConfig"]" Size="ButtonSize.ExtraSmall"
                                    Click="@(() => OpenConfigEditorAsync(Path.GetFileName(g.Primary.ConfigFile)))" ButtonStyle="ButtonStyle.Info" Variant="Variant.Filled" />
                                @foreach (var m in g.Members)
                                {
                                    <RadzenButton Icon="block" Size="ButtonSize.ExtraSmall"
                                        Text="@($":{m.Port}")"
                                        title="@($"{L["Disable"]} ({m.Port})")"
                                        Click="@(() => ExecuteActionAsync(ApacheAction.DisableSite, Path.GetFileName(m.ConfigFile)))" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                                }
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>

            <RadzenText TextStyle="TextStyle.H6" class="rz-mt-4 rz-mb-2">
                @L["SitesDisabled"] (@DisabledVirtualHostGroups.Count)
            </RadzenText>
            <RadzenDataGrid Data="@DisabledVirtualHostGroups" TItem="ApacheVirtualHostGroup" Density="Density.Compact"
                AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced"
                AllowPaging="true" PageSize="25" PagerHorizontalAlign="HorizontalAlign.Center">
                <Columns>
                    <RadzenDataGridColumn TItem="ApacheVirtualHostGroup" Property="ServerName" Title="@L["ServerName"]" Width="260px">
                        <Template Context="g">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                <strong>@g.ServerName</strong>
                                @if (g.Members.Count > 1)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@($"× {g.Members.Count}")" />
                                }
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ApacheVirtualHostGroup" Title="@L["Ports"]" Width="200px" Sortable="false" Filterable="false">
                        <Template Context="g">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" Wrap="FlexWrap.Wrap">
                                @foreach (var m in g.Members)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@m.Port.ToString()" />
                                }
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ApacheVirtualHostGroup" Title="@L["Actions"]" Width="320px" Sortable="false" Filterable="false">
                        <Template Context="g">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" Wrap="FlexWrap.Wrap">
                                <RadzenButton Icon="edit" Text="@L["EditConfig"]" Size="ButtonSize.ExtraSmall"
                                    Click="@(() => OpenConfigEditorAsync(Path.GetFileName(g.Primary.ConfigFile)))" ButtonStyle="ButtonStyle.Info" Variant="Variant.Filled" />
                                @foreach (var m in g.Members)
                                {
                                <RadzenButton Icon="check"
                                        Text="@($":{m.Port}")"
                                        title="@($"{L["Enable"]} ({m.Port})")"
                                        Click="@(() => ExecuteActionAsync(ApacheAction.EnableSite, Path.GetFileName(m.ConfigFile)))" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                                }
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenTabsItem>

        @* --- Modules tab --- *@
        <RadzenTabsItem Text="@L["Modules"]">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" class="rz-mb-2" Gap="0.5rem">
                <RadzenBadge Text="@FilteredModules.Count.ToString()" BadgeStyle="BadgeStyle.Info" />
                <RadzenTextBox @bind-Value="_moduleSearch" Placeholder="@L["FilterModules"]" />
            </RadzenStack>
            <RadzenDataGrid Data="@FilteredModules" TItem="ApacheModuleDto" Density="Density.Compact"
                AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced"
                AllowPaging="true" PageSize="25" PagerHorizontalAlign="HorizontalAlign.Center">
                <Columns>
                    <RadzenDataGridColumn TItem="ApacheModuleDto" Property="Name" Title="@L["Module"]" />
                    <RadzenDataGridColumn TItem="ApacheModuleDto" Property="Type" Title="@L["Type"]" Width="120px">
                        <Template Context="m">
                            <RadzenBadge BadgeStyle="@(m.Type == "static" ? BadgeStyle.Light : BadgeStyle.Info)"
                                Text="@m.Type" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ApacheModuleDto" Title="@L["Actions"]" Width="160px">
                        <Template Context="m">
                            @if (m.Type == "shared")
                            {
                                @if (m.IsEnabled)
                                {
                                    <RadzenButton Icon="block" Text="@L["Disable"]" Size="ButtonSize.ExtraSmall"
                                        Click="@(() => ShowConfirm(L["DisableModule"], string.Format(L["ConfirmDisableModule"], m.Name),
                                            () => ExecuteActionAsync(ApacheAction.DisableModule, m.Name.Replace("_module", ""))))" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                                }
                                else
                                {
                                <RadzenButton Icon="check" Text="@L["Enable"]"
                                        Click="@(() => ExecuteActionAsync(ApacheAction.EnableModule, m.Name.Replace("_module", "")))" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                                }
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenTabsItem>

        @* --- Logs tab --- *@
        <RadzenTabsItem Text="@L["Logs"]">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" class="rz-mb-3" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenDropDown @bind-Value="_logType" TValue="string" Data="@(new[] { "error", "access" })"
                    class="w-rem-8-75" />
                <RadzenNumeric @bind-Value="_logLines" TValue="int" Min="1" Max="10000" class="w-rem-6" />
                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">@L["Lines"]</RadzenText>
                <RadzenButton Icon="download" Text="@L["FetchLogs"]" Size="ButtonSize.Small"
                    Click="@FetchLogsAsync"
                    IsBusy="@_logLoading" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
                <RadzenButton Icon="@(_logFollowing ? "stop" : "play_arrow")"
                    Text="@(_logFollowing ? L["StopFollow"] : L["FollowLogs"])"
                    Size="ButtonSize.Small"
                    ButtonStyle="@(_logFollowing ? ButtonStyle.Danger : ButtonStyle.Success)"
                    Variant="Variant.Filled" Click="@ToggleFollow" />
            </RadzenStack>

            @if (_logContent is not null)
            {
                <pre class="apache-log-output @(_logFollowing ? "apache-log-follow" : "")">@_logContent</pre>
            }
        </RadzenTabsItem>

        @* --- Relations tab --- *@
        <RadzenTabsItem Text="@L["Relations"]">
            <ModuleLinksTab ServerId="ServerId" SourceType="ModuleLinkType.Apache" Resources="@ApacheResourceNames" />
        </RadzenTabsItem>
    </Tabs>
</UrlSyncedTabs>

@* --- Confirmation dialog --- *@
<ConfirmDialog Visible="_confirmVisible" Title="@_confirmTitle" Message="@_confirmMessage"
    OnConfirm="ConfirmAccepted" OnCancel="ConfirmCancelled" />
