<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" class="rz-mb-3" Gap="0.5rem">
    <RadzenText TextStyle="TextStyle.H5" class="rz-m-0"><strong>@(string.IsNullOrEmpty(Project) ? L["NoProject"] : Project)</strong></RadzenText>
    <div class="flex-spacer"></div>
    <RadzenButton Icon="play_arrow" Text="@L["StartAll"]" Click="@(() => CloseWithAction(DockerContainerAction.Start))" ButtonStyle="ButtonStyle.Success" Variant="Variant.Filled" />
    <RadzenButton Icon="stop" Text="@L["StopAll"]" Click="@(() => CloseWithAction(DockerContainerAction.Stop))" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
    <RadzenButton Icon="restart_alt" Text="@L["RestartAll"]" Click="@(() => CloseWithAction(DockerContainerAction.Restart))" ButtonStyle="ButtonStyle.Success" Variant="Variant.Filled" />
</RadzenStack>

<RadzenTabs>
    <Tabs>
        <RadzenTabsItem Text="@L["Containers"]"><RadzenDataGrid Responsive="false" AllowFiltering="true" FilterMode="FilterMode.Advanced" Data="@Containers" TItem="DockerContainerDto" Density="Density.Compact" AllowSorting="true" AllowColumnResize="true"><Columns><RadzenDataGridColumn TItem="DockerContainerDto" Property="Name" Title="@L["Name"]" /><RadzenDataGridColumn TItem="DockerContainerDto" Property="Image" Title="@L["Image"]" /><RadzenDataGridColumn TItem="DockerContainerDto" Property="State" Title="@L["State"]" Width="100px" /><RadzenDataGridColumn TItem="DockerContainerDto" Property="Status" Title="@L["Status"]" /><RadzenDataGridColumn TItem="DockerContainerDto" Property="Ports" Title="@L["Ports"]" /></Columns></RadzenDataGrid></RadzenTabsItem>
        <RadzenTabsItem Text="@L["DockerImages"]"><RadzenDataGrid Responsive="false" AllowFiltering="true" FilterMode="FilterMode.Advanced" Data="@Images" TItem="DockerImageDto" Density="Density.Compact" AllowSorting="true" AllowColumnResize="true"><Columns><RadzenDataGridColumn TItem="DockerImageDto" Property="Repository" Title="@L["Repository"]" /><RadzenDataGridColumn TItem="DockerImageDto" Property="Tag" Title="@L["Tag"]" Width="120px" /><RadzenDataGridColumn TItem="DockerImageDto" Property="Size" Title="@L["Size"]" Width="100px" /></Columns></RadzenDataGrid></RadzenTabsItem>
        <RadzenTabsItem Text="@L["DockerNetworks"]"><RadzenDataGrid Responsive="false" AllowFiltering="true" FilterMode="FilterMode.Advanced" Data="@Networks" TItem="DockerNetworkDto" Density="Density.Compact" AllowSorting="true" AllowColumnResize="true"><Columns><RadzenDataGridColumn TItem="DockerNetworkDto" Property="Name" Title="@L["Name"]" /><RadzenDataGridColumn TItem="DockerNetworkDto" Property="Driver" Title="@L["Driver"]" Width="120px" /><RadzenDataGridColumn TItem="DockerNetworkDto" Property="Scope" Title="@L["Scope"]" Width="120px" /></Columns></RadzenDataGrid></RadzenTabsItem>
        <RadzenTabsItem Text="@L["DockerVolumes"]"><RadzenDataGrid Responsive="false" AllowFiltering="true" FilterMode="FilterMode.Advanced" Data="@Volumes" TItem="DockerVolumeDto" Density="Density.Compact" AllowSorting="true" AllowColumnResize="true"><Columns><RadzenDataGridColumn TItem="DockerVolumeDto" Property="Name" Title="@L["Name"]" /><RadzenDataGridColumn TItem="DockerVolumeDto" Property="Driver" Title="@L["Driver"]" Width="120px" /><RadzenDataGridColumn TItem="DockerVolumeDto" Property="Mountpoint" Title="@L["Mountpoint"]" /></Columns></RadzenDataGrid></RadzenTabsItem>
        <RadzenTabsItem Text="@L["DockerCompose"]"><RadzenDataGrid Responsive="false" AllowFiltering="true" FilterMode="FilterMode.Advanced" Data="@ComposeStacks" TItem="DockerComposeStackDto" Density="Density.Compact" AllowSorting="true" AllowColumnResize="true"><Columns><RadzenDataGridColumn TItem="DockerComposeStackDto" Property="Name" Title="@L["Stack"]" /><RadzenDataGridColumn TItem="DockerComposeStackDto" Property="Status" Title="@L["Status"]" Width="120px" /><RadzenDataGridColumn TItem="DockerComposeStackDto" Property="ConfigFile" Title="@L["Config"]" /></Columns></RadzenDataGrid></RadzenTabsItem>
    </Tabs>
</RadzenTabs>

<DialogFooter><Aetheus.Front.Shared.DialogCloseButton /></DialogFooter>
