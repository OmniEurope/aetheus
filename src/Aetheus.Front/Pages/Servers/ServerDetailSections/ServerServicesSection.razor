<RadzenText TextStyle="TextStyle.H5" class="rz-mb-4">@L["Services"]</RadzenText>

@if (!CanManagePackages)
{
    @* Capability notice + live heartbeat as two aligned tiles. The capability self-heals on the next
       heartbeat (re-install with --enable-package-manage); the notice clears itself once a beat lands
       reporting the aetheus-package sudoers grant, no manual reload needed. *@
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Stretch"
        Wrap="FlexWrap.Wrap" Gap="1rem" class="rz-mb-4">
        <RadzenCard Variant="Variant.Outlined" class="flex-spacer capability-warning-tile">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <RadzenIcon Icon="lock" class="capability-warning-icon" />
                <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@L["ServiceInstallCapabilityDisabled"]</RadzenText>
            </RadzenStack>
        </RadzenCard>
        <RadzenCard Variant="Variant.Outlined" class="heartbeat-tile">
            <HeartbeatPulse Server="Server" />
        </RadzenCard>
    </RadzenStack>
}

<UrlSyncedTabs Slugs="@(new[] { "manageable", "other", "system" })">
    <Tabs>
        <RadzenTabsItem Text="@($"{L["Manageable"]} ({ModuleCount})")" Icon="build">
            <RadzenText TextStyle="TextStyle.H5" class="rz-mb-2">@L["InstalledServices"] (@ModuleInstalled.Count())</RadzenText>
            @if (!ModuleInstalled.Any())
            {
                <EmptyState Icon="build" Title="@L["NoServicesToDisplay"]" />
            }
            else
            {
                <ManageableServiceGrid Services="@ModuleInstalled" Installed="true" ShowModuleLink="true"
                    CanManagePackages="@CanManagePackages" BusyService="@_busyService" ServerOnline="@ServerOnline"
                    OnStart="@(n => ExecuteActionAsync(ServiceAction.Start, n))"
                    OnStop="@(n => ConfirmAndExecuteAsync(ServiceAction.Stop, n))"
                    OnRestart="@(n => ConfirmAndExecuteAsync(ServiceAction.Restart, n))"
                    OnLogs="@ViewServiceLogsAsync" OnUninstall="@UninstallServiceAsync"
                    OnOpenModule="@OpenServiceModule" OnBulk="@BulkActionAsync" />
            }

            <RadzenText TextStyle="TextStyle.H5" class="rz-mt-6 rz-mb-2">@L["AvailableServices"] (@ModuleNotInstalled.Count())</RadzenText>
            @if (!ModuleNotInstalled.Any())
            {
                <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" AllowClose="false">
                    @L["AllServicesInstalled"]
                </RadzenAlert>
            }
            else
            {
                <ManageableServiceGrid Services="@ModuleNotInstalled" Installed="false"
                    CanManagePackages="@CanManagePackages" CanInstallTeamspeak="@Server.TeamspeakSetupAvailable" BusyService="@_busyService" ServerOnline="@ServerOnline"
                    OnInstall="@InstallServiceAsync" OnBulk="@BulkActionAsync" />
            }
        </RadzenTabsItem>

        <RadzenTabsItem Text="@($"{L["OtherServices"]} ({OtherCount})")" Icon="apps">
            <RadzenText TextStyle="TextStyle.H5" class="rz-mb-2">@L["InstalledServices"] (@OtherInstalled.Count())</RadzenText>
            @if (!OtherInstalled.Any())
            {
                <EmptyState Icon="build" Title="@L["NoServicesToDisplay"]" />
            }
            else
            {
                <ManageableServiceGrid Services="@OtherInstalled" Installed="true" ShowModuleLink="false"
                    CanManagePackages="@CanManagePackages" BusyService="@_busyService" ServerOnline="@ServerOnline"
                    OnStart="@(n => ExecuteActionAsync(ServiceAction.Start, n))"
                    OnStop="@(n => ConfirmAndExecuteAsync(ServiceAction.Stop, n))"
                    OnRestart="@(n => ConfirmAndExecuteAsync(ServiceAction.Restart, n))"
                    OnLogs="@ViewServiceLogsAsync" OnUninstall="@UninstallServiceAsync" OnBulk="@BulkActionAsync" />
            }

            <RadzenText TextStyle="TextStyle.H5" class="rz-mt-6 rz-mb-2">@L["AvailableServices"] (@OtherNotInstalled.Count())</RadzenText>
            @if (!OtherNotInstalled.Any())
            {
                <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" AllowClose="false">
                    @L["AllServicesInstalled"]
                </RadzenAlert>
            }
            else
            {
                <ManageableServiceGrid Services="@OtherNotInstalled" Installed="false"
                    CanManagePackages="@CanManagePackages" CanInstallTeamspeak="@Server.TeamspeakSetupAvailable" BusyService="@_busyService" ServerOnline="@ServerOnline"
                    OnInstall="@InstallServiceAsync" OnBulk="@BulkActionAsync" />
            }
        </RadzenTabsItem>

        <RadzenTabsItem Text="@($"{L["System"]} ({SystemCount})")" Icon="settings">
            @if (!SystemServices.Any())
            {
                <EmptyState Icon="build" Title="@L["NoServicesToDisplay"]" />
            }
            else
            {
                <RadzenDataGrid Responsive="false" Data="@SystemServices" TItem="ServiceInfoDto" Density="Density.Compact"
                    AllowAlternatingRows="true"
                    AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced"
                    AllowPaging="@(!AetheusGrid.Virtualization)" PageSize="25" PagerHorizontalAlign="HorizontalAlign.Center" AllowColumnResize="true" AllowVirtualization="@AetheusGrid.Virtualization" VirtualizationOverscanCount="3">
                    <Columns>
                        <RadzenDataGridColumn TItem="ServiceInfoDto" Property="Name" Title="@L["Service"]" />
                        <RadzenDataGridColumn TItem="ServiceInfoDto" Title="@L["Type"]" Width="120px">
                            <Template Context="svc">
                                <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@FormatType(svc.Type)" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ServiceInfoDto" Property="Status" Title="@L["Status"]" Width="120px" />
                        <RadzenDataGridColumn TItem="ServiceInfoDto" Title="@L["Running"]" Width="100px">
                            <Template Context="svc">
                                <RadzenBadge BadgeStyle="@(svc.IsRunning ? BadgeStyle.Success : BadgeStyle.Danger)"
                                    Text="@(svc.IsRunning ? L["Yes"] : L["No"])" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </RadzenTabsItem>
    </Tabs>
</UrlSyncedTabs>

@if (_logsVisible)
{
    <RadzenCard class="rz-mt-4">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" class="rz-mb-2" Gap="0.5rem">
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">@L["Logs"] - @_logsServiceName</RadzenText>
            <div class="flex-spacer"></div>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-m-0">@L["LogLines"]</RadzenText>
            <RadzenDropDown TValue="int" Value="@_logLines" Data="@LineOptions" Change="@(v => OnLogLinesChanged((int)v))"
                class="log-lines-select" />
            <LabeledToggle Kind="ToggleKind.Switch" TextFirst="true" Value="_logFollow"
                ValueChanged="@(v => OnFollowChangedAsync(v))" Text="@L["FollowLogs"]" Class="rz-color-secondary" />
            <RadzenButton Icon="refresh" Size="ButtonSize.Small" Click="@RefreshLogsAsync" title="@L["Refresh"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
            <RadzenButton Icon="close" Size="ButtonSize.Small" Click="@CloseLogsAsync" Title="@L["Close"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        </RadzenStack>
        @if (_logsLoading && string.IsNullOrEmpty(_logsContent))
        {
            <AetheusLoader Size="AetheusLoaderSize.Small" />
        }
        else
        {
            @if (HasInsufficientJournalPermissions)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" AllowClose="false" class="rz-mb-2">
                    @L["JournalPermissionInsufficient"]
                </RadzenAlert>
            }
            <pre class="docker-logs">@(string.IsNullOrWhiteSpace(_logsContent) ? L["NoLogsAvailable"].ToString() : _logsContent)</pre>
            @if (_logFollow)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mt-2">
                    <AetheusLoader Size="AetheusLoaderSize.ExtraSmall" Centered="false" />
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-m-0">@L["FollowingLogs"]</RadzenText>
                </RadzenStack>
            }
        }
    </RadzenCard>
}
