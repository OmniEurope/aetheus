<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenIcon Icon="system_security_update" />
            <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@L["PatchTitle"]</RadzenText>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton Text="@L["PatchCheck"]" Icon="search" Size="ButtonSize.Small" Busy="@_busy" Click="@CheckAsync" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
            <RadzenButton Text="@L["PatchApply"]" Icon="system_update_alt" Size="ButtonSize.Small"
                Busy="@_busy" Disabled="@(!CanApply)" Click="@ApplyAsync" ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
        </RadzenStack>
    </RadzenStack>

    @if (_loading)
    {
        <AetheusLoader Size="AetheusLoaderSize.Small" />
    }
    else if (_status is null || !_status.PackageManagerPresent)
    {
        <EmptyState Icon="help" Title="@L["PatchNotApplicableTitle"]" Description="@L["PatchNotApplicableDescription"]" />
    }
    else if (!_status.Known)
    {
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenIcon Icon="help" />
                <RadzenText>@L["PatchUnknown"]</RadzenText>
            </RadzenStack>
        </RadzenCard>
    }
    else
    {
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
            <RadzenBadge BadgeStyle="@(_status.PendingTotal > 0 ? BadgeStyle.Warning : BadgeStyle.Success)"
                Text="@string.Format(L["PatchPendingCount"], _status.PendingTotal)" />
            <RadzenBadge BadgeStyle="@SecurityBadgeStyle"
                Text="@string.Format(L["PatchSecurityCount"], _status.PendingSecurity)" />
            @if (_status.CheckedAt is not null)
            {
                <RadzenText TextStyle="TextStyle.Caption">@string.Format(L["PatchCheckedAt"], _status.CheckedAt.Value.ToString("g"))</RadzenText>
            }
        </RadzenStack>

        @if (!CanApply)
        {
            <RadzenText TextStyle="TextStyle.Caption">@L["PatchApplyDisabledHint"]</RadzenText>
        }

        @if (_status.Updates.Count > 0)
        {
            <RadzenDataGrid Responsive="false" Data="@_status.Updates" TItem="PendingUpdateDto" AllowSorting="true" Density="Density.Compact" PageSize="15" AllowPaging="@(!AetheusGrid.Virtualization)" AllowFiltering="true" FilterMode="FilterMode.Advanced" AllowColumnResize="true" AllowVirtualization="@AetheusGrid.Virtualization" VirtualizationOverscanCount="3">
                <Columns>
                    <RadzenDataGridColumn TItem="PendingUpdateDto" Property="Package" Title="@L["PatchPackage"]" />
                    <RadzenDataGridColumn TItem="PendingUpdateDto" Property="CurrentVersion" Title="@L["PatchCurrentVersion"]" Width="200px" />
                    <RadzenDataGridColumn TItem="PendingUpdateDto" Property="CandidateVersion" Title="@L["PatchCandidateVersion"]" Width="200px" />
                    <RadzenDataGridColumn TItem="PendingUpdateDto" Property="IsSecurity" Title="@L["PatchSecurity"]" Width="120px">
                        <Template Context="u">
                            @if (u.IsSecurity)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="@L["PatchSecurityYes"]" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    }
</RadzenStack>
