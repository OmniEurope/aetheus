<RadzenTemplateForm TItem="DockerPruneDialogModel" Data="@_model" Submit="@Submit">
    <LocalizedDataAnnotationsValidator />
    <RadzenStack Gap="0.75rem">
        <LabeledToggle Value="@SelectAll" ValueChanged="@SetAll" Text="@L["DockerPruneSelectAll"]" />
        <LabeledToggle @bind-Value="_model.Containers" Icon="inventory_2" Text="@L["DockerPruneStoppedContainers"]" />
        <LabeledToggle @bind-Value="_model.Images" Icon="photo_library" Text="@L["DockerPruneUnusedImages"]" />
        <LabeledToggle @bind-Value="_model.Volumes" Icon="storage" Text="@L["DockerPruneUnusedVolumes"]" />
        <RadzenText TextStyle="TextStyle.Caption" class="prune-summary">@string.Format(L["PruneSummary"], SelectedCount)</RadzenText>
    </RadzenStack>
    <DialogFooter><Aetheus.Front.Shared.DialogCloseButton Text="@L["Cancel"]" /><RadzenButton ButtonType="ButtonType.Submit" Text="@L["DockerPrune"]" Icon="cleaning_services" Disabled="@(SelectedCount == 0)" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" /></DialogFooter>
</RadzenTemplateForm>
