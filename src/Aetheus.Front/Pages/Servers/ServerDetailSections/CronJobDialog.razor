<RadzenTemplateForm TItem="CronForm" Data="@_form" Submit="@Save">
    <LocalizedDataAnnotationsValidator />
    <RadzenStack Gap="0.5rem">
        <RadzenFormField Text="@L["User"]">
            <RadzenTextBox @bind-Value="_form.User" Name="User" Placeholder="deploy" MaxLength="64" />
            <ValidationMessage For="@(() => _form.User)" />
        </RadzenFormField>
        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@L["CronNonRootHint"]</RadzenText>
        <RadzenFormField Text="@L["Schedule"]">
            <RadzenTextBox @bind-Value="_form.Schedule" @bind-Value:event="oninput" Name="Schedule" Placeholder="*/5 * * * *" MaxLength="100" />
            <ValidationMessage For="@(() => _form.Schedule)" />
        </RadzenFormField>
        @{
            var v = ScheduleValidation;
        }
        @if (!string.IsNullOrWhiteSpace(_form.Schedule))
        {
            @if (v.IsValid)
            {
                <RadzenText TextStyle="TextStyle.Caption" class="cron-next-run">
                    @L["NextRun"]: @v.NextRun
                </RadzenText>
            }
            else if (!string.IsNullOrEmpty(v.Error))
            {
                <RadzenText TextStyle="TextStyle.Caption" class="cron-error">
                    @v.Error
                </RadzenText>
            }
        }
        <RadzenFormField Text="@L["Command"]">
            <RadzenTextBox @bind-Value="_form.Command" Name="Command" Placeholder="/usr/bin/backup.sh" MaxLength="1000" />
            <ValidationMessage For="@(() => _form.Command)" />
        </RadzenFormField>
        <Aetheus.Front.Shared.DialogFooter OnCancel="@Cancel">
            <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Save"]" Icon="save" Disabled="@(!ScheduleValidation.IsValid)" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        </Aetheus.Front.Shared.DialogFooter>
    </RadzenStack>
</RadzenTemplateForm>
