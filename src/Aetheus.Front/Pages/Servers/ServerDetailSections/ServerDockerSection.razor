<RadzenText TextStyle="TextStyle.H5" class="rz-mb-4">@L["Docker"]</RadzenText>
<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" class="rz-mb-3" Gap="0.5rem">
    <div class="blade-content-spacer"></div>
    <RadzenButton Icon="cleaning_services" Text="@L["DockerPrune"]" Size="ButtonSize.Small"
        Click="@OpenPruneDialogAsync" IsBusy="@_pruning"
        class="@(_pruning ? "prune-spinning" : "")" ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
    <LabeledToggle Kind="ToggleKind.Switch" TextFirst="true" Value="_dockerAutoRefresh"
        ValueChanged="@(v => { _dockerAutoRefresh = v; OnAutoRefreshChanged(v); })" Text="@L["DockerAutoRefresh"]" />
    <RadzenButton Icon="refresh" Click="@RefreshDockerAsync"
        IsBusy="@_dockerRefreshing" Size="ButtonSize.Small" Title="@L["Refresh"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
</RadzenStack>

@* TabRenderMode.Client keeps every tab alive: switching tabs must not destroy an open shell or a
   half-edited compose file, and a SignalR result arriving on an inactive tab must still land. *@
<UrlSyncedTabs RenderMode="TabRenderMode.Client" Slugs="@(new[] { "containers", "images", "compose", "networks", "volumes", "relations" })">
    <Tabs>
        <RadzenTabsItem Text="@L["Containers"]">
            @* Four SignalR channels (inspect, exec, env, ls) come back through the parent, hence the @ref. *@
            <DockerContainersTab @ref="_containersTab" @key="ServerId" Server="@Server" ServerId="@ServerId"
                InitialLoaded="@_dockerInitialLoaded" />
        </RadzenTabsItem>

        <RadzenTabsItem Text="@L["DockerImages"]">
            <DockerImagesTab @key="ServerId" ServerId="@ServerId" Images="@Server.Docker.Images" />
        </RadzenTabsItem>

        <RadzenTabsItem Text="@L["DockerCompose"]">
            @* The compose file arrives over SignalR on the parent's connection, hence the @ref. *@
            <DockerComposeTab @ref="_composeTab" @key="ServerId" ServerId="@ServerId" Stacks="@Server.Docker.ComposeStacks" />
        </RadzenTabsItem>

        <RadzenTabsItem Text="@L["DockerNetworks"]">
            <DockerNetworksTab @key="ServerId" Networks="@Server.Docker.Networks" />
        </RadzenTabsItem>

        <RadzenTabsItem Text="@L["DockerVolumes"]">
            @* Extracted: the tab owns its own filter state, the parent owns the inventory.
               @key on ServerId so switching server resets that state instead of leaking it. *@
            <DockerVolumesTab @key="ServerId" Volumes="@Server.Docker.Volumes" />
        </RadzenTabsItem>

        @* --- Relations tab --- *@
        <RadzenTabsItem Text="@L["Relations"]">
            <DockerRelationsGraph Docker="@Server.Docker" />
        </RadzenTabsItem>
    </Tabs>
</UrlSyncedTabs>
