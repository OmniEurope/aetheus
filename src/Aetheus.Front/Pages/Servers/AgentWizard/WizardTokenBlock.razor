@* Token display block with masked content + copy button. *@
<div class="wizard-token-code wizard-code-block">
    <div class="wizard-code-header">
        <span class="wizard-code-header-label"></span>
        <RadzenButton Icon="content_copy"
                      Size="ButtonSize.ExtraSmall"
                      class="wizard-copy-btn"
                      Click="@CopyAsync"
                      Title="@L["Copy"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
    </div>
    <pre class="wizard-pre wizard-token-pre"><code class="@(IsPlaceholder ? "wizard-token-placeholder" : "")">@MaskedToken</code></pre>
</div>
