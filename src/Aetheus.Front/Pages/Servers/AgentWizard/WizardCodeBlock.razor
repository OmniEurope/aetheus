@* Reusable copy-able code line/block used inside the AddAgent wizard install steps. *@
<div class="@OuterClass">
    <div class="wizard-code-header">
        <span class="wizard-code-header-label">@Label</span>
        <RadzenButton Icon="content_copy"
                      Size="ButtonSize.ExtraSmall"
                      class="wizard-copy-btn"
                      Click="@CopyAsync"
                      Title="@L["Copy"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
    </div>
    <pre class="@PreClass"><code>@Code</code></pre>
</div>
