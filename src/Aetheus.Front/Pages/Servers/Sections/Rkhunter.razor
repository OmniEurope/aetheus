@inherits ServerTaskAwareSectionBase
@page "/servers/{Id:int}/rkhunter"
@layout Aetheus.Front.Layout.ServerDetailLayout
@implements IDisposable
@inject Microsoft.Extensions.Localization.IStringLocalizer<Aetheus.Front.Resources.AppStrings> L

<PageTitle>@(Loader?.Server?.Name ?? L["Server"]) - RKHunter - Aetheus</PageTitle>

@if (Loader?.Server is not null)
{
    <Aetheus.Front.Pages.Servers.ServerDetailSections.ServerRkhunterSection
        @ref="_section"
        ServerId="@Id"
        Rk="@Loader.Server.Rkhunter"
        OnRefreshRequested="StateHasChanged" />
}
