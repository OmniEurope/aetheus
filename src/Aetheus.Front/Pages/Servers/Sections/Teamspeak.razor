@inherits ServerTaskAwareSectionBase
@page "/servers/{Id:int}/teamspeak"
@layout Aetheus.Front.Layout.ServerDetailLayout
@implements IDisposable
@inject Microsoft.Extensions.Localization.IStringLocalizer<Aetheus.Front.Resources.AppStrings> L

<PageTitle>@(Loader?.Server?.Name ?? L["Server"]) - TeamSpeak - Aetheus</PageTitle>

@if (Loader?.Server is not null)
{
    <Aetheus.Front.Pages.Servers.ServerDetailSections.ServerTeamspeakSection
        @ref="_section" Server="@Loader.Server" ServerId="@Id" />
}
