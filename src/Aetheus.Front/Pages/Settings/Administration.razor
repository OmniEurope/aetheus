@page "/admin"

<PageTitle>@L["Administration"] - Aetheus</PageTitle>

<Aetheus.Front.Shared.PageHeader Title="@L["Administration"]" Icon="admin_panel_settings" />

<RadzenRow Gap="1rem">
    <RadzenColumn Size="6" SizeMD="4" SizeLG="3">
        <a href="/admin/users" class="admin-tile-link">
            <RadzenCard class="admin-tile-card tile-primary">
                <RadzenIcon Icon="group" class="admin-tile-icon color-primary" />
                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mt-2">@L["Users"]</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@L["UserManagement"]</RadzenText>
            </RadzenCard>
        </a>
    </RadzenColumn>
    <RadzenColumn Size="6" SizeMD="4" SizeLG="3">
        <a href="/admin/organizations" class="admin-tile-link">
            <RadzenCard class="admin-tile-card tile-primary">
                <RadzenIcon Icon="apartment" class="admin-tile-icon color-primary" />
                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mt-2">@L["Organizations"]</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@L["OrganizationManagement"]</RadzenText>
            </RadzenCard>
        </a>
    </RadzenColumn>
    <RadzenColumn Size="6" SizeMD="4" SizeLG="3">
        <a href="/admin/roles" class="admin-tile-link">
            <RadzenCard class="admin-tile-card tile-primary">
                <RadzenIcon Icon="admin_panel_settings" class="admin-tile-icon color-primary" />
                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mt-2">@L["Roles"]</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@L["RBACManagement"]</RadzenText>
            </RadzenCard>
        </a>
    </RadzenColumn>
    <RadzenColumn Size="6" SizeMD="4" SizeLG="3">
        <a href="/admin/audit" class="admin-tile-link">
            <RadzenCard class="admin-tile-card tile-info">
                <RadzenIcon Icon="policy" class="admin-tile-icon color-info" />
                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mt-2">@L["AuditLogs"]</RadzenText>
            </RadzenCard>
        </a>
    </RadzenColumn>
    <RadzenColumn Size="6" SizeMD="4" SizeLG="3">
        <a href="/admin/ai-profiles" class="admin-tile-link">
            <RadzenCard class="admin-tile-card tile-info">
                <RadzenIcon Icon="smart_toy" class="admin-tile-icon color-info" />
                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mt-2">@L["AiRunnerProfiles"]</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@L["AiRunnerProfilesDescription"]</RadzenText>
            </RadzenCard>
        </a>
    </RadzenColumn>
    <RadzenColumn Size="6" SizeMD="4" SizeLG="3">
        <a href="/admin/plugins" class="admin-tile-link">
            <RadzenCard class="admin-tile-card tile-success">
                <RadzenIcon Icon="extension" class="admin-tile-icon color-success" />
                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mt-2">@L["Plugins"]</RadzenText>
            </RadzenCard>
        </a>
    </RadzenColumn>
    <RadzenColumn Size="6" SizeMD="4" SizeLG="3">
        <a href="/admin/dashboards" class="admin-tile-link">
            <RadzenCard class="admin-tile-card tile-warning">
                <RadzenIcon Icon="space_dashboard" class="admin-tile-icon color-warning" />
                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mt-2">@L["Dashboards"]</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@L["ManageDashboards"]</RadzenText>
            </RadzenCard>
        </a>
    </RadzenColumn>
    <RadzenColumn Size="6" SizeMD="4" SizeLG="3">
        <a href="/admin/settings" class="admin-tile-link">
            <RadzenCard class="admin-tile-card tile-secondary">
                <RadzenIcon Icon="tune" class="admin-tile-icon color-secondary" />
                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mt-2">@L["PlatformSettings"]</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@L["SecurityTokens"]</RadzenText>
            </RadzenCard>
        </a>
    </RadzenColumn>
    <RadzenColumn Size="6" SizeMD="4" SizeLG="3">
        <a href="/admin/system-logs" class="admin-tile-link">
            <RadzenCard class="admin-tile-card tile-danger">
                <RadzenIcon Icon="article" class="admin-tile-icon color-danger" />
                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mt-2">@L["SystemLogs"]</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@L["SystemLogsDescription"]</RadzenText>
            </RadzenCard>
        </a>
    </RadzenColumn>
</RadzenRow>
