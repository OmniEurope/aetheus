@page "/admin/settings"

<PageTitle>@L["PlatformSettings"] - Aetheus</PageTitle>

<Aetheus.Front.Shared.PageHeader Title="@L["PlatformSettings"]" Icon="tune" BackHref="/admin" />

<UrlSyncedTabs Slugs="@(new[] { "general", "quality-gates", "secrets", "tokens" })">
    <Tabs>
        <RadzenTabsItem Text="@L["General"]">
            <RadzenCard class="rz-mt-2">
                @foreach (var setting in _settings)
                {
                    <RadzenRow class="rz-mb-2" AlignItems="AlignItems.Center">
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenText TextStyle="TextStyle.Body1">@L[setting.Key]</RadzenText>
                        </RadzenColumn>
                        <RadzenColumn Size="8" SizeMD="6">
                            <RadzenTextBox @bind-Value="_editBuffer[setting.Key]"
                                class="rz-w-100" />
                        </RadzenColumn>
                        <RadzenColumn Size="4" SizeMD="2">
                            <RadzenButton Text="@L["Save"]" Icon="save" Size="ButtonSize.Small" IsBusy="@_savingKeys.Contains(setting.Key)" Disabled="@_savingKeys.Contains(setting.Key)"
                                Click="@(() => SaveSetting(setting.Key))" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                        </RadzenColumn>
                    </RadzenRow>
                }
            </RadzenCard>
        </RadzenTabsItem>

        <RadzenTabsItem Text="@L["QualityGates"]" Icon="rule">
            <QualityGatePolicyEditor Scope="AnalysisPolicyScope.Global" CanEdit="true" />
        </RadzenTabsItem>

        <RadzenTabsItem Text="@L["Secrets"]">
            <RadzenCard class="rz-mt-2">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mb-4" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
                    <RadzenFormField Text="@L["Key"]">
                        <RadzenTextBox @bind-Value="_newSecretKey" />
                    </RadzenFormField>
                    <RadzenFormField Text="@L["Value"]">
                        <RadzenPassword @bind-Value="_newSecretValue" />
                    </RadzenFormField>
                    <RadzenButton Text="@L["Add"]" Icon="add" Click="@AddSecret" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                </RadzenStack>

                <RadzenDataGrid Responsive="false" Data="@_secrets" TItem="SecretDto" Density="Density.Compact" EmptyText="@L["NoRecords"]" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced" AllowColumnResize="true" AllowVirtualization="@AetheusGrid.Virtualization" VirtualizationOverscanCount="3" AllowPaging="@(!AetheusGrid.Virtualization)">
                    <Columns>
                        <RadzenDataGridColumn Property="Key" Title="@L["Key"]" />
                        <RadzenDataGridColumn Title="@L["Value"]" Width="200px">
                            <Template Context="secret">
                                <RadzenText TextStyle="TextStyle.Body2">--------</RadzenText>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="UpdatedAt" Title="@L["Updated"]" FormatString="{0:g}" Width="160px" />
                        <RadzenDataGridColumn Title="" Width="100px" Sortable="false">
                            <Template Context="secret">
                                <RadzenButton Icon="delete" Size="ButtonSize.Small" Click="@(() => DeleteSecret(secret.Id))"
                                    title="@L["DeleteSecret"]" aria-label="@L["DeleteSecret"]" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenCard>
        </RadzenTabsItem>

        <RadzenTabsItem Text="@L["RegistrationTokens"]">
            <RadzenCard class="rz-mt-2">
                <RadzenButton Text="@L["GenerateToken"]" Icon="add" class="rz-mb-4" Click="@GenerateToken" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />

                <RadzenDataGrid Responsive="false" Data="@_tokens" TItem="RegistrationTokenDto" Density="Density.Compact" EmptyText="@L["NoRecords"]" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced" class="aetheus-grid-fullheight" AllowColumnResize="true" AllowVirtualization="@AetheusGrid.Virtualization" VirtualizationOverscanCount="3" AllowPaging="@(!AetheusGrid.Virtualization)">
                    <Columns>
                        <RadzenDataGridColumn Property="Token" Title="@L["Token"]">
                            <Template Context="t">
                                @if (_revealedTokens.Contains(t.Id))
                                {
                                    <code class="token-code">@t.Token</code>
                                }
                                else
                                {
                                    <code class="token-code">----------------</code>
                                }
                                <RadzenButton Icon="@(_revealedTokens.Contains(t.Id) ? "visibility_off" : "visibility")"
                                    Size="ButtonSize.ExtraSmall" Variant="Variant.Text"
                                    Click="@(() => ToggleTokenReveal(t.Id))"
                                    title="@(_revealedTokens.Contains(t.Id) ? L["HideToken"].Value : L["ShowToken"].Value)"
                                    aria-label="@(_revealedTokens.Contains(t.Id) ? L["HideToken"].Value : L["ShowToken"].Value)" />
                                <RadzenButton Icon="content_copy" Size="ButtonSize.ExtraSmall" Click="@(() => CopyToken(t.Token))"
                                    title="@L["CopyToken"]" aria-label="@L["CopyToken"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="IsUsed" Title="@L["Used"]" Width="120px">
                            <Template Context="t">
                                <RadzenBadge BadgeStyle="@(t.IsUsed ? BadgeStyle.Light : BadgeStyle.Success)"
                                    Text="@(t.IsUsed ? L["Used"].Value : L["Available"].Value)" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="ExpiresAt" Title="@L["Expires"]" FormatString="{0:g}" Width="160px" />
                    </Columns>
                </RadzenDataGrid>
            </RadzenCard>
        </RadzenTabsItem>
    </Tabs>
</UrlSyncedTabs>
