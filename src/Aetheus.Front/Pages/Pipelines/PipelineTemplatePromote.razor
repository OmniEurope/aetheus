@inherits PipelineTemplatePromotionBase
@page "/pipelines/{PipelineId:int}/template/promote"

<PageTitle>@L["PromoteToTemplate"] - Aetheus</PageTitle>

<PageHeader Title="@L["PromoteToTemplate"]" Icon="publish" BackHref="@($"/pipelines/{PipelineId}")" />

@if (_loading)
{
    <AetheusLoader />
}
else if (_loadFailed || _preview is null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
        @L["LoadError"]
        <RadzenButton Text="@L["Retry"]" Icon="refresh" Click="@LoadPreviewAsync"
            ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
    </RadzenAlert>
}
else
{
    <EditForm Model="@_model" OnValidSubmit="@SubmitAsync">
        <LocalizedDataAnnotationsValidator />
        <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-3">@string.Format(L["PromoteTemplateVersion"], _preview.TemplateName, _preview.LatestVersion + 1)</RadzenText>
        <MonacoDiffViewer OriginalValue="@_preview.LatestTemplateYaml" ModifiedValue="@_preview.EffectivePipelineYaml" />
        <RadzenFormField Text="@L["ChangelogEntry"]" class="rz-w-100 rz-mt-3">
            <RadzenTextBox @bind-Value="_model.ChangelogEntry" class="rz-w-100" />
        </RadzenFormField>
        <ValidationMessage For="@(() => _model.ChangelogEntry)" />
        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mt-3 rz-mb-2">@L["NewTemplateYaml"]</RadzenText>
        <MonacoEditor Value="@_model.YamlContent" ValueChanged="@(value => _model.YamlContent = value)" />
        <LabeledToggle @bind-Value="_model.RebaseSourcePipeline" Text="@L["RebaseSourcePipeline"]" Class="rz-mt-3" />
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-mt-4">
            <RadzenButton Text="@L["Cancel"]" Icon="close" Click="@Cancel" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
            <RadzenButton Text="@L["PublishVersion"]" Icon="publish" ButtonType="ButtonType.Submit"
                IsBusy="@_saving" Disabled="@_saving" ButtonStyle="ButtonStyle.Success" Variant="Variant.Filled" />
        </RadzenStack>
    </EditForm>
}
