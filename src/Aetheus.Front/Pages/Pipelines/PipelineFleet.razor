<PageTitle>@L["PipelineFleet"] - Aetheus</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
        <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">@L["PipelineFleet"]</RadzenText>
        <div class="server-list-spacer"></div>
        <RadzenTextBox Value="@_search" ValueChanged="OnSearchChanged" Placeholder="@L["SearchPipelines"]" />
        <RadzenDropDown TValue="int?" Data="@_templates" TextProperty="Name" ValueProperty="Id"
                        Value="@_templateId" ValueChanged="OnTemplateChanged"
                        Placeholder="@L["AllTemplates"]" AllowClear="true" />
        <RadzenDropDown TValue="int?" Data="@_projects" TextProperty="Name" ValueProperty="Id"
                        Value="@_projectId" ValueChanged="OnProjectChanged"
                        Placeholder="@L["AllProjects"]" AllowClear="true" />
        <RadzenDropDown TValue="PipelineFleetFreshness?" Data="@_freshnessOptions"
                        TextProperty="Text" ValueProperty="Value" Value="@_freshness"
                        ValueChanged="OnFreshnessChanged" Placeholder="@L["AllStatuses"]" AllowClear="true" />
        <RadzenButton Text="@L["Refresh"]" Icon="refresh" Click="@ReloadAsync"
                      ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
    </RadzenStack>

    @if (_filtersLoadError)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@L["FiltersLoadError"]</RadzenAlert>
    }

    @if (_gridLoadError)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@L["LoadError"]</RadzenAlert>
    }

    <RadzenDataGrid Responsive="false" @ref="_grid" Data="@_items" TItem="PipelineFleetItemDto" Count="@_totalCount"
                    LoadData="@LoadDataAsync" IsLoading="@_loading" AllowPaging="@(!AetheusGrid.Virtualization)" PageSize="25"
                    AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced"
                    Density="Density.Compact" EmptyText="@L["NoRecords"]" AllowColumnResize="true" AllowVirtualization="@AetheusGrid.Virtualization" VirtualizationOverscanCount="3">
        <Columns>
            <RadzenDataGridColumn TItem="PipelineFleetItemDto" Property="PipelineName" Title="@L["Pipeline"]" MinWidth="14rem">
                <Template Context="item">
                    <RadzenLink Path="@($"pipelines/{item.PipelineId}")" Text="@item.PipelineName" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineFleetItemDto" Property="OwnerName" Title="@L["Owner"]" MinWidth="12rem" />
            <RadzenDataGridColumn TItem="PipelineFleetItemDto" Property="TemplateName" Title="@L["Template"]" MinWidth="12rem" />
            <RadzenDataGridColumn TItem="PipelineFleetItemDto" Property="PinnedVersion" Title="@L["PinnedVersion"]" Width="8rem" TextAlign="TextAlign.Center">
                <Template Context="item">@(item.PinnedVersion is null ? (item.UsesLegacyReference ? L["LegacyLatest"] : "-") : $"v{item.PinnedVersion}")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineFleetItemDto" Property="LatestVersion" Title="@L["LatestVersion"]" Width="8rem" TextAlign="TextAlign.Center">
                <Template Context="item">@(item.LatestVersion is null ? "-" : $"v{item.LatestVersion}")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineFleetItemDto" Property="Freshness" Title="@L["Status"]" Width="10rem">
                <Template Context="item">
                    <RadzenBadge Text="@FreshnessText(item.Freshness)" BadgeStyle="@FreshnessStyle(item.Freshness)" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineFleetItemDto" Title="@L["Actions"]" Width="11rem" Sortable="false">
                <Template Context="item">
                    @if (item.Freshness == PipelineFleetFreshness.Outdated && item.LatestVersion is not null && CanUpdate(item))
                    {
                        <RadzenButton Text="@L["Update"]" Icon="system_update_alt" Size="ButtonSize.Small"
                                      Click="@(() => OpenUpdateAsync(item))" ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenStack>
