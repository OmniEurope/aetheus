<EditForm Model="@_model" OnValidSubmit="@SubmitAsync">
    <LocalizedDataAnnotationsValidator />
    <RadzenStack Gap="1rem">
        <RadzenFormField Text="@L["Name"]">
            <RadzenTextBox @bind-Value="_model.TemplateName" />
        </RadzenFormField>
        <ValidationMessage For="@(() => _model.TemplateName)" />
        <RadzenFormField Text="@L["Category"]">
            <RadzenTextBox @bind-Value="_model.Category" />
        </RadzenFormField>
        <RadzenFormField Text="@L["Description"]">
            <RadzenTextArea @bind-Value="_model.Description" Rows="3" />
        </RadzenFormField>
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">@L["ExtractionParametersHelp"]</RadzenAlert>
        <RadzenText TextStyle="TextStyle.Subtitle2">@L["NewTemplateYaml"]</RadzenText>
        <MonacoEditor Value="@_model.TemplateYamlContent" ValueChanged="@(value => _model.TemplateYamlContent = value)" />
        <ValidationMessage For="@(() => _model.TemplateYamlContent)" />
        <LabeledToggle @bind-Value="_model.RewritePipeline" Text="@L["RewritePipelineToPin"]" />
        @if (_model.RewritePipeline)
        {
            <RadzenText TextStyle="TextStyle.Subtitle2">@L["RewrittenPipelineYaml"]</RadzenText>
            <MonacoEditor Value="@_model.RewrittenPipelineYaml" ValueChanged="@(value => _model.RewrittenPipelineYaml = value)" />
        }
        <DialogFooter OnCancel="@Cancel">
            <RadzenButton Text="@L["Extract"]" Icon="add_circle" ButtonType="ButtonType.Submit"
                          IsBusy="@_saving" Disabled="@_saving"
                          ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        </DialogFooter>
    </RadzenStack>
</EditForm>
