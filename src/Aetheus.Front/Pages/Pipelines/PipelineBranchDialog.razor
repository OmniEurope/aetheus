@using Aetheus.Front.Shared
@using Aetheus.Shared.DTOs

<RadzenStack Gap="1rem" class="pipeline-branch-dialog">
    <div class="pipeline-branch-dialog-intro">
        <span class="pipeline-branch-dialog-icon" aria-hidden="true">
            <RadzenIcon Icon="account_tree" />
        </span>
        <RadzenStack Gap="0.15rem">
            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0">@L["RunFromBranch"]</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="pipeline-branch-dialog-hint rz-m-0">@L["BranchListRefreshedHint"]</RadzenText>
        </RadzenStack>
    </div>

    <RadzenFormField Text="@L["SourceBranch"]" Variant="Variant.Outlined" class="rz-w-100">
        <RadzenDropDown TValue="string" Data="@Branches" TextProperty="Name" ValueProperty="Name"
            @bind-Value="_branch" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
            class="rz-w-100 pipeline-branch-dropdown">
            <Template Context="item">
                @{ var branch = (GitLightBranchDto)item; }
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="pipeline-branch-option">
                    <RadzenIcon Icon="account_tree" class="rz-color-secondary" />
                    <RadzenText class="rz-m-0 pipeline-branch-name">@branch.Name</RadzenText>
                    @if (branch.IsDefault)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@L["Default"]" />
                    }
                </RadzenStack>
            </Template>
        </RadzenDropDown>
    </RadzenFormField>

    <DialogFooter OnCancel="Cancel">
        <RadzenButton Text="@L["Run"]" Icon="play_arrow" Click="Confirm" Disabled="@string.IsNullOrWhiteSpace(_branch)"
            ButtonStyle="ButtonStyle.Success" Variant="Variant.Filled" />
    </DialogFooter>
</RadzenStack>
