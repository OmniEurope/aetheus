@inherits PipelineTemplatePromotionBase

@if (_loading)
{
    <AetheusLoader />
}
else if (_preview is not null)
{
    <EditForm Model="@_model" OnValidSubmit="@SubmitAsync">
        <LocalizedDataAnnotationsValidator />
        <RadzenStack Gap="1rem">
            <RadzenText TextStyle="TextStyle.Subtitle1">@string.Format(L["PromoteTemplateVersion"], _preview.TemplateName, _preview.LatestVersion + 1)</RadzenText>
            <MonacoDiffViewer OriginalValue="@_preview.LatestTemplateYaml" ModifiedValue="@_preview.EffectivePipelineYaml" />
            <RadzenFormField Text="@L["ChangelogEntry"]">
                <RadzenTextBox @bind-Value="_model.ChangelogEntry" />
            </RadzenFormField>
            <ValidationMessage For="@(() => _model.ChangelogEntry)" />
            <RadzenText TextStyle="TextStyle.Subtitle2">@L["NewTemplateYaml"]</RadzenText>
            <MonacoEditor Value="@_model.YamlContent" ValueChanged="@(value => _model.YamlContent = value)" />
            <LabeledToggle @bind-Value="_model.RebaseSourcePipeline" Text="@L["RebaseSourcePipeline"]" />
            <DialogFooter OnCancel="@Cancel">
                <RadzenButton Text="@L["PublishVersion"]" Icon="publish" ButtonType="ButtonType.Submit"
                              IsBusy="@_saving" Disabled="@_saving"
                              ButtonStyle="ButtonStyle.Success" Variant="Variant.Filled" />
            </DialogFooter>
        </RadzenStack>
    </EditForm>
}
else if (_loadFailed)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@L["LoadError"]</RadzenAlert>
    <DialogFooter OnCancel="@Cancel">
        <RadzenButton Text="@L["Retry"]" Icon="refresh" Click="@LoadPreviewAsync"
                      ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
    </DialogFooter>
}
