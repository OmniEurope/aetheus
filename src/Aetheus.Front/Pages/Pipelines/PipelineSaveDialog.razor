@using Aetheus.Front.Shared

<RadzenStack Gap="1rem">
    @if (Branches.Count > 0)
    {
        <RadzenFormField Text="@L["CommitBranch"]">
            <RadzenDropDown TValue="string" Data="@Branches" @bind-Value="_branch" />
        </RadzenFormField>
    }

    <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Lighter" AllowClose="false">
        @L["PipelineSaveCommitPreview"]
    </RadzenAlert>

    <MonacoDiffViewer OriginalValue="@SavedYaml" ModifiedValue="@DraftYaml" />

    <DialogFooter OnCancel="Cancel">
        <RadzenButton Text="@L["Save"]" Icon="save" Click="Confirm" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
    </DialogFooter>
</RadzenStack>
