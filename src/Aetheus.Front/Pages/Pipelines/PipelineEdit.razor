@page "/pipelines/new"
@page "/pipelines/{Id:int}"
@using Aetheus.Front.Helpers

<PageTitle>@(_isNew ? L["NewPipeline"] : _pipeline?.Name ?? L["Pipeline"]) - Aetheus</PageTitle>

@if (_isNew || (!_loading && _pipeline is not null))
{
    <Aetheus.Front.Shared.PageHeader Title="@(_isNew ? L["NewPipeline"] : _pipeline?.Name ?? "")" Icon="account_tree" BackHref="@BackHref">
        <ChildContent>
            @if (!_isNew && _pipeline?.LastRunStatus.HasValue == true)
            {
                <RadzenBadge BadgeStyle="@PipelineRunPresentation.Badge(_pipeline.LastRunStatus!.Value)" Text="@L.Localize(_pipeline.LastRunStatus.Value)" />
            }
            @if (!_isNew && _source is not null)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Light" Icon="sync" Text="@L["GitManaged"]"
                    title="@($"{L["GitManagedHint"]} - {_source.Path}")" />
                <RadzenBadge BadgeStyle="BadgeStyle.Light" Icon="account_tree"
                    Text="@_source.Branch" title="@($"{_source.Path} @ {_source.CommitHash ?? "-"}")" />
            }
        </ChildContent>
        <Actions>
            @if (!_isNew)
            {
                <RadzenButton Icon="refresh" Size="ButtonSize.ExtraSmall"
                    Click="@OnRefresh" aria-label="@L["Refresh"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                <RadzenSplitButton Text="@L["Run"]" Icon="play_arrow" Click="@OnRunClick" Size="ButtonSize.Small" IsBusy="@_running" BusyText="@L["Run"]" ButtonStyle="ButtonStyle.Success" Variant="Variant.Filled">
                    <RadzenSplitButtonItem Text="@L["ChooseBranch"]" Value="branch" Icon="account_tree" />
                </RadzenSplitButton>
                <RadzenButton Text="@L["Edit"]" Icon="edit" Click="@(() => _selectedTab = 1)" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Info" Variant="Variant.Filled" />
                <RadzenButton Text="@L["DryRun"]" Icon="science" Click="@OnDryRun" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
                @if (_fleetItem is { Freshness: PipelineFleetFreshness.Outdated, LatestVersion: not null }
                    && Permissions.CanWrite(ResourceType.Pipeline, Id))
                {
                    <RadzenButton Text="@L["UpdatePipelineTemplate"]" Icon="system_update_alt" Click="@OnUpdateTemplate"
                                  Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
                }
                @if (_canTemplateWrite)
                {
                    @if (HasTemplateReference)
                    {
                        <RadzenButton Text="@L["PromoteToTemplate"]" Icon="publish" Click="@OnPromoteTemplate"
                                       ButtonStyle="ButtonStyle.Success" Variant="Variant.Filled" />
                    }
                    else
                    {
                        <RadzenButton Text="@L["ExtractAsTemplate"]" Icon="add_circle" Click="@OnExtractTemplate"
                                       ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                    }
                }
                <RadzenButton Text="@L["Delete"]" Icon="delete" Click="@OnDelete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
            }
        </Actions>
    </Aetheus.Front.Shared.PageHeader>

    @if (HasLegacyTemplateReference)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter">
            @L["LegacyTemplateReferenceWarning"]
            <RadzenButton Text="@L["PinTemplateVersion"]" Icon="save" Click="@PinLegacyTemplateAsync"
                          ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        </RadzenAlert>
    }
}

@if (_isNew)
{
    @* New pipeline: show edit form directly *@
    <div class="rz-mt-4">
        <RadzenTemplateForm TItem="PipelineModel" Data="@_model" Submit="@OnSubmit">
            <LocalizedDataAnnotationsValidator />
            <RadzenRow Gap="1rem" class="rz-mt-2">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Gap="1rem">
                        <RadzenFormField Text="@L["Name"]">
                            <RadzenTextBox @bind-Value="_model.Name" @oninput="@(e => _model.Name = e.Value?.ToString() ?? string.Empty)" Name="Name" />
                            <ValidationMessage For="@(() => _model.Name)" />
                        </RadzenFormField>
                        <RadzenFormField Text="@L["Description"]">
                            <RadzenTextBox @bind-Value="_model.Description" @oninput="@(e => _model.Description = e.Value?.ToString() ?? string.Empty)" Name="Description" />
                        </RadzenFormField>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>

            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mt-4 rz-mb-1">@L["YamlDefinition"]</RadzenText>
            @if (_templates.Count > 0)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-2">
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">@L["Template"]:</RadzenText>
                    <RadzenDropDown TValue="int?" Data="@_templates" TextProperty="Name" ValueProperty="Id"
                        Placeholder="@L["SelectTemplate"]" AllowClear="true" @bind-Value="_selectedTemplateId"
                        Change="@OnTemplateSelected" class="tpl-select" />
                </RadzenStack>
            }
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" class="rz-mb-2">
                <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Create"]" Icon="add" IsBusy="@_saving" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                <RadzenButton Text="@L["ValidateYaml"]" Icon="check_circle" Click="@OnValidateYaml" IsBusy="@_validating" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
                <RadzenButton Text="@L["FormatYaml"]" Icon="format_align_left" Click="@OnFormatYaml" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
                @if (_yamlValid.HasValue)
                {
                    <RadzenBadge BadgeStyle="@(_yamlValid.Value ? BadgeStyle.Success : BadgeStyle.Danger)"
                        Text="@(_yamlValid.Value ? L["Valid"] : L["Invalid"])" />
                }
            </RadzenStack>

            <MonacoEditor @ref="_monacoEditor" Value="@_model.YamlDefinition"
                ValueChanged="@OnYamlValueChanged" DebouncedValueChanged="@OnDebouncedYamlChanged"
                OnBlur="@OnValidateYaml" OnSave="@OnSubmit" />
        </RadzenTemplateForm>
    </div>
}
else if (_loading)
{
    <RadzenProgressBarCircular ShowValue="true" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" class="rz-mt-4" />
}
else
{
    <div class="pipeline-detail-page">
    <UrlSyncedTabs Slugs="@(new[] { "runs", "edit", "visual", "settings" })" @bind-SelectedIndex="_selectedTab" class="pipeline-detail-tabs rz-mt-2">
        <Tabs>
            <RadzenTabsItem Text="@L["Runs"]" Icon="history">
                @if (_running)
                {
                    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false"
                        class="rz-mt-2" aria-label="@L["Running"]" />
                }
                @if (_runs.Count == 0)
                {
                    <RadzenText TextStyle="TextStyle.Body1" class="rz-color-secondary rz-mt-4">@L["NoRunsYet"]</RadzenText>
                }
                else
                {
                    <Aetheus.Front.Shared.AetheusDataGrid @ref="_runsGrid" TItem="PipelineRunDto"
                        Data="@_runs" Count="@_runsTotalCount" PageSize="@_runsPageSize"
                        LoadData="@OnRunsLoadDataAsync" AutoLoad="false" AllowSorting="false" AllowFiltering="false"
                        RowClick="@(run => Nav.NavigateTo(PipelineRunPresentation.Href(run.Id, ProjectId, ServerId)))" class="rz-mt-2">
                        <Columns>
                            <RadzenDataGridColumn TItem="PipelineRunDto" Property="Id" Title="#" Width="80px">
                                <Template Context="run">
                                    <NavLink href="@PipelineRunPresentation.Href(run.Id, ProjectId, ServerId)" class="pipeline-name-link" @onclick:stopPropagation="true">#@run.Id</NavLink>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="PipelineRunDto" Property="Status" Title="@L["Status"]" Width="120px">
                                <Template Context="run">
                                    <RadzenBadge BadgeStyle="@PipelineRunPresentation.Badge(run.Status)" Text="@L.Localize(run.Status)" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="PipelineRunDto" Title="@L["CurrentStep"]" Width="200px" Sortable="false" Filterable="false">
                                <Template Context="run">
                                    @{ var cur = PipelineRunPresentation.CurrentStep(run); }
                                    @if (cur is not null)
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                                            <div class="run-tl-dot run-timeline-dot-running"><span class="run-timeline-pulse"></span></div>
                                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">@cur</RadzenText>
                                        </RadzenStack>
                                    }
                                    else if (run.Status == PipelineStatus.Running)
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                                            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" Size="ProgressBarCircularSize.Small" />
                                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">@L["PreparingRun"]</RadzenText>
                                        </RadzenStack>
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="PipelineRunDto" Property="BranchName" Title="@L["SourceBranch"]" Width="150px">
                                <Template Context="run">
                                    @if (!string.IsNullOrWhiteSpace(run.BranchName))
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                            <RadzenIcon Icon="account_tree" class="rz-color-secondary" />
                                            <span>@run.BranchName</span>
                                        </RadzenStack>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="PipelineRunDto" Title="@L["Server"]" Width="160px" Sortable="false" Filterable="false">
                                <Template Context="run">
                                    @{ var runServer = run.Steps.FirstOrDefault(s => !s.IsSystem && s.ServerName is not null); }
                                    @if (runServer is not null)
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                            @if (runServer.ServerOs is not null) { <RadzenIcon Icon="@(PipelineRunPresentation.IsWindows(runServer.ServerOs) ? "desktop_windows" : "computer")" class="@(PipelineRunPresentation.IsWindows(runServer.ServerOs) ? "run-os-icon run-os-icon-windows" : "run-os-icon run-os-icon-linux")" /> }
                                            <span>@runServer.ServerName</span>
                                        </RadzenStack>
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="PipelineRunDto" Property="StartedAt" Title="@L["Started"]" FormatString="{0:g}" />
                            <RadzenDataGridColumn TItem="PipelineRunDto" Property="CompletedAt" Title="@L["Completed"]" FormatString="{0:g}" />
                            <RadzenDataGridColumn TItem="PipelineRunDto" Title="@L["Duration"]" Width="120px">
                                <Template Context="run">
                                    @PipelineRunPresentation.FormatDuration(run.StartedAt, run.CompletedAt)
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="PipelineRunDto" Title="@L["Steps"]" Width="80px" TextAlign="TextAlign.Center">
                                <Template Context="run">
                                    @run.Steps.Count
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="PipelineRunDto" Title="" Width="110px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                                <Template Context="run">
                                    <span @onclick:stopPropagation="true">
                                        @if (PipelineRunPresentation.IsFailed(run))
                                        {
                                            <RadzenButton Icon="replay" Text="@L["Rerun"]" Size="ButtonSize.ExtraSmall"
                                                Click="@OnRun" IsBusy="@_running" aria-label="@L["Rerun"]" ButtonStyle="ButtonStyle.Success" Variant="Variant.Filled" />
                                        }
                                    </span>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </Aetheus.Front.Shared.AetheusDataGrid>
                }
            </RadzenTabsItem>
            <RadzenTabsItem Text="@L["Edit"]" Icon="edit">
                @* Compact meta (name + description inline) + toolbar; the editor fills the remaining
                   viewport height so the definition uses 100% of the space with no page scrollbar. *@
                <RadzenTemplateForm TItem="PipelineModel" Data="@_model" Submit="@OnSubmit" class="pipeline-edit-form">
                    <LocalizedDataAnnotationsValidator />
                    <div class="pipeline-edit-meta">
                        <RadzenFormField Text="@L["Name"]" class="pipeline-edit-name">
                            <RadzenTextBox @bind-Value="_model.Name" @oninput="@(e => _model.Name = e.Value?.ToString() ?? string.Empty)" Name="Name" />
                            <ValidationMessage For="@(() => _model.Name)" />
                        </RadzenFormField>
                        <RadzenFormField Text="@L["Description"]" class="pipeline-edit-desc">
                            <RadzenTextBox @bind-Value="_model.Description" @oninput="@(e => _model.Description = e.Value?.ToString() ?? string.Empty)" Name="Description" />
                        </RadzenFormField>
                    </div>
                    <div class="pipeline-edit-toolbar">
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0 rz-mr-2">@L["YamlDefinition"]</RadzenText>
                        <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Save"]" Icon="save" IsBusy="@_saving" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                        <RadzenButton Text="@L["ValidateYaml"]" Icon="check_circle" Click="@OnValidateYaml" IsBusy="@_validating" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
                        <RadzenButton Text="@L["FormatYaml"]" Icon="format_align_left" Click="@OnFormatYaml" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
                        <RadzenButton Text="@(_showDiff ? L["HideDiff"] : L["ShowDiff"])" Icon="difference"
                            ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                            Click="@(() => _showDiff = !_showDiff)" Size="ButtonSize.Small" />
                        @if (_yamlValid.HasValue)
                        {
                            <RadzenBadge BadgeStyle="@(_yamlValid.Value ? BadgeStyle.Success : BadgeStyle.Danger)"
                                Text="@(_yamlValid.Value ? L["Valid"] : L["Invalid"])" />
                        }
                    </div>

                    @* Editor left; Ctrl+Click on a `pipeline: <name>` ref opens that pipeline's read-only
                       definition in the peek pane on the right (same viewer as the run YAML tab). *@
                    <div class="pipeline-edit-body">
                        <div class="pipeline-yaml-editor">
                            <MonacoEditor @ref="_monacoEditor" Value="@_model.YamlDefinition"
                                ValueChanged="@OnYamlValueChanged" DebouncedValueChanged="@OnDebouncedYamlChanged"
                                OnBlur="@OnValidateYaml" OnSave="@OnSubmit" OnPipelineRefClicked="@OnEditorPipelineRef" />
                        </div>

                        @if (_showDiff)
                        {
                            <div class="pipeline-yaml-editor">
                                <MonacoDiffViewer OriginalValue="@_savedYaml" ModifiedValue="@_model.YamlDefinition" />
                            </div>
                        }

                        @if (_peekName is not null)
                        {
                            <PipelineDefinitionPeek PipelineName="@_peekName" ProjectId="@(_pipeline?.ProjectId)"
                                OnClose="@(() => { _peekName = null; })" />
                        }
                    </div>
                </RadzenTemplateForm>
            </RadzenTabsItem>
            <RadzenTabsItem Text="@L["Visual"]" Icon="account_tree">
                <VisualPipelineEditor YamlDefinition="@_model.YamlDefinition"
                                      YamlDefinitionChanged="@OnVisualYamlChanged"
                                      BaseTemplateYaml="@_baseTemplateYaml"
                                      PipelineId="@Id"
                                      AvailableServers="@_serverNames"
                                      AvailableLibraries="@_libraryNames"
                                      AvailableVaults="@_vaultNames" />
            </RadzenTabsItem>
            <RadzenTabsItem Text="@L["Settings"]" Icon="settings">
                <RadzenStack Gap="1rem" class="rz-mt-2">
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <OwnerTypeSelector Projects="@_projects"
                                @bind-ProjectId="_model.ProjectId"
                                @bind-EnvironmentId="_model.EnvironmentId"
                                @bind-ProjectServerId="_model.ProjectServerId" />
                        </RadzenColumn>
                    </RadzenRow>
                    @if (_sourceBranches.Count > 0)
                    {
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="@L["SourceBranch"]">
                                    <RadzenDropDown TValue="string" Data="@_sourceBranches" @bind-Value="_model.SourceBranch"
                                        Placeholder="@L["SourceBranch"]" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    }
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="@L["TriggerType"]">
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-p-2">
                                    @(_pipeline is not null ? L.Localize(_pipeline.TriggerType) : L["DefinedInYaml"])
                                </RadzenText>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                        <RadzenButton Text="@L["SaveSettings"]" Icon="save" Click="@OnSubmit" IsBusy="@_saving" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenTabsItem>
        </Tabs>
    </UrlSyncedTabs>
    </div>
}
