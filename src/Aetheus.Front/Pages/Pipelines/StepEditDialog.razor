@using Aetheus.Shared.DTOs

<RadzenStack Gap="1rem">
    <RadzenFormField Text="@L["StepName"]">
        <RadzenTextBox @bind-Value="_name" />
    </RadzenFormField>

    <RadzenFormField Text="@L["ShellCommand"]">
        <RadzenTextArea @bind-Value="_shell" Rows="6" class="text-mono-sm" />
    </RadzenFormField>

    <RadzenFormField Text="@L["TimeoutSeconds"]">
        <RadzenNumeric @bind-Value="_timeout" Min="1" Max="86400" />
    </RadzenFormField>

    <DialogFooter OnCancel="@OnCancel">
        <RadzenButton Text="@L["Save"]" Icon="save" Click="@OnSave" Disabled="@string.IsNullOrWhiteSpace(_name)" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
    </DialogFooter>
</RadzenStack>
