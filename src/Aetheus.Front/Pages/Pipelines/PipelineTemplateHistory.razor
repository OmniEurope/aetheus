@inherits PipelineTemplateVersionHistoryBase
@page "/templates/{TemplateId:int}/versions"

<PageTitle>@L["VersionHistoryTitle"] - Aetheus</PageTitle>

<PageHeader Title="@string.Format(L["VersionHistory"], _templateName)" Icon="history" BackHref="@($"/templates/{TemplateId}")" />

@if (_templateLoading)
{
    <AetheusLoader />
}
else if (_templateLoadFailed)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@L["LoadFailed"]</RadzenAlert>
}
else
{
    <AetheusDataGrid @ref="_versionsGrid" Data="@_versions" Count="@_versionCount"
        TItem="PipelineTemplateVersionSummaryDto" IsLoading="@_versionsLoading"
        LoadData="@LoadVersionsAsync" PageSize="10">
        <EmptyTemplate>
            <EmptyState Icon="history" Title="@L["NoRecords"]" />
        </EmptyTemplate>
        <Columns>
            <RadzenDataGridColumn TItem="PipelineTemplateVersionSummaryDto" Property="Version" Title="@L["Version"]" Width="6rem">
                <Template Context="version">v@version.Version</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineTemplateVersionSummaryDto" Property="ChangelogEntry" Title="@L["Changelog"]" />
            <RadzenDataGridColumn TItem="PipelineTemplateVersionSummaryDto" Property="CreatedByUsername" Title="@L["CreatedBy"]" Width="12rem" />
            <RadzenDataGridColumn TItem="PipelineTemplateVersionSummaryDto" Property="CreatedAt" Title="@L["Date"]" Width="12rem" FormatString="{0:g}" />
        </Columns>
    </AetheusDataGrid>

    @if (_latestVersion > 1)
    {
        <RadzenCard class="rz-mt-4">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" Wrap="FlexWrap.Wrap" class="rz-mb-3">
                <RadzenFormField Text="@L["OriginalVersion"]">
                    <RadzenNumeric TValue="int" Value="@_originalVersion" Change="@OnOriginalVersionChanged" Min="1" Max="@_latestVersion" />
                </RadzenFormField>
                <RadzenFormField Text="@L["ModifiedVersion"]">
                    <RadzenNumeric TValue="int" Value="@_modifiedVersion" Change="@OnModifiedVersionChanged" Min="1" Max="@_latestVersion" />
                </RadzenFormField>
            </RadzenStack>
            @if (_yamlLoadFailed)
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
                    @L["LoadFailed"]
                    <RadzenButton Text="@L["Retry"]" Icon="refresh" Click="@LoadSelectedYamlAsync"
                        ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                </RadzenAlert>
            }
            else if (_yamlLoading)
            {
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
            }
            else
            {
                <MonacoDiffViewer OriginalValue="@_originalYaml" ModifiedValue="@_modifiedYaml" />
            }
        </RadzenCard>
    }
}
