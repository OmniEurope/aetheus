@using Aetheus.Shared.Enums

@* Extracted from PipelineRun.razor (audit 360, A360-75): the page sat 8 lines over the 600-line
   budget, which is why the size guard could not be extended to .razor files. This block was the
   natural seam - it renders one self-contained card and needs nothing from the page but its data
   and a callback. *@
@if (Results.Count > 0)
{
    <RadzenCard class="rz-p-3 rz-mb-4">
        <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-2">
            <RadzenIcon Icon="psychology" class="run-tile-icon" /> @L["AiRunResults"]
        </RadzenText>
        <RadzenDataGrid Responsive="false" Data="@Results" TItem="AiRunResultDto" Density="Density.Compact"
                        AllowPaging="@(!AetheusGrid.Virtualization)" AllowSorting="true" AllowFiltering="true"
                        FilterMode="FilterMode.Advanced" class="rz-w-100" AllowColumnResize="true" AllowVirtualization="@AetheusGrid.Virtualization" VirtualizationOverscanCount="3">
            <Columns>
                <RadzenDataGridColumn TItem="AiRunResultDto" Property="ProfileName" Title="@L["AiRunnerProfile"]">
                    <Template Context="result">
                        @result.ProfileName
                        @if (result.SendsDataExternally)
                        {
                            <RadzenIcon Icon="cloud_upload" class="rz-color-warning rz-ml-1"
                                        title="@L["ExternalData"]" />
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AiRunResultDto" Property="Verdict" Title="@L["Verdict"]" Width="110px">
                    <Template Context="result">
                        <RadzenBadge BadgeStyle="@(result.Verdict == AiVerdict.Pass ? BadgeStyle.Success : result.Verdict == AiVerdict.Fail ? BadgeStyle.Danger : BadgeStyle.Info)"
                                     Text="@result.Verdict.ToString()" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AiRunResultDto" Property="DurationMs" Title="@L["Duration"]" Width="110px">
                    <Template Context="result">@TimeSpan.FromMilliseconds(result.DurationMs).ToString(@"mm\:ss")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AiRunResultDto" Title="@L["Actions"]" Width="70px">
                    <Template Context="result">
                        <RadzenButton Icon="visibility" Size="ButtonSize.ExtraSmall"
                                      Click="@(() => OnView.InvokeAsync(result))" title="@L["View"]"
                                      ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
}
