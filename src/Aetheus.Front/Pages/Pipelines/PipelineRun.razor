@* SPDX-License-Identifier: EUPL-1.2 *@
@page "/pipelines/runs/{RunId:int}"
@using Aetheus.Front.Helpers
@using Aetheus.Shared.Enums
@using static Aetheus.Front.Pages.Pipelines.PipelineRunFormatting
@using static Aetheus.Front.Pages.Pipelines.PipelineRunLogView

<PageTitle>@(L["PipelineRun"]) #@RunId - Aetheus</PageTitle>

@if (_loading)
{
    <AetheusLoader Size="AetheusLoaderSize.Large" />
}
else if (_run is null)
{
    <RadzenText TextStyle="TextStyle.Body1" class="rz-color-secondary">@L["RunNotFound"]</RadzenText>
}
else
{
    <PipelineRunHeader Run="@_run" PipelineHref="@PipelineHref" GitBranch="@GitBranch"
        BlockingWarningCount="@BlockingWarnings.Count" InfoWarningCount="@InfoWarnings.Count"
        RunInProgress="@(RunInProgress && !_run.CancellationRequested)" CanRerun="@CanRerun" HasFailedSteps="@HasFailedSteps"
        Cancelling="@_cancelling" Rerunning="@_rerunning" Retrying="@_retrying"
        VariablesRequested="@ShowVariables" EditRequested="@(() => Nav.NavigateTo(PipelineHref))"
        CancelRequested="@CancelRunAsync" RerunRequested="@OnRerunClick" RetryFailedRequested="@RetryFailedAsync" />

    @* Alerts *@
    @if (BlockingWarningViews.Count > 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="false"
                     Icon="cloud_off" Title="@L["RunBlockedTitle"]" class="rz-mt-2">
            @foreach (var item in BlockingWarningViews)
            {
                <div>
                    @item.Message
                    @if (item.ConfigHref is not null)
                    {
                        <a href="@item.ConfigHref" class="pipeline-name-link rz-ml-2">@L["ConfigureTarget"]</a>
                    }
                </div>
            }
        </RadzenAlert>
    }
    @if (InfoWarnings.Count > 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Lighter" AllowClose="false" class="rz-mt-2">
            @foreach (var warning in InfoWarnings) { <div>@warning</div> }
        </RadzenAlert>
    }
    @if (_run.CancellationRequested && RunInProgress)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Lighter" AllowClose="false"
                     Icon="pending_actions" Title="@L["CancellationAcceptedTitle"]" class="rz-mt-2">
            @L["CancellationAcceptedDetail"]
        </RadzenAlert>
    }
    @if (_gateState.IsIncomplete)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Lighter" AllowClose="false"
                     Icon="warning" Title="@L["AnalysisGateIncompleteTitle"]" class="rz-mt-2">
            @string.Format(L["AnalysisGateIncompleteDetail"], string.Join(", ", _gateState.FailedRunIds))
        </RadzenAlert>
    }
    @* S-UX-RUNB: surface WHY a run failed at the top of the page (failed step names + exit codes), so the
       "why" reads at a glance without opening the Overview tab or drilling into a step. *@
    @if (_run.Status == PipelineStatus.Failed && FailedSteps.Count > 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="false"
                     Icon="error" Title="@L["RunFailedTitle"]" class="rz-mt-2">
            @string.Format(L["RunFailedStepsLabel"], FailedRunReason)
        </RadzenAlert>
    }

    @* Tabs *@
    <UrlSyncedTabs class="pipeline-run-tabs rz-mt-4" Slugs="@TabSlugs()" @bind-SelectedIndex="_selectedTab">
        <Tabs>
            @* Tab 1: Overview *@
            <RadzenTabsItem Text="@L["Overview"]" Icon="dashboard">
                <div class="run-overview rz-mt-3">
                    <PipelineRunAiResultsCard Results="@_aiResults" OnView="@OpenAiResultAsync" />
                    @* S-UX-28: inline error logs for failed steps, surfaced directly on the Overview *@
                    @if (FailedSteps.Count > 0)
                    {
                        <RadzenCard class="rz-p-3 rz-mb-4 run-failed-card">
                            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-2 rz-color-danger">
                                <RadzenIcon Icon="error" class="run-tile-icon" /> @L["FailedSteps"]
                            </RadzenText>
                            @foreach (var failed in FailedSteps)
                            {
                                <div class="run-failed-step">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="clickable-cell" @onclick="@(() => SelectStep(failed))" role="button" tabindex="0" @onkeydown="@(async e => { if (e.Key == "Enter" || e.Key == " ") await SelectStep(failed); })">
                                        <RadzenBadge BadgeStyle="@GetStepBadge(failed)" Text="@StepStatusText(failed, L)" class="run-status-badge" />
                                        <span class="run-tl-name">@failed.StepName</span>
                                        @if (failed.ExitCode is { } code)
                                        {
                                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@string.Format(L["ExitCodeLabel"], code)</RadzenText>
                                        }
                                    </RadzenStack>
                                    @{ var errLines = ErrorLinesFor(failed, _stepLogsCache); }
                                    @if (errLines.Count > 0)
                                    {
                                        <div class="run-logs-terminal run-logs-terminal-sm rz-mt-1">
                                            <div class="run-logs-lines">
                                                @foreach (var log in errLines)
                                                {
                                                    <div class="run-log-line @(log.Level == TaskLogLevel.Error ? "step-log-error" : "")">@log.Message</div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </RadzenCard>
                    }

                    @{
                        var envNames = _run.Steps
                            .SelectMany(s => s.OutputVariables)
                            .Where(kv => kv.Key == "ENVIRONMENT_NAME")
                            .Select(kv => kv.Value)
                            .Distinct()
                            .ToList();
                        if (envNames.Count == 0)
                            envNames = _run.Artifacts
                                .Where(a => !string.IsNullOrEmpty(a.EnvironmentName))
                                .Select(a => a.EnvironmentName!)
                                .Distinct()
                                .ToList();
                        var parentPipeline = UpstreamPipeline(_run.ResolvedVariables);
                        var parentRunId = UpstreamRunId(_run.ResolvedVariables);
                        var compatibilityOutputs = _run.Steps
                            .SelectMany(step => step.OutputVariables)
                            .Where(output => output.Key is "CompatibilityMode" or "PreviousVersionTested" or "CompatibilityVerdict")
                            .GroupBy(output => output.Key, StringComparer.Ordinal)
                            .ToDictionary(group => group.Key, group => group.Last().Value, StringComparer.Ordinal);
                        var stepProgress = PipelineRunPresentation.StepProgress(_run);
                    }
                    @if (compatibilityOutputs.TryGetValue("CompatibilityMode", out var compatibilityMode))
                    {
                        <RadzenCard class="rz-p-3 rz-mb-4">
                            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-2">
                                <RadzenIcon Icon="verified" class="run-tile-icon" /> @L["CompatibilityAttestation"]
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">
                                @L["CompatibilityMode"]: <strong>@compatibilityMode</strong>
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">
                                @L["PreviousVersionTested"]:
                                <strong>@compatibilityOutputs.GetValueOrDefault("PreviousVersionTested", "false")</strong>
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">
                                @L["CompatibilityVerdict"]:
                                <strong>@compatibilityOutputs.GetValueOrDefault("CompatibilityVerdict", "")</strong>
                            </RadzenText>
                        </RadzenCard>
                    }
                    @* All run facts + produced outputs (release/artifact/env) share ONE responsive, equal-height
                       grid so every tile sits on the same line and only wraps when the viewport narrows. *@
                    <div class="run-overview-tiles rz-mb-4">
                        @* Status and step progress answer the same question ("where does the run stand?"),
                           so they share one tile that jumps to the step logs. *@
                        <div class="run-tile-link" role="button" tabindex="0" @onclick="GoToLogsTab"
                             @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") GoToLogsTab(); })">
                            <RadzenCard class="run-overview-card">
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary"><RadzenIcon Icon="info" class="run-tile-icon" /> @L["Status"]</RadzenText>
                                <RadzenBadge BadgeStyle="@GetRunBadge(_run.Status)" Text="@L.Localize(_run.Status)" />
                                <span class="run-tile-subrow">
                                    <span class="run-tile-sublabel"><RadzenIcon Icon="list_alt" class="run-tile-icon" /> @L["Steps"]</span>
                                    <span class="run-tile-value">@stepProgress.Completed / @stepProgress.Total</span>
                                </span>
                            </RadzenCard>
                        </div>
                        @* Start instant and elapsed time are one timing fact, read together. *@
                        <RadzenCard class="run-overview-card">
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary"><RadzenIcon Icon="event" class="run-tile-icon" /> @L["Started"]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" title="@_run.StartedAt.ToString("F")">@_run.StartedAt.ToString("g")</RadzenText>
                            <span class="run-tile-subrow">
                                <span class="run-tile-sublabel"><RadzenIcon Icon="schedule" class="run-tile-icon" /> @L["Duration"]</span>
                                <span><PipelineRunLiveDuration StartedAt="@_run.StartedAt" CompletedAt="@_run.CompletedAt" IsRunning="@RunInProgress" /></span>
                            </span>
                        </RadzenCard>
                        @if (ShowGateTab && _gateState.Result is { } gate)
                        {
                            <PipelineRunGateOverview Gate="@gate" GateRequested="@(() => NavigateToTab("gate"))" />
                        }
                        @if (_run.Parameters.Count > 0)
                        {
                            <div class="run-tile-link run-parameters-tile" role="button" tabindex="0" @onclick="ShowParameters"
                                 @onkeydown="@(async e => { if (e.Key == "Enter" || e.Key == " ") await ShowParameters(); })">
                                <RadzenCard class="run-overview-card">
                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary"><RadzenIcon Icon="tune" class="run-tile-icon" /> @L["RunParameters"]</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1">@string.Format(L["RunParametersCount"], _run.Parameters.Count)</RadzenText>
                                </RadzenCard>
                            </div>
                        }
                        @if (parentPipeline is not null)
                        {
                            @if (parentRunId is { } parentId)
                            {
                                <a href="@PipelineRunPresentation.Href(parentId, ProjectId ?? _run.ProjectId, ServerId)" class="run-tile-link run-parent-pipeline-tile">
                                    <RadzenCard class="run-overview-card">
                                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary"><RadzenIcon Icon="conversion_path" class="run-tile-icon" /> @L["ParentPipeline"]</RadzenText>
                                        <RadzenText TextStyle="TextStyle.Body1">@parentPipeline</RadzenText>
                                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@L["PipelineRun"] #@parentId</RadzenText>
                                    </RadzenCard>
                                </a>
                            }
                            else
                            {
                                <RadzenCard class="run-overview-card run-parent-pipeline-tile">
                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary"><RadzenIcon Icon="conversion_path" class="run-tile-icon" /> @L["ParentPipeline"]</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1">@parentPipeline</RadzenText>
                                </RadzenCard>
                            }
                        }
                        @* Repository / branch / commit are one answer - "which source did this run build?" -
                           so they share a single tile with one link per line instead of three tiles. *@
                        @{
                            var repositoryHref = _repoId is { } sourceRepoId
                                ? $"/git-repositories/{sourceRepoId}"
                                : _run.ProjectId is { } sourceProjectId ? $"/git-repositories?projectId={sourceProjectId}" : null;
                            var commitHref = _run.Commits.Count > 0
                                ? PipelineRunRepositoryResolver.CommitHref(_repoId, _run.Commits[0])
                                : !string.IsNullOrEmpty(_run.CommitHash)
                                    ? _repoId is { } commitRepoId
                                        ? $"/git-repositories/{commitRepoId}/commits/{Uri.EscapeDataString(_run.CommitHash)}"
                                        : _run.ProjectId is { } commitProjectId ? $"/git-repositories?projectId={commitProjectId}" : null
                                    : null;
                            var commitSha = _run.Commits.Count > 0 ? _run.Commits[0].Sha : _run.CommitHash;
                            var branchLinks = new List<(string Name, string Href)>();
                            if (_run.Branches.Count > 0)
                            {
                                branchLinks.AddRange(_run.Branches.Select(b => (b.Name, PipelineRunRepositoryResolver.BranchHref(_repoId, b))));
                            }
                            else if (!string.IsNullOrEmpty(_run.BranchName))
                            {
                                branchLinks.Add((_run.BranchName, PipelineRunRepositoryResolver.BranchHref(_repoId, _run.ProjectId, _run.BranchName)));
                            }
                            var hasSourceFacts = repositoryHref is not null || branchLinks.Count > 0 || !string.IsNullOrEmpty(commitSha);
                        }
                        @if (hasSourceFacts)
                        {
                            <RadzenCard class="run-overview-card run-source-tile">
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary"><RadzenIcon Icon="folder_open" class="run-tile-icon" /> @L["Source"]</RadzenText>
                                @if (repositoryHref is not null)
                                {
                                    <span class="run-tile-subrow">
                                        <span class="run-tile-sublabel">@L["Repository"]</span>
                                        <a href="@repositoryHref" class="pipeline-name-link run-tile-value" title="@(_run.ProjectName ?? L["Repository"].Value)">@(_run.ProjectName ?? L["Repository"].Value)</a>
                                    </span>
                                }
                                @foreach (var branch in branchLinks)
                                {
                                    <span class="run-tile-subrow">
                                        <span class="run-tile-sublabel"><RadzenIcon Icon="account_tree" class="run-tile-icon" /> @L["Branch"]</span>
                                        <a href="@branch.Href" class="pipeline-name-link run-tile-value" title="@branch.Name">@branch.Name</a>
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(commitSha))
                                {
                                    <span class="run-tile-subrow">
                                        <span class="run-tile-sublabel"><RadzenIcon Icon="commit" class="run-tile-icon" /> @L["Commit"]</span>
                                        @if (commitHref is not null)
                                        {
                                            <a href="@commitHref" class="pipeline-name-link cross-link-sha run-tile-value" title="@commitSha">@ShortSha(commitSha)</a>
                                        }
                                        else
                                        {
                                            <span class="cross-link-sha" title="@commitSha">@ShortSha(commitSha)</span>
                                        }
                                    </span>
                                }
                            </RadzenCard>
                        }
                        @* Optional quality metrics - placed last, only when the run produced them. *@
                        @if (_run.CoverageSummary is { } covTile)
                        {
                            <div class="run-tile-link" role="button" tabindex="0" @onclick="GoToCoverageTab"
                                 @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") GoToCoverageTab(); })">
                                <RadzenCard class="run-overview-card">
                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary"><RadzenIcon Icon="bar_chart" class="run-tile-icon" /> @L["Coverage"]</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" class="@CoverageColorClass(covTile.LineRate)">@FormatPercent(covTile.LineRate)</RadzenText>
                                </RadzenCard>
                            </div>
                        }
                        @if (HasLintTab)
                        {
                            <div class="run-tile-link" role="button" tabindex="0" @onclick="GoToLintTab"
                                 @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") GoToLintTab(); })">
                                <RadzenCard class="run-overview-card">
                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary"><RadzenIcon Icon="rule" class="run-tile-icon" /> @L["Lint"]</RadzenText>
                                    <RadzenBadge BadgeStyle="@(LintPassed == false ? BadgeStyle.Danger : BadgeStyle.Success)" Text="@(LintPassed == false ? L["Failed"] : L["Passed"])" />
                                </RadzenCard>
                            </div>
                        }
                        @* Produced outputs - same grid as the run facts so all tiles share the row and wrap together. *@
                        @foreach (var release in _releases)
                            {
                                <a href="/releases/@release.Id" class="run-tile-link">
                                    <RadzenCard class="run-overview-card">
                                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary"><RadzenIcon Icon="new_releases" class="run-tile-icon rz-color-success" /> @L["Release"]</RadzenText>
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem" Wrap="FlexWrap.Wrap">
                                            @* A commit-derived release name is a full 40-char sha; middle-truncate it so the
                                               tile keeps its column width instead of forcing the grid to scroll sideways. *@
                                            <span class="run-tile-value run-release-version" title="@release.Version">@TruncateMiddle(release.Version)</span>
                                            <RadzenBadge BadgeStyle="@ReleaseHelper.GetReleaseBadge(release.Status)" Text="@L[release.Status.ToString()]" />
                                        </RadzenStack>
                                        @if (AppVersion is { Length: > 0 } appVersion)
                                        {
                                            <span class="run-tile-subrow">
                                                <span class="run-tile-sublabel"><RadzenIcon Icon="sell" class="run-tile-icon" /> @L["Version"]</span>
                                                <span class="run-release-app-version" title="@appVersion">@appVersion</span>
                                            </span>
                                        }
                                    </RadzenCard>
                                </a>
                            }
                            @if (_run.Artifacts.Count > 0)
                            {
                                <div class="run-tile-link run-artifacts-tile" role="button" tabindex="0" @onclick="GoToArtifactsTab"
                                     @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") GoToArtifactsTab(); })">
                                    <RadzenCard class="run-overview-card">
                                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary"><RadzenIcon Icon="inventory_2" class="run-tile-icon rz-color-info" /> @L["Artifacts"]</RadzenText>
                                        <RadzenText TextStyle="TextStyle.Body1">@_run.Artifacts.Count</RadzenText>
                                    </RadzenCard>
                                </div>
                            }
                            @foreach (var env in envNames)
                            {
                                <RadzenCard class="run-overview-card">
                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary"><RadzenIcon Icon="cloud" class="run-tile-icon rz-color-warning" /> @L["Environment"]</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1">@env</RadzenText>
                                </RadzenCard>
                            }
                    </div>

                    @* Test Results Summary *@
                    @if (_run.TestResultSummary is not null)
                    {
                        <RadzenCard class="rz-p-3 rz-mb-4">
                            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-2">@L["TestResults"]</RadzenText>
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@_run.TestResultSummary.TotalTests.ToString()" />
                                    <RadzenText TextStyle="TextStyle.Caption">@L["Total"]</RadzenText>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@_run.TestResultSummary.Passed.ToString()" />
                                    <RadzenText TextStyle="TextStyle.Caption">@L["Passed"]</RadzenText>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="@_run.TestResultSummary.Failed.ToString()" />
                                    <RadzenText TextStyle="TextStyle.Caption">@L["Failed"]</RadzenText>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@_run.TestResultSummary.Skipped.ToString()" />
                                    <RadzenText TextStyle="TextStyle.Caption">@L["Skipped"]</RadzenText>
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenCard>
                    }

                    @* Pipeline progress - same collapsible run tree as the Journaux tab (mockup design):
                       stage label + child-pipeline chip + description; a leaf-step click opens its logs. *@
                    <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-3">@L["Progress"]</RadzenText>
                    <RunTimelineTree Run="_run!" Depth="0" SelectedStepId="_selectedStep?.Id" OnSelectStep="SelectStep"
                                     PreloadedChildren="ChildRuns" PreviousRuns="_previousDurations.Runs"
                                     ProjectId="ProjectId" ServerId="ServerId" />
                </div>
            </RadzenTabsItem>

            @* Tab 2: Logs *@
            <RadzenTabsItem Text="@L["Logs"]" Icon="terminal">
                @* Side-by-side split: run tree left, logs right. Orchestration runs get a wider left
                   column so the stage label + child-pipeline chip + description fit on one line. *@
                <div class="run-split-layout @(IsOrchestration ? "run-split-wide" : "") rz-mt-3">
                    @* Left panel: compact timeline *@
                    <div class="run-split-timeline">
                        @* A1-A4: recursive, collapsible run tree. Trigger steps are child-run nodes that
                           lazy-load and nest the triggered pipeline's own timeline instead of an opaque
                           empty-log row. *@
                        <RunTimelineTree Run="_run!" Depth="0" SelectedStepId="_selectedStep?.Id" OnSelectStep="SelectStep"
                                         PreloadedChildren="ChildRuns" PreviousRuns="_previousDurations.Runs"
                                         ProjectId="ProjectId" ServerId="ServerId" />
                    </div>

                    @* Right panel: log viewer *@
                    <div class="run-split-logs">
                        @if (_selectedStep is null)
                        {
                            <div class="run-logs-empty">
                                <RadzenIcon Icon="terminal" class="run-empty-icon" />
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-mt-2">@L["SelectStepToViewLogs"]</RadzenText>
                            </div>
                        }
                        else
                        {
                            <div class="run-logs-header run-step-logs-header">
                                <div class="run-step-logs-heading">
                                    <RadzenBadge BadgeStyle="@GetStepBadge(_selectedStep)" Text="@StepStatusText(_selectedStep, L)" />
                                    <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0 run-step-logs-title" title="@_selectedStep.StepName">@_selectedStep.StepName</RadzenText>
                                    @if (_selectedStep.IsSystem)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@L["System"]" class="run-system-label" />
                                    }
                                    @if (_selectedStep.IsContainerIsolated)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@L["Container"]" Icon="deployed_code" class="run-system-label" />
                                    }
                                    @if (_selectedStep.OutputVariables.TryGetValue("RELEASE_ID", out var releaseId))
                                    {
                                        <a href="/releases/@releaseId" class="pipeline-name-link">
                                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@L["Release"]" Icon="open_in_new" />
                                        </a>
                                    }
                                    @foreach (var logArt in _run!.Artifacts.Where(a => a.StageName == _selectedStep.StageName))
                                    {
                                        <a href="/artifacts/@logArt.Id" class="pipeline-name-link">
                                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@logArt.Name" Icon="inventory_2" />
                                        </a>
                                    }
                                    @{ var logDur = FormatDuration(_selectedStep.StartedAt, _selectedStep.CompletedAt); }
                                    @if (!string.IsNullOrEmpty(logDur))
                                    {
                                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary run-step-logs-duration">@logDur</RadzenText>
                                    }
                                </div>
                                <div class="run-step-logs-toolbar">
                                    @if (!string.IsNullOrEmpty(_selectedStep.Command))
                                    {
                                        <RadzenButton Icon="@(_showCommand ? "code_off" : "code")" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                      Text="@L["Command"]" Variant="@(_showCommand ? Variant.Filled : Variant.Outlined)"
                                                      Click="@(() => _showCommand = !_showCommand)"
                                                      title="@(_showCommand ? L["HideCommand"] : L["ShowCommand"])" />
                                    }
                                    <RadzenButton Icon="@(_showResults ? "visibility" : "visibility_off")" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                  Text="@L["Output"]" Variant="@(_showResults ? Variant.Filled : Variant.Outlined)"
                                                  Click="@(() => _showResults = !_showResults)"
                                                  title="@(_showResults ? L["HideOutput"] : L["ShowOutput"])" />
                                    <RadzenTextBox @bind-Value="_logSearch" Placeholder="@L["SearchLogs"]" aria-label="@L["SearchLogs"]" class="run-logs-search" />
                                    <div class="run-step-logs-actions">
                                        <RadzenButton Icon="content_copy" Size="ButtonSize.Small" title="@L["CopyLogs"]"
                                                      Text="@L["CopyLogs"]" Click="@CopyLogsAsync" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                                        <RadzenButton Icon="vertical_align_top" Size="ButtonSize.Small"
                                                      Click="@ScrollLogsToTopAsync" title="@L["ScrollToTop"]" aria-label="@L["ScrollToTop"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                                        <RadzenButton Icon="vertical_align_bottom" Size="ButtonSize.Small"
                                                      Click="@ScrollLogsToBottomAsync" title="@L["ScrollToBottom"]" aria-label="@L["ScrollToBottom"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                                        <RadzenButton Icon="arrow_downward" Size="ButtonSize.Small"
                                                      Variant="@(_followLogs ? Variant.Filled : Variant.Outlined)"
                                                      Click="@ToggleFollowLogs" title="@L["FollowLogs"]" aria-label="@L["FollowLogs"]" ButtonStyle="ButtonStyle.Light" />
                                    </div>
                                </div>
                            </div>
                            @if (_showCommand && !string.IsNullOrEmpty(_selectedStep.Command))
                            {
                                <div class="run-cmd" title="@L["ExecutedCommand"]">
                                    <RadzenIcon Icon="chevron_right" class="run-cmd-icon" />
                                    <code class="run-cmd-text">@_selectedStep.Command</code>
                                </div>
                            }
                            @if (!_showResults)
                            {
                                <div class="run-logs-terminal run-logs-collapsed">
                                    <div class="step-log-empty">
                                        <RadzenIcon Icon="visibility_off" class="step-log-empty-icon" />
                                        <span>@L["OutputHidden"]</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                            <div class="run-logs-terminal" @ref="_logsTerminal">
                                @if (_selectedStep.Status == TaskExecutionStatus.Pending)
                                {
                                    <div class="step-log-empty">
                                        <RadzenIcon Icon="schedule" class="step-log-empty-icon" />
                                        <span>@GetPendingReason(_selectedStep, _stages, _run, L)</span>
                                    </div>
                                }
                                else if (_selectedStep.Status == TaskExecutionStatus.Assigned)
                                {
                                    <div class="step-log-empty">
                                        <RadzenIcon Icon="pending_actions" class="step-log-empty-icon" />
                                        <span>@GetQueueReason(_selectedStep, L)</span>
                                    </div>
                                }
                                else if (_logsLoading && _selectedStep.TaskId.HasValue && !_stepLogsCache.ContainsKey(_selectedStep.TaskId.Value))
                                {
                                    <AetheusLoader Size="AetheusLoaderSize.Small" />
                                }
                                else
                                {
                                    var logs = _selectedStep.TaskId.HasValue ? _stepLogsCache.GetValueOrDefault(_selectedStep.TaskId.Value) : null;
                                    @if (logs is null or { Count: 0 })
                                    {
                                        <div class="step-log-empty">@GetEmptyLogsReason(_selectedStep, L)</div>
                                    }
                                    else
                                    {
                                        var filteredLogs = FilterLogs(logs, _logSearch);
                                        @if (filteredLogs.Count == 0)
                                        {
                                            <div class="step-log-empty">@L["NoLogs"]</div>
                                        }
                                        else
                                        {
                                            @* Virtualized so a step with thousands of log lines (a full test run)
                                               renders only the visible rows instead of flooding the DOM and freezing
                                               the tab. ItemSize is the single-line height; wrapped lines are rare in
                                               tool output, so approximate sizing is acceptable here. *@
                                            <div class="run-logs-lines">
                                                <Virtualize Items="filteredLogs" ItemSize="21" OverscanCount="20" Context="entry">
                                                    <div class="run-log-line @(entry.Log.Level == TaskLogLevel.Error ? "step-log-error" : "")"><span class="run-log-num">@entry.Num</span>@HighlightLogVariables(entry.Log.Message, _logVarRegex)</div>
                                                </Virtualize>
                                            </div>
                                        }
                                    }
                                }
                            </div>
                            }
                        }
                    </div>
                </div>
            </RadzenTabsItem>

            @if (ShowGateTab && _gateState.Result is { } gateResult)
            {
                <RadzenTabsItem Text="@L["AnalysisGateTab"]" Icon="rule">
                    <PipelineRunGateFindings Gate="@gateResult" ProjectId="@EffectiveProjectId" />
                </RadzenTabsItem>
            }

            @* G0: structural tab - YAML snapshot sits right after Journaux, before the data-driven tabs. *@
            @if (!string.IsNullOrEmpty(_run.YamlSnapshot))
            {
                <RadzenTabsItem Text="YAML" Icon="data_object">
                    @* Definition left, full-height; `pipeline: <name>` refs are clickable and open the
                       referenced pipeline's live definition in a right peek pane (one at a time). *@
                    <div class="run-yaml-split rz-mt-3">
                        <div class="run-yaml-pane">
                            <div class="run-logs-header">
                                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0">@L["Definition"]</RadzenText>
                                <span class="rz-color-secondary run-yaml-subtitle">@_run.PipelineName</span>
                                <div class="pipeline-list-spacer"></div>
                                <RadzenButton Icon="wrap_text" Size="ButtonSize.Small"
                                              Variant="@(_yamlWrap ? Variant.Filled : Variant.Outlined)"
                                              Text="@L["WrapLines"]" Click="@(() => _yamlWrap = !_yamlWrap)"
                                               title="@L["WrapLinesHint"]" ButtonStyle="ButtonStyle.Light" />
                                <RadzenButton Icon="content_copy" Size="ButtonSize.Small"
                                              Text="@L["Copy"]" Click="@CopyYamlAsync" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                            </div>
                            <div class="run-yaml-code @(_yamlWrap ? "run-yaml-wrap" : "")">
                                @foreach (var yl in PipelineYamlLines.Parse(_run.YamlSnapshot))
                                {
                                    <div class="yaml-line">@if (yl.PipelineRef is { } pref){@yl.Text<span class="yaml-pipeline-link" role="link" tabindex="0" title="@L["PeekPipelineDefinition"]" @onclick="@(() => _peekName = pref)" @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") _peekName = pref; })">@pref</span>}else{@yl.Text}</div>
                                }
                            </div>
                        </div>
                        @if (_peekName is not null)
                        {
                            <PipelineDefinitionPeek PipelineName="@_peekName" ProjectId="@(_run.ProjectId)" OnClose="ClosePeek" />
                        }
                    </div>
                </RadzenTabsItem>
            }

            <PipelineRunResultsTabs Run="@_run" Metrics="@_metrics" StepLogs="@_stepLogsCache"
                LintSteps="@LintSteps" HasLintTab="@HasLintTab"
                ArtifactDownloadRequested="@DownloadArtifactAsync"
                CoverageLogsRequested="@LoadCoverageLogsAsync" LintLogsRequested="@LoadLintLogsAsync" />
       </Tabs>
    </UrlSyncedTabs>
}
