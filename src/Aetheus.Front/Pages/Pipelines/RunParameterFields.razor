@using Aetheus.Shared.DTOs

@foreach (var p in Parameters)
{
    <div class="run-params-field">
        @if (string.Equals(p.Type, "boolean", StringComparison.OrdinalIgnoreCase))
        {
            <LabeledToggle Kind="ToggleKind.Switch" Value="@BoolValue(p.Name)"
                ValueChanged="@(value => _bools[p.Name] = value)"
                Text="@($"{p.DisplayName}{(p.Required ? " *" : "")}")" />
        }
        else
        {
            <RadzenLabel Component="@p.Name" class="rz-mb-1 run-params-label"
                Text="@($"{p.DisplayName}{(p.Required ? " *" : "")}")" />

            switch (p.Type?.ToLowerInvariant())
            {
                case "choice":
                    <RadzenDropDown TValue="string" Value="@StringValue(p.Name)"
                                    ValueChanged="@(value => _strings[p.Name] = value)"
                                    Data="@p.AllowedValues" Name="@p.Name"
                                    AllowClear="!p.Required" class="run-params-input" />
                    break;
                case "number":
                    <RadzenNumeric TValue="decimal?" Value="@NumberValue(p.Name)"
                                   ValueChanged="@(value => _numbers[p.Name] = value)"
                                   Name="@p.Name" class="run-params-input" />
                    break;
                default:
                    <RadzenTextBox Value="@StringValue(p.Name)"
                                   ValueChanged="@(value => _strings[p.Name] = value)"
                                   @oninput="@(e => _strings[p.Name] = e.Value?.ToString())"
                                   Name="@p.Name" class="run-params-input" />
                    break;
            }
        }

        @if (!string.IsNullOrWhiteSpace(p.Description))
        {
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-base-600">@p.Description</RadzenText>
        }
    </div>
}

@if (AvailableReleases.Count > 0)
{
    <div class="run-params-field">
        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-base-600">
            @(FillTargetName is not null ? L["AvailableReleasesClickToFill"] : L["AvailableReleases"])
        </RadzenText>
        <RadzenStack Gap="0.1rem">
            @foreach (var release in AvailableReleases)
            {
                @if (FillTargetName is not null)
                {
                    <RadzenButton Text="@($"{release.Version} - {release.Status}")" Icon="content_copy"
                        Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                        Click="@(() => FillFromRelease(release.Version))" />
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@release.Version - @release.Status</RadzenText>
                }
            }
        </RadzenStack>
    </div>
}
