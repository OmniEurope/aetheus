@using Microsoft.AspNetCore.Components.Forms

@if (!Embedded)
{
    <PageTitle>@L["PipelineTemplates"] - Aetheus</PageTitle>
}

<div class="pipeline-list-toolbar">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
        @if (!Embedded)
        {
            <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">@L["PipelineTemplates"]</RadzenText>
            <HelpLink PageKey="templates" />
        }
        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@string.Format(L["Total"], _templates.Count)" />
        <div class="pipeline-list-spacer"></div>
        <RadzenButton Icon="refresh" Size="ButtonSize.Small" Click="@LoadTemplatesAsync"
            title="@L["Refresh"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        @if (_canWrite)
        {
            <RadzenButton Text="@L["Import"]" Icon="upload_file" Click="@OnImportClickAsync"
                title="@L["Import"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
            <InputFile @ref="_fileInput" OnChange="@OnFileSelectedAsync" class="input-file-hidden" accept=".yaml,.yml" />
            <RadzenButton Text="@L["NewTemplate"]" Icon="add" Click="@CreateTemplate"
                title="@L["NewTemplate"]" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        }
    </RadzenStack>
</div>

@if (_loadFailed)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
        @L["LoadFailed"]
        <RadzenButton Text="@L["Retry"]" Icon="refresh" Click="@LoadTemplatesAsync"
            title="@L["Retry"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
    </RadzenAlert>
}
else
{
    <AetheusDataGrid Data="@_templates" TItem="PipelineTemplateSummaryDto" IsLoading="@_loading"
        RowClick="@EditTemplate" FullHeight="true">
        <EmptyTemplate>
            <EmptyState Icon="description" Title="@L["NoRecords"]" Description="@L["EmptyTemplatesHint"]">
                <ActionContent>
                    @if (_canWrite)
                    {
                        <RadzenButton Text="@L["NewTemplate"]" Icon="add" Click="@CreateTemplate"
                            title="@L["NewTemplate"]" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                    }
                </ActionContent>
            </EmptyState>
        </EmptyTemplate>
        <Columns>
            <RadzenDataGridColumn TItem="PipelineTemplateSummaryDto" Property="Name" Title="@L["Name"]" Width="12rem">
                <Template Context="template">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenIcon Icon="description" class="rz-color-secondary" />
                        <a href="@($"/templates/{template.Id}")" class="pipeline-name-link" title="@template.Name"
                            @onclick:stopPropagation="true">@template.Name</a>
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineTemplateSummaryDto" Property="Version" Title="@L["VersionShort"]"
                Width="5rem" Filterable="false" TextAlign="TextAlign.Center">
                <Template Context="template">@($"v{template.Version}")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineTemplateSummaryDto" Property="Description" Title="@L["Description"]" Width="8rem">
                <Template Context="template"><span title="@template.Description">@template.Description</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineTemplateSummaryDto" Property="UpdatedAt" Title="@L["Updated"]"
                Width="7.5rem" Filterable="false">
                <Template Context="template">
                    @if (template.UpdatedAt.Year < 2000)
                    {
                        <span>@L["Never"]</span>
                    }
                    else
                    {
                        <span title="@template.UpdatedAt.ToString("F")">@RelativeTime.FormatAgo(L, template.UpdatedAt)</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineTemplateSummaryDto" Property="PipelineCount" Title="@L["Pipelines"]"
                Width="6.5rem" Filterable="false" TextAlign="TextAlign.Center">
                <Template Context="template">
                    @if (template.PipelineCount > 0)
                    {
                        <a href="@($"/pipelines?templateId={template.Id}")" class="pipeline-name-link"
                            title="@string.Format(L["ViewPipelinesUsingTemplate"], template.Name)"
                            @onclick:stopPropagation="true">@template.PipelineCount</a>
                    }
                    else
                    {
                        <span>0</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineTemplateSummaryDto" Property="LatestRunAt" Title="@L["LatestRunShort"]"
                Width="7.5rem" Filterable="false">
                <Template Context="template">
                    @if (template.LatestRunAt is { } latestRunAt)
                    {
                        <span title="@latestRunAt.ToString("F")">@RelativeTime.FormatAgo(L, latestRunAt)</span>
                    }
                    else
                    {
                        <span>@L["Never"]</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineTemplateSummaryDto" Title="@L["Actions"]" Width="8rem"
                Sortable="false" Filterable="false" TextAlign="TextAlign.Right">
                <Template Context="template">
                    <span @onclick:stopPropagation="true">
                        <RadzenButton Text="@L["UseTemplate"]" Icon="add_circle" Click="@(() => UseTemplate(template))"
                            title="@L["UseTemplate"]" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                        <RadzenButton Text="@L["VersionHistoryTitle"]" Icon="history" Click="@(() => ViewHistory(template))"
                            title="@L["VersionHistoryTitle"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                        <RadzenButton Text="@L["Export"]" Icon="download" Click="@(() => ExportTemplateAsync(template))"
                            title="@L["Export"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
                        @if (_canWrite)
                        {
                            <RadzenButton Text="@L["Edit"]" Icon="edit" Click="@(() => EditTemplate(template))"
                                title="@L["Edit"]" ButtonStyle="ButtonStyle.Info" Variant="Variant.Filled" />
                            <RadzenButton Text="@L["Delete"]" Icon="delete" Click="@(() => DeleteTemplateAsync(template))"
                                title="@L["Delete"]" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                        }
                    </span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </AetheusDataGrid>
}
