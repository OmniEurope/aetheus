@inherits PipelineTemplateVersionHistoryBase

<RadzenStack Gap="1rem">
    @if (_versionsLoadFailed)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenText>@L["LoadFailed"]</RadzenText>
                <RadzenButton Text="@L["Retry"]" Icon="refresh" Click="@RetryVersionsAsync"
                    Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
            </RadzenStack>
        </RadzenAlert>
    }

    <RadzenDataGrid Responsive="false" @ref="_versionsGrid" Data="@_versions" Count="@_versionCount"
        TItem="PipelineTemplateVersionSummaryDto" IsLoading="@_versionsLoading"
        LoadData="@LoadVersionsAsync" AllowPaging="true" PageSize="10" AllowSorting="true"
        AllowFiltering="true" FilterMode="FilterMode.Advanced"
        Density="Density.Compact" AllowColumnResize="true">
        <Columns>
            <RadzenDataGridColumn TItem="PipelineTemplateVersionSummaryDto" Property="Version" Title="@L["Version"]" Width="6rem">
                <Template Context="version">v@version.Version</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineTemplateVersionSummaryDto" Property="ChangelogEntry" Title="@L["Changelog"]" />
            <RadzenDataGridColumn TItem="PipelineTemplateVersionSummaryDto" Property="CreatedByUsername" Title="@L["CreatedBy"]" Width="12rem" />
            <RadzenDataGridColumn TItem="PipelineTemplateVersionSummaryDto" Property="CreatedAt" Title="@L["Date"]" Width="12rem" FormatString="{0:g}" />
        </Columns>
    </RadzenDataGrid>

    @if (LatestVersion > 1)
    {
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" Wrap="FlexWrap.Wrap">
            <RadzenFormField Text="@L["OriginalVersion"]">
                <RadzenNumeric TValue="int" Value="@_originalVersion" Change="@OnOriginalVersionChanged"
                    Min="1" Max="@LatestVersion" />
            </RadzenFormField>
            <RadzenFormField Text="@L["ModifiedVersion"]">
                <RadzenNumeric TValue="int" Value="@_modifiedVersion" Change="@OnModifiedVersionChanged"
                    Min="1" Max="@LatestVersion" />
            </RadzenFormField>
        </RadzenStack>

        @if (_yamlLoadFailed)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenText>@L["LoadFailed"]</RadzenText>
                    <RadzenButton Text="@L["Retry"]" Icon="refresh" Click="@LoadSelectedYamlAsync"
                        Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                </RadzenStack>
            </RadzenAlert>
        }
        else if (_yamlLoading)
        {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
        }
        else
        {
            <MonacoDiffViewer OriginalValue="@_originalYaml" ModifiedValue="@_modifiedYaml" />
        }
    }

    <DialogFooter OnCancel="@Close" CancelText="@L["Close"]" />
</RadzenStack>
