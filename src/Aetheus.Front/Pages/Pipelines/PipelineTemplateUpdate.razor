@inherits PipelineFleetUpdateBase
@page "/pipelines/{PipelineId:int}/template/update/{TargetVersion:int}"

<PageTitle>@L["UpdatePipelineTemplate"] - Aetheus</PageTitle>

<PageHeader Title="@L["UpdatePipelineTemplate"]" Icon="system_update_alt" BackHref="@($"/pipelines/{PipelineId}")" />

@if (_loading)
{
    <AetheusLoader />
}
else if (_loadFailed || _preview is null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
        @L["LoadError"]
        <RadzenButton Text="@L["Retry"]" Icon="refresh" Click="@LoadPreviewAsync"
            ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
    </RadzenAlert>
}
else
{
    <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-3">
        @string.Format(L["TemplateVersionTransition"], _preview.TemplateName, _preview.CurrentVersion, _preview.TargetVersion)
    </RadzenText>
    @if (_preview.OrphanOverrides.Count > 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" ShowIcon="true">
            <RadzenText>@L["OrphanOverridesWarning"]</RadzenText>
            <ul>
                @foreach (var orphan in _preview.OrphanOverrides)
                {
                    <li><code>@orphan</code></li>
                }
            </ul>
        </RadzenAlert>
        <LabeledToggle @bind-Value="_acknowledged" Text="@L["AcknowledgeOrphanOverrides"]" Class="rz-mb-3" />
    }
    <MonacoDiffViewer OriginalValue="@_preview.CurrentResolvedYaml" ModifiedValue="@_preview.TargetResolvedYaml" />
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-mt-4">
        <RadzenButton Text="@L["Cancel"]" Icon="close" Click="@Cancel" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        <RadzenButton Text="@L["ConfirmUpdate"]" Icon="system_update_alt" Click="@ConfirmAsync"
            IsBusy="@_saving" Disabled="@(_saving || (_preview.RequiresOrphanAcknowledgement && !_acknowledged))"
            ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
    </RadzenStack>
}
