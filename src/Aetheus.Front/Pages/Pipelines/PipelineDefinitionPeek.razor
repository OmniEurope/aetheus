@using Aetheus.Shared.DTOs

@* Read-only right split pane: shows a referenced pipeline's live definition. Its own `pipeline:` refs
   are themselves clickable (navigates within this pane); wrap/copy are independent; close bubbles up. *@
@if (_currentName is not null)
{
    <div class="run-yaml-pane run-yaml-peek">
        <div class="run-logs-header">
            <RadzenIcon Icon="account_tree" class="run-tl-chip-icon" />
            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0">@(_current?.Name ?? _currentName)</RadzenText>
            @if (_current is { } pp)
            {
                <a href="/pipelines/@pp.Id" class="pipeline-name-link" title="@L["OpenPipeline"]"><RadzenIcon Icon="open_in_new" /></a>
            }
            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@L["ReadOnly"]" class="run-system-label" />
            <div class="pipeline-list-spacer"></div>
            @if (_current is not null)
            {
                <RadzenButton Icon="wrap_text" Size="ButtonSize.Small"
                              Variant="@(_wrap ? Variant.Filled : Variant.Outlined)"
                               Text="@L["WrapLines"]" Click="@(() => _wrap = !_wrap)" title="@L["WrapLinesHint"]" ButtonStyle="ButtonStyle.Light" />
                <RadzenButton Icon="content_copy" Size="ButtonSize.Small"
                              Text="@L["Copy"]" Click="@CopyAsync" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
            }
            <RadzenButton Icon="close" Size="ButtonSize.Small"
                          Click="@(() => OnClose.InvokeAsync())" title="@L["Close"]" aria-label="@L["Close"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        </div>
        @if (_loading)
        {
            <div class="run-yaml-code run-yaml-empty"><AetheusLoader Size="AetheusLoaderSize.Small" /></div>
        }
        else if (_current is { } pk)
        {
            <div class="run-yaml-code @(_wrap ? "run-yaml-wrap" : "")">
                @foreach (var yl in PipelineYamlLines.Parse(pk.YamlDefinition))
                {
                    <div class="yaml-line">@if (yl.PipelineRef is { } pref){@yl.Text<span class="yaml-pipeline-link" role="link" tabindex="0" title="@L["PeekPipelineDefinition"]" @onclick="@(() => PeekAsync(pref))" @onkeydown="@(async e => { if (e.Key == "Enter" || e.Key == " ") await PeekAsync(pref); })">@pref</span>}else{@yl.Text}</div>
                }
            </div>
        }
        else
        {
            <div class="run-yaml-code run-yaml-empty">@L["PipelineNotFound"]</div>
        }
    </div>
}
