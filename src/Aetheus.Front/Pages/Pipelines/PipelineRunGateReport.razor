<RadzenCard class="analysis-findings-report rz-mt-3 rz-p-3">
    <div class="analysis-findings-report-heading">
        <div>
            <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@L["AnalysisFindingsReport"]</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">@L["AnalysisFindingsReportDescription"]</RadzenText>
        </div>
        <RadzenBadge BadgeStyle="@PipelineRunGatePresentation.GateStyle(Gate.Status)"
                     Text="@L[PipelineRunGatePresentation.StatusKey(Gate.Status)]" />
    </div>
    @if (Gate.Findings.Count == 0)
    {
        <EmptyState Icon="task_alt" Title="@L["AnalysisNoFindings"]" Description="@L["AnalysisNoFindingsDescription"]" />
    }
    else
    {
        @foreach (var group in Groups)
        {
            <section class="analysis-findings-report-group">
                <div class="analysis-findings-report-group-heading">
                    <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@L[PipelineRunGatePresentation.CategoryKey(group.Key)]</RadzenText>
                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@group.Count().ToString()" />
                </div>
                <div class="analysis-findings-report-list">
                    @foreach (var finding in group)
                    {
                        <article class="analysis-finding-report-item">
                            <div class="analysis-finding-report-title">
                                <RadzenBadge BadgeStyle="@PipelineRunGatePresentation.SeverityStyle(finding.Severity)" Text="@L[PipelineRunGatePresentation.SeverityKey(finding.Severity)]" />
                                @if (finding.IsNew) { <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@L["New"]" /> }
                                <strong>@finding.Title</strong>
                            </div>
                            <p>@finding.Message</p>
                            <div class="analysis-finding-report-meta">
                                <span>@L["AnalysisRule"]: @finding.RuleId</span>
                            </div>
                            @if (string.IsNullOrWhiteSpace(finding.FilePath))
                            {
                                <span class="analysis-finding-location-unavailable">@L["AnalysisLocationUnavailable"]</span>
                            }
                            else
                            {
                                <div class="analysis-finding-location">
                                    <RadzenIcon Icon="location_on" />
                                    <div>
                                        <code title="@finding.FilePath">@finding.FilePath</code>
                                        @if (finding.StartLine is { } line)
                                        {
                                            <span>@L["Line"] @line</span>
                                        }
                                    </div>
                                </div>
                            }
                            <RadzenButton Text="@L["ViewDetails"]" Icon="visibility" Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled"
                                          Click="@(() => OpenFinding(finding.FindingId))" />
                        </article>
                    }
                </div>
            </section>
        }
    }
</RadzenCard>
