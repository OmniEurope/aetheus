@using Aetheus.Shared.DTOs

<div class="dry-run-dialog">
    @if (Result is not null)
    {
        @if (Result.Warnings.Count > 0)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-4">
                @foreach (var warning in Result.Warnings)
                {
                    <div>@warning</div>
                }
            </RadzenAlert>
        }

        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-2">
            @L["ResolvedVariables"] (@Result.ResolvedVariables.Count)
        </RadzenText>

        @if (Result.ResolvedVariables.Count > 0)
        {
            <RadzenDataGrid Data="@Result.ResolvedVariables.Select(kv => new { kv.Key, kv.Value })" TItem="object"
                Density="Density.Compact" class="rz-mb-4 dlg-summary-pre" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced">
                <Columns>
                    <RadzenDataGridColumn Property="Key" Title="@L["Key"]" Width="200px" />
                    <RadzenDataGridColumn Property="Value" Title="@L["Value"]" />
                </Columns>
            </RadzenDataGrid>
        }

        @foreach (var stage in Result.Stages)
        {
            <RadzenText TextStyle="TextStyle.H6" class="rz-mt-2 rz-mb-1">@stage.StageName (@stage.Agent)</RadzenText>
            <RadzenDataGrid Data="@stage.Steps" TItem="DryRunStepDto" Density="Density.Compact" class="rz-mb-2" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced">
                <Columns>
                    <RadzenDataGridColumn Property="StepName" Title="@L["Step"]" Width="150px" />
                    <RadzenDataGridColumn Property="OriginalCommand" Title="@L["OriginalCommand"]" />
                    <RadzenDataGridColumn Property="ResolvedCommand" Title="@L["ResolvedCommand"]" />
                </Columns>
            </RadzenDataGrid>
        }
    }
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" class="rz-mt-3">
        <Aetheus.Front.Shared.DialogCloseButton />
    </RadzenStack>
</div>
