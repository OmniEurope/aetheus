@using Aetheus.Shared.DTOs

<RadzenTemplateForm TItem="object" Data="@(new object())" Submit="@OnSubmit">
    <div class="run-params-dialog">
        @if (Branches.Count > 0)
        {
            <div class="run-params-field">
                <RadzenLabel Component="launch-branch" class="rz-mb-1 run-params-label" Text="@L["Branch"]" />
                <RadzenDropDown TValue="string" Value="@_branch" Name="launch-branch"
                                ValueChanged="@(async (string value) => await OnBranchChangedAsync(value))"
                                Data="@Branches" TextProperty="Name" ValueProperty="Name"
                                Disabled="@_reloading"
                                class="run-params-input" />
            </div>
        }

        <RunParameterFields @key="_parametersRevision" @ref="_fields"
                            Parameters="@_parameters" AvailableReleases="@AvailableReleases" />

        @if (Branches.Count == 0 && _parameters.Count == 0)
        {
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-base-600">@L["NoRunOptions"]</RadzenText>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-2">@_error</RadzenAlert>
        }

        <DialogFooter OnCancel="@OnCancel">
            <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Run"]" Icon="play_arrow"
                          ButtonStyle="ButtonStyle.Success" Variant="Variant.Filled" Disabled="@_reloading" />
        </DialogFooter>
    </div>
</RadzenTemplateForm>
