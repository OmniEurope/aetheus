@page "/templates/new"
@page "/templates/{Id:int}"

<PageTitle>@(_isNew ? L["NewTemplate"] : _template?.Name ?? L["EditTemplate"]) - Aetheus</PageTitle>

<PageHeader Title="@(_isNew ? L["NewTemplate"] : _template?.Name ?? L["EditTemplate"])" Icon="description" BackHref="/templates">
    <ChildContent>
        @if (_template is not null)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@($"v{_template.Version}")" />
        }
    </ChildContent>
    <Actions>
        @if (_template is not null)
        {
            <RadzenButton Text="@L["UseTemplate"]" Icon="add_circle" Click="@UseTemplate"
                ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
            <RadzenButton Text="@L["VersionHistoryTitle"]" Icon="history" Click="@ViewHistory"
                ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        }
    </Actions>
</PageHeader>

@if (_loading)
{
    <AetheusLoader />
}
else if (_loadFailed)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@L["LoadFailed"]</RadzenAlert>
}
else
{
    <RadzenTemplateForm TItem="TemplateFormModel" Data="@_model" Submit="@OnSubmitAsync">
        <LocalizedDataAnnotationsValidator />
        <RadzenRow Gap="1rem" class="rz-mt-3">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Gap="1rem">
                    <RadzenFormField Text="@L["Name"]" class="rz-w-100">
                        <RadzenTextBox @bind-Value="_model.Name" @oninput="@(e => _model.Name = e.Value?.ToString() ?? string.Empty)"
                            Name="Name" Disabled="@(!_isNew)" class="rz-w-100" />
                    </RadzenFormField>
                    <ValidationMessage For="@(() => _model.Name)" />
                    <RadzenFormField Text="@L["Category"]" class="rz-w-100">
                        <RadzenTextBox @bind-Value="_model.Category" @oninput="@(e => _model.Category = e.Value?.ToString() ?? string.Empty)"
                            Name="Category" class="rz-w-100" />
                    </RadzenFormField>
                    <ValidationMessage For="@(() => _model.Category)" />
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Gap="1rem">
                    <RadzenFormField Text="@L["Description"]" class="rz-w-100">
                        <RadzenTextArea @bind-Value="_model.Description" @oninput="@(e => _model.Description = e.Value?.ToString() ?? string.Empty)"
                            Name="Description" Rows="3" class="rz-w-100" />
                    </RadzenFormField>
                    <RadzenFormField Text="@L["ChangelogEntry"]" class="rz-w-100">
                        <RadzenTextBox @bind-Value="_model.ChangelogEntry" @oninput="@(e => _model.ChangelogEntry = e.Value?.ToString() ?? string.Empty)"
                            Name="ChangelogEntry" Placeholder="@L["DescribeChanges"]" class="rz-w-100" />
                    </RadzenFormField>
                    <ValidationMessage For="@(() => _model.ChangelogEntry)" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mt-4 rz-mb-2">@L["YAML"]</RadzenText>
        <MonacoEditor Value="@_model.YamlContent" ValueChanged="@(value => _model.YamlContent = value)" />
        <ValidationMessage For="@(() => _model.YamlContent)" />

        @if (!string.IsNullOrWhiteSpace(_template?.Changelog))
        {
            <RadzenFieldset Text="@L["Changelog"]" AllowCollapse="true" Collapsed="true" class="rz-mt-3">
                <pre class="text-block-pre">@_template.Changelog</pre>
            </RadzenFieldset>
        }

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-mt-4">
            <RadzenButton Text="@L["Cancel"]" Icon="close" Click="@Cancel"
                ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
            <RadzenButton Text="@L["Save"]" Icon="save" ButtonType="ButtonType.Submit"
                IsBusy="@_saving" Disabled="@_saving" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        </RadzenStack>
    </RadzenTemplateForm>
}
