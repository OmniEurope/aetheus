@using Aetheus.Shared.DTOs

<RadzenTemplateForm TItem="object" Data="@(new object())" Submit="@OnSubmit">
    <div class="run-params-dialog">
        <RunParameterFields @ref="_fields" Parameters="@Parameters" Prefill="@Prefill" AvailableReleases="@AvailableReleases" />

        @if (!string.IsNullOrEmpty(_error))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-2">@_error</RadzenAlert>
        }

        <DialogFooter OnCancel="@OnCancel">
            <RadzenButton ButtonType="ButtonType.Submit" Text="@(SubmitText ?? L["Run"])" Icon="@SubmitIcon" ButtonStyle="ButtonStyle.Success" Variant="Variant.Filled" />
        </DialogFooter>
    </div>
</RadzenTemplateForm>
