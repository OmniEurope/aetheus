<RadzenCard class="analysis-run-gate-overview analysis-run-gate-page rz-mt-3 rz-p-3">
    <div class="analysis-run-gate-heading">
        <RadzenIcon Icon="verified_user" />
        <div>
            <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@L["AnalysisGateTab"]</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">@L["AnalysisGateDescription"]</RadzenText>
        </div>
        <RadzenBadge BadgeStyle="@PipelineRunGatePresentation.GateStyle(Gate.Status)"
                     Text="@L[PipelineRunGatePresentation.StatusKey(Gate.Status)]" />
        @if (Gate.Grade?.OverallGrade is { } grade)
        {
            <strong class="@($"analysis-run-gate-grade {PipelineRunGatePresentation.GradeCss(grade)}")">@grade</strong>
        }
    </div>
    <div class="analysis-run-gate-toolbar rz-mb-3">
        <div class="analysis-run-gate-metrics">
            <div><strong>@Gate.FindingCount</strong><span>@L["AnalysisGateFindings"]</span></div>
            <div><strong>@Gate.NewFindingCount</strong><span>@L["AnalysisGateNewFindings"]</span></div>
            <div><strong>@Gate.ReportCount</strong><span>@L["AnalysisReports"]</span></div>
            <div><strong>@Gate.Violations.Count</strong><span>@L["AnalysisGateViolations"]</span></div>
        </div>
        <div class="analysis-run-gate-actions">
            @if (ProjectId is { } projectId)
            {
                <RadzenButton Text="@L["AnalysisOpenProjectQuality"]" Icon="open_in_new" Size="ButtonSize.Small"
                              ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled"
                              title="@L["AnalysisOpenProjectQuality"]" Click="@(() => OpenProjectQuality(projectId))" />
            }
            <RadzenButton Text="@L["AnalysisExportAllAiPrompt"]" Icon="download" Size="ButtonSize.Small"
                          ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled"
                          Disabled="@(Gate.Findings.Count == 0)" title="@L["AnalysisExportAllAiPrompt"]"
                          Click="ExportAllAiPromptAsync" />
        </div>
    </div>
    @if (Gate.Findings.Count == 0)
    {
        <EmptyState Icon="task_alt" Title="@L["AnalysisNoFindings"]" Description="@L["AnalysisNoFindingsDescription"]" />
    }
    else
    {
        <RadzenDataGrid Responsive="false" Data="@Gate.Findings" TItem="AnalysisRunGateFindingDto" AllowPaging="@(!AetheusGrid.Virtualization)" PageSize="25"
                        AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced"
                        Density="Density.Compact" class="analysis-run-findings-grid aetheus-grid-fullheight" AllowColumnResize="true" AllowVirtualization="@AetheusGrid.Virtualization" VirtualizationOverscanCount="3">
            <Columns>
                <RadzenDataGridColumn TItem="AnalysisRunGateFindingDto" Property="Severity" Title="@L["Severity"]" Width="7rem">
                    <Template Context="finding"><RadzenBadge BadgeStyle="@PipelineRunGatePresentation.SeverityStyle(finding.Severity)" Text="@L[PipelineRunGatePresentation.SeverityKey(finding.Severity)]" /></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AnalysisRunGateFindingDto" Property="Category" Title="@L["Category"]" Width="9rem">
                    <Template Context="finding">@L[PipelineRunGatePresentation.CategoryKey(finding.Category)]</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AnalysisRunGateFindingDto" Property="Title" Title="@L["Title"]" Width="22rem">
                    <Template Context="finding">
                        <div class="analysis-finding-grid-summary">
                            <a href="@FindingHref(finding.FindingId)" class="pipeline-name-link">@finding.Title</a>
                            <span class="analysis-finding-grid-message" title="@finding.Message">@finding.Message</span>
                        </div>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AnalysisRunGateFindingDto" Property="FilePath" Title="@L["AnalysisExactLocation"]" Width="19rem">
                    <Template Context="finding">
                        @if (string.IsNullOrWhiteSpace(finding.FilePath))
                        {
                            <span class="analysis-finding-location-unavailable">@L["AnalysisLocationUnavailable"]</span>
                        }
                        else
                        {
                            <div class="analysis-finding-location">
                                <RadzenIcon Icon="location_on" />
                                <div>
                                    <code title="@finding.FilePath">@finding.FilePath</code>
                                    @if (finding.StartLine is { } line)
                                    {
                                        <span>@L["AnalysisGateLine"] @line</span>
                                    }
                                </div>
                            </div>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AnalysisRunGateFindingDto" Property="RuleId" Title="@L["AnalysisRule"]" Width="12rem" />
                <RadzenDataGridColumn TItem="AnalysisRunGateFindingDto" Property="IsNew" Title="@L["AnalysisGateNewBadge"]" Width="5rem">
                    <Template Context="finding">@if (finding.IsNew) { <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@L["AnalysisGateNewBadge"]" /> }</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AnalysisRunGateFindingDto" Title="@L["Actions"]" Width="4rem" Sortable="false" Filterable="false">
                    <Template Context="finding"><RadzenButton Icon="open_in_new" Size="ButtonSize.ExtraSmall" title="@L["AnalysisGateOpenFinding"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" Click="@(() => OpenFinding(finding.FindingId))" /></Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>
