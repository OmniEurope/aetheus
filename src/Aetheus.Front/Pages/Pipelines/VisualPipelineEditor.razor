@using Aetheus.Shared.DTOs

@if (_parseError)
{
    <div class="vp-error-banner">
        <RadzenIcon Icon="error" />
        <span>@L["InvalidYamlCannotVisualize"]</span>
    </div>
}
else
{
    @* Pipeline-level settings (collapsible) *@
    <RadzenFieldset Text="@L["PipelineSettings"]" AllowCollapse="true" Collapsed="@_settingsCollapsed"
                    CollapseChanged="@((bool v) => _settingsCollapsed = v)">
        <div class="vp-settings-panel">
            <RadzenRow Gap="1rem">
                <RadzenColumn SizeMD="4">
                    <RadzenFormField Text="@L["Trigger"]">
                        <RadzenDropDown TValue="string" Value="@_definition.Trigger"
                                        Data="@_triggerOptions" Change="@(val => OnTriggerChanged((string)val))" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn SizeMD="4">
                    <RadzenFormField Text="@L["VariableLibraries"]">
                        <RadzenDropDown TValue="IEnumerable<string>" Value="@_definition.VariableLibraries"
                                        Data="@AvailableLibraries" Multiple="true" AllowClear="true" Chips="true"
                                        AllowFiltering="true" Placeholder="@L["SelectLibraries"]"
                                        Change="@(val => OnLibrariesChanged(val as IEnumerable<string>))" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn SizeMD="4">
                    <RadzenFormField Text="@L["Vaults"]">
                        <RadzenDropDown TValue="IEnumerable<string>" Value="@_definition.Vaults"
                                        Data="@AvailableVaults" Multiple="true" AllowClear="true" Chips="true"
                                        AllowFiltering="true" Placeholder="@L["SelectVaults"]"
                                        Change="@(val => OnVaultsChanged(val as IEnumerable<string>))" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            @* Pipeline-level variables *@
            <RadzenFieldset Text="@L["PipelineVariables"]" AllowCollapse="true" Collapsed="true" class="rz-mt-2">
                <div class="vp-var-grid">
                    @foreach (var kvp in _definition.Variables)
                    {
                        var key = kvp.Key;
                        <RadzenTextBox Value="@key" Disabled="true" class="icon-input-sm" />
                        <RadzenTextBox Value="@kvp.Value" Placeholder="@L["Value"]"
                                       Change="@(val => OnPipelineVarChanged(key, val))"
                                       class="icon-input-sm" />
                        <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall" Click="@(() => OnRemovePipelineVar(key))" Title="@L["Delete"]" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                    }
                </div>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" class="rz-mt-2">
                    <RadzenTextBox @bind-Value="_newPipelineVarKey" Placeholder="@L["Key"]" class="text-input-flex" />
                    <RadzenTextBox @bind-Value="_newPipelineVarValue" Placeholder="@L["Value"]" class="text-input-flex" />
                    <RadzenButton Icon="add" Size="ButtonSize.ExtraSmall" Click="@OnAddPipelineVar"
                                  Disabled="@string.IsNullOrWhiteSpace(_newPipelineVarKey)" Title="@L["Add"]" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                </RadzenStack>
            </RadzenFieldset>
        </div>
    </RadzenFieldset>

    @* Toolbar *@
    <div class="vp-toolbar">
        <RadzenButton Text="@L["AddStage"]" Icon="add" Size="ButtonSize.Small"
                      Click="@OnAddStage" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        <RadzenDropDown TValue="int?" Placeholder="@L["StageTemplate"]" Data="@_stageTemplateItems"
                        TextProperty="Text" ValueProperty="Value"
                        Change="@OnInsertStageTemplate"
                        class="w-rem-10 fs-13" />
        <RadzenButton Icon="undo" Size="ButtonSize.Small" Click="@OnUndo" Disabled="@(!CanUndo)"
                      title="@L["Undo"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        <RadzenButton Icon="redo" Size="ButtonSize.Small" Click="@OnRedo" Disabled="@(!CanRedo)"
                      title="@L["Redo"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        <RadzenButton Text="@L["AutoLayout"]" Icon="auto_fix_high" Size="ButtonSize.Small"
                      Click="@OnAutoLayout" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
        <RadzenButton Icon="zoom_in" Size="ButtonSize.Small" Click="@OnZoomIn" Title="@L["ZoomIn"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        <RadzenButton Icon="zoom_out" Size="ButtonSize.Small" Click="@OnZoomOut" Title="@L["ZoomOut"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        <RadzenButton Icon="fit_screen" Size="ButtonSize.Small" Click="@OnFitView" Title="@L["FitScreen"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
    </div>

    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" class="vp-editor-guide">
        <RadzenIcon Icon="info" />
        <span>@L["VisualPipelineGuide"]</span>
    </RadzenAlert>

    @if (_baseDefinition is not null)
    {
        <RadzenFieldset Text="@L["InheritedElements"]" AllowCollapse="true" Collapsed="false">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                @foreach (var item in ProvenanceItems)
                {
                    <RadzenBadge Text="@($"{ProvenanceText(item.Provenance)}: {item.Path}")"
                                 BadgeStyle="@ProvenanceStyle(item.Provenance)"
                                 class="@(item.Provenance == PipelineElementProvenance.Inherited ? "vp-provenance-inherited" : null)" />
                }
            </RadzenStack>
        </RadzenFieldset>
    }

    @* Canvas *@
    <div id="@_canvasId" class="vp-canvas-outer" tabindex="0" @onkeydown="OnCanvasKeyDown">
        <div class="vp-canvas-inner">
            @* SVG edge layer *@
            <svg class="vp-edge-layer" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <marker id="arrow-default" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
                        <polygon points="0 0, 10 3.5, 0 7" class="vp-edge-arrow" />
                    </marker>
                    <marker id="arrow-selected" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
                        <polygon points="0 0, 10 3.5, 0 7" class="vp-edge-arrow-selected" />
                    </marker>
                </defs>
                @foreach (var edge in _edges)
                {
                    var isSelected = edge.From == _selectedStageId || edge.To == _selectedStageId;
                    var markerUrl = isSelected ? "url(#arrow-selected)" : "url(#arrow-default)";
                    <path d="@edge.PathData" class="@(isSelected ? "vp-edge vp-edge-selected" : "vp-edge")"
                          data-from="@edge.From" data-to="@edge.To" marker-end="@markerUrl" />
                }
            </svg>

            @* Stage nodes *@
            @if (DisplayStages.Count == 0)
            {
                <div class="vp-empty-canvas">
                    <RadzenIcon Icon="account_tree" class="icon-3xl" />
                    <RadzenText TextStyle="TextStyle.Body1">@L["EmptyPipeline"]</RadzenText>
                    <RadzenButton Text="@L["AddStage"]" Icon="add" Click="@OnAddStage" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                </div>
            }
            else
            {
                @for (var i = 0; i < DisplayStages.Count; i++)
                {
                    var stage = DisplayStages[i];
                    var stageId = i.ToString();
                    var pos = _nodePositions.GetValueOrDefault(stageId);
                    var isReadOnly = GetLocalStageIndex(i) < 0;
                    <StageNode Stage="@stage"
                               ElementId="@($"vp-node-{_canvasId}-{stageId}")"
                               X="@(pos?.X ?? 0)" Y="@(pos?.Y ?? 0)"
                               IsSelected="@(_selectedStageId == stageId)"
                               ReadOnly="@isReadOnly"
                               Provenance="@StageProvenance(stage)"
                               AddStepText="@L["AddStep"]"
                               Warnings="@GetStageWarnings(stage)"
                               OnSelect="@(() => OnStageSelected(stageId))"
                               OnDelete="@(() => OnDeleteStage(stageId))"
                               OnDuplicate="@(() => OnDuplicateStage(stageId))"
                               OnAddStep="@(() => OnAddStepToStage(stageId))"
                               OnEditStep="@(idx => OnEditStepInStage(stageId, idx))" />
                }
            }
        </div>
    </div>

    @* Stage edit panel *@
    @if (_selectedStageId is not null && _selectedStageIndex >= 0 && _selectedStageIndex < _definition.Stages.Count)
    {
        <StageEditPanel Stage="@_definition.Stages[_selectedStageIndex]"
                        AvailableServers="@AvailableServers"
                        OtherStageNames="@GetOtherStageNames(_selectedStageIndex)"
                        StageChanged="@OnSelectedStageChanged"
                        OnClose="@(() => _selectedStageId = null)"
                        OnDeleteStage="@(() => OnDeleteStage(_selectedStageId!))"
                        EditStep="@(idx => OnEditStepInStage(_selectedStageId!, idx))"
                        AddStep="@(() => OnAddStepToStage(_selectedStageId!))" />
    }
}
