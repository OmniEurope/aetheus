<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" class="rz-mb-2">
    <RadzenButton Icon="content_copy" Size="ButtonSize.Small"
                  Text="@L["Copy"]" Click="@CopyAllAsync" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
</RadzenStack>
<RadzenDataGrid Data="@VariableList" TItem="KeyValuePair<string, string>" Density="Density.Compact"
    AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced">
    <Columns>
        <RadzenDataGridColumn TItem="KeyValuePair<string, string>" Property="Key" Title="@L["Key"]" />
        <RadzenDataGridColumn TItem="KeyValuePair<string, string>" Title="@L["Source"]" Width="7rem" Sortable="false">
            <Template Context="kv">
                @if (IsSystemVariable(kv.Key))
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@L["VarSourceSystem"]" />
                }
                else
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@L["VarSourceResolved"]" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="KeyValuePair<string, string>" Property="Value" Title="@L["Value"]">
            <Template Context="kv">
                <code>@kv.Value</code>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" class="rz-mt-3">
    <Aetheus.Front.Shared.DialogCloseButton />
</RadzenStack>
