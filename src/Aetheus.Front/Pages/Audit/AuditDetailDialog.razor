@using Aetheus.Shared.DTOs

<div>
    @* Server-verified hash-chain integrity for this entry (never an optimistic default). *@
    <RadzenCard class="rz-mb-3">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            @if (_verifying)
            {
                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.ExtraSmall" />
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">@L["AuditVerifying"]</RadzenText>
            }
            else if (_verification is null)
            {
                <RadzenIcon Icon="help" class="rz-color-secondary" />
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">@L["AuditIntegrityUnavailable"]</RadzenText>
            }
            else if (_verification.IsValid)
            {
                <RadzenIcon Icon="verified" class="rz-color-success" />
                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@L["AuditChainIntact"]" />
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                    @string.Format(L["AuditVerifiedThrough"], _verification.TotalEntries)
                </RadzenText>
            }
            else
            {
                <RadzenIcon Icon="gpp_bad" class="rz-color-danger" />
                <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="@L["AuditChainBroken"]" />
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                    @string.Format(L["AuditBreakAt"], _verification.FirstInvalidId)
                </RadzenText>
            }
        </RadzenStack>
    </RadzenCard>

    @* Structured facts: actor, action, target, time. *@
    <RadzenStack Gap="0.5rem">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="detail-row">
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary"><RadzenIcon Icon="person" class="run-tile-icon" /> @L["Actor"]</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2">@Log.Username</RadzenText>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="detail-row">
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary"><RadzenIcon Icon="bolt" class="run-tile-icon" /> @L["Action"]</RadzenText>
            <RadzenBadge BadgeStyle="@ActionBadge" Text="@L[$"AuditAction_{Log.Action}"]" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="detail-row">
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary"><RadzenIcon Icon="target" class="run-tile-icon" /> @L["Target"]</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="text-mono">@Log.EntityType@(Log.EntityId.HasValue ? $" #{Log.EntityId}" : string.Empty)</RadzenText>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="detail-row">
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary"><RadzenIcon Icon="schedule" class="run-tile-icon" /> @L["Timestamp"]</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2">@Log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</RadzenText>
        </RadzenStack>
    </RadzenStack>

    @if (!string.IsNullOrWhiteSpace(Log.Details))
    {
        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mt-3 rz-mb-1">@L["Details"]</RadzenText>
        <pre class="exception-pre">@FormattedDetails</pre>
    }

    <DialogFooter CancelText="@L["Close"]" OnCancel="Close">
        <SecondaryContent>
            @if (!string.IsNullOrWhiteSpace(Log.Details))
            {
                <RadzenButton Text="@L["Copy"]" Icon="content_copy" Click="CopyAsync" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
            }
        </SecondaryContent>
    </DialogFooter>
</div>
