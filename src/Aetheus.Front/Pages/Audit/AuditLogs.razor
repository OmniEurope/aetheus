@page "/admin/audit"
@page "/audit"
@using Aetheus.Front.Helpers

<PageTitle>@L["AuditLogs"] - Aetheus</PageTitle>

<Aetheus.Front.Shared.PageHeader Title="@L["AuditLogs"]" Icon="policy">
    <ChildContent>
        <HelpLink PageKey="audit" />
        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@string.Format(L["Total"], _count)" />
    </ChildContent>
    <Actions>
        @if (_chainResult is not null)
        {
            <RadzenBadge BadgeStyle="@(_chainResult.IsValid ? BadgeStyle.Success : BadgeStyle.Danger)"
                IsPill="true"
                Text="@(_chainResult.IsValid ? string.Format(L["AuditChainIntactCount"], _chainResult.TotalEntries) : string.Format(L["AuditBreakAt"], _chainResult.FirstInvalidId))" />
        }
        else if (_chainChecked)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@L["AuditIntegrityUnavailable"]" />
        }
        <RadzenButton Icon="verified_user" Text="@L["AuditVerifyChain"]" Size="ButtonSize.Small"
            Click="@VerifyChainAsync" IsBusy="_verifyingChain" BusyText="@L["AuditVerifying"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
        <RadzenButton Icon="refresh" Size="ButtonSize.Small"
            Click="@ReloadData" title="@L["Refresh"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
    </Actions>
    <Filters>
        <RadzenIcon Icon="filter_list" class="rz-color-secondary" />
        <RadzenTextBox Placeholder="@L["SearchAuditLogs"]" @bind-Value="_search"
            Change="@OnSearchChanged" class="pipeline-list-search" />
        <RadzenDropDown TValue="string" Data="@_actionOptions" Placeholder="@L["AllActions"]"
            AllowClear="true" @bind-Value="_actionFilter" Change="@(async (_) => await ReloadData())" />
        <RadzenDropDown TValue="string" Data="@_entityOptions" Placeholder="@L["AllEntities"]"
            AllowClear="true" @bind-Value="_entityFilter" Change="@(async (_) => await ReloadData())" />
        <RadzenDatePicker TValue="DateTime?" Placeholder="@L["DateFrom"]" @bind-Value="_dateFrom"
            DateFormat="yyyy-MM-dd" Change="@(async (_) => await ReloadData())" AllowClear="true" />
        <RadzenDatePicker TValue="DateTime?" Placeholder="@L["DateTo"]" @bind-Value="_dateTo"
            DateFormat="yyyy-MM-dd" Change="@(async (_) => await ReloadData())" AllowClear="true" />
        @if (!string.IsNullOrEmpty(_search) || !string.IsNullOrEmpty(_actionFilter) || !string.IsNullOrEmpty(_entityFilter) || _dateFrom.HasValue || _dateTo.HasValue)
        {
            <RadzenButton Text="@L["ClearFilters"]" Icon="clear" Size="ButtonSize.Small"
                Click="@ClearFilters" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        }
    </Filters>
</Aetheus.Front.Shared.PageHeader>
<AetheusDataGrid TItem="AuditLogDto" Data="@_logs" Count="@_count" LoadData="@LoadData"
    PageSize="50" AllowSorting="true" IsLoading="@_loading" Density="Density.Compact" FullHeight="true">
    <Columns>
        <RadzenDataGridColumn TItem="AuditLogDto" Property="Timestamp" Title="@L["Timestamp"]" Width="180px">
            <Template Context="log">
                <span title="@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")">@RelativeTime.FormatAgo(L, log.Timestamp)</span>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AuditLogDto" Property="Username" Title="@L["User"]" Width="140px" />
        <RadzenDataGridColumn TItem="AuditLogDto" Property="Action" Title="@L["Action"]" Width="160px">
            <Template Context="log">
                <RadzenBadge BadgeStyle="@GetActionBadge(log.Action)" Text="@L[$"AuditAction_{log.Action}"]" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AuditLogDto" Property="EntityType" Title="@L["EntityType"]" Width="160px" />
        <RadzenDataGridColumn TItem="AuditLogDto" Property="EntityId" Title="@L["ID"]" Width="80px" />
        <RadzenDataGridColumn TItem="AuditLogDto" Title="@L["Actions"]" MinWidth="15rem" Sortable="false" Filterable="false">
            <Template Context="log">
                <RadzenButton Text="@L["ViewDetails"]" Icon="visibility"
                              Click="@(() => ShowDetailsDialogAsync(log))" ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
                @if (!string.IsNullOrWhiteSpace(log.Details))
                {
                    <RadzenButton Text="@L["CopyDetails"]" Icon="content_copy"
                                  Click="@(() => CopyDetailsAsync(log.Details))" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AuditLogDto" Property="Details" Title="@L["Details"]" />
    </Columns>
</AetheusDataGrid>
