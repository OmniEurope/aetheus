@inherits EntityEditDialogBase
@using Aetheus.Shared.DTOs

<RadzenTemplateForm TItem="EditModel" Data="@_model" Submit="@SubmitAsync">
    <LocalizedDataAnnotationsValidator />
    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12">
            <RadzenFormField Text="@L["NotificationChannel"]" class="rz-w-100">
                <RadzenDropDown @bind-Value="_model.NotificationChannelId" Data="@Channels"
                    TextProperty="Name" ValueProperty="Id" Disabled="@IsEdit" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12">
            <RadzenFormField Text="@L["EventType"]" class="rz-w-100">
                <RadzenTextBox @bind-Value="_model.EventType" Placeholder="alert.triggered" />
            </RadzenFormField>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@L["NotificationEventTypeHint"]</RadzenText>
            <ValidationMessage For="@(() => _model.EventType)" />
        </RadzenColumn>
        @if (IsEdit)
        {
            <RadzenColumn Size="12">
                <LabeledToggle Kind="ToggleKind.Switch" @bind-Value="_model.IsEnabled" Text="@L["Active"]" />
            </RadzenColumn>
        }
        <RadzenColumn Size="12">
            <RadzenFormField Text="@L["NotificationFilter"]" class="rz-w-100">
                <RadzenTextArea @bind-Value="_model.FilterJson" Rows="3" class="text-mono" />
            </RadzenFormField>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@L["NotificationFilterHint"]</RadzenText>
        </RadzenColumn>
    </RadzenRow>
    <DialogFooter OnCancel="@Cancel">
        <RadzenButton Text="@(IsEdit ? L["Save"] : L["Create"])" Icon="@(IsEdit ? "save" : "add")"
                      ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" IsBusy="@_busy" />
    </DialogFooter>
</RadzenTemplateForm>
