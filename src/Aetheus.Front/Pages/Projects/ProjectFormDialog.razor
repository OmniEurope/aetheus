@* Create/Edit project as a dialog. Project == null => create mode; otherwise edit mode.
   Closes with the resulting ProjectDto on success (caller refreshes); a delete navigates away. *@
<RadzenTemplateForm TItem="ProjectFormModel" Data="@_model" Submit="@OnSubmit">
    <LocalizedDataAnnotationsValidator />
    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Gap="1rem">
                <RadzenFormField Text="@L["Name"]" class="rz-w-100">
                    <RadzenTextBox @bind-Value="_model.Name" @oninput="@(e => _model.Name = e.Value?.ToString() ?? string.Empty)"
                        Name="Name" id="project-form-name" class="rz-w-100" />
                    <ValidationMessage For="@(() => _model.Name)" />
                </RadzenFormField>
                <RadzenFormField Text="@L["Description"]" class="rz-w-100">
                    <RadzenTextArea @bind-Value="_model.Description" @oninput="@(e => _model.Description = e.Value?.ToString() ?? string.Empty)"
                        Name="Description" Rows="3" class="rz-w-100" />
                    <ValidationMessage For="@(() => _model.Description)" />
                </RadzenFormField>
            </RadzenStack>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Gap="1rem">
                <RadzenFormField Text="@L["RepositoryUrl"]" class="rz-w-100">
                    <RadzenTextBox @bind-Value="_model.RepositoryUrl" @oninput="@(e => _model.RepositoryUrl = e.Value?.ToString() ?? string.Empty)" Name="RepositoryUrl"
                        Placeholder="https://github.com/owner/repo.git" class="rz-w-100" />
                </RadzenFormField>
                <RadzenFormField Text="@L["DefaultBranch"]" class="rz-w-100">
                    <RadzenTextBox @bind-Value="_model.DefaultBranch" @oninput="@(e => _model.DefaultBranch = e.Value?.ToString() ?? string.Empty)"
                        Name="DefaultBranch" Placeholder="main" class="rz-w-100" />
                </RadzenFormField>
                @if (!_isNew)
                {
                    <RadzenFormField Text="@L["Status"]" class="rz-w-100">
                        <RadzenDropDown @bind-Value="_model.Status" Data="@_statusOptions"
                            TextProperty="Text" ValueProperty="Value" class="rz-w-100" />
                    </RadzenFormField>
                }
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    <RadzenFormField Text="@L["TagsCommaSeparated"]" class="rz-mt-3 rz-w-100">
        <RadzenTextBox @bind-Value="_model.TagsRaw" @oninput="@(e => _model.TagsRaw = e.Value?.ToString() ?? string.Empty)"
            Name="Tags" class="rz-w-100" />
    </RadzenFormField>

    @* S-FEAT-15 / S-FEAT-16: per-project CI/CD settings (blank = global / built-in default). *@
    <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mt-4 rz-mb-2 rz-color-secondary">@L["ProjectCiSettings"]</RadzenText>
    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenFormField Text="@L["ArtifactRetentionDays"]" class="rz-w-100">
                <RadzenNumeric @bind-Value="_model.ArtifactRetentionDays" Min="1" Max="3650" Name="ArtifactRetentionDays" class="rz-w-100" />
                <ValidationMessage For="@(() => _model.ArtifactRetentionDays)" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenFormField Text="@L["ArtifactLatestRetentionDays"]" class="rz-w-100">
                <RadzenNumeric @bind-Value="_model.ArtifactLatestRetentionDays" Min="1" Max="3650" Name="ArtifactLatestRetentionDays" class="rz-w-100" />
                <ValidationMessage For="@(() => _model.ArtifactLatestRetentionDays)" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenFormField Text="@L["ReleaseNumberingPattern"]" Component="ReleaseNumberingPattern" class="rz-w-100">
                <RadzenTextBox @bind-Value="_model.ReleaseNumberingPattern" @oninput="@(e => _model.ReleaseNumberingPattern = e.Value?.ToString() ?? string.Empty)"
                    Name="ReleaseNumberingPattern" Placeholder="1.0.$(BUILD_BUILDID)" class="rz-w-100" />
                <ValidationMessage For="@(() => _model.ReleaseNumberingPattern)" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>

    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mt-4">
        @if (!_isNew)
        {
            <RadzenButton ButtonType="ButtonType.Button" Text="@L["Delete"]" Icon="delete"
                Click="@OnDelete" Disabled="@_saving" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
        }
        <div class="flex-spacer"></div>
        <RadzenButton ButtonType="ButtonType.Button" Icon="close" Text="@L["Cancel"]" Click="@(() => Dialog.Close())" Disabled="@_saving" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        <RadzenButton ButtonType="ButtonType.Submit" Text="@(_isNew ? L["Create"] : L["Save"])"
            Icon="@(_isNew ? "add" : "save")" ButtonStyle="ButtonStyle.Primary" IsBusy="@_saving" />
    </RadzenStack>
</RadzenTemplateForm>
