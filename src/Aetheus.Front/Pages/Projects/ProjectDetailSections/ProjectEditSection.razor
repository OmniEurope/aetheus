@if (Project is null)
{
    <RadzenProgressBarCircular ShowValue="true" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <RadzenText TextStyle="TextStyle.H5" class="rz-mb-4">@L["EditProject"]</RadzenText>
    <RadzenTemplateForm TItem="ProjectEditSection.ProjectModel" Data="@_model" Submit="@OnSubmit">
        <LocalizedDataAnnotationsValidator />
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Gap="1rem">
                    <RadzenFormField Text="@L["Name"]">
                        <RadzenTextBox @bind-Value="_model.Name" Name="Name" />
                        <ValidationMessage For="@(() => _model.Name)" />
                    </RadzenFormField>
                    <RadzenFormField Text="@L["Description"]">
                        <RadzenTextArea @bind-Value="_model.Description" Name="Description" Rows="3" />
                    </RadzenFormField>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Gap="1rem">
                    <RadzenFormField Text="@L["RepositoryUrl"]">
                        <RadzenTextBox @bind-Value="_model.RepositoryUrl" Name="RepositoryUrl" Placeholder="https://..." />
                    </RadzenFormField>
                    <RadzenFormField Text="@L["DefaultBranch"]">
                        @if (_branchesLoaded)
                        {
                            <RadzenDropDown @bind-Value="_model.DefaultBranch" Data="@_branches" Name="DefaultBranch"
                                AllowClear="false" AllowFiltering="true" />
                        }
                        else
                        {
                            <RadzenTextBox @bind-Value="_model.DefaultBranch" Name="DefaultBranch" Placeholder="main" />
                        }
                    </RadzenFormField>
                    <RadzenFormField Text="@L["Status"]">
                        <RadzenDropDown @bind-Value="_model.Status" Data="@_statusOptions"
                            TextProperty="Text" ValueProperty="Value" />
                    </RadzenFormField>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        <RadzenFormField Text="@L["TagsCommaSeparated"]" class="rz-mt-4 rz-w-100">
            <RadzenTextBox @bind-Value="_model.TagsRaw" Name="Tags" />
        </RadzenFormField>

        @* S-FEAT-15 / S-FEAT-16: per-project CI/CD settings (blank = use the global / built-in default) *@
        <RadzenText TextStyle="TextStyle.H6" class="rz-mt-4 rz-mb-2">@L["ProjectCiSettings"]</RadzenText>
        <RadzenRow Gap="1rem" class="project-ci-settings-row">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenFormField Text="@L["ArtifactRetentionDays"]" class="rz-w-100">
                    <RadzenNumeric @bind-Value="_model.ArtifactRetentionDays" Min="1" Max="3650" Name="ArtifactRetentionDays" class="rz-w-100" />
                    <ValidationMessage For="@(() => _model.ArtifactRetentionDays)" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenFormField Text="@L["ArtifactLatestRetentionDays"]" class="rz-w-100">
                    <RadzenNumeric @bind-Value="_model.ArtifactLatestRetentionDays" Min="1" Max="3650" Name="ArtifactLatestRetentionDays" class="rz-w-100" />
                    <ValidationMessage For="@(() => _model.ArtifactLatestRetentionDays)" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenFormField Text="@L["ReleaseNumberingPattern"]" Component="ReleaseNumberingPattern" class="rz-w-100">
                    <RadzenTextBox @bind-Value="_model.ReleaseNumberingPattern" Name="ReleaseNumberingPattern" Placeholder="1.0.$(BUILD_BUILDID)" class="rz-w-100" />
                    <ValidationMessage For="@(() => _model.ReleaseNumberingPattern)" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-4">
            <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Save"]" Icon="save" IsBusy="@_saving" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
            <RadzenButton Text="@L["Delete"]" Icon="delete" Click="@OnDelete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
        </RadzenStack>
    </RadzenTemplateForm>
}
