@using Aetheus.Shared.Enums

<RadzenText TextStyle="TextStyle.H5" class="rz-mb-3">@L["ExternalRepo"]</RadzenText>

@if (_loading)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
}
else if (!_enabled)
{
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenIcon Icon="toggle_off" class="rz-color-secondary" />
            <RadzenText TextStyle="TextStyle.Body1" class="rz-color-secondary">@L["ExternalRepoDisabled"]</RadzenText>
        </RadzenStack>
    </RadzenCard>
}
else if (_repo is not null)
{
    @* Attached: show mirror status + actions. *@
    <RadzenCard>
        <RadzenStack Gap="0.5rem">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0">
                    @_repo.ProviderType / @_repo.OwnerOrGroup / @_repo.RepositoryName
                </RadzenText>
                <RadzenBadge BadgeStyle="@MirrorBadge(_repo.MirrorStatus)" Text="@L.Localize(_repo.MirrorStatus)" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="detail-row">
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">@L["LastFetched"]</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@(_repo.LastFetchedAt?.ToString("g") ?? "-")</RadzenText>
            </RadzenStack>
            @if (!string.IsNullOrEmpty(_repo.LastFetchError))
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-danger">@_repo.LastFetchError</RadzenText>
            }
            @if (!string.IsNullOrEmpty(_repo.CloneUrl))
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="detail-row">
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">@L["Url"]</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" class="text-mono">@_repo.CloneUrl</RadzenText>
                </RadzenStack>
            }
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@L["ExternalRepoCloneHint"]</RadzenText>
            @if (_canWrite)
            {
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-2">
                    <RadzenButton Text="@L["SyncNow"]" Icon="sync" Size="ButtonSize.Small" IsBusy="_syncing" Click="@SyncNowAsync" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                    <RadzenButton Text="@L["Detach"]" Icon="link_off" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" Click="@DetachAsync" />
                </RadzenStack>
            }
        </RadzenStack>
    </RadzenCard>
}
else if (_canWrite)
{
    @* Not attached: attach form. *@
    <RadzenCard>
        <RadzenTemplateForm TItem="AttachModel" Data="@_model" Submit="@AttachAsync">
            <LocalizedDataAnnotationsValidator />
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="@L["Provider"]" class="rz-w-100">
                        <RadzenDropDown @bind-Value="_model.ProviderType" Data="@_providers" TextProperty="Text" ValueProperty="Value" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenFormField Text="@L["BaseUrl"]" class="rz-w-100">
                        <RadzenTextBox @bind-Value="_model.BaseUrl" Placeholder="https://gitea.example.com" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="@L["OwnerOrGroup"]" class="rz-w-100">
                        <RadzenTextBox @bind-Value="_model.OwnerOrGroup" />
                    </RadzenFormField>
                    <ValidationMessage For="@(() => _model.OwnerOrGroup)" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="@L["RepositoryName"]" class="rz-w-100">
                        <RadzenTextBox @bind-Value="_model.RepositoryName" />
                    </RadzenFormField>
                    <ValidationMessage For="@(() => _model.RepositoryName)" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="@L["DefaultBranch"]" class="rz-w-100">
                        <RadzenTextBox @bind-Value="_model.DefaultBranch" Placeholder="main" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="@L["AuthType"]" class="rz-w-100">
                        <RadzenDropDown @bind-Value="_model.AuthType" Data="@_authTypes" TextProperty="Text" ValueProperty="Value" />
                    </RadzenFormField>
                </RadzenColumn>
                @if (_model.AuthType == GitAuthType.HttpsToken)
                {
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="@L["Username"]" class="rz-w-100">
                            <RadzenTextBox @bind-Value="_model.Username" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="@L["Token"]" class="rz-w-100">
                            <RadzenPassword @bind-Value="_model.Token" />
                        </RadzenFormField>
                    </RadzenColumn>
                }
                else
                {
                    <RadzenColumn Size="12">
                        <RadzenFormField Text="@L["PrivateKey"]" class="rz-w-100">
                            <RadzenTextArea @bind-Value="_model.PrivateKeyPem" Rows="3" class="text-mono" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="@L["Passphrase"]" class="rz-w-100">
                            <RadzenPassword @bind-Value="_model.Passphrase" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="@L["KnownHosts"]" class="rz-w-100">
                            <RadzenTextBox @bind-Value="_model.KnownHosts" />
                        </RadzenFormField>
                    </RadzenColumn>
                }
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="@L["FetchIntervalMinutes"]" class="rz-w-100">
                        <RadzenNumeric @bind-Value="_model.FetchIntervalMinutes" Min="1" Max="1440" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <LabeledToggle Kind="ToggleKind.Switch" Class="rz-mt-4" @bind-Value="_model.AutoSyncEnabled" Text="@L["AutoSync"]" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <LabeledToggle Kind="ToggleKind.Switch" Class="rz-mt-4" @bind-Value="_model.WriteEnabled" Text="@L["WriteEnabled"]" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mt-2">@L["ExternalRepoCloneHint"]</RadzenText>
            <RadzenButton Text="@L["Attach"]" Icon="link" ButtonType="ButtonType.Submit" IsBusy="_busy" class="rz-mt-3" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
        </RadzenTemplateForm>
    </RadzenCard>
}
else
{
    <EmptyState Icon="link_off" Title="@L["NoExternalRepo"]" Description="@L["NoExternalRepoDescription"]" />
}
