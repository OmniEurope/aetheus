@using Aetheus.Shared.Enums

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-3">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
        <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@L["Board"]</RadzenText>
        <RadzenDropDown TValue="string" Data="@Assignees" @bind-Value="_assigneeFilter" AllowClear="true"
            Placeholder="@L["Assignee"]" Change="@(() => StateHasChanged())" class="kanban-filter" />
        <RadzenDropDown TValue="string" Data="@Tags" @bind-Value="_tagFilter" AllowClear="true"
            Placeholder="@L["Tags"]" Change="@(() => StateHasChanged())" class="kanban-filter" />
    </RadzenStack>
    @if (_canWrite)
    {
        <RadzenButton Text="@L["Create"]" Icon="add" Size="ButtonSize.Small" Click="@OpenCreateAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
    }
</RadzenStack>

@if (_loading)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
}
else
{
    <div class="kanban-board">
        @foreach (var status in Columns)
        {
            var columnStatus = status;
            <div class="kanban-column">
                <div class="kanban-column-header">
                    <span>@L.Localize(columnStatus)</span>
                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@ColumnItems(columnStatus).Count().ToString()" />
                </div>
                <div class="kanban-column-drop @(_dropTarget == columnStatus ? "kanban-drop-active" : "")"
                     @ondragover:preventDefault="true"
                     @ondragenter="@(() => _dropTarget = columnStatus)"
                     @ondragenter:preventDefault="true"
                     @ondrop="@(() => OnDropAsync(columnStatus))">
                    @foreach (var item in ColumnItems(columnStatus))
                    {
                        var card = item;
                        <RadzenCard class="@($"kanban-card {(_dragged?.Id == card.Id ? "kanban-card-dragging" : "")}")"
                                    draggable="@(_canWrite ? "true" : "false")"
                                    @ondragstart="@(() => OnDragStart(card))"
                                    @ondragend="@OnDragEnd"
                                    @onclick="@(() => OpenEditAsync(card))">
                            <div class="kanban-card-title">@card.Title</div>
                            <div class="kanban-card-meta">
                                <RadzenBadge BadgeStyle="@TypeBadge(card.Type)" Text="@L.Localize(card.Type)" />
                                @if (!string.IsNullOrEmpty(card.AssigneeName))
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@card.AssigneeName" />
                                }
                                @foreach (var tag in card.Tags)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Base" Text="@tag" />
                                }
                                @if (_canWrite)
                                {
                                    <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall" title="@L["Delete"]" aria-label="@L["Delete"]"
                                        Click="@(() => DeleteAsync(card))" @onclick:stopPropagation="true" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                                }
                            </div>
                        </RadzenCard>
                    }
                </div>
            </div>
        }
    </div>
}
