@if (_loading)
{
    <AetheusLoader />
}
else
{
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-4">
        <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@L["Artifacts"]</RadzenText>
        <RadzenButton Icon="refresh" Size="ButtonSize.Small"
            Click="@LoadDataAsync" title="@L["Refresh"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mb-3">
        <RadzenDropDown TValue="ArtifactRetentionPolicy?" @bind-Value="@_selectedPolicy" Change="@(_ => LoadDataAsync())"
            Placeholder="@L["AllTypes"]" AllowClear="true" Data="@_policyOptions" TextProperty="Label" ValueProperty="Value" class="artifact-policy-filter" />
    </RadzenStack>

    <RadzenDataGrid Responsive="false" Data="@_artifacts" TItem="PipelineArtifactDto" Density="Density.Compact"
        Count="@_totalCount" PageSize="@_pageSize" AllowPaging="@(!AetheusGrid.Virtualization)"
        LoadData="@OnLoadData" EmptyText="@L["NoArtifactsFound"]" class="aetheus-clickable-rows"
        RowClick="@OnRowClick" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced" AllowColumnResize="true" AllowVirtualization="@AetheusGrid.Virtualization" VirtualizationOverscanCount="3">
        <Columns>
            <RadzenDataGridColumn TItem="PipelineArtifactDto" Title="" Width="50px" Sortable="false" Filterable="false">
                <Template Context="a">
                    <span @onclick:stopPropagation="true">
                        <RadzenButton Icon="download" Size="ButtonSize.Small"
                            Click="@(() => DownloadArtifact(a))" title="@L["Download"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
                    </span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineArtifactDto" Property="Name" Title="@L["Name"]" Width="200px">
                <Template Context="a">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                        <RadzenIcon Icon="inventory_2" class="rz-color-secondary" />
                        <a href="/artifacts/@a.Id" class="pipeline-name-link" @onclick:stopPropagation="true">@a.Name</a>
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineArtifactDto" Property="PipelineName" Title="@L["Pipeline"]" Width="160px">
                <Template Context="a">
                    <a href="/pipelines/runs/@a.PipelineRunId" class="pipeline-name-link" @onclick:stopPropagation="true">@a.PipelineName</a>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineArtifactDto" Property="RetentionPolicy" Title="@L["Type"]" Width="100px">
                <Template Context="a">
                    <RadzenBadge BadgeStyle="@GetPolicyBadge(a.RetentionPolicy)" Text="@a.RetentionPolicy.ToString()" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineArtifactDto" Property="EnvironmentName" Title="@L["Environment"]" Width="120px">
                <Template Context="a">
                    @if (!string.IsNullOrEmpty(a.EnvironmentName))
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@a.EnvironmentName" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineArtifactDto" Title="@L["Release"]" Width="100px" Sortable="false">
                <Template Context="a">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" Wrap="FlexWrap.Wrap">
                        @foreach (var rel in a.Releases)
                        {
                            <a href="/releases/@rel.Id" class="pipeline-name-link" @onclick:stopPropagation="true">@rel.Version</a>
                        }
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineArtifactDto" Property="SizeBytes" Title="@L["Size"]" Width="90px">
                <Template Context="a">
                    @FormatSize(a.SizeBytes)
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PipelineArtifactDto" Property="CreatedAt" Title="@L["Date"]" FormatString="{0:g}" Width="140px" />
        </Columns>
    </RadzenDataGrid>
}
