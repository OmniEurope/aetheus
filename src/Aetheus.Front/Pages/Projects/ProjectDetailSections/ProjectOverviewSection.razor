@if (Project is null)
{
    <AetheusLoader />
}
else
{
    <UrlSyncedTabs Slugs="@TabSlugs" Class="project-overview-tabs">
        <Tabs>
            <RadzenTabsItem Text="@L["Overview"]" Icon="dashboard">
                @if (ShowGettingStarted)
                {
                    <RadzenCard class="project-onboarding rz-mb-5">
                        <div class="project-onboarding-heading">
                            <span class="project-onboarding-heading-icon" aria-hidden="true"><RadzenIcon Icon="rocket_launch" /></span>
                            <div>
                                <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@L["ProjectGettingStartedTitle"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2" class="project-onboarding-copy rz-m-0">@L["ProjectGettingStartedDescription"]</RadzenText>
                            </div>
                        </div>
                        <div class="project-onboarding-grid">
                            <a href="@GitOnboardingHref" class="tile-link project-onboarding-link">
                                <RadzenCard class="@($"project-onboarding-step {(_hasGitRepository ? "project-onboarding-step-ready" : string.Empty)}")">
                                    <div class="project-onboarding-step-heading">
                                        <span class="project-onboarding-icon"><RadzenIcon Icon="commit" /></span>
                                        <RadzenText TextStyle="TextStyle.H5" class="project-onboarding-title rz-m-0">1. @L["CreateGitRepository"]</RadzenText>
                                        <span class="@($"project-onboarding-state {(_hasGitRepository ? "is-ready" : string.Empty)}")">
                                            <RadzenIcon Icon="@(_hasGitRepository ? "check" : "arrow_forward")" />
                                            <span>@(_hasGitRepository ? L["Ready"] : L["Configure"])</span>
                                        </span>
                                    </div>
                                    <RadzenText TextStyle="TextStyle.Body2" class="project-onboarding-copy rz-m-0">@L["CreateGitRepositoryHint"]</RadzenText>
                                </RadzenCard>
                            </a>
                            <a href="@EnvironmentOnboardingHref" class="tile-link project-onboarding-link">
                                <RadzenCard class="@($"project-onboarding-step {(Project.EnvironmentCount > 0 ? "project-onboarding-step-ready" : string.Empty)}")">
                                    <div class="project-onboarding-step-heading">
                                        <span class="project-onboarding-icon"><RadzenIcon Icon="layers" /></span>
                                        <RadzenText TextStyle="TextStyle.H5" class="project-onboarding-title rz-m-0">2. @L["CreateEnvironment"]</RadzenText>
                                        <span class="@($"project-onboarding-state {(Project.EnvironmentCount > 0 ? "is-ready" : string.Empty)}")">
                                            <RadzenIcon Icon="@(Project.EnvironmentCount > 0 ? "check" : "arrow_forward")" />
                                            <span>@(Project.EnvironmentCount > 0 ? L["Ready"] : L["Configure"])</span>
                                        </span>
                                    </div>
                                    <RadzenText TextStyle="TextStyle.Body2" class="project-onboarding-copy rz-m-0">@L["CreateEnvironmentHint"]</RadzenText>
                                </RadzenCard>
                            </a>
                            <a href="@PipelineOnboardingHref" class="tile-link project-onboarding-link">
                                <RadzenCard class="@($"project-onboarding-step {(Project.Pipelines.Count > 0 ? "project-onboarding-step-ready" : string.Empty)}")">
                                    <div class="project-onboarding-step-heading">
                                        <span class="project-onboarding-icon"><RadzenIcon Icon="account_tree" /></span>
                                        <RadzenText TextStyle="TextStyle.H5" class="project-onboarding-title rz-m-0">3. @L["CreatePipeline"]</RadzenText>
                                        <span class="@($"project-onboarding-state {(Project.Pipelines.Count > 0 ? "is-ready" : string.Empty)}")">
                                            <RadzenIcon Icon="@(Project.Pipelines.Count > 0 ? "check" : "arrow_forward")" />
                                            <span>@(Project.Pipelines.Count > 0 ? L["Ready"] : L["Configure"])</span>
                                        </span>
                                    </div>
                                    <RadzenText TextStyle="TextStyle.Body2" class="project-onboarding-copy rz-m-0">@L["CreatePipelineHint"]</RadzenText>
                                </RadzenCard>
                            </a>
                        </div>
                    </RadzenCard>
                }

                @* Two balanced cards: "Information" (description, status, dates, tags) on the left,
                   "Repository" (git source, branch, last git activity) on the right. *@
                <RadzenRow Gap="1rem">
                    <RadzenColumn SizeMD="6" Size="12">
                        <RadzenCard class="overview-info-card">
                            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-3">@L["Information"]</RadzenText>
                            <div class="essentials-grid essentials-grid--stacked">
                                @if (!string.IsNullOrWhiteSpace(Project.Description))
                                {
                                    <div class="essential-item">
                                        <RadzenIcon Icon="notes" class="essential-icon" />
                                        <div class="essential-text">
                                            <span class="essential-label">@L["Description"]</span>
                                            <span class="essential-value">@Project.Description</span>
                                        </div>
                                    </div>
                                }
                                <div class="essential-item">
                                    <RadzenIcon Icon="sensors" class="essential-icon" />
                                    <div class="essential-text">
                                        <span class="essential-label">@L["Status"]</span>
                                        <span class="essential-value">
                                            <RadzenBadge BadgeStyle="@(Project.Status == ProjectStatus.Active ? BadgeStyle.Success : BadgeStyle.Light)"
                                                Text="@L[Project.Status.ToString()]" />
                                        </span>
                                    </div>
                                </div>
                                <div class="essential-item">
                                    <RadzenIcon Icon="verified" class="essential-icon" />
                                    <div class="essential-text">
                                        <span class="essential-label">@L["AnalysisGrade"]</span>
                                        <a href="@($"/projects/{Project.Id}/quality")"
                                            class="@($"project-gate-grade project-overview-gate-grade {GradeCss(Project.LatestGateGrade)}")"
                                            title="@L["AnalysisGlobalGrade"]">
                                            @GradeText(Project.LatestGateGrade)
                                        </a>
                                    </div>
                                </div>
                                <div class="essential-item">
                                    <RadzenIcon Icon="event" class="essential-icon" />
                                    <div class="essential-text">
                                        <span class="essential-label">@L["Created"]</span>
                                        <span class="essential-value">@Project.CreatedAt.ToString("g")</span>
                                    </div>
                                </div>
                                <div class="essential-item">
                                    <RadzenIcon Icon="update" class="essential-icon" />
                                    <div class="essential-text">
                                        <span class="essential-label">@L["Updated"]</span>
                                        <span class="essential-value">@Project.UpdatedAt.ToString("g")</span>
                                    </div>
                                </div>
                                @if (Project.Tags.Count > 0)
                                {
                                    <div class="essential-item">
                                        <RadzenIcon Icon="sell" class="essential-icon" />
                                        <div class="essential-text">
                                            <span class="essential-label">@L["Tags"]</span>
                                            <span class="essential-value">
                                                @foreach (var tag in Project.Tags)
                                                {
                                                    <RadzenBadge Text="@tag" BadgeStyle="BadgeStyle.Light" />
                                                }
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </RadzenCard>
                    </RadzenColumn>
                    <RadzenColumn SizeMD="6" Size="12">
                        <RadzenCard class="overview-info-card">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem" class="rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0">@L["Repository"]</RadzenText>
                                @if (Permissions.CanWrite(ResourceType.Project, Project.Id))
                                {
                                    <RadzenButton Text="@L["AddGitRepository"]" Icon="add" Size="ButtonSize.Small"
                                        Click="AddGitRepository" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                                }
                            </RadzenStack>
                            @if (string.IsNullOrWhiteSpace(Project.RepositoryUrl) && _primaryGitRepository is null)
                            {
                                <EmptyState Icon="commit" Description="@L["NoRepository"]" />
                            }
                            else
                            {
                                <div class="essentials-grid essentials-grid--stacked">
                                    @if (_primaryGitRepository is not null)
                                    {
                                        <div class="essential-item">
                                            <RadzenIcon Icon="folder_open" class="essential-icon" />
                                            <div class="essential-text">
                                                <span class="essential-label">@L["RepositoryName"]</span>
                                                <a class="essential-value pipeline-name-link"
                                                   href="@($"/git-repositories/{_primaryGitRepository.Id}")">@_primaryGitRepository.Name</a>
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(RepositoryDisplayUrl))
                                    {
                                        <div class="essential-item">
                                            <RadzenIcon Icon="link" class="essential-icon" />
                                            <div class="essential-text">
                                                <span class="essential-label">@L["RepositoryUrl"]</span>
                                                <span class="essential-value overview-break-anywhere">@RepositoryDisplayUrl</span>
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(RepositoryDisplayBranch))
                                    {
                                        <div class="essential-item">
                                            <RadzenIcon Icon="account_tree" class="essential-icon" />
                                            <div class="essential-text">
                                                <span class="essential-label">@L["DefaultBranch"]</span>
                                                <span class="essential-value">@RepositoryDisplayBranch</span>
                                            </div>
                                        </div>
                                    }
                                    @if (Project.LastGitUpdateAt.HasValue)
                                    {
                                        <div class="essential-item">
                                            <RadzenIcon Icon="history" class="essential-icon" />
                                            <div class="essential-text">
                                                <span class="essential-label">@L["LastGitUpdate"]</span>
                                                <span class="essential-value"
                                                    title="@Project.LastGitUpdateAt.Value.ToString("F")">@RelativeTime.FormatAgo(L, Project.LastGitUpdateAt.Value)</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </RadzenCard>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenText TextStyle="TextStyle.H5" class="rz-mt-6 rz-mb-2">@L["ProjectSections"]</RadzenText>
                <div class="project-section-grid-scroll rz-mb-4" role="region" aria-label="@L["ProjectSections"]" tabindex="0">
                    <div class="project-section-grid">
                        @foreach (var navItem in ProjectNavigationCatalog.VisibleItems(Permissions, Project.Id))
                        {
                            var isPipeline = navItem.Slug == "pipelines";
                            var isCurrent = navItem.Slug == "overview";
                            <a href="@(navItem.Href(Project.Id))"
                               class="tile-link project-section-link"
                               aria-current="@(isCurrent ? "page" : null)">
                                <RadzenCard class="@($"tile-clickable project-section-tile{(isCurrent ? " project-section-tile-current" : string.Empty)}")">
                                    <div class="project-section-tile-content">
                                        <div class="project-section-tile-heading">
                                            <RadzenIcon Icon="@(navItem.Icon)" />
                                            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0">@L[navItem.LabelKey]</RadzenText>
                                            @if (isPipeline && LatestRunStatus is { } status)
                                            {
                                                <span class="pipeline-run-dot pipeline-run-dot-@status.ToString().ToLowerInvariant()"
                                                      title="@L.Localize(status)"></span>
                                            }
                                        </div>
                                        @if (isPipeline)
                                        {
                                            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@Project.Pipelines.Count.ToString()" />
                                        }
                                    </div>
                                </RadzenCard>
                            </a>
                        }
                    </div>
                </div>

                @* F-bis: coverage + LOC of the run behind the most recent release (shown only when real data exists) *@
                @if (_lastReleaseMetrics is { } metrics)
                {
                    <RadzenText TextStyle="TextStyle.H5" class="rz-mt-6 rz-mb-2">@L["LastReleaseMetrics"]</RadzenText>
                    <RadzenCard class="rz-p-3">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem" Wrap="FlexWrap.Wrap">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenBadge BadgeStyle="BadgeStyle.Light" Icon="new_releases" Text="@metrics.Version" />
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-m-0" title="@metrics.When.ToString("F")">@RelativeTime.FormatAgo(L, metrics.When)</RadzenText>
                            </RadzenStack>
                            @if (metrics.CoverageLineRate is { } cov)
                            {
                                <RadzenStack Gap="0.125rem">
                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-m-0">@L["Coverage"]</RadzenText>
                                    <RadzenText TextStyle="TextStyle.H5" class="@($"{CoverageColorClass(cov)} rz-m-0")">@($"{cov * 100:F1}%")</RadzenText>
                                </RadzenStack>
                            }
                            @if (metrics.LinesOfCode is { } loc)
                            {
                                <RadzenStack Gap="0.125rem">
                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-m-0">@L["LinesOfCode"]</RadzenText>
                                    <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@loc.ToString("N0")</RadzenText>
                                </RadzenStack>
                            }
                        </RadzenStack>
                    </RadzenCard>
                }

                <RadzenRow Gap="1rem" class="rz-mt-6 equal-tile-row project-overview-recent-row">
                    <RadzenColumn SizeMD="6" Size="12">
                        <RadzenCard class="project-overview-recent-card">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-2">
                                <RadzenIcon Icon="commit" />
                                <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@L["RecentCommits"]</RadzenText>
                            </RadzenStack>
                            @if (_loadingRecentCommits)
                            {
                                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" aria-label="@L["Loading"]" />
                            }
                            <RadzenDataGrid Responsive="false" Data="@_recentCommits" TItem="RecentCommitView" Density="Density.Compact"
                                AllowPaging="@(!AetheusGrid.Virtualization)" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced"
                                IsLoading="@_loadingRecentCommits" EmptyText="@L["NoRecentCommits"]"
                                RowClick="@OnRecentCommitClick" class="aetheus-clickable-rows project-overview-recent-grid" AllowColumnResize="true" AllowVirtualization="@AetheusGrid.Virtualization" VirtualizationOverscanCount="3">
                                <Columns>
                                    <RadzenDataGridColumn TItem="RecentCommitView" Property="ShortSha" Title="@L["Commit"]" Width="6rem">
                                        <Template Context="commit">
                                            <a href="@CommitHref(commit)" title="@commit.RepositoryName" @onclick:stopPropagation="true">@commit.ShortSha</a>
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="RecentCommitView" Property="BranchName" Title="@L["Branch"]" Width="5.5rem" />
                                    <RadzenDataGridColumn TItem="RecentCommitView" Property="Message" Title="@L["Message"]" MinWidth="8rem" />
                                    <RadzenDataGridColumn TItem="RecentCommitView" Property="AuthorDate" Title="@L["Date"]" Width="6.5rem">
                                        <Template Context="commit">
                                            <span title="@commit.AuthorDate.ToString("F")">@RelativeTime.FormatAgo(L, commit.AuthorDate)</span>
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        </RadzenCard>
                    </RadzenColumn>
                    <RadzenColumn SizeMD="6" Size="12">
                        <RadzenCard class="project-overview-recent-card">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-2">
                                <RadzenIcon Icon="history" />
                                <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@L["RecentPipelines"]</RadzenText>
                            </RadzenStack>
                            <PipelineRunsGrid Items="@_recentPipelineRuns" Compact="true" AllowPaging="@(!AetheusGrid.Virtualization)"
                                IsLoading="@_loadingRecentPipelines" MaxGroups="@RecentItemLimit"
                                CssClass="project-overview-recent-grid"
                                EmptyTitleKey="NoRecentPipelines" EmptyDescriptionKey="NoRecentPipelines" />
                        </RadzenCard>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenTabsItem>

            <RadzenTabsItem Text="@L["Readme"]" Icon="description">
                <section class="project-readme-panel">
                    @if (!string.IsNullOrWhiteSpace(_readmeBranch))
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-color-secondary rz-m-0">@L["DefaultBranch"]</RadzenText>
                            <RadzenBadge Text="@_readmeBranch" BadgeStyle="BadgeStyle.Light" />
                        </RadzenStack>
                    }
                    @if (string.IsNullOrEmpty(_readmeHtml))
                    {
                        <EmptyState Icon="description" Title="@L["NoProjectReadme"]"
                            Description="@L["NoProjectReadmeHint"]" />
                    }
                    else
                    {
                        <article class="readme-rendered project-readme-content">@((MarkupString)_readmeHtml)</article>
                    }
                </section>
            </RadzenTabsItem>

            <RadzenTabsItem Text="@L["Changelog"]" Icon="history">
                @if (_changelog.Count == 0)
                {
                    <EmptyState Icon="history" Title="@L["NoProjectChangelog"]"
                        Description="@L["NoProjectChangelogHint"]" />
                }
                else
                {
                    <RadzenTimeline Orientation="Orientation.Vertical" AlignItems="AlignItems.Start"
                        LinePosition="LinePosition.Start" class="rz-mt-2 project-activity-timeline project-changelog-timeline">
                        <Items>
                            @foreach (var release in _changelog)
                            {
                                var when = release.PublishedAt ?? release.DetectedAt;
                                <RadzenTimelineItem PointStyle="@ReleasePointStyle(release.Status)">
                                    <PointContent>
                                        <RadzenIcon Icon="new_releases" />
                                    </PointContent>
                                    <ChildContent>
                                        <RadzenStack Gap="0.5rem" class="project-changelog-entry">
                                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-m-0"
                                                title="@when.ToString("F")">@RelativeTime.FormatAgo(L, when)</RadzenText>
                                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">@release.Version</RadzenText>
                                                <RadzenBadge Text="@L.Localize(release.Status)" BadgeStyle="BadgeStyle.Light" />
                                                @if (!string.IsNullOrWhiteSpace(release.TagName))
                                                {
                                                    <RadzenBadge Text="@release.TagName" BadgeStyle="BadgeStyle.Light" />
                                                }
                                            </RadzenStack>
                                            <RadzenText TextStyle="TextStyle.Body2" class="project-changelog-copy rz-m-0">@release.Changelog</RadzenText>
                                        </RadzenStack>
                                    </ChildContent>
                                </RadzenTimelineItem>
                            }
                        </Items>
                    </RadzenTimeline>
                }
            </RadzenTabsItem>
        </Tabs>
    </UrlSyncedTabs>
}
