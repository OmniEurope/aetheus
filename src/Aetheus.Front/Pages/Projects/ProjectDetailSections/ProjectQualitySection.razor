@if (_loading)
{
    <AetheusLoader />
}
else
{
    <div class="@($"analysis-quality-workspace {(_qualitySectionIndex == 1 ? "analysis-quality-findings" : string.Empty)}")">
        <UrlSyncedTabs Slugs="@QualitySectionSlugs"
                       @bind-SelectedIndex="_qualitySectionIndex"
                       Change="OnQualitySectionChangedAsync"
                       RenderMode="TabRenderMode.Client"
                       TabPosition="TabPosition.Top"
                       class="analysis-workspace-tabs">
            <Tabs>
                <RadzenTabsItem Text="@L["AnalysisOverview"]" Icon="insights" />
                <RadzenTabsItem Text="@SectionText(L["AnalysisFindings"], _summary.OpenCount)" Icon="policy" />
            </Tabs>
        </UrlSyncedTabs>

        <section class="analysis-workspace-panel" role="tabpanel">
        @if (_qualitySectionIndex == 0)
        {
                <RadzenCard class="@($"analysis-grade-overview {GradeCss(_summary.Grade?.OverallGrade)}")">
                    <div class="analysis-grade-primary">
                        <div class="analysis-grade-letter" aria-label="@L["AnalysisGlobalGrade"]">
                            @GradeText(_summary.Grade?.OverallGrade)
                        </div>
                        <div>
                            <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@L["AnalysisGlobalGrade"]</RadzenText>
                            @if (_summary.Grade is null)
                            {
                                <RadzenText>@L["AnalysisGradeNotConfigured"]</RadzenText>
                            }
                            else if (_summary.Grade.Completeness == AnalysisGradeCompleteness.Incomplete)
                            {
                                <RadzenText>@L["AnalysisGradeIncomplete"]</RadzenText>
                            }
                            else
                            {
                                <RadzenText>@L["AnalysisLimitingDomain"]: @DomainLabel(_summary.Grade.LimitingDomain)</RadzenText>
                            }
                            <div class="analysis-grade-meta">
                                <span>@L["Commit"]: @ShortCommit(_summary.Grade?.CommitHash)</span>
                                <span>@L["Date"]: @(_summary.Grade?.EvaluatedAt?.ToString("g") ?? L["NotAvailable"])</span>
                            </div>
                        </div>
                    </div>
                    @if (_summary.Grade is not null)
                    {
                        <div class="analysis-grade-domains">
                            @foreach (var domain in QualityDomains)
                            {
                                <section class="analysis-grade-domain">
                                    <div class="analysis-grade-domain-heading">
                                        <span>@domain.Label</span>
                                        <strong class="@GradeCss(domain.Grade)">@GradeText(domain.Grade)</strong>
                                    </div>
                                    <div class="analysis-grade-domain-state">
                                        @(domain.Required ? L["AnalysisRequired"] : L["AnalysisAdvisory"])
                                        · @(domain.Completeness == AnalysisGradeCompleteness.Complete ? L["Complete"] : L["Incomplete"])
                                        · @L["AnalysisFreshness"]: @(domain.EvaluatedAt?.ToString("g") ?? L["NotAvailable"])
                                    </div>
                                    @foreach (var measure in domain.Measures)
                                    {
                                        <div class="analysis-grade-measure">
                                            <span title="@measure.Key">@MeasureLabel(measure.Key)</span>
                                            <strong class="@GradeCss(measure.Grade)">@GradeText(measure.Grade)</strong>
                                            <span class="analysis-grade-value">@MeasureText(measure)</span>
                                            @if (measure.DistanceToNextGrade.HasValue && measure.NextGrade.HasValue)
                                            {
                                                <small>@L["AnalysisDistanceToGrade", measure.DistanceToNextGrade.Value.ToString("0.##"), measure.NextGrade]</small>
                                            }
                                        </div>
                                    }
                                    @if (domain.CrapScore.HasValue)
                                    {
                                        <div class="analysis-grade-measure">
                                            <span title="complexity.crap.avg">@L["AnalysisCrapAverage"]</span>
                                            <strong aria-label="@L["AnalysisAdvisory"]">–</strong>
                                            <span class="analysis-grade-value">@domain.CrapScore.Value.ToString("0.0")</span>
                                            <small>@L["AnalysisCrapExplanation"]</small>
                                        </div>
                                    }
                                </section>
                            }
                        </div>
                    }
                </RadzenCard>

                <RadzenRow Gap="1rem" class="rz-mb-4 analysis-summary-row">
                    <RadzenColumn Size="6" SizeMD="4" SizeXL="2">
                        <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" class="analysis-summary-card analysis-summary-action"
                                      Click="@(() => OpenFindingsAsync(status: AnalysisFindingStatus.Open))"
                                      title="@L["AnalysisOpenFindings"]" aria-label="@L["AnalysisOpenFindings"]" data-quality-shortcut="open">
                            <RadzenIcon Icon="bug_report" /><RadzenText TextStyle="TextStyle.H4">@_summary.OpenCount</RadzenText><RadzenText>@L["AnalysisOpenFindings"]</RadzenText>
                        </RadzenButton>
                    </RadzenColumn>
                    <RadzenColumn Size="6" SizeMD="4" SizeXL="2">
                        <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" class="analysis-summary-card analysis-summary-action"
                                      Click="@(() => OpenFindingsAsync(isNew: true))"
                                      title="@L["AnalysisNewFindings"]" aria-label="@L["AnalysisNewFindings"]" data-quality-shortcut="new">
                            <RadzenIcon Icon="fiber_new" /><RadzenText TextStyle="TextStyle.H4">@_summary.NewCount</RadzenText><RadzenText>@L["AnalysisNewFindings"]</RadzenText>
                        </RadzenButton>
                    </RadzenColumn>
                    <RadzenColumn Size="6" SizeMD="4" SizeXL="2">
                        <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" class="analysis-summary-card analysis-summary-action analysis-critical"
                                      Click="@(() => OpenFindingsAsync(status: AnalysisFindingStatus.Open, severity: AnalysisSeverity.Critical))"
                                      title="@L["Critical"]" aria-label="@L["Critical"]" data-quality-shortcut="critical">
                            <RadzenIcon Icon="crisis_alert" /><RadzenText TextStyle="TextStyle.H4">@_summary.CriticalCount</RadzenText><RadzenText>@L["Critical"]</RadzenText>
                        </RadzenButton>
                    </RadzenColumn>
                    <RadzenColumn Size="6" SizeMD="4" SizeXL="2">
                        <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" class="analysis-summary-card analysis-summary-action analysis-high"
                                      Click="@(() => OpenFindingsAsync(status: AnalysisFindingStatus.Open, severity: AnalysisSeverity.High))"
                                      title="@L["High"]" aria-label="@L["High"]" data-quality-shortcut="high">
                            <RadzenIcon Icon="priority_high" /><RadzenText TextStyle="TextStyle.H4">@_summary.HighCount</RadzenText><RadzenText>@L["High"]</RadzenText>
                        </RadzenButton>
                    </RadzenColumn>
                    <RadzenColumn Size="6" SizeMD="4" SizeXL="2">
                        <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" class="analysis-summary-card analysis-summary-action"
                                      Click="@(() => OpenFindingsAsync(status: AnalysisFindingStatus.Fixed))"
                                      title="@L["Fixed"]" aria-label="@L["Fixed"]" data-quality-shortcut="fixed">
                            <RadzenIcon Icon="verified" /><RadzenText TextStyle="TextStyle.H4">@_summary.FixedCount</RadzenText><RadzenText>@L["Fixed"]</RadzenText>
                        </RadzenButton>
                    </RadzenColumn>
                    <RadzenColumn Size="6" SizeMD="4" SizeXL="2">
                        <div class="analysis-summary-card analysis-summary-static" aria-label="@L["AnalysisLastRun"]">
                            <RadzenIcon Icon="schedule" /><RadzenText TextStyle="TextStyle.Subtitle1">@(_summary.LastAnalysisAt?.ToString("g") ?? L["Never"])</RadzenText><RadzenText>@L["AnalysisLastRun"]</RadzenText>
                        </div>
                    </RadzenColumn>
                </RadzenRow>

                @if (!HasAny)
                {
                    <EmptyState Icon="insights" Title="@L["NoQualityData"]" Description="@L["NoQualityDataDescription"]" />
                }
                else
                {
                    <RadzenRow Gap="1rem">
                        @if (_coverage.Count == 1)
                        {
                            <RadzenColumn Size="12" SizeLG="6"><RadzenCard class="analysis-chart-card">
                                <RadzenText TextStyle="TextStyle.Subtitle2">@L["CoverageTrend"]</RadzenText>
                                <RadzenDataGrid Responsive="false" Data="@_coverage" TItem="CoveragePoint" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced" Density="Density.Compact" class="analysis-table" AllowColumnResize="true" AllowVirtualization="@AetheusGrid.Virtualization" VirtualizationOverscanCount="3" AllowPaging="@(!AetheusGrid.Virtualization)">
                                    <Columns><RadzenDataGridColumn TItem="CoveragePoint" Property="Label" Title="@L["PipelineRun"]" /><RadzenDataGridColumn TItem="CoveragePoint" Property="LinePct" Title="@L["LineCoverage"]" FormatString="{0:0.0}%" /><RadzenDataGridColumn TItem="CoveragePoint" Property="BranchPct" Title="@L["BranchCoverage"]" FormatString="{0:0.0}%" /></Columns>
                                </RadzenDataGrid>
                            </RadzenCard></RadzenColumn>
                        }
                        @if (_coverage.Count >= 2)
                        {
                            <RadzenColumn Size="12" SizeLG="6"><RadzenCard class="analysis-chart-card">
                                <RadzenText TextStyle="TextStyle.Subtitle2">@L["CoverageTrend"]</RadzenText>
                                <RadzenChart><RadzenLineSeries Data="@_coverage" CategoryProperty="Label" ValueProperty="LinePct" Title="@L["LineCoverage"]" Smooth="true"><RadzenMarkers MarkerType="MarkerType.Circle" /></RadzenLineSeries><RadzenLineSeries Data="@_coverage" CategoryProperty="Label" ValueProperty="BranchPct" Title="@L["BranchCoverage"]" Smooth="true" /><RadzenValueAxis Min="0" Max="100" Step="25" /><RadzenCategoryAxis /><RadzenLegend Position="LegendPosition.Bottom" /></RadzenChart>
                            </RadzenCard></RadzenColumn>
                        }
                        @if (_tests.Count >= 2)
                        {
                            <RadzenColumn Size="12" SizeLG="6"><RadzenCard class="analysis-chart-card">
                                <RadzenText TextStyle="TextStyle.Subtitle2">@L["TestTrend"]</RadzenText>
                                <RadzenChart><RadzenLineSeries Data="@_tests" CategoryProperty="Label" ValueProperty="Passed" Title="@L["Passed"]" Smooth="true" /><RadzenLineSeries Data="@_tests" CategoryProperty="Label" ValueProperty="Failed" Title="@L["Failed"]" Smooth="true" /><RadzenValueAxis /><RadzenCategoryAxis /><RadzenLegend Position="LegendPosition.Bottom" /></RadzenChart>
                            </RadzenCard></RadzenColumn>
                        }
                        @if (_complexity.Count >= 2)
                        {
                            <RadzenColumn Size="12" SizeLG="6"><RadzenCard class="analysis-chart-card">
                                <RadzenText TextStyle="TextStyle.Subtitle2">@L["ComplexityTrend"]</RadzenText>
                                <RadzenChart><RadzenLineSeries Data="@_complexity" CategoryProperty="Label" ValueProperty="Crap" Title="CRAP" Smooth="true" /><RadzenLineSeries Data="@_complexity" CategoryProperty="Label" ValueProperty="AvgCc" Title="@L["AvgCyclomatic"]" Smooth="true" /><RadzenValueAxis /><RadzenCategoryAxis /><RadzenLegend Position="LegendPosition.Bottom" /></RadzenChart>
                            </RadzenCard></RadzenColumn>
                        }
                    </RadzenRow>
                }
        }
        else
        {
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" Wrap="FlexWrap.Wrap" class="rz-mb-3 analysis-finding-filters">
                    <RadzenTextBox @bind-Value="_findingSearch" Placeholder="@L["Search"]" Change="ReloadFindingsAsync" />
                    <RadzenDropDown TValue="AnalysisCategory?" @bind-Value="_findingCategory" Data="@_categories" AllowClear="true" Placeholder="@L["Category"]" Change="ReloadFindingsAsync" />
                    <RadzenDropDown TValue="AnalysisSeverity?" @bind-Value="_findingSeverity" Data="@_severities" AllowClear="true" Placeholder="@L["Severity"]" Change="ReloadFindingsAsync" />
                    <RadzenDropDown TValue="AnalysisFindingStatus?" @bind-Value="_findingStatus" Data="@_findingStatuses" AllowClear="true" Placeholder="@L["Status"]" Change="ReloadFindingsAsync" />
                    <RadzenDropDown TValue="bool?" @bind-Value="_findingIsNew" Data="@FindingNewnessOptions" TextProperty="Label" ValueProperty="Value" AllowClear="true" Placeholder="@L["AnalysisNewness"]" Change="ReloadFindingsAsync" />
                    <RadzenTextBox @bind-Value="_findingScanner" Placeholder="@L["AnalysisScanner"]" Change="ReloadFindingsAsync" />
                     <RadzenTextBox @bind-Value="_findingBranch" Placeholder="@L["Branch"]" Change="ReloadFindingsAsync" />
                     <RadzenTextBox @bind-Value="_findingResponsible" Placeholder="@L["AnalysisResponsible"]" Change="ReloadFindingsAsync" />
                     <RadzenButton Text="@L["AnalysisExportAllAiPrompt"]" Icon="download" Size="ButtonSize.Small"
                                   ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled"
                                   IsBusy="@_exportingPrompt" Disabled="@(_findingCount == 0 || _exportingPrompt)"
                                   title="@L["AnalysisExportAllAiPrompt"]" Click="ExportAllAiPromptAsync" />
                 </RadzenStack>
                 <RadzenDataGrid Responsive="false" @ref="_findingsGrid" Data="@_findings" Count="@_findingCount" TItem="AnalysisFindingDto" LoadData="LoadFindingsAsync" RowClick="OpenFinding" AllowPaging="@(!AetheusGrid.Virtualization)" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced" PageSize="25" Density="Density.Compact" class="analysis-table aetheus-clickable-rows aetheus-grid-fullheight" AllowColumnResize="true" AllowVirtualization="@AetheusGrid.Virtualization" VirtualizationOverscanCount="3">
                    <Columns>
                        <RadzenDataGridColumn TItem="AnalysisFindingDto" Property="Id" Title="ID" Width="6rem"><Template Context="item"><RadzenLink Path="@($"analysis/findings/{item.Id}")" Text="@($"#{item.Id}")" /></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="AnalysisFindingDto" Property="Severity" Title="@L["Severity"]" Width="8rem"><Template Context="item"><RadzenBadge Text="@item.Severity.ToString()" BadgeStyle="@SeverityStyle(item.Severity)" /></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="AnalysisFindingDto" Property="Category" Title="@L["Category"]" />
                        <RadzenDataGridColumn TItem="AnalysisFindingDto" Property="RuleId" Title="@L["AnalysisRule"]" />
                        <RadzenDataGridColumn TItem="AnalysisFindingDto" Property="Title" Title="@L["Title"]" />
                        <RadzenDataGridColumn TItem="AnalysisFindingDto" Property="Status" Title="@L["Status"]" />
                        <RadzenDataGridColumn TItem="AnalysisFindingDto" Property="Responsible" Title="@L["AnalysisResponsible"]" />
                        <RadzenDataGridColumn TItem="AnalysisFindingDto" Property="LastSeenAt" Title="@L["LastSeen"]" FormatString="{0:g}" />
                    </Columns>
                </RadzenDataGrid>
        }
        </section>
    </div>
}
