@inherits ProjectPagedSectionBase<TaskLogDto>
@if (_result is null)
{
    <AetheusLoader />
}
else
{
    <RadzenText TextStyle="TextStyle.H5" class="rz-mb-4">@L["Logs"]</RadzenText>
    <RadzenTextBox Placeholder="@L["Search"]" @bind-Value="_search" Change="@OnSearchChangedAsync"
        class="pipeline-list-search rz-mb-2" />
    <AetheusDataGrid @ref="_grid" Data="@_result.Items" TItem="TaskLogDto"
        Count="@_result.TotalCount" IsLoading="@_loading" LoadData="@OnLoadDataAsync"
        PageSize="25" EmptyText="@L["NoLogs"]">
        <EmptyTemplate>
            <EmptyState Icon="article" Title="@L["NoLogs"]" />
        </EmptyTemplate>
        <Columns>
            <RadzenDataGridColumn TItem="TaskLogDto" Property="Timestamp" Title="@L["Time"]" FormatString="{0:G}" Width="180px" />
            <RadzenDataGridColumn TItem="TaskLogDto" Property="Level" Title="@L["Level"]" Width="100px">
                <Template Context="log">
                    <RadzenBadge BadgeStyle="@GetLevelBadge(log.Level)" Text="@L[log.Level.ToString()]" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="TaskLogDto" Property="Message" Title="@L["Message"]" MinWidth="18rem" />
        </Columns>
    </AetheusDataGrid>
}
