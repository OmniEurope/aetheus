@using Aetheus.Shared.Enums

<RadzenStack Gap="1rem">
    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="@L["Version"]" AllowFloatingLabel="false">
                <RadzenTextBox Value="@Release.Version" ReadOnly="true" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="@L["Status"]" AllowFloatingLabel="false">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" class="rz-p-2">
                    <RadzenBadge BadgeStyle="@ReleaseHelper.GetReleaseBadge(Release.Status)" Text="@L[Release.Status.ToString()]" />
                </RadzenStack>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>

    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="@L["Branch"]" AllowFloatingLabel="false">
                <RadzenTextBox Value="@Release.BranchName" ReadOnly="true" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="#" AllowFloatingLabel="false">
                <RadzenTextBox Value="@Release.BuildNumber.ToString()" ReadOnly="true" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>

    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="@L["Detected"]" AllowFloatingLabel="false">
                <RadzenTextBox Value="@Release.DetectedAt.ToString("g")" ReadOnly="true" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            @if (Release.PublishedAt.HasValue)
            {
                <RadzenFormField Text="@L["Published"]" AllowFloatingLabel="false">
                    <RadzenTextBox Value="@Release.PublishedAt.Value.ToString("g")" ReadOnly="true" />
                </RadzenFormField>
            }
        </RadzenColumn>
    </RadzenRow>

    @if (!string.IsNullOrEmpty(Release.Changelog))
    {
        <RadzenFormField Text="@L["Changelog"]" AllowFloatingLabel="false">
            <RadzenTextArea Value="@Release.Changelog" ReadOnly="true" Rows="6" class="rz-w-100" />
        </RadzenFormField>
    }

    <DialogFooter CancelText="@L["Close"]" OnCancel="@(() => Dialog.Close())">
        <SecondaryContent>
            @if (Release.Artifacts.Count > 0)
            {
                <RadzenButton Text="@L["Artifact"]" Icon="inventory_2" Click="@(() => Nav.NavigateTo($"/projects/{Release.ProjectId}/artifacts"))" ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
            }
            @if (Release.PipelineRunId.HasValue)
            {
                <RadzenButton Text="@L["PipelineRun"]" Icon="visibility" Click="@(() => Nav.NavigateTo($"/pipelines/runs/{Release.PipelineRunId}"))" ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
            }
        </SecondaryContent>
    </DialogFooter>
</RadzenStack>
