@using Aetheus.Shared.Enums

<RadzenTemplateForm TItem="EditModel" Data="@_model" Submit="@SubmitAsync">
    <LocalizedDataAnnotationsValidator />
    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12">
            <RadzenFormField Text="@L["Title"]" class="rz-w-100">
                <RadzenTextBox @bind-Value="_model.Title" />
            </RadzenFormField>
            <ValidationMessage For="@(() => _model.Title)" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenFormField Text="@L["Type"]" class="rz-w-100">
                <RadzenDropDown @bind-Value="_model.Type" Data="@_types" TextProperty="Text" ValueProperty="Value" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenFormField Text="@L["Status"]" class="rz-w-100">
                <RadzenDropDown @bind-Value="_model.Status" Data="@_statuses" TextProperty="Text" ValueProperty="Value" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenFormField Text="@L["Priority"]" class="rz-w-100">
                <RadzenNumeric @bind-Value="_model.Priority" Min="0" Max="4" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12">
            <RadzenFormField Text="@L["Description"]" class="rz-w-100">
                <RadzenTextArea @bind-Value="_model.Description" Rows="3" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12">
            <RadzenFormField Text="@L["Tags"]" class="rz-w-100">
                <RadzenTextBox @bind-Value="_model.TagsCsv" Placeholder="frontend, urgent" />
            </RadzenFormField>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@L["TagsHint"]</RadzenText>
        </RadzenColumn>
    </RadzenRow>
    <DialogFooter OnCancel="@Cancel">
        <RadzenButton Text="@(IsEdit ? L["Save"] : L["Create"])" Icon="@(IsEdit ? "save" : "add")"
                      ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" IsBusy="@_busy" />
    </DialogFooter>
</RadzenTemplateForm>
