@page "/projects"

<PageTitle>@L["Projects"] - Aetheus</PageTitle>

<div class="project-list-toolbar">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap"
        class="project-list-heading">
        <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">@L["Projects"]</RadzenText>
        <HelpLink PageKey="projects" />
        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@(string.Format(L["Total"], VisibleProjects.Count))" />
        <div class="project-list-spacer"></div>
        <RadzenButton Icon="refresh" Size="ButtonSize.Small"
            Click="@LoadData" title="@L["Refresh"]" aria-label="@L["Refresh"]"
            ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        <RadzenButton Text="@L["NewProject"]" Icon="add" Click="@OpenCreateDialog"
            Disabled="@(!_canWrite)" title="@(!_canWrite ? L["InsufficientPermissions"] : "")"
            ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" class="project-list-create" />
    </RadzenStack>

    <div class="project-list-controls">
        <div class="project-list-search-wrap">
            <RadzenIcon Icon="search" class="rz-color-secondary project-list-search-icon" />
            <RadzenTextBox Placeholder="@L["SearchProjects"]" @bind-Value="_search" Change="@(_ => ApplyFilters())"
                class="project-list-search" aria-label="@L["SearchProjects"]" />
        </div>
        <RadzenDropDown TValue="ProjectStatus?" Data="@_statusOptions" TextProperty="Text" ValueProperty="Value"
            Placeholder="@L["AllStatuses"]" AllowClear="true" @bind-Value="_statusFilter"
            Change="@(_ => ApplyFilters())" aria-label="@L["FilterByStatus"]" class="project-list-status-filter" />
        <RadzenDropDown TValue="ProjectSortOption" Data="@_sortOptions" TextProperty="Text" ValueProperty="Value"
            @bind-Value="_sortOption" aria-label="@L["SortProjects"]" class="project-list-sort" />
        <RadzenButton Icon="@(_favoritesOnly ? "star" : "star_border")" Text="@L["FavoritesOnly"]"
            Click="@ToggleFavoritesOnly" aria-pressed="@_favoritesOnly"
            ButtonStyle="@(_favoritesOnly ? ButtonStyle.Primary : ButtonStyle.Light)"
            Variant="@(_favoritesOnly ? Variant.Flat : Variant.Outlined)"
            class="project-favorites-filter" />
        <div class="project-view-switch" role="group" aria-label="@L["ProjectViewMode"]">
            <RadzenButton Icon="grid_view" Size="ButtonSize.Small"
                Click="@(() => SetViewModeAsync(ProjectViewMode.Comfortable))"
                title="@L["ComfortableView"]" aria-label="@L["ComfortableView"]"
                aria-pressed="@(_viewMode == ProjectViewMode.Comfortable)"
                ButtonStyle="@(_viewMode == ProjectViewMode.Comfortable ? ButtonStyle.Primary : ButtonStyle.Light)"
                Variant="@(_viewMode == ProjectViewMode.Comfortable ? Variant.Flat : Variant.Text)" />
            <RadzenButton Icon="view_list" Size="ButtonSize.Small"
                Click="@(() => SetViewModeAsync(ProjectViewMode.Dense))"
                title="@L["DenseView"]" aria-label="@L["DenseView"]"
                aria-pressed="@(_viewMode == ProjectViewMode.Dense)"
                ButtonStyle="@(_viewMode == ProjectViewMode.Dense ? ButtonStyle.Primary : ButtonStyle.Light)"
                Variant="@(_viewMode == ProjectViewMode.Dense ? Variant.Flat : Variant.Text)" />
        </div>
        @if (_statusFilter.HasValue || !string.IsNullOrEmpty(_search) || _favoritesOnly)
        {
            <RadzenButton Text="@L["ClearFilters"]" Icon="clear" Size="ButtonSize.Small"
                Click="@ClearFilters" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        }
    </div>
</div>

@if (_loading)
{
    <div class="project-card-grid-loading">
        <AetheusLoader />
    </div>
}
else if (_viewMode == ProjectViewMode.Comfortable)
{
    <div class="project-card-grid">
        @foreach (var project in VisibleProjects)
        {
            <RadzenCard class="project-card" role="link" tabindex="0" data-testid="project-item"
                @onclick="@(() => OpenProject(project.Id))"
                @onkeydown="@((KeyboardEventArgs args) => OnProjectKeyDown(args, project.Id))">
                <div class="project-card-header">
                    <RadzenIcon Icon="folder" class="project-card-icon" />
                    <div class="project-card-heading">
                        <a href="@($"/projects/{project.Id}")" class="project-card-name"
                            @onclick:stopPropagation="true">@project.Name</a>
                        <RadzenBadge BadgeStyle="@(project.Status == ProjectStatus.Active ? BadgeStyle.Success : BadgeStyle.Light)"
                            Text="@L[project.Status.ToString()]" class="project-card-status" />
                    </div>
                    @if (!Permissions.CanWrite(ResourceType.Project, project.Id))
                    {
                        <RadzenIcon Icon="lock" class="rz-color-secondary icon-xs-app" title="@L["Read"]" />
                    }
                    <span class="project-card-action" @onclick:stopPropagation="true">
                        <RadzenButton Icon="@(_favoriteProjectIds.Contains(project.Id) ? "star" : "star_border")"
                            Size="ButtonSize.Small" Click="@(() => ToggleFavoriteAsync(project))"
                            title="@(_favoriteProjectIds.Contains(project.Id) ? L["RemoveFromFavorites"] : L["AddToFavorites"])"
                            aria-label="@(_favoriteProjectIds.Contains(project.Id) ? L["RemoveFromFavorites"] : L["AddToFavorites"])"
                            aria-pressed="@_favoriteProjectIds.Contains(project.Id)"
                            ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                            class="@(_favoriteProjectIds.Contains(project.Id) ? "project-favorite active" : "project-favorite")" />
                    </span>
                </div>

                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary project-card-desc">
                    @(string.IsNullOrWhiteSpace(project.Description) ? L["NoDescription"] : TruncateText(project.Description, 120))
                </RadzenText>

                <div class="project-production">
                    <span class="project-production-label">@L["Production"]</span>
                    <span class="@($"project-production-status {ProductionStatusClass(project.ProductionStatus)}")">
                        <span class="project-production-dot"></span>
                        @L[$"Production{project.ProductionStatus}"]
                    </span>
                    <a href="@($"/projects/{project.Id}/quality")" class="project-gate-summary"
                        @onclick:stopPropagation="true" title="@L["AnalysisGlobalGrade"]">
                        <span class="project-production-label">@L["AnalysisGrade"]</span>
                        <strong class="@($"project-gate-grade {GradeCss(project.LatestGateGrade)}")">
                            @GradeText(project.LatestGateGrade)
                        </strong>
                    </a>
                    @if (project.OnlineUserCount.HasValue)
                    {
                        <span class="project-online-users" title="@L["OnlineUsersAvailable"]">
                            <RadzenIcon Icon="group" />
                            @(string.Format(L["OnlineUsers"], project.OnlineUserCount.Value))
                        </span>
                    }
                </div>

                <div class="project-activity">
                    <div class="project-activity-row">
                        <span class="project-activity-label">@L["LastCommit"]</span>
                        <div class="project-activity-content">
                            @if (project.LastCommitId.HasValue)
                            {
                                <a href="@GitCommitHref(project)" class="project-activity-link"
                                    @onclick:stopPropagation="true" title="@project.LastCommitMessage">
                                    <code>@ShortSha(project.LastCommitSha)</code>
                                    <span>@(string.IsNullOrWhiteSpace(project.LastCommitMessage) ? L["Commit"] : TruncateText(project.LastCommitMessage, 46))</span>
                                </a>
                                @if (project.LastCommitAt.HasValue)
                                {
                                    <span class="project-activity-date" title="@project.LastCommitAt.Value.ToString("F")">
                                        @project.LastCommitAt.Value.ToString("g") · @RelativeTime.FormatAgo(L, project.LastCommitAt.Value)
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="project-activity-empty">@L["Unavailable"]</span>
                            }
                        </div>
                    </div>
                    <div class="project-activity-row">
                        <span class="project-activity-label">@L["LastRun"]</span>
                        <div class="project-activity-content">
                            @if (project.LastRunId.HasValue)
                            {
                                <div class="project-activity-run">
                                    <span class="@($"pipeline-run-dot pipeline-run-dot-{RunStatusClass(project.LastRunStatus)}")"></span>
                                    <a href="@($"/pipelines/runs/{project.LastRunId}")" class="project-activity-link"
                                        @onclick:stopPropagation="true">
                                        #@project.LastRunId · @(project.LastRunName ?? L["PipelineRun"])
                                    </a>
                                </div>
                                @if (project.LastRunAt.HasValue)
                                {
                                    <span class="project-activity-date" title="@project.LastRunAt.Value.ToString("F")">
                                        @project.LastRunAt.Value.ToString("g") · @RelativeTime.FormatAgo(L, project.LastRunAt.Value)
                                    </span>
                                }
                                @if (project.ParentRunId.HasValue)
                                {
                                    <span class="project-parent-run">
                                        <RadzenIcon Icon="subdirectory_arrow_right" />
                                        @L["ChildOf"]
                                        <a href="@($"/pipelines/runs/{project.ParentRunId}")"
                                            @onclick:stopPropagation="true">
                                            #@project.ParentRunId · @(project.ParentRunName ?? L["PipelineRun"])
                                        </a>
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="project-activity-empty">@L["Unavailable"]</span>
                            }
                        </div>
                    </div>
                </div>

                @if (project.Tags.Count > 0)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" Wrap="FlexWrap.Wrap"
                        class="project-card-tags">
                        @foreach (var tag in project.Tags.Take(4))
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@tag" />
                        }
                        @if (project.Tags.Count > 4)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"+{project.Tags.Count - 4}")" />
                        }
                    </RadzenStack>
                }
            </RadzenCard>
        }
    </div>
}
else
{
    <div class="project-dense-list">
        <div class="project-dense-header" aria-hidden="true">
            <span>@L["Project"]</span>
            <span>@L["Production"]</span>
            <span>@L["AnalysisGrade"]</span>
            <span>@L["LastCommit"]</span>
            <span>@L["LastRun"]</span>
            <span>@L["OnlineUsersHeader"]</span>
        </div>
        @foreach (var project in VisibleProjects)
        {
            <div class="project-dense-row" role="link" tabindex="0" data-testid="project-item"
                @onclick="@(() => OpenProject(project.Id))"
                @onkeydown="@((KeyboardEventArgs args) => OnProjectKeyDown(args, project.Id))">
                <div class="project-dense-project">
                    <span @onclick:stopPropagation="true">
                        <RadzenButton Icon="@(_favoriteProjectIds.Contains(project.Id) ? "star" : "star_border")"
                            Size="ButtonSize.Small" Click="@(() => ToggleFavoriteAsync(project))"
                            title="@(_favoriteProjectIds.Contains(project.Id) ? L["RemoveFromFavorites"] : L["AddToFavorites"])"
                            aria-label="@(_favoriteProjectIds.Contains(project.Id) ? L["RemoveFromFavorites"] : L["AddToFavorites"])"
                            aria-pressed="@_favoriteProjectIds.Contains(project.Id)"
                            ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                            class="@(_favoriteProjectIds.Contains(project.Id) ? "project-favorite active" : "project-favorite")" />
                    </span>
                    <RadzenIcon Icon="folder" class="project-dense-folder" />
                    <div>
                        <a href="@($"/projects/{project.Id}")" @onclick:stopPropagation="true">@project.Name</a>
                        <span class="project-dense-description">@TruncateText(project.Description, 64)</span>
                    </div>
                </div>
                <div>
                    <span class="@($"project-production-status {ProductionStatusClass(project.ProductionStatus)}")">
                        <span class="project-production-dot"></span>
                        @L[$"Production{project.ProductionStatus}"]
                    </span>
                </div>
                <div>
                    <a href="@($"/projects/{project.Id}/quality")"
                        class="@($"project-gate-grade {GradeCss(project.LatestGateGrade)}")"
                        @onclick:stopPropagation="true" title="@L["AnalysisGlobalGrade"]">
                        @GradeText(project.LatestGateGrade)
                    </a>
                </div>
                <div class="project-dense-activity">
                    @if (project.LastCommitId.HasValue)
                    {
                        <a href="@GitCommitHref(project)" @onclick:stopPropagation="true">
                            <code>@ShortSha(project.LastCommitSha)</code>
                        </a>
                        <span title="@project.LastCommitAt?.ToString("F")">
                            @(project.LastCommitAt.HasValue ? RelativeTime.FormatAgo(L, project.LastCommitAt.Value) : "-")
                        </span>
                    }
                    else
                    {
                        <span class="project-activity-empty">@L["Unavailable"]</span>
                    }
                </div>
                <div class="project-dense-activity">
                    @if (project.LastRunId.HasValue)
                    {
                        <div>
                            <span class="@($"pipeline-run-dot pipeline-run-dot-{RunStatusClass(project.LastRunStatus)}")"></span>
                            <a href="@($"/pipelines/runs/{project.LastRunId}")" @onclick:stopPropagation="true">
                                #@project.LastRunId · @(project.LastRunName ?? L["PipelineRun"])
                            </a>
                        </div>
                        <span title="@project.LastRunAt?.ToString("F")">
                            @(project.LastRunAt.HasValue ? RelativeTime.FormatAgo(L, project.LastRunAt.Value) : "-")
                        </span>
                        @if (project.ParentRunId.HasValue)
                        {
                            <span class="project-dense-parent">
                                ↳ @L["ChildOf"]
                                <a href="@($"/pipelines/runs/{project.ParentRunId}")"
                                    @onclick:stopPropagation="true">#@project.ParentRunId</a>
                            </span>
                        }
                    }
                    else
                    {
                        <span class="project-activity-empty">@L["Unavailable"]</span>
                    }
                </div>
                <div class="project-dense-users">
                    @if (project.OnlineUserCount.HasValue)
                    {
                        <RadzenIcon Icon="group" />
                        <span>@project.OnlineUserCount</span>
                    }
                    else
                    {
                        <span class="project-activity-empty">-</span>
                    }
                </div>
            </div>
        }
    </div>
}

@if (VisibleProjects.Count == 0 && !_loading)
{
    <EmptyState Icon="folder" Title="@L["NoProjectsFound"]" Description="@L["EmptyProjectsHint"]">
        <ActionContent>
            @if (_statusFilter.HasValue || !string.IsNullOrEmpty(_search) || _favoritesOnly)
            {
                <RadzenButton Text="@L["ClearFilters"]" Icon="clear" Size="ButtonSize.Small"
                    Click="@ClearFilters" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
            }
            else
            {
                <RadzenButton Text="@L["NewProject"]" Icon="add" Size="ButtonSize.Small"
                    Click="@OpenCreateDialog" Disabled="@(!_canWrite)"
                    ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
            }
        </ActionContent>
    </EmptyState>
}
