@page "/projects/new"
@page "/projects/{Id:int}"

<PageTitle>@L["NewProject"] - Aetheus</PageTitle>

@if (_isNew)
{
    <Aetheus.Front.Shared.PageHeader Title="@L["NewProject"]" Icon="folder" BackHref="/projects" />

    <RadzenTemplateForm TItem="ProjectModel" Data="@_model" Submit="@OnSubmit" class="rz-mt-4 form-narrow">
        <LocalizedDataAnnotationsValidator />
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Gap="1rem">
                    <RadzenFormField Text="@L["Name"]">
                        <RadzenTextBox @bind-Value="_model.Name" Name="Name" />
                        <ValidationMessage For="@(() => _model.Name)" />
                    </RadzenFormField>
                    <RadzenFormField Text="@L["Description"]">
                        <RadzenTextArea @bind-Value="_model.Description" Name="Description" Rows="3" />
                    </RadzenFormField>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Gap="1rem">
                    <RadzenFormField Text="@L["RepositoryUrl"]" class="rz-w-100">
                        <RadzenTextBox @bind-Value="_model.RepositoryUrl" Name="RepositoryUrl"
                            Placeholder="https://github.com/owner/repo.git"
                            class="project-repo-url-input" />
                    </RadzenFormField>
                    <RadzenFormField Text="@L["DefaultBranch"]">
                        <RadzenTextBox @bind-Value="_model.DefaultBranch" Name="DefaultBranch"
                            Placeholder="main" />
                    </RadzenFormField>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        <RadzenFormField Text="@L["TagsCommaSeparated"]" class="rz-mt-4 rz-w-100">
            <RadzenTextBox @bind-Value="_model.TagsRaw" Name="Tags" />
        </RadzenFormField>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-4">
            <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Create"]" Icon="add" IsBusy="@_saving" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        </RadzenStack>
    </RadzenTemplateForm>
}
