@inherits ProjectLoaderSectionBase
@page "/projects/{Id:int}/overview"
@layout Aetheus.Front.Layout.ProjectDetailLayout
@inject Microsoft.Extensions.Localization.IStringLocalizer<Aetheus.Front.Resources.AppStrings> L

<PageTitle>@(Loader?.Project?.Name ?? L["Project"]) - @L["Overview"] - Aetheus</PageTitle>

@if (Loader?.Project is not null)
{
    <Aetheus.Front.Pages.Projects.ProjectDetailSections.ProjectOverviewSection
        Project="@Loader.Project" />
}
