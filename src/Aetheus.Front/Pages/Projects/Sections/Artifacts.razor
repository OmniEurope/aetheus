@page "/projects/{Id:int}/artifacts"
@layout Aetheus.Front.Layout.ProjectDetailLayout
@inject Microsoft.Extensions.Localization.IStringLocalizer<Aetheus.Front.Resources.AppStrings> L

<PageTitle>@(Loader?.Project?.Name ?? L["Project"]) - @L["Artifacts"] - Aetheus</PageTitle>

@if (Loader?.Project is not null)
{
    <Aetheus.Front.Pages.Projects.ProjectDetailSections.ProjectArtifactsSection ProjectId="@Id" />
}
