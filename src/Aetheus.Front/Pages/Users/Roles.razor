@page "/admin/roles"

<PageTitle>@L["Roles"] - Aetheus</PageTitle>

<div class="iam-page iam-list-page">
    <Aetheus.Front.Shared.PageHeader Title="@L["Roles"]" Icon="admin_panel_settings"
        Subtitle="@L["RBACManagement"]" Class="iam-page-header">
        <ChildContent>
        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@string.Format(L["Total"], _totalCount)" />
        </ChildContent>
        <Actions>
        <RadzenButton Icon="refresh" Size="ButtonSize.Small"
            Click="@LoadAsync" title="@L["Refresh"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        <RadzenButton Text="@L["NewRole"]" Icon="add" Click="@OnCreate" Size="ButtonSize.Small"
            title="@L["NewRole"]" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        </Actions>
    </Aetheus.Front.Shared.PageHeader>

    <AdminIdentityNav ActiveSection="roles" />

    <div class="iam-grid-surface">
        <RadzenDataGrid Responsive="false" @ref="_grid" TItem="RoleDto" Data="@_roles" Count="@_totalCount"
            LoadData="@LoadDataAsync" AllowPaging="@(!AetheusGrid.Virtualization)" PageSize="25" IsLoading="@_loading"
            AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced"
            class="aetheus-clickable-rows aetheus-grid-fullheight" Density="Density.Compact"
            RowClick="@OnRowClick" AllowColumnResize="true" AllowVirtualization="@AetheusGrid.Virtualization" VirtualizationOverscanCount="3">
            <Columns>
                <RadzenDataGridColumn TItem="RoleDto" Property="Name" Title="@L["Name"]" MinWidth="180px">
                    <Template Context="role">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.625rem">
                            <span class="iam-entity-avatar"><RadzenIcon Icon="admin_panel_settings" /></span>
                            <a href="/admin/roles/@role.Id" class="server-name-link" @onclick:stopPropagation="true">@role.Name</a>
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="RoleDto" Property="Description" Title="@L["Description"]" MinWidth="240px">
                    <Template Context="role">@LocalizeDescription(role)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="RoleDto" Property="PermissionCount" Title="@L["Permissions"]" Width="150px">
                    <Template Context="role"><RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@role.PermissionCount.ToString()" /></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="RoleDto" Property="UserCount" Title="@L["Users"]" Width="130px" />
                <RadzenDataGridColumn TItem="RoleDto" Title="@L["Actions"]" Width="120px" Sortable="false">
                    <Template Context="role">
                        <span @onclick:stopPropagation="true">
                            <RadzenButton Icon="content_copy" Size="ButtonSize.Small"
                                Click="@(() => OnClone(role))" title="@L["CloneRole"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                            @if (role.Name != "Admin")
                            {
                                <RadzenButton Icon="delete" Size="ButtonSize.Small" Click="@(() => OnDelete(role))"
                                    title="@L["Delete"]" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                            }
                        </span>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>
