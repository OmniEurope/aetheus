@page "/alerts"

<PageTitle>@L["Alerts"] - Aetheus</PageTitle>

<Aetheus.Front.Shared.PageHeader Title="@L["Alerts"]" Icon="notifications">
    <ChildContent>
        <HelpLink PageKey="alerts" />
    </ChildContent>
    <Actions>
        <RadzenButton Text="@L["Create"]" Icon="add" Click="@OpenCreateDialogAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
    </Actions>
</Aetheus.Front.Shared.PageHeader>

@if (AlertNotify.Recent.Count > 0)
{
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-2">
        <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@L["RecentAlerts"] (@AlertNotify.Recent.Count)</RadzenText>
        <RadzenButton Text="@L["MarkAllRead"]" Icon="done_all" Size="ButtonSize.Small" Click="@(() => AlertNotify.ClearRecent())" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
    </RadzenStack>
    <RadzenDataGrid Data="@AlertNotify.Recent" TItem="AlertTriggeredDto" AllowSorting="true" Density="Density.Compact" class="rz-mb-6" AllowFiltering="true" FilterMode="FilterMode.Advanced">
        <Columns>
            <RadzenDataGridColumn TItem="AlertTriggeredDto" Property="TriggeredAt" Title="@L["TriggeredAt"]" Width="170px" FormatString="{0:g}" />
            <RadzenDataGridColumn TItem="AlertTriggeredDto" Property="Severity" Title="@L["Severity"]" Width="120px">
                <Template Context="a"><RadzenBadge BadgeStyle="@RecentSeverityBadge(a.Severity)" Text="@a.Severity" /></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AlertTriggeredDto" Property="ServerName" Title="@L["Server"]" Width="170px" />
            <RadzenDataGridColumn TItem="AlertTriggeredDto" Property="Message" Title="@L["AlertMessage"]" />
        </Columns>
    </RadzenDataGrid>
}

<RadzenText TextStyle="TextStyle.H5" class="rz-mb-2">@L["AlertRules"]</RadzenText>
<RadzenDataGrid Data="@_alerts" TItem="AlertRuleDto" IsLoading="@_loading" AllowSorting="true" Density="Density.Compact" AllowFiltering="true" FilterMode="FilterMode.Advanced" class="aetheus-grid-fullheight">
        <EmptyTemplate>
            <EmptyState Icon="notifications_off" Title="@L["NoAlerts"]" Description="@L["NoAlertsDescription"]" />
        </EmptyTemplate>
        <Columns>
            <RadzenDataGridColumn Property="Name" Title="@L["AlertName"]" MinWidth="10rem" />
            <RadzenDataGridColumn Property="Severity" Title="@L["Severity"]" Width="130px">
                <Template Context="alert">
                    <RadzenBadge BadgeStyle="@GetSeverityBadgeStyle(alert.Severity)" Text="@L.Localize(alert.Severity)" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="Metric" Title="@L["Metric"]" Width="130px">
                <Template Context="alert">
                    <RadzenBadge BadgeStyle="@GetMetricBadgeStyle(alert.Metric)" Text="@L.Localize(alert.Metric)" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="@L["Threshold"]" Width="140px">
                <Template Context="alert">
                    @alert.Operator @alert.Threshold%
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="SustainedSeconds" Title="@L["SustainedSeconds"]" Width="140px" />
            <RadzenDataGridColumn Property="IsEnabled" Title="@L["Status"]" Width="110px">
                <Template Context="alert">
                    @if (alert.IsEnabled)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@L["Active"]" />
                    }
                    else
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@L["Disabled"]" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="LastTriggeredAt" Title="@L["LastTriggered"]" Width="160px">
                <Template Context="alert">
                    @if (alert.LastTriggeredAt.HasValue)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="@alert.LastTriggeredAt.Value.ToString("g")" />
                    }
                    else
                    {
                        <RadzenText TextStyle="TextStyle.Caption">-</RadzenText>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="@L["Actions"]" MinWidth="14rem" Sortable="false">
                <Template Context="alert">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                        <RadzenButton Text="@L["Edit"]" Icon="edit" Click="@(() => OpenEditDialogAsync(alert))" ButtonStyle="ButtonStyle.Info" Variant="Variant.Filled" />
                        <RadzenButton Text="@L["Delete"]" Icon="delete" Click="@(() => DeleteAlert(alert.Id))" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
