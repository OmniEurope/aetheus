@inherits Aetheus.Front.Shared.EntityEditDialogBase
@* X4D8: create/edit alert rule form, extracted out of the Alerts list page into a dialog so the
   list reads as a true full-height list-page (no inline form pushing the grid up). *@
<RadzenTemplateForm TItem="UpdateAlertRuleRequest" Data="@_model" Submit="@SubmitAsync">
    <LocalizedDataAnnotationsValidator />
    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="@L["AlertName"]" class="rz-w-100">
                <RadzenTextBox @bind-Value="_model.Name" />
            </RadzenFormField>
            <ValidationMessage For="@(() => _model.Name)" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="@L["Metric"]" class="rz-w-100">
                <RadzenDropDown @bind-Value="_model.Metric" Data="@_metricTypes"
                    TextProperty="Text" ValueProperty="Value" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="@L["Threshold"]" class="rz-w-100">
                <RadzenNumeric @bind-Value="_model.Threshold" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="@L["SustainedSeconds"]" class="rz-w-100">
                <RadzenNumeric @bind-Value="_model.SustainedSeconds" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="@L["Severity"]" class="rz-w-100">
                <RadzenDropDown @bind-Value="_model.Severity" Data="@_severityTypes"
                    TextProperty="Text" ValueProperty="Value" />
            </RadzenFormField>
        </RadzenColumn>
        @if (IsEdit)
        {
            <RadzenColumn Size="12" SizeMD="6">
                <LabeledToggle Kind="ToggleKind.Switch" @bind-Value="_model.IsEnabled" Text="@L["Active"]" />
            </RadzenColumn>
        }
    </RadzenRow>
    <DialogFooter OnCancel="@Cancel">
        <RadzenButton Text="@(IsEdit ? L["Save"] : L["Create"])" Icon="@(IsEdit ? "save" : "add")"
                      ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" IsBusy="@_busy" />
    </DialogFooter>
</RadzenTemplateForm>
