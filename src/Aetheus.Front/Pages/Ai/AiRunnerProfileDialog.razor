@if (_loading)
{
    <AetheusLoader Size="AetheusLoaderSize.Small" />
}
else
{
    <RadzenTemplateForm TItem="EditModel" Data="@_model" Submit="@SubmitAsync">
        <DataAnnotationsValidator />
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="@L["Name"]" class="rz-w-100">
                    <RadzenTextBox @bind-Value="_model.Name" class="rz-w-100" />
                </RadzenFormField>
                <ValidationMessage For="@(() => _model.Name)" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="@L["Binary"]" class="rz-w-100">
                    <RadzenTextBox @bind-Value="_model.Binary" class="rz-w-100" />
                </RadzenFormField>
                <ValidationMessage For="@(() => _model.Binary)" />
            </RadzenColumn>
            <RadzenColumn Size="12">
                <RadzenFormField Text="@L["Description"]" class="rz-w-100">
                    <RadzenTextBox @bind-Value="_model.Description" class="rz-w-100" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12">
                <RadzenFormField Text="@L["ArgumentTemplate"]" class="rz-w-100">
                    <RadzenTextArea @bind-Value="_model.Arguments" Rows="7" class="rz-w-100 text-mono" />
                </RadzenFormField>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                    @L["AiArgumentTemplateHint"]
                </RadzenText>
            </RadzenColumn>
            <RadzenColumn Size="12">
                <RadzenFormField Text="@L["EnvironmentVariables"]" class="rz-w-100">
                    <RadzenTextArea @bind-Value="_model.Environment" Rows="4" class="rz-w-100 text-mono" />
                </RadzenFormField>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                    @L["AiEnvironmentHint"]
                </RadzenText>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenFormField Text="@L["TimeoutSeconds"]" class="rz-w-100">
                    <RadzenNumeric @bind-Value="_model.TimeoutSeconds" Min="1" Max="86400" class="rz-w-100" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenFormField Text="@L["MaxOutputBytes"]" class="rz-w-100">
                    <RadzenNumeric @bind-Value="_model.MaxOutputBytes" Min="1024" Max="1000000" class="rz-w-100" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <LabeledToggle Kind="ToggleKind.Switch" @bind-Value="_model.SendsDataExternally"
                               Text="@L["ExternalData"]" />
            </RadzenColumn>
        </RadzenRow>
        <DialogFooter OnCancel="@Cancel">
            <RadzenButton Text="@(IsEdit ? L["Save"] : L["Create"])" Icon="@(IsEdit ? "save" : "add")"
                          ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" IsBusy="@_busy" />
        </DialogFooter>
    </RadzenTemplateForm>
}
