@if (_loading)
{
    <AetheusLoader Size="AetheusLoaderSize.Small" />
}
else
{
    <RadzenTemplateForm TItem="EditModel" Data="@_model" Submit="@SubmitAsync">
        <DataAnnotationsValidator />
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="@L["Name"]" class="rz-w-100">
                    <RadzenTextBox @bind-Value="_model.Name" class="rz-w-100" />
                </RadzenFormField>
                <ValidationMessage For="@(() => _model.Name)" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="@L["AiRunnerProfile"]" class="rz-w-100">
                    <RadzenDropDown @bind-Value="_model.ProfileId" Data="@_profiles" TextProperty="Name"
                                    ValueProperty="Id" class="rz-w-100" />
                </RadzenFormField>
            </RadzenColumn>
            @if (!FixedProjectId.HasValue)
            {
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="@L["OwnerType"]" class="rz-w-100">
                        <RadzenDropDown @bind-Value="_model.OwnerType" Data="@_ownerTypes"
                                        TextProperty="Text" ValueProperty="Value" class="rz-w-100" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="8">
                    @if (_model.OwnerType == "project")
                    {
                        <RadzenFormField Text="@L["Project"]" class="rz-w-100">
                            <RadzenDropDown @bind-Value="_model.ProjectId" Data="@_projects" TextProperty="Name"
                                            ValueProperty="Id" AllowFiltering="true" class="rz-w-100" />
                        </RadzenFormField>
                    }
                    else
                    {
                        <RadzenFormField Text="@L["Server"]" class="rz-w-100">
                            <RadzenDropDown @bind-Value="_model.ServerId" Data="@_servers" TextProperty="Name"
                                            ValueProperty="Id" AllowFiltering="true" class="rz-w-100" />
                        </RadzenFormField>
                    }
                </RadzenColumn>
            }
            <RadzenColumn Size="12">
                <RadzenFormField Text="@L["PromptTemplate"]" class="rz-w-100">
                    <RadzenTextArea @bind-Value="_model.PromptTemplate" Rows="9" class="rz-w-100 text-mono" />
                </RadzenFormField>
                <ValidationMessage For="@(() => _model.PromptTemplate)" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="@L["Schedule"]" class="rz-w-100">
                    <RadzenTextBox @bind-Value="_model.Schedule" Placeholder="0 0 */6 * * *" class="rz-w-100 text-mono" />
                </RadzenFormField>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@L["AiScheduleHint"]</RadzenText>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="@L["EventTypes"]" class="rz-w-100">
                    <RadzenTextBox @bind-Value="_model.EventTypes" Placeholder="pipeline.completed, release.created"
                                   class="rz-w-100 text-mono" />
                </RadzenFormField>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@L["AiEventTypesHint"]</RadzenText>
            </RadzenColumn>
            <RadzenColumn Size="12">
                <LabeledToggle Kind="ToggleKind.Switch" @bind-Value="_model.Enabled" Text="@L["Active"]" />
            </RadzenColumn>
        </RadzenRow>
        <DialogFooter OnCancel="@Cancel">
            <RadzenButton Text="@(IsEdit ? L["Save"] : L["Create"])" Icon="@(IsEdit ? "save" : "add")"
                          ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" IsBusy="@_busy" />
        </DialogFooter>
    </RadzenTemplateForm>
}
