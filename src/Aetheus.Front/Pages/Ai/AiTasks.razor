@inherits PagedDataGridPageBase<AiTaskDefinitionDto>
@page "/ai-tasks"
@page "/projects/{ProjectId:int}/ai-tasks"

<PageTitle>@L["AiTasks"] - Aetheus</PageTitle>

<PageHeader Title="@L["AiTasks"]" Icon="psychology" />

<RadzenRow Gap="1rem" class="rz-mt-4 rz-mb-4">
    <RadzenColumn Size="12" SizeMD="4">
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@L["RunsLastSevenDays"]</RadzenText>
            <RadzenText TextStyle="TextStyle.H4">@(_consumption?.RunCount ?? 0)</RadzenText>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="4">
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@L["FailedRuns"]</RadzenText>
            <RadzenText TextStyle="TextStyle.H4">@(_consumption?.FailedCount ?? 0)</RadzenText>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="4">
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@L["ExecutionTime"]</RadzenText>
            <RadzenText TextStyle="TextStyle.H4">@FormatDuration(_consumption?.DurationMs ?? 0)</RadzenText>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
             JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-3">
    <RadzenTextBox Placeholder="@L["Search"]" @bind-Value="_search" Change="@OnSearchChangedAsync" />
    <RadzenButton Text="@L["Create"]" Icon="add" Click="@(() => OpenDialogAsync(null))"
                  Disabled="@(!CanCreate)" title="@(!CanCreate ? L["InsufficientPermissions"] : "")"
                  ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
</RadzenStack>

@if (_loading)
{
    <AetheusLoader />
}
else
{
    <RadzenDataGrid Responsive="false" @ref="_grid" Data="@_tasks" Count="@_totalCount"
                    TItem="AiTaskDefinitionDto" AllowPaging="@(!AetheusGrid.Virtualization)" PageSize="25"
                    LoadData="@LoadDataAsync" IsLoading="@_loading"
                    Density="Density.Compact" AllowSorting="true" AllowFiltering="true"
                    FilterMode="FilterMode.Advanced" class="rz-w-100" AllowColumnResize="true" AllowVirtualization="@AetheusGrid.Virtualization" VirtualizationOverscanCount="3">
        <EmptyTemplate>
            <EmptyState Icon="psychology" Title="@L["NoAiTasks"]" Description="@L["NoAiTasksDescription"]" />
        </EmptyTemplate>
        <Columns>
            <RadzenDataGridColumn TItem="AiTaskDefinitionDto" Property="Name" Title="@L["Name"]" />
            <RadzenDataGridColumn TItem="AiTaskDefinitionDto" Property="ProfileName" Title="@L["AiRunnerProfile"]">
                <Template Context="task">
                    @task.ProfileName
                    @if (task.ProfileSendsDataExternally)
                    {
                        <RadzenIcon Icon="cloud_upload" class="rz-color-warning rz-ml-1"
                                    title="@L["ExternalData"]" aria-label="@L["ExternalData"]" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AiTaskDefinitionDto" Title="@L["Source"]" Width="210px">
                <Template Context="task">
                    @if (task.ProjectId is { } projectId)
                    {
                        <RadzenLink Path="@($"/projects/{projectId}/overview")"
                            Text="@($"{L["Project"]}: {task.ProjectName ?? $"#{projectId}"}")" />
                    }
                    else if (task.ServerId is { } serverId)
                    {
                        <RadzenLink Path="@($"/servers/{serverId}/overview")"
                            Text="@($"{L["Server"]}: {task.ServerName ?? $"#{serverId}"}")" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AiTaskDefinitionDto" Property="Schedule" Title="@L["Schedule"]" Width="170px">
                <Template Context="task"><code>@(task.Schedule ?? L["Manual"])</code></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AiTaskDefinitionDto" Property="Enabled" Title="@L["Status"]" Width="105px">
                <Template Context="task">
                    <RadzenBadge BadgeStyle="@(task.Enabled ? BadgeStyle.Success : BadgeStyle.Light)"
                                 Text="@(task.Enabled ? L["Active"] : L["Disabled"])" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AiTaskDefinitionDto" Title="@L["Actions"]" Width="190px"
                                  Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                <Template Context="task">
                    <RadzenButton Icon="play_arrow" Size="ButtonSize.ExtraSmall"
                                  IsBusy="@(_runningTaskId == task.Id)"
                                  Disabled="@(_runningTaskId.HasValue || !CanWrite(task))"
                                  Click="@(() => RunAsync(task))" title="@L["RunNow"]"
                                  ButtonStyle="ButtonStyle.Success" Variant="Variant.Filled" />
                    <RadzenButton Icon="description" Size="ButtonSize.ExtraSmall"
                                  Click="@(() => OpenResultsAsync(task))" title="@L["Results"]"
                                  ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
                    <RadzenButton Icon="edit" Size="ButtonSize.ExtraSmall"
                                  Disabled="@(!CanWrite(task))"
                                  Click="@(() => OpenDialogAsync(task))" title="@L["Edit"]"
                                  ButtonStyle="ButtonStyle.Info" Variant="Variant.Filled" />
                    <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall"
                                  Disabled="@(!CanAdmin(task))"
                                  Click="@(() => DeleteAsync(task))" title="@L["Delete"]"
                                  ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
