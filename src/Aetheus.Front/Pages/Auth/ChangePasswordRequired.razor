@page "/account/change-password"

<PageTitle>@L["ChangePasswordRequiredTitle"] - Aetheus</PageTitle>

<div class="login-container">
    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenText TextStyle="TextStyle.H4" class="rz-mb-0">@L["ChangePasswordRequiredTitle"]</RadzenText>
            <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" AllowClose="false">
                @L["ChangePasswordRequiredMessage"]
            </RadzenAlert>

            <RadzenTemplateForm TItem="PasswordChangeModel" Data="@_model" Submit="@OnSubmit">
                <LocalizedDataAnnotationsValidator />
                <RadzenStack Gap="1rem">
                    <RadzenFormField Text="@L["CurrentPassword"]">
                        <ChildContent>
                            @if (_showPasswords)
                            {
                                <RadzenTextBox @bind-Value="_model.CurrentPassword" Name="CurrentPassword" aria-label="@L["CurrentPassword"]" />
                            }
                            else
                            {
                                <RadzenPassword @bind-Value="_model.CurrentPassword" Name="CurrentPassword" aria-label="@L["CurrentPassword"]" />
                            }
                        </ChildContent>
                        <End>
                            <RadzenButton ButtonType="ButtonType.Button" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light"
                                          Icon="@(_showPasswords ? "visibility_off" : "visibility")"
                                          Click="@ToggleShowPasswords" Size="ButtonSize.Small"
                                          title="@(_showPasswords ? L["HidePassword"] : L["ShowPassword"])"
                                          aria-label="@(_showPasswords ? L["HidePassword"] : L["ShowPassword"])" />
                        </End>
                        <Helper>
                            <ValidationMessage For="@(() => _model.CurrentPassword)" />
                        </Helper>
                    </RadzenFormField>
                    <RadzenFormField Text="@L["NewPassword"]">
                        <ChildContent>
                            @if (_showPasswords)
                            {
                                <RadzenTextBox @bind-Value="_model.NewPassword" Name="NewPassword" aria-label="@L["NewPassword"]" />
                            }
                            else
                            {
                                <RadzenPassword @bind-Value="_model.NewPassword" Name="NewPassword" aria-label="@L["NewPassword"]" />
                            }
                        </ChildContent>
                        <Helper>
                            <ValidationMessage For="@(() => _model.NewPassword)" />
                        </Helper>
                    </RadzenFormField>
                    <RadzenFormField Text="@L["ConfirmPassword"]">
                        <ChildContent>
                            @if (_showPasswords)
                            {
                                <RadzenTextBox @bind-Value="_model.ConfirmPassword" Name="ConfirmPassword" aria-label="@L["ConfirmPassword"]" />
                            }
                            else
                            {
                                <RadzenPassword @bind-Value="_model.ConfirmPassword" Name="ConfirmPassword" aria-label="@L["ConfirmPassword"]" />
                            }
                        </ChildContent>
                        <Helper>
                            <ValidationMessage For="@(() => _model.ConfirmPassword)" />
                        </Helper>
                    </RadzenFormField>

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Flat">@_error</RadzenAlert>
                    }

                    <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Save"]" Icon="lock_reset"
                        IsBusy="@_busy" BusyText="@L["Saving"]" class="btn-full-width" aria-label="@L["Save"]" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
                    @* FP3K: explicit way out for a user who can't / won't change their password now. *@
                    <RadzenButton ButtonType="ButtonType.Button" Text="@L["Logout"]" Icon="logout"
                        Click="@LogoutAsync"
                        class="btn-full-width" aria-label="@L["Logout"]" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenStack>
    </RadzenCard>
</div>
