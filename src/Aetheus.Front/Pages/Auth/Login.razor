@page "/login"

<PageTitle>@L["Login"] - Aetheus</PageTitle>

<div class="login-container">
    <div class="login-logo">
        <img src="aetheus-icon.svg" alt="Aetheus" class="login-logo-img" />
    </div>
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.H4" class="rz-mb-4">@L["Login"]</RadzenText>

        <RadzenTemplateForm TItem="LoginModel" Data="@_model" Submit="@OnSubmit">
            <LocalizedDataAnnotationsValidator />
            <RadzenStack Gap="1rem">
                <RadzenFormField Text="@L["Username"]">
                    <RadzenTextBox @bind-Value="_model.Username"
                                   @oninput="@(e => _model.Username = e.Value?.ToString() ?? string.Empty)"
                                   Name="Username" aria-label="@L["Username"]" />
                    <RadzenRequiredValidator Component="Username" Text="@L["UsernameRequired"]" />
                </RadzenFormField>
                <RadzenFormField Text="@L["Password"]">
                    <ChildContent>
                        @if (_showPassword)
                        {
                            <RadzenTextBox @bind-Value="_model.Password"
                                           @oninput="@(e => _model.Password = e.Value?.ToString() ?? string.Empty)"
                                           Name="Password" aria-label="@L["Password"]" />
                        }
                        else
                        {
                            <RadzenPassword @bind-Value="_model.Password"
                                            @oninput="@(e => _model.Password = e.Value?.ToString() ?? string.Empty)"
                                            Name="Password" aria-label="@L["Password"]" />
                        }
                    </ChildContent>
                    <End>
                        <RadzenButton ButtonType="ButtonType.Button" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light"
                                      Icon="@(_showPassword ? "visibility_off" : "visibility")"
                                      Click="@ToggleShowPassword" Size="ButtonSize.Small"
                                      title="@(_showPassword ? L["HidePassword"] : L["ShowPassword"])"
                                      aria-label="@(_showPassword ? L["HidePassword"] : L["ShowPassword"])" />
                    </End>
                    <Helper>
                        <RadzenRequiredValidator Component="Password" Text="@L["PasswordRequired"]" />
                    </Helper>
                </RadzenFormField>

                @if (_totpRequired)
                {
                    <RadzenFormField Text="@L["TotpCode"]">
                        <RadzenTextBox @bind-Value="_model.TotpCode" Name="TotpCode"
                                       MaxLength="10" aria-label="@L["TotpCode"]"
                                       Placeholder="@L["TotpCodePlaceholder"]" AutoComplete="false" />
                    </RadzenFormField>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-base-500">
                        @L["TotpRecoveryHint"]
                    </RadzenText>
                }

                <LabeledToggle @bind-Value="_model.RememberMe" Text="@L["RememberMe"]" />

                @if (!string.IsNullOrEmpty(_error))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Flat">
                        @_error
                    </RadzenAlert>
                }

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-1">
                    <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Login"]" Icon="login"
                                  IsBusy="@_loading" BusyText="@L["LoggingIn"]"
                                  aria-label="@L["Login"]" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                    <RadzenButton ButtonType="ButtonType.Button" Icon="lock_reset"
                                  Text="@L["ForgotPassword"]" Click="@ToggleForgotHint"
                                  ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" />
                </RadzenStack>
                @if (_showForgotHint)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" AllowClose="true">
                        @L["ForgotPasswordHint"]
                    </RadzenAlert>
                }
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
</div>
