@page "/logs"
@using Microsoft.AspNetCore.SignalR.Client

<PageTitle>@L["LiveLogs"] - Aetheus</PageTitle>

<Aetheus.Front.Shared.PageHeader Title="@L["LiveLogs"]" Icon="terminal">
    <ChildContent>
        <HelpLink PageKey="logs" />
    </ChildContent>
    <Actions>
        <RadzenNumeric @bind-Value="_taskIdFilter" Placeholder="@L["TaskId"]" TValue="int?" />
        <RadzenButton Text="@L["Watch"]" Icon="visibility" Click="@StartWatching"
            Disabled="@(_taskIdFilter is null)" ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
        @if (_hubConnection?.State == HubConnectionState.Connected)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@L["Connected"]" />
        }
        <RadzenButton Icon="delete_sweep" Text="@L["Clear"]" Click="@(() => _logs.Clear())" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
        @if (Auth.IsAdmin && _currentWatchId.HasValue)
        {
            <RadzenButton Icon="@(_showUnmasked ? "visibility_off" : "visibility")"
                Text="@(_showUnmasked ? L["ShowMasked"] : L["ShowUnmasked"])"
                Variant="Variant.Filled" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small"
                Click="@ToggleUnmasked" />
        }
    </Actions>
</Aetheus.Front.Shared.PageHeader>

<div class="live-log-panel" @ref="_logContainer">
    @if (_logs.Count == 0)
    {
        @if (_currentWatchId.HasValue)
        {
            <EmptyState Icon="terminal" Title="@L["NoLogEntriesYet"]" Description="@L["WaitingForLogEntries"]" />
        }
        else
        {
            <EmptyState Icon="manage_search" Title="@L["SelectTaskToWatch"]" Description="@L["SelectTaskToWatchDescription"]" />
        }
    }
    else
    {
        @foreach (var log in _logs)
        {
            <div class="log-entry log-level-@log.Level.ToString().ToLowerInvariant()">
                <span class="log-timestamp">[@log.Timestamp.ToString("HH:mm:ss.fff")]</span>
                <span class="log-task-id">[Task#@log.TaskId]</span>
                <span>[@log.Level]</span> @((MarkupString)HighlightMasked(log.Message))
            </div>
        }
    }
</div>


