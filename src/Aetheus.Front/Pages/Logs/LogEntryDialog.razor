<div>
    <pre class="exception-pre">@Message</pre>
    @if (!string.IsNullOrWhiteSpace(Exception))
    {
        <RadzenText TextStyle="TextStyle.H6" class="rz-mt-3 rz-mb-1">@L["ExceptionDetails"]</RadzenText>
        <pre class="exception-pre">@Exception</pre>
    }
    <DialogFooter CancelText="@L["Close"]" OnCancel="Close">
        <SecondaryContent>
            <RadzenButton Text="@L["Copy"]" Icon="content_copy" Click="CopyAsync" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
        </SecondaryContent>
    </DialogFooter>
</div>
