@page "/help/{PageKey}"

<PageTitle>@(_article?.Title ?? L["HelpCenter"]) - Aetheus</PageTitle>

@if (_article is null)
{
    <AetheusLoader Size="AetheusLoaderSize.Large" />
}
else
{
    <Aetheus.Front.Shared.PageHeader Title="@_article.Title" Icon="@_article.Icon" BackHref="/help" />

    <RadzenStack Gap="1.5rem">
        <RadzenText TextStyle="TextStyle.Body1" class="rz-color-secondary">@_article.Description</RadzenText>

        @foreach (var helpSection in _article.Sections)
        {
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.H5" class="rz-mb-2">@helpSection.Title</RadzenText>
                <div class="markdown-content help-section-content">@((MarkupString)RenderContent(helpSection.Content))</div>
            </RadzenCard>
        }

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <Aetheus.Front.Shared.BrowserBackButton Text="@L["BackToHelp"]" Title="@L["GoBack"]" />
            @if (_pageRoute is not null)
            {
                <RadzenButton Text="@L["GoToPage"]" Icon="open_in_new" Click="@(() => Nav.NavigateTo(_pageRoute))" ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
            }
        </RadzenStack>
    </RadzenStack>
}
