@page "/admin/api-reference"
@page "/api-reference"

<PageTitle>@L["ApiReference"] - Aetheus</PageTitle>

<Aetheus.Front.Shared.PageHeader Title="@L["ApiReference"]" Icon="api">
    <ChildContent>
        @if (_endpoints.Count > 0)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@string.Format(L["EndpointsCount"], _endpoints.Count)" />
        }
    </ChildContent>
    <Actions>
        <RadzenTextBox Placeholder="@L["Search"]" @bind-Value="_search" Change="@(_ => StateHasChanged())" class="api-ref-search" />
    </Actions>
</Aetheus.Front.Shared.PageHeader>

@if (_loading)
{
    <AetheusLoader />
}
else if (_forbidden)
{
    <EmptyState Icon="lock" Title="@L["AccessDenied"]" Description="@L["ApiReferenceAdminOnly"]" />
}
else if (_endpoints.Count == 0)
{
    <EmptyState Icon="api" Title="@L["ApiReferenceEmptyTitle"]" Description="@L["ApiReferenceEmptyHint"]" />
}
else
{
    @foreach (var group in FilteredGroups)
    {
        <RadzenText TextStyle="TextStyle.H5" class="rz-mt-4 rz-mb-2">@group.Key</RadzenText>
        <RadzenCard class="rz-p-0">
            @foreach (var ep in group)
            {
                <div class="api-ref-row">
                    <span class="api-ref-method api-ref-method-@ep.Method.ToLowerInvariant()">@ep.Method</span>
                    <code class="api-ref-path">@ep.Path</code>
                    @if (!string.IsNullOrEmpty(ep.Summary))
                    {
                        <span class="api-ref-summary rz-color-secondary">@ep.Summary</span>
                    }
                </div>
            }
        </RadzenCard>
    }
}
