@inherits EntityEditDialogBase
@using Aetheus.Shared.Enums

@if (_loading)
{
    <AetheusLoader Size="AetheusLoaderSize.Small" />
}
else
{
    <RadzenTemplateForm TItem="EditModel" Data="@_model" Submit="@SubmitAsync">
        <LocalizedDataAnnotationsValidator />
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="@L["Name"]" class="rz-w-100">
                    <RadzenTextBox @bind-Value="_model.Name" />
                </RadzenFormField>
                <ValidationMessage For="@(() => _model.Name)" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="@L["Type"]" class="rz-w-100">
                    <RadzenDropDown @bind-Value="_model.Type" Data="@_types" TextProperty="Text" ValueProperty="Value"
                        Disabled="@IsEdit" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12">
                <RadzenFormField Text="@L["Description"]" class="rz-w-100">
                    <RadzenTextBox @bind-Value="_model.Description" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12">
                <RadzenFormField Text="@L["Url"]" class="rz-w-100">
                    <RadzenTextBox @bind-Value="_model.Url" Placeholder="https://github.com" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12">
                <RadzenFormField Text="@L["Credentials"]" class="rz-w-100">
                    <RadzenTextArea @bind-Value="_model.ConfigurationJson" Rows="5" class="text-mono" />
                </RadzenFormField>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@L["ServiceConnectionCredentialsHint"]</RadzenText>
                <ValidationMessage For="@(() => _model.ConfigurationJson)" />
            </RadzenColumn>
        </RadzenRow>
        <DialogFooter OnCancel="@Cancel">
            <RadzenButton Text="@(IsEdit ? L["Save"] : L["Create"])" Icon="@(IsEdit ? "save" : "add")"
                          ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" IsBusy="@_busy" />
        </DialogFooter>
    </RadzenTemplateForm>
}
