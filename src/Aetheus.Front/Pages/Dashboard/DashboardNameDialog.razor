<RadzenStack Gap="1rem">
    <RadzenFormField Text="@L["Name"]" Variant="Variant.Filled">
        <RadzenTextBox @bind-Value="_value" @oninput="@(e => _value = e.Value?.ToString() ?? "")"
            @onkeydown="@OnKeyDown" id="dashboard-name-input" />
    </RadzenFormField>
    <Aetheus.Front.Shared.DialogFooter OnCancel="@(() => Dialog.Close())" CancelVariant="Variant.Text">
        <RadzenButton Text="@L["Create"]" Icon="add" Click="@Save" Disabled="@string.IsNullOrWhiteSpace(_value)" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
    </Aetheus.Front.Shared.DialogFooter>
</RadzenStack>
