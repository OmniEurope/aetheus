@page "/"
@using Aetheus.Front.Helpers

<PageTitle>@L["Dashboard"] - Aetheus</PageTitle>

<Aetheus.Front.Shared.PageHeader Title="@L["Dashboard"]" Icon="space_dashboard">
    <ChildContent>
        <HelpLink PageKey="dashboard" />
    </ChildContent>
    <Actions>
        @if (Auth.IsAdmin)
        {
            <RadzenButton Text="@L["ManageDashboards"]" Icon="settings"
                Click="@(() => Nav.NavigateTo("/dashboards"))"
                title="@L["ManageDashboards"]" aria-label="@L["ManageDashboards"]" ButtonStyle="ButtonStyle.Info" Variant="Variant.Filled" />
        }
    </Actions>
</Aetheus.Front.Shared.PageHeader>

@if (Permissions.IsLoaded && !CanViewDashboard)
{
    <EmptyState Icon="lock" Title="@L["AccessDenied"]" />
}
else
{
<RadzenRow Gap="1rem" AlignItems="AlignItems.Stretch" class="dashboard-stat-row rz-mb-4">
    <RadzenColumn Size="12" SizeSM="6" SizeMD="4" SizeLG="2">
        <RadzenCard class="stat-card stat-card-info">
            <RadzenIcon Icon="dns" class="stat-card-icon rz-color-info" />
            <div>
                <RadzenText TextStyle="TextStyle.Subtitle2">@L["TotalServers"]</RadzenText>
                <RadzenText TextStyle="TextStyle.H3">@(_dashboard?.TotalServers.ToString() ?? "-")</RadzenText>
            </div>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeSM="6" SizeMD="4" SizeLG="2">
        <RadzenCard class="stat-card stat-card-success">
            <RadzenIcon Icon="wifi" class="stat-card-icon rz-color-success" />
            <div>
                <RadzenText TextStyle="TextStyle.Subtitle2">@L["Online"]</RadzenText>
                <RadzenText TextStyle="TextStyle.H3" class="text-success">@(_dashboard?.OnlineServers.ToString() ?? "-")</RadzenText>
            </div>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeSM="6" SizeMD="4" SizeLG="2">
        <RadzenCard class="stat-card stat-card-danger">
            <RadzenIcon Icon="wifi_off" class="stat-card-icon rz-color-danger" />
            <div>
                <RadzenText TextStyle="TextStyle.Subtitle2">@L["Offline"]</RadzenText>
                <RadzenText TextStyle="TextStyle.H3" class="text-danger">@(_dashboard?.OfflineServers.ToString() ?? "-")</RadzenText>
            </div>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeSM="6" SizeMD="4" SizeLG="2">
        <RadzenCard class="stat-card stat-card-warning">
            <RadzenIcon Icon="pending_actions" class="stat-card-icon rz-color-warning" />
            <div>
                <RadzenText TextStyle="TextStyle.Subtitle2">@L["PendingTasks"]</RadzenText>
                <RadzenText TextStyle="TextStyle.H3">@(_dashboard?.PendingTasks.ToString() ?? "-")</RadzenText>
            </div>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeSM="6" SizeMD="4" SizeLG="2">
        <RadzenCard class="stat-card stat-card-info">
            <RadzenIcon Icon="play_circle" class="stat-card-icon rz-color-info" />
            <div>
                <RadzenText TextStyle="TextStyle.Subtitle2">@L["RunningPipelines"]</RadzenText>
                <RadzenText TextStyle="TextStyle.H3">@(_dashboard?.RunningPipelines.ToString() ?? "-")</RadzenText>
            </div>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeSM="6" SizeMD="4" SizeLG="2">
        <RadzenCard class="stat-card stat-card-success">
            <RadzenIcon Icon="monitor_heart" class="stat-card-icon rz-color-success" />
            <div>
                <RadzenText TextStyle="TextStyle.Subtitle2">@L["MonitoredApps"]</RadzenText>
                <RadzenText TextStyle="TextStyle.H3">@(_appSummary is null ? "-" : (_appSummary.UpCount + _appSummary.DownCount + _appSummary.DegradedCount + _appSummary.UnknownCount).ToString())</RadzenText>
            </div>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

<RadzenRow Gap="1rem" AlignItems="AlignItems.Stretch" class="dashboard-tile-row">
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenCard class="dashboard-tile">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="dashboard-tile-title rz-mb-2">
                <RadzenIcon Icon="dns" />
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">@L["Servers"]</RadzenText>
            </RadzenStack>
            <RadzenDataGrid Data="@(_dashboard?.Servers)" TItem="ServerDto" AllowSorting="true" Density="Density.Compact"
                IsLoading="@(_dashboard is null)"
                EmptyText="@L["NoRecords"]" AllowFiltering="true" FilterMode="FilterMode.Advanced" RowClick="@(args => { if (args.Data is not null) Nav.NavigateTo($"/servers/{args.Data.Id}/overview"); })"
                class="dashboard-clickable-grid">
                <EmptyTemplate>
                    <EmptyState Icon="dns" Title="@L["EmptyDashboardServers"]" />
                </EmptyTemplate>
                <Columns>
                    <RadzenDataGridColumn Property="Hostname" Title="@L["Hostname"]" MinWidth="11rem">
                        <Template Context="server">
                            <span @onclick:stopPropagation="true">
                                <RadzenLink Path="@($"/servers/{server.Id}/overview")" Text="@server.Hostname" />
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="LastHeartbeat" Title="@L["LastHeartbeat"]" MinWidth="9rem">
                        <Template Context="server">
                            @* Year < 2000 = never reported (front DateTime.MinValue shifts by local offset on the wire). *@
                            @(server.LastHeartbeat.Year < 2000 ? "-" : server.LastHeartbeat.ToString("g"))
                        </Template>
                    </RadzenDataGridColumn>
                    @* Status = last column: online/offline icon + one icon per pipeline capability the
                       server has (build/deploy/management). Capability icons are omitted when absent, so a
                       server with no known capabilities shows only the online/offline icon. *@
                    <RadzenDataGridColumn Property="Status" Title="@L["Status"]" Width="9rem">
                        <Template Context="server">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                                @if (server.Status == ServerStatus.Online)
                                {
                                    <RadzenIcon Icon="wifi" class="rz-color-success" title="@L.Localize(server.Status)" role="img" aria-label="@L.Localize(server.Status)" />
                                }
                                else
                                {
                                    <RadzenIcon Icon="wifi_off" class="rz-color-danger" title="@L.Localize(server.Status)" role="img" aria-label="@L.Localize(server.Status)" />
                                }
                                @if (server.PipelineRunnerEnabled == true)
                                {
                                    <span class="clickable-cell" role="button" tabindex="0" title="@L["CapBuild"]" aria-label="@L["CapBuild"]"
                                          @onclick="@(() => NavToSection(server.Id, "pipelines"))" @onkeydown="@(e => OnCapKey(e, server.Id, "pipelines"))">
                                        <RadzenIcon Icon="build" class="rz-color-info" />
                                    </span>
                                }
                                @if (server.DeploymentTargetAvailable == true)
                                {
                                    <span class="clickable-cell" role="button" tabindex="0" title="@L["CapDeploy"]" aria-label="@L["CapDeploy"]"
                                          @onclick="@(() => NavToSection(server.Id, "apps"))" @onkeydown="@(e => OnCapKey(e, server.Id, "apps"))">
                                        <RadzenIcon Icon="rocket_launch" class="rz-color-info" />
                                    </span>
                                }
                                @if (server.PackageManagementAvailable == true)
                                {
                                    <span class="clickable-cell" role="button" tabindex="0" title="@L["CapManage"]" aria-label="@L["CapManage"]"
                                          @onclick="@(() => NavToSection(server.Id, "modules"))" @onkeydown="@(e => OnCapKey(e, server.Id, "modules"))">
                                        <RadzenIcon Icon="settings" class="rz-color-info" />
                                    </span>
                                }
                                @* S-TECH-CUNK: a server that has never phoned home has UNKNOWN capabilities (all null),
                                   shown as a muted marker - distinct from a reported "no capabilities" (all false = no icons). *@
                                @if (server.PipelineRunnerEnabled is null && server.DeploymentTargetAvailable is null && server.PackageManagementAvailable is null)
                                {
                                    <RadzenIcon Icon="help_outline" class="rz-color-secondary" title="@L["CapUnknown"]" role="img" aria-label="@L["CapUnknown"]" />
                                }
                                @* S-UX-CDTT: when the agent reported capability diagnostics (a drop-in unreadable,
                                   sudo blocked), surface them in a rich tooltip so the operator sees WHY a capability
                                   is OFF without SSHing. *@
                                @if (server.CapabilityDiagnostics.Count > 0)
                                {
                                    <RadzenIcon Icon="info" class="rz-color-warning" role="img" aria-label="@L["CapabilityDiagnosticsHint"]"
                                                title="@($"{L["CapabilityDiagnosticsHint"]}\n- {string.Join("\n- ", server.CapabilityDiagnostics)}")" />
                                }
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenCard class="dashboard-tile">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="dashboard-tile-title rz-mb-2">
                <RadzenIcon Icon="history" />
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">@L["RecentRuns"]</RadzenText>
            </RadzenStack>
            <RadzenDataGrid Data="@(_dashboard?.RecentRuns)" TItem="PipelineRunDto" Density="Density.Compact"
                IsLoading="@(_dashboard is null)"
                AllowSorting="true"
                EmptyText="@L["NoRecords"]" AllowFiltering="true" FilterMode="FilterMode.Advanced" RowClick="@(args => { if (args.Data is not null) Nav.NavigateTo($"/pipelines/runs/{args.Data.Id}"); })"
                class="dashboard-clickable-grid">
                <EmptyTemplate>
                    <EmptyState Icon="play_circle" Title="@L["EmptyDashboardRuns"]" />
                </EmptyTemplate>
                <Columns>
                    <RadzenDataGridColumn Property="Id" Title="@L["RunId"]" Width="6rem">
                        <Template Context="run">
                            <span @onclick:stopPropagation="true">
                                <RadzenLink Path="@($"/pipelines/runs/{run.Id}")" Text="@($"#{run.Id}")" />
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="PipelineName" Title="@L["Pipeline"]" MinWidth="11rem" />
                    <RadzenDataGridColumn Property="Status" Title="@L["Status"]" MinWidth="7rem">
                        <Template Context="run">
                            <RadzenBadge BadgeStyle="@GetRunBadge(run.Status)" Text="@L.Localize(run.Status)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="StartedAt" Title="@L["Started"]" FormatString="{0:g}" MinWidth="9rem" />
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenCard class="dashboard-tile">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="dashboard-tile-title rz-mb-2">
                <RadzenIcon Icon="folder" />
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">@L["Projects"]</RadzenText>
            </RadzenStack>
            <RadzenDataGrid Data="@(_dashboard?.Projects)" TItem="ProjectDto" AllowSorting="true" Density="Density.Compact"
                IsLoading="@(_dashboard is null)"
                EmptyText="@L["NoRecords"]" AllowFiltering="true" FilterMode="FilterMode.Advanced" RowClick="@(args => { if (args.Data is not null) Nav.NavigateTo($"/projects/{args.Data.Id}"); })"
                class="dashboard-clickable-grid">
                <EmptyTemplate>
                    <EmptyState Icon="folder" Title="@L["EmptyDashboardProjects"]" />
                </EmptyTemplate>
                <Columns>
                    <RadzenDataGridColumn Property="Name" Title="@L["Name"]" MinWidth="6rem">
                        <Template Context="project">
                            <span @onclick:stopPropagation="true">
                                <RadzenLink Path="@($"/projects/{project.Id}")" Text="@project.Name" />
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="Description" Title="@L["Description"]" MinWidth="6rem" />
                    <RadzenDataGridColumn Property="PipelineCount" Title="@L["Pipelines"]" Width="6.5rem" />
                    <RadzenDataGridColumn Property="UpdatedAt" Title="@L["Updated"]" FormatString="{0:g}" Width="8rem" />
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenCard class="dashboard-tile">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-2">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="monitor_heart" />
                    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">@L["MonitoredApps"]</RadzenText>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@($"{_appSummary?.UpCount ?? 0} {L["AppHealthUp"]}")" />
                    <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="@($"{_appSummary?.DownCount ?? 0} {L["AppHealthDown"]}")" />
                    @if (_appSummary?.DegradedCount > 0)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@($"{_appSummary.DegradedCount} {L["AppHealthDegraded"]}")" />
                    }
                    @if (_appSummary?.UnknownCount > 0)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@($"{_appSummary.UnknownCount} {L["AppHealthUnknown"]}")" />
                    }
                </RadzenStack>
            </RadzenStack>
            <RadzenDataGrid Data="@(_appSummary?.Troubled)" TItem="MonitoredAppStatusDto" Density="Density.Compact"
                IsLoading="@(_appSummary is null)"
                EmptyText="@L["NoTroubledApps"]" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced" RowClick="@(args => { if (args.Data is not null) Nav.NavigateTo($"/projects/{args.Data.ProjectId}/monitoring"); })"
                class="dashboard-clickable-grid">
                <EmptyTemplate>
                    <EmptyState Icon="monitor_heart" Title="@L["NoTroubledApps"]" />
                </EmptyTemplate>
                <Columns>
                    <RadzenDataGridColumn Property="Name" Title="@L["Name"]" MinWidth="9rem">
                        <Template Context="app">
                            <span @onclick:stopPropagation="true">
                                <RadzenLink Path="@($"/projects/{app.ProjectId}/monitoring")" Text="@app.Name" />
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="ProjectName" Title="@L["Project"]" MinWidth="8rem" />
                    <RadzenDataGridColumn Property="CurrentStatus" Title="@L["Status"]" Width="9rem">
                        <Template Context="app">
                            <RadzenBadge BadgeStyle="@GetAppHealthBadge(app.CurrentStatus)" Text="@L[$"AppHealth{app.CurrentStatus}"]" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="LastStatusChangeAt" Title="@L["Since"]" FormatString="{0:g}" Width="10rem" />
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>
}
