@page "/admin/dashboards"
@page "/dashboards"

<PageTitle>@L["Dashboards"] - Aetheus</PageTitle>

<Aetheus.Front.Shared.PageHeader Title="@L["Dashboards"]" Icon="space_dashboard">
    <ChildContent>
        <HelpLink PageKey="dashboards" />
    </ChildContent>
    <Actions>
        <RadzenButton Text="@L["Create"]" Icon="add" Click="@CreateDashboard" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
    </Actions>
</Aetheus.Front.Shared.PageHeader>

@if (_loading)
{
    <AetheusLoader Size="AetheusLoaderSize.Large" />
}
else if (_dashboards.Count == 0)
{
    @* B-bis: no blue Info banner - use the shared empty state with a create action. *@
    <EmptyState Icon="dashboard" Title="@L["NoRecords"]">
        <ActionContent>
            <RadzenButton Text="@L["Create"]" Icon="add" Click="@CreateDashboard" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        </ActionContent>
    </EmptyState>
}
else
{
    <RadzenRow Gap="1rem">
        @foreach (var dashboard in _dashboards)
        {
            <RadzenColumn Size="4" SizeSM="6" SizeXS="12">
                <RadzenCard class="rz-p-4">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenText TextStyle="TextStyle.H5">@dashboard.Name</RadzenText>
                        @if (dashboard.IsDefault)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@L["IsDefault"]" />
                        }
                    </RadzenStack>
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-2">
                        @dashboard.Widgets.Count @L["Widgets"]
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-mt-1">
                        @dashboard.CreatedAt.ToString("g")
                    </RadzenText>
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-3">
                        <RadzenButton Text="@L["Edit"]" Icon="edit" Size="ButtonSize.Small"
                            Click="@(() => EditDashboard(dashboard))" ButtonStyle="ButtonStyle.Info" Variant="Variant.Filled" />
                        <RadzenButton Text="@L["Delete"]" Icon="delete" Size="ButtonSize.Small"
                            Click="@(() => DeleteDashboard(dashboard.Id))" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        }
    </RadzenRow>
}
