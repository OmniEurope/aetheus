@inherits Aetheus.Front.Shared.RealtimeAdminGridPageBase<PackageFeedDto>
@page "/admin/package-feeds"
@using Aetheus.Shared.Enums

<PageTitle>@L["PackageFeeds"] - Aetheus</PageTitle>

<Aetheus.Front.Shared.PageHeader Title="@L["PackageFeeds"]" Icon="inventory">
    <Actions>
        <RadzenButton Text="@L["Create"]" Icon="add" Size="ButtonSize.Small" Click="@OpenCreateAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        <RadzenButton Icon="refresh" Size="ButtonSize.Small" Click="@ReloadAsync" title="@L["Refresh"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
    </Actions>
    <Filters>
        <RadzenTextBox Placeholder="@L["Search"]" @bind-Value="_search"
            Change="@(_ => ResetSearchAsync())" class="pipeline-list-search" />
    </Filters>
</Aetheus.Front.Shared.PageHeader>

<AetheusDataGrid @ref="_grid" Data="@_feeds" TItem="PackageFeedDto" Count="@_totalCount"
    IsLoading="@_loading" LoadData="@LoadDataAsync" PageSize="25"
    class="rz-mt-4" FullHeight="true">
    <EmptyTemplate>
        <EmptyState Icon="inventory" Title="@L["NoPackageFeeds"]" Description="@L["NoPackageFeedsDescription"]" />
    </EmptyTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="PackageFeedDto" Property="Name" Title="@L["Name"]" />
        <RadzenDataGridColumn TItem="PackageFeedDto" Property="FeedType" Title="@L["Type"]" Width="120px">
            <Template Context="f"><RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@f.FeedType.ToString()" /></Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="PackageFeedDto" Property="UpstreamUrl" Title="@L["UpstreamUrl"]">
            <Template Context="f"><span class="text-mono">@f.UpstreamUrl</span></Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="PackageFeedDto" Property="PackageCount" Title="@L["Packages"]" Width="100px" />
        <RadzenDataGridColumn TItem="PackageFeedDto" Title="@L["Actions"]" Width="200px" Sortable="false">
            <Template Context="f">
                <RadzenButton Icon="inventory_2" Size="ButtonSize.ExtraSmall" Text="@L["ManagePackages"]"
                    Click="@(() => ManagePackagesAsync(f))" ButtonStyle="ButtonStyle.Light" Variant="Variant.Filled" />
                <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall" Click="@(() => DeleteAsync(f))" title="@L["Delete"]" aria-label="@L["Delete"]" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</AetheusDataGrid>
