@using Aetheus.Shared.DTOs

@if (_loading)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
}
else
{
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-3">
        <RadzenTextBox @bind-Value="_newPackage" Placeholder="@L["PackageName"]" class="rz-flex-grow-1" />
        <RadzenButton Text="@L["Add"]" Icon="add" Size="ButtonSize.Small" IsBusy="_adding" Click="@AddAsync" Disabled="@string.IsNullOrWhiteSpace(_newPackage)" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        <RadzenButton Text="@L["SyncNow"]" Icon="sync" Size="ButtonSize.Small" IsBusy="_syncing" Click="@SyncAsync" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
    </RadzenStack>

    @if (_lastSync is not null)
    {
        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mb-2">
            @string.Format(L["PackageFeedSyncSummary"], _lastSync.Synced, _lastSync.Failed, _lastSync.Unsupported)
            @if (!string.IsNullOrEmpty(_lastSync.Message)) { <span> - @_lastSync.Message</span> }
        </RadzenText>
    }

    <RadzenDataGrid Data="@_packages" TItem="PackageEntryDto" Density="Density.Compact" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced">
        <EmptyTemplate>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-p-4">@L["NoTrackedPackages"]</RadzenText>
        </EmptyTemplate>
        <Columns>
            <RadzenDataGridColumn TItem="PackageEntryDto" Property="Name" Title="@L["PackageName"]" />
            <RadzenDataGridColumn TItem="PackageEntryDto" Property="LatestVersion" Title="@L["LatestVersion"]" Width="140px">
                <Template Context="p">
                    @if (string.IsNullOrEmpty(p.LatestVersion))
                    {
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@L["NotSyncedYet"]</RadzenText>
                    }
                    else
                    {
                        <span class="text-mono">@p.LatestVersion</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PackageEntryDto" Property="LastSyncedAt" Title="@L["LastFetched"]" Width="160px">
                <Template Context="p">@(p.LastSyncedAt.Year < 2000 ? "-" : p.LastSyncedAt.ToString("g"))</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PackageEntryDto" Title="" Width="56px" Sortable="false" TextAlign="TextAlign.Center">
                <Template Context="p">
                    <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall" Click="@(() => RemoveAsync(p))" title="@L["Delete"]" aria-label="@L["Delete"]" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

    <DialogFooter CancelText="@L["Close"]" OnCancel="@Close" />
}
