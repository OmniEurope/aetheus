@page "/not-found"
@layout MainLayout
@inject IStringLocalizer<AppStrings> L
@inject NavigationManager Nav

<PageTitle>@L["NotFound"] - Aetheus</PageTitle>

<div class="not-found-container">
    <svg class="not-found-illustration" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="200" cy="150" r="120" fill="var(--rz-primary)" opacity="0.08" />
        <text x="200" y="140" text-anchor="middle" font-size="96" font-weight="800" fill="var(--rz-primary)" opacity="0.6">404</text>
        <circle cx="160" cy="200" r="6" fill="var(--rz-primary)" opacity="0.25" />
        <circle cx="240" cy="200" r="6" fill="var(--rz-primary)" opacity="0.25" />
        <path d="M170 220 Q200 235 230 220" stroke="var(--rz-primary)" stroke-width="3" fill="none" opacity="0.25" stroke-linecap="round" />
        <rect x="125" y="250" width="150" height="8" rx="4" fill="var(--rz-primary)" opacity="0.12" />
    </svg>
    <RadzenText TextStyle="TextStyle.H4" class="rz-mb-2">@L["NotFound"]</RadzenText>
    <RadzenText TextStyle="TextStyle.Body1" class="rz-color-secondary rz-mb-6">@L["NotFoundMessage"]</RadzenText>
    <RadzenButton Text="@L["BackToHome"]" Icon="home" Click="@(() => Nav.NavigateTo("/"))" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
</div>