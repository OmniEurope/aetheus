<RadzenTemplateForm TItem="CreateOrganizationRequest" Data="_model" Submit="@((CreateOrganizationRequest _) => OnSubmit())">
    <LocalizedDataAnnotationsValidator />
    <RadzenStack Gap="1rem">
        <RadzenFormField Text="@L["Name"]" Variant="Variant.Filled">
            <RadzenTextBox @bind-Value="_model.Name" aria-label="@L["Name"]" />
        </RadzenFormField>
        <RadzenFormField Text="@L["Slug"]" Variant="Variant.Filled">
            <RadzenTextBox @bind-Value="_model.Slug" aria-label="@L["Slug"]" />
        </RadzenFormField>
        <RadzenFormField Text="@L["Description"]" Variant="Variant.Filled">
            <RadzenTextArea @bind-Value="_model.Description" Rows="3" aria-label="@L["Description"]" />
        </RadzenFormField>
        <ValidationSummary />

        @if (!string.IsNullOrEmpty(_error))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" ShowIcon="true">@_error</RadzenAlert>
        }

        <DialogFooter OnCancel="@Cancel">
            <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Save"]"
                          Icon="save" IsBusy="@_saving" BusyText="@L["Saving"]" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        </DialogFooter>
    </RadzenStack>
</RadzenTemplateForm>
