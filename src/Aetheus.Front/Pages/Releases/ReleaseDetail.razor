@page "/releases/{ReleaseId:int}"
@using Aetheus.Front.Helpers
@using Aetheus.Shared.Enums

<PageTitle>@(_release?.Version ?? L["Release"]) - Aetheus</PageTitle>

@if (_loading)
{
    <RadzenProgressBarCircular ShowValue="true" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
}
else if (_release is null)
{
    <RadzenText TextStyle="TextStyle.Body1" class="rz-color-secondary">@L["ReleaseNotFound"]</RadzenText>
}
else
{
    <Aetheus.Front.Shared.PageHeader Title="@_release.Version" Icon="new_releases"
        BackHref="@($"/projects/{_release.ProjectId}/releases")">
        <ChildContent>
            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@_release.ProjectName" />
            <RadzenBadge BadgeStyle="@ReleaseHelper.GetReleaseBadge(_release.Status)" Text="@L[_release.Status.ToString()]" />
            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@($"#{_release.BuildNumber}")" />
        </ChildContent>
        <Actions>
            <RadzenButton Icon="undo" Text="@L["Rollback"]" Size="ButtonSize.Small"
                Click="@RollbackAsync" Disabled="@(!_canWrite || !CanRollback)"
                title="@RollbackDisabledReason" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
        </Actions>
    </Aetheus.Front.Shared.PageHeader>

    @* Key facts - lifecycle timestamps *@
    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mt-4">
        @if (_release.DetectedAt.Year > 2000)
        {
            <RadzenCard class="run-overview-card">
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary"><RadzenIcon Icon="search" class="run-tile-icon" /> @L["Detected"]</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1">@_release.DetectedAt.ToString("g")</RadzenText>
            </RadzenCard>
        }
        @if (_release.PublishedAt.HasValue)
        {
            <RadzenCard class="run-overview-card">
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary"><RadzenIcon Icon="publish" class="run-tile-icon" /> @L["Published"]</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1">@_release.PublishedAt.Value.ToString("g")</RadzenText>
            </RadzenCard>
        }
        @if (_release.PromotedAt.HasValue)
        {
            <RadzenCard class="run-overview-card">
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary"><RadzenIcon Icon="rocket_launch" class="run-tile-icon" /> @L["Promoted"]</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1">@_release.PromotedAt.Value.ToString("g")</RadzenText>
            </RadzenCard>
        }
    </RadzenStack>

    @* Source (where it comes from) vs Deliverables (what it ships / where it targets) *@
    <RadzenRow Gap="1rem" class="rz-mt-4">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenCard>
                <div class="detail-panel-title">
                    <RadzenIcon Icon="account_tree" class="run-tile-icon rz-color-primary" />
                    <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">@L["Source"]</RadzenText>
                </div>
                @if (_release.Branches.Count > 0)
                {
                    @foreach (var branch in _release.Branches)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="detail-row">
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary"><RadzenIcon Icon="call_split" class="run-tile-icon" /> @L["Branch"]</RadzenText>
                            <a href="/git/branches/@branch.Id" class="detail-value-link">@branch.Name</a>
                        </RadzenStack>
                    }
                }
                else if (!string.IsNullOrEmpty(_release.BranchName))
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="detail-row">
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary"><RadzenIcon Icon="call_split" class="run-tile-icon" /> @L["Branch"]</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2">@_release.BranchName</RadzenText>
                    </RadzenStack>
                }
                @if (_release.Commits.Count > 0)
                {
                    @foreach (var commit in _release.Commits)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="detail-row">
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary"><RadzenIcon Icon="commit" class="run-tile-icon" /> @L["Commit"]</RadzenText>
                            <a href="/git/commits/@commit.Id" class="detail-value-link text-mono" title="@commit.Sha">@ShortSha(commit.Sha)</a>
                        </RadzenStack>
                    }
                }
                else if (!string.IsNullOrEmpty(_release.CommitHash))
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="detail-row">
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary"><RadzenIcon Icon="commit" class="run-tile-icon" /> @L["Commit"]</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" class="text-mono" title="@_release.CommitHash">@ShortSha(_release.CommitHash)</RadzenText>
                    </RadzenStack>
                }
                @if (!string.IsNullOrEmpty(_release.TagName))
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="detail-row">
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary"><RadzenIcon Icon="sell" class="run-tile-icon" /> @L["Tag"]</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2">@_release.TagName</RadzenText>
                    </RadzenStack>
                }
                @if (_release.PipelineRunId.HasValue)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="detail-row">
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary"><RadzenIcon Icon="play_arrow" class="run-tile-icon" /> @L["PipelineRun"]</RadzenText>
                        <a href="/pipelines/runs/@_release.PipelineRunId" class="detail-value-link">#@_release.PipelineRunId</a>
                    </RadzenStack>
                }
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="detail-row">
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary"><RadzenIcon Icon="folder" class="run-tile-icon" /> @L["Project"]</RadzenText>
                    <a href="/projects/@_release.ProjectId" class="detail-value-link">@_release.ProjectName</a>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        @if (HasDeliverables)
        {
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenCard>
                    <div class="detail-panel-title">
                        <RadzenIcon Icon="inventory_2" class="run-tile-icon rz-color-info" />
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">@L["Deliverables"]</RadzenText>
                    </div>
                    @foreach (var artifact in _release.Artifacts)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="detail-row">
                            <a href="/artifacts/@artifact.Id" class="detail-value-link"><RadzenIcon Icon="inventory_2" class="run-tile-icon rz-color-info" /> @artifact.Name</a>
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">@FormatSize(artifact.SizeBytes)</RadzenText>
                        </RadzenStack>
                    }
                    @if (!string.IsNullOrEmpty(_release.EnvironmentName))
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="detail-row">
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary"><RadzenIcon Icon="cloud" class="run-tile-icon rz-color-warning" /> @L["Environment"]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@_release.EnvironmentName</RadzenText>
                        </RadzenStack>
                    }
                </RadzenCard>
            </RadzenColumn>
        }
    </RadzenRow>

    @* Changelog as Timeline *@
    @if (!string.IsNullOrEmpty(_release.Changelog))
    {
        <RadzenCard class="rz-mt-4 rz-p-4">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-3">
                <RadzenIcon Icon="history" />
                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0">@L["Changelog"]</RadzenText>
            </RadzenStack>
            <RadzenTimeline Orientation="Orientation.Vertical" AlignItems="AlignItems.Start" LinePosition="LinePosition.Start" class="release-changelog-timeline">
                <Items>
                    @foreach (var entry in ParseChangelogEntries(_release.Changelog))
                    {
                        <RadzenTimelineItem PointStyle="@GetChangelogPointStyle(entry.Type)">
                            <ChildContent>
                                <div class="release-cl-content">
                                    @if (!string.IsNullOrEmpty(entry.Type))
                                    {
                                        <RadzenBadge BadgeStyle="@GetChangelogBadge(entry.Type)" Text="@entry.Type" class="release-cl-badge" />
                                    }
                                    <span class="release-cl-text">@entry.Text</span>
                                </div>
                            </ChildContent>
                        </RadzenTimelineItem>
                    }
                </Items>
            </RadzenTimeline>
        </RadzenCard>
    }
}
