@page "/backups"

<PageTitle>@L["Backups"] - Aetheus</PageTitle>

<Aetheus.Front.Shared.PageHeader Title="@L["Backups"]" Icon="backup">
    <Actions>
        <RadzenButton Text="@L["BackupNewPolicy"]" Icon="add" Click="@NewPolicy" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
    </Actions>
</Aetheus.Front.Shared.PageHeader>

<RadzenText TextStyle="TextStyle.Body2" class="rz-mb-4">@L["BackupPageDescription"]</RadzenText>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-3">
    <RadzenTextBox @bind-Value="_policySearch" Change="@ResetPoliciesAsync"
        Placeholder="@L["Search"]" class="pipeline-list-search" />
    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@string.Format(L["Total"], _policiesTotalCount)" />
</RadzenStack>

@if (_form is not null)
{
    <RadzenCard class="rz-mb-4">
        <RadzenTemplateForm TItem="PolicyForm" Data="@_form" Submit="@(async (PolicyForm _) => await SaveAsync())">
            <LocalizedDataAnnotationsValidator />
            <RadzenStack Gap="1rem">
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">@(_form.Id == 0 ? L["BackupNewPolicy"] : L["BackupEditPolicy"])</RadzenText>
                <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="1rem" AlignItems="AlignItems.Start">
                    <RadzenFormField Text="@L["BackupName"]" Variant="Variant.Outlined">
                        <RadzenTextBox @bind-Value="_form.Name" Name="Name" MaxLength="120" />
                        <ValidationMessage For="@(() => _form.Name)" />
                    </RadzenFormField>
                    <RadzenFormField Text="@L["Project"]" Variant="Variant.Outlined">
                        <RadzenDropDown TValue="int" @bind-Value="_form.ProjectId" Data="@_projects" ValueProperty="Id" TextProperty="Name" Disabled="@(_form.Id != 0)" />
                        <ValidationMessage For="@(() => _form.ProjectId)" />
                    </RadzenFormField>
                    <RadzenFormField Text="@L["Server"]" Variant="Variant.Outlined">
                        <RadzenDropDown TValue="int" @bind-Value="_form.ServerId" Data="@_servers" ValueProperty="Id" TextProperty="Name" Disabled="@(_form.Id != 0)" />
                        <ValidationMessage For="@(() => _form.ServerId)" />
                    </RadzenFormField>
                    <RadzenFormField Text="@L["BackupEngine"]" Variant="Variant.Outlined">
                        <RadzenDropDown TValue="BackupDbEngine" @bind-Value="_form.DbEngine" Data="@_engineOptions"
                            TextProperty="Text" ValueProperty="Value" />
                    </RadzenFormField>
                </RadzenStack>

                @if (_form.DbEngine != BackupDbEngine.None)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="1rem" AlignItems="AlignItems.Start">
                        <RadzenFormField Text="@L["BackupDbHost"]" Variant="Variant.Outlined">
                            <RadzenTextBox @bind-Value="_form.DbHost" MaxLength="255" />
                        </RadzenFormField>
                        <RadzenFormField Text="@L["BackupDbPort"]" Variant="Variant.Outlined">
                            <RadzenNumeric TValue="int?" @bind-Value="_form.DbPort" Min="1" Max="65535" />
                        </RadzenFormField>
                        <RadzenFormField Text="@L["BackupDbName"]" Variant="Variant.Outlined">
                            <RadzenTextBox @bind-Value="_form.DbName" MaxLength="120" />
                        </RadzenFormField>
                        <RadzenFormField Text="@L["BackupDbUser"]" Variant="Variant.Outlined">
                            <RadzenTextBox @bind-Value="_form.DbUser" MaxLength="120" />
                        </RadzenFormField>
                        <RadzenFormField Text="@(_form.Id == 0 ? L["BackupDbPassword"] : L["BackupDbPasswordKeep"])" Variant="Variant.Outlined">
                            <RadzenPassword @bind-Value="_form.DbPassword" />
                        </RadzenFormField>
                    </RadzenStack>
                }

                <RadzenFormField Text="@L["BackupFilePaths"]" Variant="Variant.Outlined">
                    <RadzenTextArea @bind-Value="_form.FilePathsText" Rows="3" />
                </RadzenFormField>

                <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="1rem" AlignItems="AlignItems.Start">
                    <RadzenFormField Text="@L["BackupScheduleCron"]" Variant="Variant.Outlined">
                        <RadzenTextBox @bind-Value="_form.ScheduleCron" Name="ScheduleCron" MaxLength="120" />
                        <ValidationMessage For="@(() => _form.ScheduleCron)" />
                    </RadzenFormField>
                    <RadzenFormField Text="@L["BackupRetention"]" Variant="Variant.Outlined">
                        <RadzenNumeric TValue="int" @bind-Value="_form.RetentionCount" Min="1" Max="365" />
                    </RadzenFormField>
                    <RadzenFormField Text="@L["BackupRestoreCheckCron"]" Variant="Variant.Outlined">
                        <RadzenTextBox @bind-Value="_form.RestoreCheckCron" MaxLength="120" />
                    </RadzenFormField>
                    @if (_form.Id != 0)
                    {
                        <LabeledToggle Kind="ToggleKind.Switch" @bind-Value="_form.Enabled" Text="@L["BackupEnabled"]" />
                    }
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Save"]" Icon="save" Busy="@_saving" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                    <RadzenButton Text="@L["Cancel"]" Icon="close" Click="@CancelForm" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                </RadzenStack>
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
}

<AetheusDataGrid @ref="_policyGrid" Data="@_policies" TItem="BackupPolicyDto"
    Count="@_policiesTotalCount" IsLoading="@_loading" LoadData="@OnLoadPoliciesAsync"
    PageSize="25" Density="Density.Compact" class="aetheus-grid-fullheight">
    <EmptyTemplate>
        <EmptyState Icon="backup" Title="@L["BackupEmptyTitle"]" Description="@L["BackupEmptyDescription"]" />
    </EmptyTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="BackupPolicyDto" Property="Name" Title="@L["BackupName"]" MinWidth="10rem" />
        <RadzenDataGridColumn TItem="BackupPolicyDto" Title="@L["Project"]" Width="160px">
            <Template Context="p">@ProjectName(p.ProjectId)</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="BackupPolicyDto" Title="@L["Server"]" Width="160px">
            <Template Context="p">@ServerName(p.ServerId)</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="BackupPolicyDto" Property="DbEngine" Title="@L["BackupEngine"]" Width="120px">
            <Template Context="p">@L.Localize(p.DbEngine)</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="BackupPolicyDto" Property="ScheduleCron" Title="@L["BackupScheduleCron"]" Width="140px" />
        <RadzenDataGridColumn TItem="BackupPolicyDto" Property="RetentionCount" Title="@L["BackupRetention"]" Width="110px" />
        <RadzenDataGridColumn TItem="BackupPolicyDto" Property="LastRunAt" Title="@L["BackupLastRun"]" Width="160px">
            <Template Context="p">@(p.LastRunAt?.ToString("g") ?? L["BackupNever"])</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="BackupPolicyDto" Property="Enabled" Title="@L["BackupEnabled"]" Width="110px">
            <Template Context="p">
                <RadzenBadge BadgeStyle="@(p.Enabled ? BadgeStyle.Success : BadgeStyle.Light)" Text="@(p.Enabled ? L["BackupEnabledYes"] : L["BackupEnabledNo"])" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="BackupPolicyDto" Title="@L["Actions"]" MinWidth="32rem" Sortable="false">
            <Template Context="p">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                    <RadzenButton Text="@L["BackupRuns"]" Icon="history" Click="@(() => ShowRunsAsync(p))" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" />
                    <RadzenButton Text="@L["BackupRunNow"]" Icon="play_arrow" Click="@(() => RunNowAsync(p))" ButtonStyle="ButtonStyle.Success" Variant="Variant.Filled" />
                    <RadzenButton Text="@L["Edit"]" Icon="edit" Click="@(() => EditPolicy(p))" ButtonStyle="ButtonStyle.Info" Variant="Variant.Filled" />
                    <RadzenButton Text="@L["Delete"]" Icon="delete" Click="@(() => DeletePolicyAsync(p))" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</AetheusDataGrid>

@if (_runsFor is not null)
{
    <RadzenText TextStyle="TextStyle.H6" class="rz-mt-6 rz-mb-2">@string.Format(L["BackupRunsFor"], _runsFor.Name)</RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-2">
        <RadzenTextBox @bind-Value="_runsSearch" Change="@ResetRunsAsync"
            Placeholder="@L["Search"]" class="pipeline-list-search" />
        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@string.Format(L["Total"], _runsTotalCount)" />
    </RadzenStack>
    <AetheusDataGrid @ref="_runsGrid" Data="@_runs" TItem="BackupRunDto"
        Count="@_runsTotalCount" IsLoading="@_runsLoading" LoadData="@OnLoadRunsAsync"
        Density="Density.Compact" PageSize="10">
        <EmptyTemplate>
            <EmptyState Icon="history" Title="@L["BackupNoRuns"]" Description="@L["BackupNoRunsDescription"]" />
        </EmptyTemplate>
        <Columns>
            <RadzenDataGridColumn TItem="BackupRunDto" Property="StartedAt" Title="@L["BackupStartedAt"]" Width="170px" FormatString="{0:g}" />
            <RadzenDataGridColumn TItem="BackupRunDto" Property="Status" Title="@L["BackupStatus"]" Width="120px">
                <Template Context="r"><RadzenBadge BadgeStyle="@RunStatusStyle(r.Status)" Text="@L.Localize(r.Status)" /></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="BackupRunDto" Property="RestoreCheckStatus" Title="@L["BackupRestoreCheck"]" Width="150px">
                <Template Context="r"><RadzenBadge BadgeStyle="@RestoreStyle(r.RestoreCheckStatus)" Text="@RestoreLabel(r.RestoreCheckStatus)" /></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="BackupRunDto" Property="SizeBytes" Title="@L["BackupSize"]" Width="110px" />
            <RadzenDataGridColumn TItem="BackupRunDto" Property="Message" Title="@L["BackupMessage"]" />
        </Columns>
    </AetheusDataGrid>
}
