<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!--
            Canonical product-coverage exclusion whitelist (reviewed 2026-07-14):
            * compiler/OpenAPI generated types and *.g.cs files;
            * EF migration history generated by tooling.

            Every handwritten source file, including Program.cs, design-time infrastructure,
            logging providers, Blazor components, agent collectors and hosted services, remains in
            the denominator. E2E execution is separate evidence, never a coverage exclusion.
          -->
          <Exclude>[*]Microsoft.AspNetCore.OpenApi.Generated.*,[*]Aetheus.Back.Data.Migrations.*,[*]System.Runtime.CompilerServices.*</Exclude>
          <ExcludeByFile>**/*.g.cs,**/Migrations/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
