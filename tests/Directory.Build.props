<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Microsoft.Testing.Platform test projects are executables; Microsoft.NET.Test.Sdk used to set
         this, and it is gone with VSTest. Every project under tests/ is a test project. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- A test that only makes sense on one OS is a [PlatformFact]/[PlatformTheory]
       (tests/Shared/PlatformSpecificTests.cs), not discovered elsewhere: no default filter is set here,
       since xunit refuses to combine one with the `filter` option a caller adds. -->

</Project>
