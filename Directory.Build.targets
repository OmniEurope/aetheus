<Project>
  <!-- PRM002 consumes Razor source as AdditionalFiles. Centralising this input prevents a project
       from silently disabling the convention by omitting a project-local item group. -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\**\*.razor"
                     Exclude="$(MSBuildProjectDirectory)\bin\**;$(MSBuildProjectDirectory)\obj\**" />
  </ItemGroup>
</Project>
