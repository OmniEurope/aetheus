# Production environment file template (R-248). prod-deploy-prepare.sh reads it on the FIRST deploy
# only, to write ENV_FILE; an existing file is never regenerated. It holds no secret and never will.
#
# Each non-comment line is KEY=VALUE, copied in this order. A VALUE is either a literal written as is,
# or one declared placeholder, the whole value:
#   #{PUBLIC_API_URL}# #{PUBLIC_APP_URL}# #{APP_VERSION}#  run value, required non-empty
#   #{SECRET_HEX_<N>}#                                     SECRET: `openssl rand -hex <N>` on the host
# Anything else between #{ and }# is refused. Comment and blank lines are not copied.
APPNAME=aetheus
ENV=prod
# Example: https://api.example.org
API_BASE_URL=#{PUBLIC_API_URL}#
# Example: 1.1.1842
APP_VERSION=#{APP_VERSION}#
DB_USER=aetheus
DB_PASSWORD=#{SECRET_HEX_24}#
JWT_KEY=#{SECRET_HEX_32}#
ADMIN_PASSWORD=#{SECRET_HEX_16}#
ENCRYPTION_KEY=#{SECRET_HEX_32}#
ENCRYPTION_SALT=#{SECRET_HEX_16}#
DEPLOYMENT_BOOTSTRAP_IDENTITY_KEY=#{SECRET_HEX_32}#
# Example: https://app.example.org
FRONT_URL=#{PUBLIC_APP_URL}#
FRONT_URL_ACCEPT=#{PUBLIC_APP_URL}#
FRONT_URL_PROD=#{PUBLIC_APP_URL}#
