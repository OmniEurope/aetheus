<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="../Toto.Domain/Toto.Domain.csproj" />
    <PackageReference Include="Npgsql" Version="10.0.1" />
    <PackageReference Include="Aetheus.Telemetry"
                      Version="$(AetheusTelemetryVersion)"
                      Condition="'$(EnableAetheusTelemetry)' == 'true'" />
    <PackageReference Include="Aetheus.WebAnalytics"
                      Version="$(AetheusWebAnalyticsVersion)"
                      Condition="'$(EnableAetheusWebAnalytics)' == 'true'" />
  </ItemGroup>
  <PropertyGroup>
    <EnableAetheusTelemetry Condition="'$(EnableAetheusTelemetry)' == ''">false</EnableAetheusTelemetry>
    <AetheusTelemetryVersion Condition="'$(AetheusTelemetryVersion)' == ''">0.1.0</AetheusTelemetryVersion>
    <EnableAetheusWebAnalytics Condition="'$(EnableAetheusWebAnalytics)' == ''">false</EnableAetheusWebAnalytics>
    <AetheusWebAnalyticsVersion Condition="'$(AetheusWebAnalyticsVersion)' == ''">0.1.0</AetheusWebAnalyticsVersion>
  </PropertyGroup>
</Project>
