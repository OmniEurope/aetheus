from pathlib import Path
from zipfile import ZIP_DEFLATED, ZipFile


def build_wheel(wheel_directory: str, config_settings=None, metadata_directory=None) -> str:
    wheel_name = "toto_python-1.0.0-py3-none-any.whl"
    destination = Path(wheel_directory)
    destination.mkdir(parents=True, exist_ok=True)
    with ZipFile(destination / wheel_name, "w", ZIP_DEFLATED) as wheel:
        wheel.write("toto_math.py", "toto_math.py")
        wheel.writestr(
            "toto_python-1.0.0.dist-info/METADATA",
            "Metadata-Version: 2.1\nName: toto-python\nVersion: 1.0.0\n",
        )
        wheel.writestr(
            "toto_python-1.0.0.dist-info/WHEEL",
            "Wheel-Version: 1.0\nGenerator: toto-build-backend\nRoot-Is-Purelib: true\nTag: py3-none-any\n",
        )
    return wheel_name
