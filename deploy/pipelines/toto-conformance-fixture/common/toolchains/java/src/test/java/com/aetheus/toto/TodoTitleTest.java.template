package com.aetheus.toto;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;

import org.junit.jupiter.api.Test;

final class TodoTitleTest {
    @Test
    void trimsARealTitle() {
        assertEquals("ship Toto", TodoTitle.normalize("  ship Toto  "));
    }

    @Test
    void rejectsAnEmptyTitle() {
        assertThrows(IllegalArgumentException.class, () -> TodoTitle.normalize(" "));
    }
}
