# =============================================================================
# Dockerfile - Aetheus Backend (.NET 10 Web API)
# Also packages agent binaries (Linux tar.gz + Windows zip) served at /downloads
# =============================================================================
# syntax=docker/dockerfile:1.7
ARG APP_VERSION=0.0.0
ARG CACHE_COHORT=shared

FROM mcr.microsoft.com/dotnet/sdk:10.0.100@sha256:c7445f141c04f1a6b454181bd098dcfa606c61ba0bd213d0a702489e5bd4cd71 AS build-source
ARG CACHE_COHORT
WORKDIR /src

# Persist NuGet cache across builds (BuildKit). Massively speeds up incremental
# builds where only source files change.
ENV NUGET_PACKAGES=/root/.nuget/packages \
    DOTNET_NOLOGO=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1

COPY Directory.Build.props .
COPY Directory.Build.targets .
COPY Directory.Packages.props .
COPY NuGet.config .
COPY scanner-manifest.json /scanner-manifest.json
COPY .aetheus/security-rules/opengrep/aetheus-security.yml /.aetheus/security-rules/opengrep/aetheus-security.yml
COPY src/Aetheus.Shared/Aetheus.Shared.csproj Aetheus.Shared/
COPY src/Aetheus.Analyzers/Aetheus.Analyzers.csproj Aetheus.Analyzers/
COPY src/Aetheus.Telemetry/Aetheus.Telemetry.csproj Aetheus.Telemetry/
COPY src/Aetheus.Back/Aetheus.Back.csproj Aetheus.Back/
COPY src/Aetheus.Agent.Core/Aetheus.Agent.Core.csproj Aetheus.Agent.Core/
COPY src/Aetheus.Agent.Linux/Aetheus.Agent.Linux.csproj Aetheus.Agent.Linux/
COPY src/Aetheus.Agent.Windows/Aetheus.Agent.Windows.csproj Aetheus.Agent.Windows/

# Single combined restore: -r linux-x64 covers both the runtime publish of
# Aetheus.Back and the EF migrations bundle (also linux-x64). The agents
# get RID-specific assets via their own publish later.
#
# This layer WARMS the cache; it is deliberately no longer the only restore. Its result lives in two
# stores with independent lifetimes: `project.assets.json` in the image layer, the packages it points
# at in the `nuget-*` cache mount. `docker buildx prune` (the agent's bounded storage maintenance)
# reclaims mount records and layer records separately, so the small, recently-used restore layer can
# survive a sweep that empties the large package mount. A later `--no-restore` publish then reads an
# assets file whose packages are gone and fails with NETSDK1064 - which is exactly what happened on
# mirror run 1102, 36 minutes after run 1098 built the SAME commit successfully. The publishes below
# therefore restore in their own layer, so a reclaimed mount is refilled instead of failing a build.
RUN --mount=type=cache,id=nuget-${CACHE_COHORT},target=/root/.nuget/packages,sharing=locked \
    dotnet restore Aetheus.Back/Aetheus.Back.csproj -r linux-x64 \
    && dotnet restore Aetheus.Agent.Linux/Aetheus.Agent.Linux.csproj -r linux-x64 \
    && dotnet restore Aetheus.Agent.Windows/Aetheus.Agent.Windows.csproj -r win-x64

# Install the EF tool BEFORE copying sources: source-only rebuilds keep this
# layer cached instead of re-downloading the tool on every deploy.
RUN --mount=type=cache,id=nuget-${CACHE_COHORT},target=/root/.nuget/packages,sharing=locked \
    dotnet tool install --global dotnet-ef --version 10.0.12
ENV PATH="${PATH}:/root/.dotnet/tools"

ARG APP_VERSION
ARG SOURCE_COMMIT

FROM build-source AS agent-linux-build
COPY src/Aetheus.Shared/ Aetheus.Shared/
COPY src/Aetheus.Agent.Core/ Aetheus.Agent.Core/
COPY src/Aetheus.Agent.Linux/ Aetheus.Agent.Linux/
COPY deploy/scripts/install-agent-linux.sh deploy/scripts/install-agent-linux.sh
# R-249: the host configuration templates install-agent-linux.sh renders, shipped next to it.
COPY deploy/agent-host-config/ deploy/agent-host-config/
COPY deploy/scripts/zap-active-automation.sh /deploy/scripts/zap-active-automation.sh
COPY deploy/scripts/publish-observability-package.sh /deploy/scripts/publish-observability-package.sh
COPY deploy/scripts/promote-observability-packages.sh /deploy/scripts/promote-observability-packages.sh
ARG APP_VERSION
RUN --mount=type=cache,id=nuget-${CACHE_COHORT},target=/root/.nuget/packages,sharing=locked \
    dotnet publish Aetheus.Agent.Linux/Aetheus.Agent.Linux.csproj \
        -c Release -r linux-x64 --self-contained true \
        -o /tmp/agent-linux \
        /p:Version=${APP_VERSION} \
    && sed -i 's/\r$//' deploy/scripts/install-agent-linux.sh \
    && chmod +x deploy/scripts/install-agent-linux.sh \
    && cp deploy/scripts/install-agent-linux.sh /tmp/agent-linux/install-agent-linux.sh \
    && find deploy/agent-host-config -type f -exec sed -i 's/\r$//' {} + \
    && cp -R deploy/agent-host-config /tmp/agent-linux/agent-host-config \
    && mkdir -p /agent-release \
    && tar -C /tmp/agent-linux -czf /agent-release/aetheus-agent-linux-x64-v${APP_VERSION}.tar.gz . \
    && rm -rf /tmp/agent-linux

FROM build-source AS agent-windows-build
COPY src/Aetheus.Shared/ Aetheus.Shared/
COPY src/Aetheus.Agent.Core/ Aetheus.Agent.Core/
COPY src/Aetheus.Agent.Windows/ Aetheus.Agent.Windows/
COPY deploy/scripts/install-agent-windows.ps1 deploy/scripts/install-agent-windows.ps1
COPY deploy/scripts/zap-active-automation.sh /deploy/scripts/zap-active-automation.sh
COPY deploy/scripts/publish-observability-package.sh /deploy/scripts/publish-observability-package.sh
COPY deploy/scripts/promote-observability-packages.sh /deploy/scripts/promote-observability-packages.sh
ARG APP_VERSION
RUN --mount=type=cache,id=nuget-${CACHE_COHORT},target=/root/.nuget/packages,sharing=locked \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    dotnet publish Aetheus.Agent.Windows/Aetheus.Agent.Windows.csproj \
        -c Release -r win-x64 --self-contained true \
        -o /tmp/agent-windows \
        /p:Version=${APP_VERSION} \
    && cp deploy/scripts/install-agent-windows.ps1 /tmp/agent-windows/install-agent-windows.ps1 \
    && apt-get update && apt-get install -y --no-install-recommends zip \
    && mkdir -p /agent-release \
    && (cd /tmp/agent-windows && zip -r /agent-release/aetheus-agent-win-x64-v${APP_VERSION}.zip .) \
    && rm -rf /tmp/agent-windows

FROM build-source AS agent-release
COPY --from=agent-linux-build /agent-release/ /agent-release/
COPY --from=agent-windows-build /agent-release/ /agent-release/
COPY deploy/scripts/generate-agent-release-manifest.sh /generate-agent-release-manifest.sh
ARG APP_VERSION
ARG SOURCE_COMMIT
RUN chmod +x /generate-agent-release-manifest.sh \
    && /generate-agent-release-manifest.sh /agent-release "${APP_VERSION}" "${SOURCE_COMMIT}"

FROM scratch AS agent-release-output
COPY --from=agent-release /agent-release/ /

# The backend publish is NOT built here any more. The pipeline has already compiled the whole
# solution in Release before this image is built, and rebuilding the same sources from a cold obj/
# inside the container cost 88.6 s (measured 2026-09-07). deploy/scripts/publish-application.sh
# produces it on the host, into .pipeline-publish/backend/, and it is copied in below.
#
# The EF migrations bundle stays here, deliberately. `dotnet ef migrations bundle --runtime linux-x64
# --self-contained` emits an apphost for the BUILD host's operating system, so producing it on a
# Windows host writes a PE executable this Linux image copies, chmods and then fails to run with no
# output at all. Built in this container, the answer no longer depends on who ran the pipeline.
FROM build-source AS ef-bundle
COPY src/Aetheus.Shared/ Aetheus.Shared/
COPY src/Aetheus.Analyzers/ Aetheus.Analyzers/
COPY src/Aetheus.Telemetry/ Aetheus.Telemetry/
COPY src/Aetheus.Back/ Aetheus.Back/
COPY deploy/pipelines/toto-conformance-fixture/ /deploy/pipelines/toto-conformance-fixture/
COPY deploy/pipelines/toto-vulnerable-fixture/ /deploy/pipelines/toto-vulnerable-fixture/
COPY deploy/pipelines/toto-*.yaml /deploy/pipelines/
COPY deploy/pipeline-templates/*.yaml /deploy/pipeline-templates/
COPY deploy/pipeline-templates/generic/*.yaml /deploy/pipeline-templates/generic/
COPY deploy/scripts/generate-delivery-contract.mjs /deploy/scripts/generate-delivery-contract.mjs
COPY deploy/scripts/verify-delivery-promotion.mjs /deploy/scripts/verify-delivery-promotion.mjs
COPY deploy/scripts/resolve-injected-nuget-packages.mjs /deploy/scripts/resolve-injected-nuget-packages.mjs
COPY deploy/scripts/generate-artifact-provenance.mjs /deploy/scripts/generate-artifact-provenance.mjs
COPY deploy/scripts/generate-candidate-assurance-contract.mjs /deploy/scripts/generate-candidate-assurance-contract.mjs
COPY deploy/scripts/verify-candidate-assurance-contract.mjs /deploy/scripts/verify-candidate-assurance-contract.mjs
# Pass the non-routable placeholder directly to the design-time factory. Arguments after
# `--` are forwarded by dotnet-ef to IDesignTimeDbContextFactory, avoiding environment
# propagation differences between Docker engines. This value is never used at runtime.
# The restore belongs to this layer because `dotnet ef` builds the project from the assets file the
# cached restore layer left behind, and never re-downloads a package the buildx cache mount no longer
# holds. Mirror run 1104 proved the split exactly: the combined restore came back `#28 CACHED` and
# this stage still failed with NETSDK1064 on Microsoft.AspNetCore.OpenApi.
# RunAnalyzers=false: this compile only feeds the bundle, and the analyzers' verdict belongs to the
# CI Compile stage. Skipping them halves the compile (28 s -> 14 s for Aetheus.Back, measured locally
# on 2026-09-13) and leaves the assemblies byte-identical (same sha256); source generators still run.
# dotnet-ef forwards no MSBuild property, so it is set as an environment variable MSBuild reads.
RUN --mount=type=cache,id=nuget-${CACHE_COHORT},target=/root/.nuget/packages,sharing=locked \
    dotnet restore Aetheus.Back/Aetheus.Back.csproj -r linux-x64 \
    && RunAnalyzers=false dotnet-ef migrations bundle \
        --project Aetheus.Back/Aetheus.Back.csproj \
        --startup-project Aetheus.Back/Aetheus.Back.csproj \
        --runtime linux-x64 \
        --self-contained \
        --force \
        -o /app/efbundle \
        -- \
        --design-connection "Host=localhost;Database=aetheus_design;Username=build"

FROM mcr.microsoft.com/dotnet/aspnet:10.0.12@sha256:6a94333d37514e385650a3c81a55e5350b67253dbe136e9cf17e499c35606a8c AS runtime
WORKDIR /app

# Static layers (apt, writable dirs) BEFORE the build-output COPY: placed after
# it, they were invalidated - and apt re-run - on every source change.
# curl is required by the compose healthcheck on /health/live.
# libssl3t64 is named with openssl so apt takes the security candidate even when the base image lags
# the Ubuntu fix (recette R2-028, CVE-2026-84782).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgssapi-krb5-2 git openssl libssl3t64 curl \
    && rm -rf /var/lib/apt/lists/*

# Every named-volume mount point must exist app-owned in the image, otherwise a
# fresh volume materializes root-owned and the first write fails under USER app.
# Binaries copied below stay root-owned (read-only for the app user) on purpose;
# only logs/ and data/ are writable.
RUN mkdir -p /app/logs /app/data/git-repos /app/data/dp-keys /app/data/artifacts /app/data/packages \
    && chown -R app:app /app/logs /app/data

COPY .pipeline-publish/backend/ .
COPY --from=ef-bundle /app/efbundle ./efbundle
COPY --from=agent-release /agent-release/ ./wwwroot/downloads/
COPY deploy/docker/entrypoint-back.sh ./entrypoint-back.sh
# The host publish is what this image now IS, so its absence must stop the build rather than produce
# an image with no application in it.
RUN test -s /app/Aetheus.Back.dll && test -s /app/efbundle

RUN sed -i 's/\r//' /app/entrypoint-back.sh \
    && chmod 0755 /app/entrypoint-back.sh /app/efbundle \
    # The build agent's restrictive umask can leave published files mode 0600 (root-only), so the
    # non-root `app` user cannot even READ appsettings.json / the assemblies ("Access to the path is
    # denied"). Enforce the intended "root-owned, world-readable" state: read for files, traverse for
    # dirs, no write added.
    && chmod -R a+rX /app

EXPOSE 8080

USER app

# Invoke via `sh` explicitly rather than exec'ing the script directly: the shell only needs READ on
# the file (not the execute bit), which sidesteps the "cannot open: Permission denied" the exec-form
# entrypoint hit under USER app on the QA/deploy stack.
ENTRYPOINT ["/bin/sh", "/app/entrypoint-back.sh"]
