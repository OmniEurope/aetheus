# =============================================================================
# Dockerfile - Aetheus Frontend (Blazor WebAssembly)
# =============================================================================
# syntax=docker/dockerfile:1.7
FROM mcr.microsoft.com/dotnet/sdk:10.0.202@sha256:adc02be8b87957d07208a4a3e51775935b33bad3317de8c45b1e67357b4c073b AS build
WORKDIR /src

ENV NUGET_PACKAGES=/root/.nuget/packages \
    DOTNET_NOLOGO=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1

COPY Directory.Build.props .
COPY Directory.Build.targets .
# Central Package Management: restore needs Directory.Packages.props to resolve every PackageReference
# version (without it: NU1015), and NuGet.config pins the sole feed. The back Dockerfile copies both;
# the front was missing them, so the QA/deploy front image build failed at restore.
COPY Directory.Packages.props .
COPY NuGet.config .
COPY scanner-manifest.json /scanner-manifest.json
COPY src/Aetheus.Shared/Aetheus.Shared.csproj Aetheus.Shared/
COPY src/Aetheus.Analyzers/Aetheus.Analyzers.csproj Aetheus.Analyzers/
COPY src/Aetheus.Front/Aetheus.Front.csproj Aetheus.Front/
RUN --mount=type=cache,id=nuget,target=/root/.nuget/packages,sharing=locked \
    dotnet restore Aetheus.Front/Aetheus.Front.csproj

COPY src/Aetheus.Shared/ Aetheus.Shared/
COPY src/Aetheus.Analyzers/ Aetheus.Analyzers/
COPY src/Aetheus.Front/ Aetheus.Front/

# NOT --no-restore: the .csproj-only restore above does not pull the Blazor WASM runtime pack
# (browser-wasm assets are resolved at publish/build time), so a --no-restore publish fails in
# ResolvePackageAssets (MSB4018 / FallbackPackagePathResolver). Letting publish restore is cheap -
# the nuget cache mount already holds every package from the restore layer above.
RUN --mount=type=cache,id=nuget,target=/root/.nuget/packages,sharing=locked \
    dotnet publish Aetheus.Front/Aetheus.Front.csproj \
        -c Release \
        -o /app/publish -p:StaticWebAssetsPublishFingerprint=false

FROM mcr.microsoft.com/dotnet/sdk:10.0.202@sha256:adc02be8b87957d07208a4a3e51775935b33bad3317de8c45b1e67357b4c073b AS server-build
WORKDIR /src

ENV NUGET_PACKAGES=/root/.nuget/packages \
    DOTNET_NOLOGO=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1

# The analytics RCL relies on the repository-wide nullable and implicit-using policy.
COPY Directory.Build.props .
COPY Directory.Build.targets .
COPY Directory.Packages.props .
COPY NuGet.config .

# The production static host receives the short-lived analytics credentials injected by
# the Aetheus deploy stage. Keep the browser secret-free: the RCL pseudonymizes and exports
# events server-side through the same-origin /aetheus-analytics endpoint.
COPY src/Aetheus.Analyzers/ src/Aetheus.Analyzers/
COPY src/Aetheus.WebAnalytics/ src/Aetheus.WebAnalytics/
COPY packages/aetheus-web-analytics/src/aetheus-web-analytics.js packages/aetheus-web-analytics/src/aetheus-web-analytics.js
COPY deploy/docker/StaticServer.csproj deploy/docker/StaticServer.csproj
COPY deploy/docker/packages.lock.json deploy/docker/packages.lock.json
COPY deploy/docker/StaticServer.Program.cs deploy/docker/StaticServer.Program.cs
WORKDIR /src/deploy/docker

RUN --mount=type=cache,id=nuget,target=/root/.nuget/packages,sharing=locked \
    dotnet restore StaticServer.csproj --locked-mode \
    && dotnet publish StaticServer.csproj -c Release -o /server/publish --no-restore --nologo

FROM mcr.microsoft.com/dotnet/aspnet:10.0.11@sha256:207cc51496778557731c81ff670333d8ade4a4fec22768fd1be8e78474a84ecf AS runtime
WORKDIR /app

COPY --from=server-build /server/publish .
COPY --from=build /app/publish/wwwroot ./wwwroot

COPY deploy/docker/entrypoint-front.sh /entrypoint.sh
# chmod 0755 (absolute mode), NOT `chmod +x`: COPY preserves the build-context file's perms, and the
# agent's checkout can leave entrypoint-front.sh mode 6xx; `+x` then yields 7xx with no world-read, so the
# non-root `app` user cannot open it (`/bin/sh: cannot open /entrypoint.sh: Permission denied` -> crash-loop).
# 0755 forces rwxr-xr-x = world-readable+executable. Same fix already applied to Dockerfile.back's entrypoint.
RUN sed -i 's/\r//' /entrypoint.sh && chmod 0755 /entrypoint.sh
RUN chown -R app:app /app/wwwroot

EXPOSE 8080

USER app

ENTRYPOINT ["/bin/sh", "/entrypoint.sh"]
